def variant(bg, container, hover, outline, fg, muted, primary, on_primary,
            secondary, on_secondary, tertiary, on_tertiary, error, on_error,
            cursor, selection, normal, bright):
    """One variant in Noctalia's palette format. normal/bright: 8 colours each."""
    return {
        "mPrimary": primary, "mOnPrimary": on_primary,
        "mSecondary": secondary, "mOnSecondary": on_secondary,
        "mTertiary": tertiary, "mOnTertiary": on_tertiary,
        "mError": error, "mOnError": on_error,
        "mSurface": bg, "mOnSurface": fg,
        "mSurfaceVariant": container, "mOnSurfaceVariant": muted,
        "mOutline": outline, "mShadow": "#000000",
        "mHover": hover, "mOnHover": fg,
        "terminal": {
            "background": bg, "foreground": fg,
            "cursor": cursor, "cursorText": bg,
            "selectionBg": selection, "selectionFg": fg,
            "normal": dict(zip(ANSI, normal)),
            "bright": dict(zip(ANSI, bright)),
        },
    }


