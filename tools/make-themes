def write(name, spec):
    folder = ROOT / name
    folder.mkdir(exist_ok=True)
    palette = {key: spec[key] for key in ("dark", "light") if key in spec}
    (folder / "palette.json").write_text(json.dumps(palette, indent=2) + "\n")
    lines = [f'name = "{spec["name"]}"', f'description = "{spec["description"]}"', f'mode = "{spec["mode"]}"']
    if "credit" in spec:
        lines += [f'credit = "{spec["credit"]}"', f'license = "{spec["license"]}"', f'url = "{spec["url"]}"']
    else:
        lines += ['credit = "Original"']
    (folder / "theme.toml").write_text("\n".join(lines) + "\n")


def main():
    wanted = sys.argv[1:] or list(THEMES)
    for name in wanted:
        if name not in THEMES:
            sys.exit(f"make-themes: no generated theme called {name}")
        write(name, THEMES[name])
        print(f"themes/{name}")
    subprocess.run([str(ROOT.parent / "tools/make-tokens"), *wanted], check=True)


if __name__ == "__main__":
    main()
