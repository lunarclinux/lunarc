#!/usr/bin/env bash
# Checks the repository: shell syntax, shellcheck (if installed), the name and
# blocked-reference rules on every tracked file, and one pattern that has caused bugs.
#
#   tools/lint
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd); cd "$root" || exit
source distro.conf
fail=0
problem() { printf '\033[31m%s\033[0m %s\n' "lint:" "$*"; fail=1; }

# Shell scripts: anything tracked with a bash shebang, plus the sourced step files.
mapfile -t scripts < <(git ls-files | while read -r f; do
  [[ -f $f ]] || continue
  case $f in install/steps/*.sh|install/*.sh|bin/lib.sh|migrations/*/*.sh) echo "$f"; continue ;; esac
  head -1 "$f" | grep -qE '^#!.*bash' && echo "$f"
done)

for f in "${scripts[@]}"; do bash -n "$f" || problem "syntax error in $f"; done

if command -v shellcheck >/dev/null; then
  shellcheck -x -S warning -e SC1090,SC1091,SC2034,SC2154 "${scripts[@]}" || problem "shellcheck found issues"
else
  echo "lint: shellcheck not installed; skipped"
fi

# `[[ test ]] && cmd` as the last statement of a function, loop or case branch
# returns failure when the test is false, which stops `set -e` scripts. (This
# broke `crash list`, `crash show` and GPU detection.) Use an if instead.
for f in "${scripts[@]}"; do
  awk -v file="$f" '
    prev ~ /^[[:space:]]*\[\[.*\]\][[:space:]]*&&[^|]*$/ && $0 ~ /^[[:space:]]*(done|\}|;;|fi|esac)([[:space:];]|$)/ {
      printf "%s:%d: [[ … ]] && … right before \"%s\": use if/then instead\n", file, NR - 1, $1
      bad = 1
    }
    { prev = $0 }
    END { exit bad }' "$f" || problem "last-statement && pattern in $f"
done

# The name lives only in distro.conf. Blocked references: an extended regex in
# .git/info/blocked-references (local, not committed; skipped without it).
names="\\b(${DISTRO_ID}|${DISTRO_REPO}|${DISTRO_NAME})\\b"
blocked=$(cat "$(git rev-parse --git-common-dir 2>/dev/null)/info/blocked-references" 2>/dev/null || true)
while read -r f; do
  case $f in distro.conf|docs/*|site/*|.github/*|SECURITY.md|CONTRIBUTING.md|README.md|THIRD-PARTY-NOTICES.md|.githooks/*|tools/lint) continue ;; esac
  [[ -f $f ]] || continue
  grep -qE "$names" <<<"$f" && problem "file name contains the distro name: $f"
  grep -IqE "$names" "$f" && problem "$f writes the distro name literally"
  if [[ -n $blocked ]] && grep -IqiE "$blocked" "$f"; then problem "$f mentions a blocked reference"; fi
done < <(git ls-files)

# Nothing runs a downloaded script straight through a shell: software comes
# from packages, or from a download checked against a pinned checksum or
# signature before it runs.
pipe='(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh\b|(ba|z)?sh[[:space:]]+(-c[[:space:]]+)?["'\'']?<?\$\((curl|wget)\b|(ba|z)?sh[[:space:]]+<\((curl|wget)\b'
while read -r f; do
  # (vm/checks/security.sh types such commands to test the install watch.)
  case $f in docs/*|site/*|tools/lint|vm/checks/security.sh) continue ;; esac
  [[ -f $f ]] || continue
  grep -IqE "$pipe" "$f" && problem "$f pipes a download into a shell: $(grep -nIE "$pipe" "$f" | head -1)"
done < <(git ls-files)

# The menu's fields are split on "|": one inside a command or description
# cuts the line short (the Privacy item ran a half-quoted command).
awk -F'|' '!/^[[:space:]]*#/ && NF > 5 { printf "default/menu/menu:%d: %d fields, at most 5 (a \"|\" in a command or description?)\n", NR, NF; bad = 1 } END { exit bad }' \
  default/menu/menu || problem "menu lines with too many fields"

# The shell's plugins: a Luau syntax error (a reserved word as a field name)
# stops the plugin from loading and took the shell down with it.
if command -v luau-compile >/dev/null; then
  while read -r f; do
    luau-compile --null "$f" >/dev/null 2>&1 || problem "$f: $(luau-compile --null "$f" 2>&1 | grep -m1 Error)"
  done < <(git ls-files '*.luau')
else
  echo "lint: luau-compile not installed; Luau syntax not checked"
fi

# The tested Hyprland family names the Hyprland the header plugin is built for.
plugin=$(sed -n 's/^_hyprland=//p' pkg/hyprland-plugin-hyprbars/PKGBUILD)
family=$(awk '$1 == "hyprland" { print $2 }' default/tested/hyprland-packages)
[[ $plugin == "$family" ]] || problem "default/tested/hyprland-packages has Hyprland ${family:-none}, hyprbars is built for $plugin"

(( fail )) && exit 1
echo "lint: ok (${#scripts[@]} shell scripts)"
