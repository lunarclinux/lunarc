# Layer 2: graphical session.
hyprland
# Header strips on terminal windows: Hyprland's hyprbars plugin, built for
# exactly this Hyprland (from the distro repository).
hyprland-plugin-hyprbars
uwsm
greetd
# The login screen (from the distro repository) and the
# text greeter it falls back to.
noctalia-greeter
greetd-tuigreet
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
qt5-wayland
qt6-wayland

# Wi-Fi: the country rules for channels and transmit power (the installer sets
# the country from the time zone); iw shows them (iw reg get)
wireless-regdb
iw

# Bluetooth
bluez
bluez-utils

# Audio
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber

# Terminal (others can be added with the terminal command) and fonts
ghostty
noto-fonts
noto-fonts-emoji
# Chinese, Japanese and Korean text
noto-fonts-cjk
ttf-jetbrains-mono-nerd
inter-font
# Geist and Geist Mono, the Frosted Terminal typefaces (from the distro
# repository).
otf-geist
otf-geist-mono

# App look: GTK and Qt follow the desktop theme
adw-gtk-theme
papirus-icon-theme
qt6ct

# Video and audio formats for Showtime, Decibels and other GStreamer apps:
# H.264/H.265, AAC, MP3 and the rest (FFmpeg's decoders through gst-libav).
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav

# Archives in the terminal: 7z (also extracts rar) and unzip. Files opens zip,
# 7z, rar and tar archives itself (libarchive).
7zip
unzip

# Spell checking (GTK apps through enchant, Firefox): US English
hunspell
hunspell-en_us

# Printing: CUPS, started when something prints and
# reachable only from this computer; network printers found through Avahi,
# which only looks and never announces this computer; .local names through
# nss-mdns. Print Settings (system-config-printer) is a default app.
cups
avahi
nss-mdns

# Saved passwords for apps (browsers, editors, mail): the Secret Service,
# unlocked at login by the login screen; and the SSH agent (gcr-4's), which
# keeps SSH key passphrases there
gnome-keyring
gcr-4

# Desktop utilities
grim
wl-clipboard
playerctl

# Capture (`<id> capture`) and dictation: region select, annotation, colour
# picker, OCR, QR, screen recording, typing into windows, and the local
# speech-to-text engine (only the speech model is downloaded, on first use)
slurp
satty
hyprpicker
tesseract
tesseract-data-eng
zbar
gpu-screen-recorder
wtype
whisper-cpp

# Boot splash and the themed disk passphrase prompt (theme in the distro package)
plymouth

# The lock screen: the screensaver plays behind a real session lock
# (`<id> lock`); both come from the distro repository.
swaylock-plugin
windowtolayer
