# Layer 1: minimal bootable system. One package per line; comments allowed.
base
linux
linux-firmware
sof-firmware
amd-ucode
intel-ucode
btrfs-progs
cryptsetup
dosfstools
limine
efibootmgr
networkmanager
sudo
zram-generator
openssh
man-db
man-pages
less
nano
# Building packages: the AUR (yay, `<id> app install` for AUR apps) needs makepkg's tools.
base-devel

# Snapshots before and after every pacman transaction (rollback: `<id> update rollback`)
snapper
snap-pac

# Security (decision record 0031): a firewall that refuses incoming
# connections, and firmware security updates (checked only when asked:
# `<id> update firmware`).
firewalld
fwupd
