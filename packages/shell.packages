# wallpaper, clipboard, idle, polkit prompts).
noctalia
upower
power-profiles-daemon
libnotify

# Screensaver (built into the distro's repository; not in Arch's)
python-terminaltexteffects

# CLI and crash inbox
jq
# The setup screens (same look as the installer)
gum
fastfetch
pacman-contrib
gdb
debuginfod

# AUR helper for `<id> app install` (community apps such as Claude Desktop, Zen, Heroic).
yay

# Terminal editor (default, nano-like keys; nano itself is in base) and the
# everyday command-line kit behind the shell defaults: prompt, z, ls, fuzzy
# search, cat with colours, find, grep, tldr.
micro
starship
zoxide
eza
fzf
bat
fd
ripgrep
tealdeer
bash-completion

# Network shares for backups (`<id> share`): NFS and SMB clients; showmount
# lists a NAS's NFS shares.
nfs-utils
cifs-utils
