# Ghostty. Colours come from the desktop theme: Noctalia writes the palette
# (themes/noctalia), and `@DISTRO_ID@ theme` the background, cursor and
# selection (@DISTRO_ID@-theme, included below).
# Reference: https://ghostty.org/docs/config
theme = noctalia
config-file = ?@DISTRO_ID@-theme
font-family = Geist Mono
font-size = 10
# Translucent, so the wallpaper (blurred, with blur on) shows through.
background-opacity = 0.55
window-padding-x = 16
window-padding-y = 12
window-decoration = none
confirm-close-surface = false
# Theme switches reload the config; don't announce it.
app-notifications = no-config-reload
