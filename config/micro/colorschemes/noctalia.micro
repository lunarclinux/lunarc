# micro colour scheme (Moonlit). Noctalia replaces this file with one
# rendered from the active theme whenever the theme changes.
color-link default "#e6e2d6,#0b1020"
color-link comment "italic #a3abc4"
color-link identifier "#8fb4f5"
color-link constant "#ebc77a"
color-link constant.string "#9fd49a"
color-link constant.string.char "#9fd49a"
color-link constant.number "#f3e3b5"
color-link constant.bool "#ebc77a"
color-link statement "bold #9c9bef"
color-link symbol "#a3abc4"
color-link symbol.brackets "#e6e2d6"
color-link preproc "#f28b82"
color-link type "#7fc8d9"
color-link special "#b9b8f4"
color-link underlined "underline #8fb4f5"
color-link error "bold #f28b82"
color-link todo "bold #1a1405,#ebc77a"
color-link hlsearch "#1a1405,#ebc77a"
color-link match-brace "bold #ebc77a"
color-link selection "#e6e2d6,#2e3a5c"
color-link statusline "#e6e2d6,#1d2742"
color-link statusline.inactive "#a3abc4,#131b31"
color-link tabbar "#a3abc4,#131b31"
color-link tabbar.active "bold #1a1405,#ebc77a"
color-link indent-char "#2e3a5c"
color-link line-number "#2e3a5c,#0b1020"
color-link current-line-number "bold #ebc77a,#111830"
color-link cursor-line "#111830"
color-link color-column "#111830"
color-link gutter-error "#f28b82"
color-link gutter-warning "#ebc77a"
color-link diff-added "#9fd49a"
color-link diff-modified "#ebc77a"
color-link diff-deleted "#f28b82"
color-link divider "#2e3a5c,#0b1020"
color-link scrollbar "#2e3a5c"
color-link message "#e6e2d6"
color-link error-message "bold #f28b82"
color-link trailingws "#f28b82"
