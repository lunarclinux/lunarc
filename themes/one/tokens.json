        "primary": "#abb2bf",
        "body": "#a0a7b3",
        "secondary": "#989eaa",
        "muted": "#828997",
        "dim": "#6a707b",
        "faint": "#5b616b"
      },
      "accent": {
        "amber": "#61afef",
        "amberLight": "#a8d3f6",
        "amberHover": "#90c7f4",
        "onAmber": "#1e2127"
      },
      "signal": {
        "cyan": "#98c379",
        "violet": "#c678dd",
        "coral": "#e06c75",
        "orange": "#e29678"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(171,178,191,0.13)",
