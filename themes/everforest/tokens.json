      "text": {
        "primary": "#d3c6aa",
        "body": "#c6baa0",
        "secondary": "#bbb099",
        "muted": "#9da9a0",
        "dim": "#7f8983",
        "faint": "#6e7773"
      },
      "accent": {
        "amber": "#a7c080",
        "amberLight": "#cfdcb9",
        "amberHover": "#c1d3a6",
        "onAmber": "#2d353b"
      },
      "signal": {
        "cyan": "#dbbc7f",
        "violet": "#7fbbb3",
        "coral": "#e67e80",
        "orange": "#e09d80"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(211,198,170,0.13)",
