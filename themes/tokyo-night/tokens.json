        "muted": "#9aa5ce",
        "dim": "#7982a3",
        "faint": "#666e8a"
      },
      "accent": {
        "amber": "#7aa2f7",
        "amberLight": "#b6ccfb",
        "amberHover": "#a2bef9",
        "onAmber": "#16161e"
      },
      "signal": {
        "cyan": "#7dcfff",
        "violet": "#bb9af7",
        "coral": "#f7768e",
        "orange": "#ec927b"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(192,202,245,0.13)",
