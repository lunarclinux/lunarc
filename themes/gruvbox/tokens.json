      "text": {
        "primary": "#ebdbb2",
        "body": "#dbcda7",
        "secondary": "#cfc19e",
        "muted": "#a89984",
        "dim": "#867b6b",
        "faint": "#736a5c"
      },
      "accent": {
        "amber": "#fabd2f",
        "amberLight": "#fcdb8d",
        "amberHover": "#fcd16d",
        "onAmber": "#282828"
      },
      "signal": {
        "cyan": "#fe8019",
        "violet": "#8ec07c",
        "coral": "#fb4934",
        "orange": "#e9712a"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(235,219,178,0.13)",
        "divider": "rgba(235,219,178,0.12)",
