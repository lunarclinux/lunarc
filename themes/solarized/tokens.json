{
  "dark": {
    "name": "@DISTRO_NAME@ · Frosted Terminal",
    "color": {
      "bg": {
        "deep": "#001e26",
        "pane": "rgba(0,30,38,0.52)",
        "popover": "rgba(0,30,38,0.76)",
        "menu": "rgba(0,30,38,0.80)"
      },
      "sheen": {
        "top": "rgba(214,190,115,0.07)",
