{
  "dark": {
    "name": "@DISTRO_NAME@ · Frosted Terminal",
    "color": {
      "bg": {
        "deep": "#040405",
        "pane": "rgba(4,4,5,0.52)",
        "popover": "rgba(4,4,5,0.76)",
        "menu": "rgba(4,4,5,0.80)"
      },
      "sheen": {
        "top": "rgba(250,223,151,0.07)",
        "bottom": "rgba(242,239,230,0.02)",
        "note": "subtle top-to-bottom gradient laid over every frosted surface"
      },
      "text": {
        "primary": "#f2efe6",
        "body": "#e0ddd5",
        "secondary": "#d2cfc8",
        "muted": "#a8a59c",
        "dim": "#817e78",
        "faint": "#6a6863"
      },
      "accent": {
        "amber": "#f5c542",
        "amberLight": "#fadf97",
        "amberHover": "#f8d67b",
        "onAmber": "#060607"
      },
      "signal": {
        "cyan": "#9ecbff",
        "violet": "#ff8a4c",
        "coral": "#ff5c5c",
        "orange": "#fa904f"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(242,239,230,0.13)",
        "divider": "rgba(242,239,230,0.12)",
        "focus": "rgba(245,197,66,0.80)",
        "popover": "rgba(245,197,66,0.38)",
        "menuInput": "rgba(245,197,66,0.30)"
      },
      "highlight": {
        "paneTopEdge": "inset 0 1px 0 rgba(245,197,66,0.32)",
        "focusTopEdge": "inset 0 1px 0 rgba(250,223,151,0.60)",
        "focusGlow": "0 0 24px rgba(245,197,66,0.12)"
      },
      "state": {
        "selectedBg": "rgba(245,197,66,0.14)",
        "selectedRing": "inset 0 0 0 1px rgba(245,197,66,0.32)",
        "activeSegmentBg": "rgba(245,197,66,0.20)",
        "activeSegmentUnderline": "inset 0 -2px 0 #f5c542"
      }
    },
    "material": {
      "paneBlur": "blur(24px) saturate(1.25)",
      "popoverBlur": "blur(28-30px) saturate(1.3)",
      "shadow": "0 16px 48px rgba(0,0,0,0.40)",
      "popoverShadow": "0 24px 70px rgba(0,0,0,0.55)",
      "blurIsOptional": "everything must still read correctly with blur off (solid rgba fills only)",
      "terminalOpacity": 0.9
    },
    "font": {
      "ui": "Geist Mono",
      "display": "Geist",
      "rule": "Geist Mono for all chrome, labels, menus, terminal-ish text. Geist only for big numbers, titles and prose."
    },
    "type": {
      "bar": "12px Geist Mono 500",
      "barClock": "12.5px Geist Mono, time 600 in amberLight",
      "paneHeader": "11px Geist Mono, letter-spacing 0.08em, UPPERCASE, '── TITLE' left / 'meta ──' right",
      "body": "13px Geist Mono, line-height 1.7",
      "menuRow": "14px Geist Mono",
      "menuInput": "16px Geist Mono 500",
      "statNumber": "32px Geist 500",
      "lockClock": "210px Geist Mono 200, letter-spacing -0.06em, amber glass gradient text",
      "kbd": "11px Geist Mono 500, 1px border hairline, 2px bottom border, radius 5"
    },
    "geometry": {
      "terminal": {
        "barHeight": 30,
        "barRadius": 0,
        "barEdgeToEdge": true,
        "gap": 8,
        "paneRadius": 6,
        "popoverRadius": 8,
        "panelRadius": 12,
        "menuRadius": 10,
        "border": 1
      },
      "rounded": {
        "barHeight": 34,
        "barRadius": 17,
        "barInset": 8,
        "gap": 8,
        "paneRadius": 16,
        "popoverRadius": 14,
        "panelRadius": 16,
        "menuRadius": 16,
        "border": 1
      },
      "default": "terminal"
    }
  }
}
