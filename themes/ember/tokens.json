      },
      "text": {
        "primary": "#ebe1d1",
        "body": "#dbd1c3",
        "secondary": "#cec5b7",
        "muted": "#b8ab98",
        "dim": "#918677",
        "faint": "#7a7164"
      },
      "accent": {
        "amber": "#e0a458",
        "amberLight": "#eecda3",
        "amberHover": "#e9bf8a",
        "onAmber": "#2a1d0c"
      },
      "signal": {
        "cyan": "#8fb38a",
        "violet": "#c97b4a",
        "coral": "#e06c5f",
        "orange": "#e0885c"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(235,225,209,0.13)",
        "divider": "rgba(235,225,209,0.12)",
        "focus": "rgba(224,164,88,0.80)",
        "popover": "rgba(224,164,88,0.38)",
        "menuInput": "rgba(224,164,88,0.30)"
      },
      "highlight": {
        "paneTopEdge": "inset 0 1px 0 rgba(224,164,88,0.32)",
        "focusTopEdge": "inset 0 1px 0 rgba(238,205,163,0.60)",
        "focusGlow": "0 0 24px rgba(224,164,88,0.12)"
      },
      "state": {
        "selectedBg": "rgba(224,164,88,0.14)",
        "selectedRing": "inset 0 0 0 1px rgba(224,164,88,0.32)",
        "activeSegmentBg": "rgba(224,164,88,0.20)",
        "activeSegmentUnderline": "inset 0 -2px 0 #e0a458"
      }
    },
    "material": {
      "paneBlur": "blur(24px) saturate(1.25)",
      "popoverBlur": "blur(28-30px) saturate(1.3)",
      "shadow": "0 16px 48px rgba(0,0,0,0.40)",
      "popoverShadow": "0 24px 70px rgba(0,0,0,0.55)",
      "blurIsOptional": "everything must still read correctly with blur off (solid rgba fills only)",
      "terminalOpacity": 0.9
    },
    "font": {
      "ui": "Geist Mono",
      "display": "Geist",
      "rule": "Geist Mono for all chrome, labels, menus, terminal-ish text. Geist only for big numbers, titles and prose."
    },
    "type": {
      "bar": "12px Geist Mono 500",
      "barClock": "12.5px Geist Mono, time 600 in amberLight",
      "paneHeader": "11px Geist Mono, letter-spacing 0.08em, UPPERCASE, '── TITLE' left / 'meta ──' right",
      "body": "13px Geist Mono, line-height 1.7",
      "menuRow": "14px Geist Mono",
      "menuInput": "16px Geist Mono 500",
      "statNumber": "32px Geist 500",
      "lockClock": "210px Geist Mono 200, letter-spacing -0.06em, amber glass gradient text",
      "kbd": "11px Geist Mono 500, 1px border hairline, 2px bottom border, radius 5"
    },
    "geometry": {
      "terminal": {
        "barHeight": 30,
        "barRadius": 0,
        "barEdgeToEdge": true,
        "gap": 8,
        "paneRadius": 6,
        "popoverRadius": 8,
        "panelRadius": 12,
        "menuRadius": 10,
        "border": 1
      },
      "rounded": {
        "barHeight": 34,
        "barRadius": 17,
        "barInset": 8,
        "gap": 8,
        "paneRadius": 16,
        "popoverRadius": 14,
        "panelRadius": 16,
        "menuRadius": 16,
        "border": 1
      },
      "default": "terminal"
    }
  },
