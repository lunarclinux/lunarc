{
  "dark": {
    "name": "@DISTRO_NAME@ · Frosted Terminal",
    "color": {
      "bg": {
        "deep": "#141210",
        "pane": "rgba(20,18,16,0.52)",
        "popover": "rgba(20,18,16,0.76)",
        "menu": "rgba(20,18,16,0.80)"
      },
      "sheen": {
        "top": "rgba(238,205,163,0.07)",
        "bottom": "rgba(235,225,209,0.02)",
