      "text": {
        "primary": "#dde5ee",
        "body": "#cdd5de",
        "secondary": "#c1c9d1",
        "muted": "#9aa8b8",
        "dim": "#788492",
        "faint": "#656f7c"
      },
      "accent": {
        "amber": "#8fb7e3",
        "amberLight": "#c1d7f0",
        "amberHover": "#b1cdeb",
        "onAmber": "#0f1620"
      },
      "signal": {
        "cyan": "#7fc6cc",
        "violet": "#a99cf0",
        "coral": "#f28b82",
        "orange": "#ecaa7e"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(221,229,238,0.13)",
