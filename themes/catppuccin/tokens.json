{
  "dark": {
    "name": "@DISTRO_NAME@ · Frosted Terminal",
    "color": {
      "bg": {
        "deep": "#151520",
        "pane": "rgba(21,21,32,0.52)",
        "popover": "rgba(21,21,32,0.76)",
        "menu": "rgba(21,21,32,0.80)"
      },
      "sheen": {
        "top": "rgba(226,206,251,0.07)",
        "bottom": "rgba(205,214,244,0.02)",
        "note": "subtle top-to-bottom gradient laid over every frosted surface"
      },
      "text": {
        "primary": "#cdd6f4",
        "body": "#bfc8e4",
        "secondary": "#b4bcd7",
        "muted": "#a6adc8",
        "dim": "#8389a0",
        "faint": "#6f7388"
      },
      "accent": {
        "amber": "#cba6f7",
        "amberLight": "#e2cefb",
        "amberHover": "#dbc1f9",
        "onAmber": "#11111b"
      },
      "signal": {
        "cyan": "#94e2d5",
        "violet": "#89b4fa",
        "coral": "#f38ba8",
        "orange": "#f6b6ac"
      },
      "signalUse": {
        "cyan": "network, git branch, success ticks, work calendar",
        "violet": "memory, home calendar",
        "coral": "recording, destructive (power off)",
        "orange": "AUR / community-source warnings"
      },
      "border": {
        "hairline": "rgba(205,214,244,0.13)",
        "divider": "rgba(205,214,244,0.12)",
        "focus": "rgba(203,166,247,0.80)",
        "popover": "rgba(203,166,247,0.38)",
        "menuInput": "rgba(203,166,247,0.30)"
      },
      "highlight": {
        "paneTopEdge": "inset 0 1px 0 rgba(203,166,247,0.32)",
        "focusTopEdge": "inset 0 1px 0 rgba(226,206,251,0.60)",
        "focusGlow": "0 0 24px rgba(203,166,247,0.12)"
      },
      "state": {
        "selectedBg": "rgba(203,166,247,0.14)",
        "selectedRing": "inset 0 0 0 1px rgba(203,166,247,0.32)",
        "activeSegmentBg": "rgba(203,166,247,0.20)",
        "activeSegmentUnderline": "inset 0 -2px 0 #cba6f7"
      }
    },
    "material": {
      "paneBlur": "blur(24px) saturate(1.25)",
      "popoverBlur": "blur(28-30px) saturate(1.3)",
      "shadow": "0 16px 48px rgba(0,0,0,0.40)",
      "popoverShadow": "0 24px 70px rgba(0,0,0,0.55)",
      "blurIsOptional": "everything must still read correctly with blur off (solid rgba fills only)"
    },
    "font": {
      "ui": "Geist Mono",
      "display": "Geist",
      "rule": "Geist Mono for all chrome, labels, menus, terminal-ish text. Geist only for big numbers, titles and prose."
    },
    "type": {
      "bar": "12px Geist Mono 500",
      "barClock": "12.5px Geist Mono, time 600 in amberLight",
      "paneHeader": "11px Geist Mono, letter-spacing 0.08em, UPPERCASE, '── TITLE' left / 'meta ──' right",
      "body": "13px Geist Mono, line-height 1.7",
      "menuRow": "14px Geist Mono",
      "menuInput": "16px Geist Mono 500",
      "statNumber": "32px Geist 500",
      "lockClock": "210px Geist Mono 200, letter-spacing -0.06em, amber glass gradient text",
      "kbd": "11px Geist Mono 500, 1px border hairline, 2px bottom border, radius 5"
    },
    "geometry": {
      "terminal": {
        "barHeight": 30,
        "barRadius": 0,
        "barEdgeToEdge": true,
        "gap": 8,
        "paneRadius": 6,
        "popoverRadius": 8,
        "panelRadius": 12,
        "menuRadius": 10,
        "border": 1
      },
      "rounded": {
        "barHeight": 34,
        "barRadius": 17,
        "barInset": 8,
        "gap": 8,
        "paneRadius": 16,
        "popoverRadius": 14,
        "panelRadius": 16,
        "menuRadius": 16,
        "border": 1
      },
      "default": "terminal"
    }
  },
