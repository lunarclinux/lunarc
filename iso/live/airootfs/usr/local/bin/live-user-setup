#!/usr/bin/env bash
# Creates the live user (no password, sudo without one) with the same starting
# configs as a newly installed user, plus the live system's additions.
set -euo pipefail
user=live
id -u "$user" >/dev/null 2>&1 && exit 0
useradd -m -G wheel,video,audio,input -s /bin/bash -c "Live user" "$user"
passwd -d "$user" >/dev/null
home=/home/$user

# Hyprland: the installer opens fullscreen.
cat >> "$home/.config/hypr/hyprland.lua" <<'LUA'

-- Live system additions.
dofile("/usr/local/share/live/hyprland.lua")
LUA

# Noctalia: no lock screen on the live system (the user has no password).
cat >> "$home/.config/noctalia/config.toml" <<'TOML'

# Live system: never lock.
[idle.behavior.lock]
enabled = false
TOML

# Keyring: the shell stores its clipboard-history key in the Secret Service at
# login, which would otherwise greet the visitor with "Choose password for new
# keyring". The live system forgets everything at shutdown, so give it an empty
# login keyring without a password of its own.
keyrings=$home/.local/share/keyrings
install -d -m700 "$home/.local" "$home/.local/share" "$keyrings"
printf 'login\n' > "$keyrings/default"
cat > "$keyrings/login.keyring" <<'KEYRING'
[keyring]
display-name=Login
ctime=0
mtime=0
lock-on-idle=false
lock-after=false
KEYRING
chmod 600 "$keyrings/default" "$keyrings/login.keyring"

chown -R "$user:$user" "$home"
