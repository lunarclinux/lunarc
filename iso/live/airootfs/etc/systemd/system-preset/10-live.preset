# Live system: NetworkManager handles the network (Noctalia's network panel
# uses it), so releng's systemd-networkd and iwd stay off. Package installs
# apply presets after the live files are copied, so removing the links alone
# isn't enough.
disable systemd-networkd.service
disable systemd-networkd*.socket
disable systemd-networkd-wait-online.service
disable iwd.service
# No remote logins on the live system (releng enables sshd with root login on;
# the VM tests start it through their cloud-init seed), and the firewall on, as
# on an installed system.
disable sshd.service
enable firewalld.service
