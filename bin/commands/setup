#!/usr/bin/env bash
# summary: One-time setup steps (run automatically at first login)
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

case ${1:-} in
  first-login)
    done_file=$STATE_DIR/first-login-done
    [[ -f $done_file ]] && exit 0
    # Shell defaults first, so the theme below also renders the prompt and editor colours.
    "/usr/bin/$DISTRO_ID" shell defaults on >/dev/null || true
    "/usr/bin/$DISTRO_ID" theme set "$(setting theme moonlit)"
    mkdir -p "$STATE_DIR"; date -Is > "$done_file"
    notify-send -a "$DISTRO_NAME" "Welcome to $DISTRO_NAME" \
      "SUPER+ALT+Space: menu. SUPER+Space: apps. SUPER+Return: terminal. SUPER+K: all shortcuts. SUPER+W: close a window. SUPER+L: lock.
Run '$DISTRO_ID help' in a terminal for the command-line tools." 2>/dev/null || true ;;
  -h|--help|"") echo "Usage: $DISTRO_ID setup first-login" ;;
  *) die "unknown setup step: $1" ;;
esac
