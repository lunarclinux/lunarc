#!/usr/bin/env bash
# summary: List and switch desktop themes and wallpapers
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

themes=$SHARE/themes
palettes=${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/palettes

usage() {
  cat <<USAGE
Usage: $DISTRO_ID theme <command>

  list [--plain]             available themes (* marks the current one);
                             --plain prints "name<TAB>description" for scripts
  current                    the current theme
  set <theme> [dark|light]   switch theme; the mode defaults to the theme's own
  mode <dark|light>          switch the current theme between dark and light
  preview [theme]            colour swatches for every theme (or one) in the terminal
  wallpaper [list]           the current theme's wallpapers (* marks the one in use)
  wallpaper next|prev        cycle through them
  wallpaper set <n>          use wallpaper number n
  greeter                    use the current theme on the login screen too
                             (done on every change; the last one chosen wins)
  shape [terminal|rounded]   window corners, the bar, menus and the login screen:
                             terminal (small corners, the bar edge to edge;
                             the default) or rounded (a floating pill bar)
  blur [on|off]              blur behind translucent windows and the shell
  opacity [solid|frosted|clear|<0.3-1>|default]
                             how much the terminal shows the wallpaper: solid (none),
                             frosted (the theme's own; the default), clear, or a number
  token <path>               print one of the current theme's design tokens,
                             e.g. color.accent.amber or geometry.current.paneRadius
                             (geometry.current: the set for the current shape)
  tokens                     write the current theme's tokens file again, and
                             the window and terminal looks made from it
                             (done on every change)
USAGE
}

meta() { awk -F' *= *' -v k="$2" '$1 == k { sub(/^[^=]*= */, ""); gsub(/^"|"$/, ""); print; exit }' "$themes/$1/theme.toml"; }
# Palette files keep "dark" and "light" as top-level keys, indented two spaces.
has_variant() { grep -qE "^  \"$2\":" "$themes/$1/palette.json"; }
theme_names() { local dir; for dir in "$themes"/*/; do dir=${dir%/}; printf '%s\n' "${dir##*/}"; done; }

# Noctalia only reads palettes from its own config folder, so each distro theme is linked there.
link_palettes() {
  mkdir -p "$palettes"
  local dir
  for dir in "$themes"/*/; do
    dir=${dir%/}
    ln -sfn "$dir/palette.json" "$palettes/$DISTRO_ID-${dir##*/}.json"
  done
}

# The theme's design tokens for one mode, as a file other programs read.
write_tokens() { # write_tokens <theme> <mode>
  local src=$themes/$1/tokens.json tmp
  if [[ ! -f $src ]]; then rm -f "$TOKENS"; return 0; fi
  mkdir -p "${TOKENS%/*}"
  tmp=$(mktemp "$TOKENS.XXXXXX"); chmod 644 "$tmp"
  if jq --arg m "$2" '.[$m] // error("no \($m) tokens")' "$src" > "$tmp"; then mv "$tmp" "$TOKENS"
  else rm -f "$tmp"; return 1
  fi
}

# The window look made from the tokens and the shape and blur settings: data
# for Hyprland (default/hypr/look.lua reads it), colours for Ghostty, and the
# current shape and blur as JSON for the shell's plugins.
LOOK_LUA=$CONFIG_DIR/hypr/look.lua
LOOK_GHOSTTY=${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/$DISTRO_ID-theme
STYLE=${TOKENS%/*}/style.json
shape() { local v; v=$(setting theme.shape terminal); [[ $v == rounded ]] || v=terminal; printf '%s\n' "$v"; }
blur() { local v; v=$(setting theme.blur on); [[ $v == off ]] || v=on; printf '%s\n' "$v"; }

# The terminal's background opacity: the setting (`theme opacity`), or the
# theme's own (material.terminalOpacity) for "frosted" and by default.
GHOSTTY_MAIN=${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config
opacity_choice() { local v; v=$(setting theme.terminal_opacity frosted); valid_opacity "$v" || v=frosted; printf '%s\n' "$v"; }
valid_opacity() { [[ $1 == solid || $1 == frosted || $1 == clear || $1 =~ ^(0\.[3-9][0-9]?|1(\.0+)?)$ ]]; }
terminal_opacity() {
  case $(opacity_choice) in
    solid) echo 1 ;;
    clear) echo 0.75 ;;
    frosted) jq -r '.material.terminalOpacity // 0.9' "$TOKENS" 2>/dev/null || echo 0.9 ;;
    *) opacity_choice ;;
  esac
}
# A background-opacity line in your own Ghostty config wins: Ghostty reads the
# theme's file after it, so the theme leaves the setting out then.
own_opacity() { { grep -sE '^[[:space:]]*background-opacity[[:space:]]*=' "$GHOSTTY_MAIN" || true; } | tail -1 | sed 's/.*=[[:space:]]*//'; }

# jq helpers: a token colour ("#rrggbb", "rgba(r,g,b,a)" or a CSS shadow
# holding one) as Hyprland's rgba(rrggbbaa) or as #rrggbb over the background.
LOOK_JQ='
  def rgb: if test("^#") then [.[1:3], .[3:5], .[5:7] | ascii_downcase | explode
      | map(if . >= 97 then . - 87 else . - 48 end) | .[0] * 16 + .[1]] + [1]
    else capture("rgba\\((?<r>[0-9]+), *(?<g>[0-9]+), *(?<b>[0-9]+), *(?<a>[0-9.]+)\\)")
      | [(.r, .g, .b | tonumber), (.a | tonumber)] end;
  def hex2: [(. / 16 | floor), (. % 16)] | map(if . < 10 then . + 48 else . + 87 end) | implode;
  def hypr: rgb | "rgba(" + (.[0:3] | map(hex2) | join("")) + ((.[3] * 255 | round) | hex2) + ")";
  def alpha($a): rgb | .[3] = $a | "rgba(" + (.[0:3] | map(hex2) | join("")) + ((.[3] * 255 | round) | hex2) + ")";
  def over($bg): (rgb) as $c | ($bg | rgb) as $b
    | "#" + ([range(3)] | map(($c[.] * $c[3] + $b[.] * (1 - $c[3])) | round | hex2) | join(""));
  def a: rgb | .[3];
  # A translucent colour laid over another, as one translucent colour.
  def stack($under): (rgb) as $t | ($under | rgb) as $u | (1 - (1 - $t[3]) * (1 - $u[3])) as $o
    | "rgba(" + ([range(3)] | map((($t[.] * $t[3] + $u[.] * $u[3] * (1 - $t[3])) / $o) | round | hex2) | join(""))
      + (($o * 255 | round) | hex2) + ")";
  def px: capture("(?<n>[0-9.]+)px") | .n | tonumber;'

write_look() {
  [[ -f $TOKENS ]] || return 0
  local tmp
  mkdir -p "${LOOK_LUA%/*}" "${LOOK_GHOSTTY%/*}"
  tmp=$(mktemp "$LOOK_LUA.XXXXXX")
  jq -r --arg shape "$(shape)" --arg blur "$(blur)" "$LOOK_JQ"'
    .color as $c | .geometry[$shape] as $g
    | ($c.border.focus | a) as $fa | ($c.border.hairline | a) as $ha
    | "-- Written by `'"$DISTRO_ID"' theme` from the theme'"'"'s design tokens; it is rewritten",
      "-- on every theme, mode, shape or blur change.",
      "return {",
      "    shape = \"\($shape)\", blur = \($blur == "on"),",
      "    gaps_in = \($g.gap / 2 | floor), gaps_out = \($g.gap), border = \($g.border), rounding = \($g.paneRadius),",
      "    active_border = { \"\($c.highlight.focusTopEdge | alpha($fa + (1 - $fa) * ($c.highlight.focusTopEdge | a)))\", \"\($c.border.focus | hypr)\" },",
      "    inactive_border = { \"\($c.highlight.paneTopEdge | alpha($ha + (1 - $ha) * ($c.highlight.paneTopEdge | a)))\", \"\($c.border.hairline | hypr)\" },",
      "    glow = \"\($c.highlight.focusGlow | hypr)\", glow_range = \($c.highlight.focusGlow | px),",
      "    shadow = \"\(.material.shadow | hypr)\",",
      "    group_active = \"\($c.border.focus | hypr)\", group_inactive = \"\($c.border.hairline | hypr)\", group_locked = \"\($c.signal.coral | alpha($fa))\",",
      "    groupbar_text = \"\($c.accent.onAmber | hypr)\", groupbar_text_inactive = \"\($c.text.secondary | hypr)\",",
      "    header = {",
      "        height = 28, font = \"\(.font.ui)\", size = \(.type.paneHeader | px), padding = 12,",
      "        fill = \"\($c.sheen.top | stack($c.bg.pane))\", text = \"\($c.text.muted | hypr)\", text_focus = \"\($c.accent.amber | hypr)\",",
      "    },",
      "}"' "$TOKENS" > "$tmp" && mv "$tmp" "$LOOK_LUA" || { rm -f "$tmp"; return 1; }
  # Ghostty: the theme's Frosted Terminal colours over the palette Noctalia writes
  # (themes/noctalia); the config includes this file.
  tmp=$(mktemp "$LOOK_GHOSTTY.XXXXXX")
  local opacity=''
  if [[ -z $(own_opacity) ]]; then opacity=$(terminal_opacity); fi
  jq -r --arg opacity "$opacity" "$LOOK_JQ"'
    .color as $c
    | "# Written by `'"$DISTRO_ID"' theme` from the theme'"'"'s design tokens; rewritten on",
      "# every theme change. Your own settings go in the main config.",
      "background = \($c.bg.deep)",
      "foreground = \($c.text.body)",
      "cursor-color = \($c.text.primary)",
      "cursor-text = \($c.bg.deep)",
      "selection-background = \($c.state.selectedBg | over($c.bg.deep))",
      "selection-foreground = \($c.text.primary)",
      (if $opacity != "" then "background-opacity = \($opacity)" else empty end)' "$TOKENS" > "$tmp" && mv "$tmp" "$LOOK_GHOSTTY" || { rm -f "$tmp"; return 1; }
  tmp=$(mktemp "$STYLE.XXXXXX"); chmod 644 "$tmp"
  jq --arg shape "$(shape)" --arg blur "$(blur)" '{shape: $shape, blur: ($blur == "on"), geometry: .geometry[$shape]}' "$TOKENS" > "$tmp" \
    && mv "$tmp" "$STYLE" || { rm -f "$tmp"; return 1; }
}

# Hyprland and running Ghostty windows pick the new look up; the bar gets its
# geometry and hairline again (Noctalia reloads its config when it changes),
# and the segments that mix their colours here redraw.
reload_look() {
  local w
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then hyprctl reload >/dev/null 2>&1 || true; fi
  pkill -USR2 -x -u "$(id -u)" ghostty 2>/dev/null || true
  bar_apply >/dev/null
  for w in clock workspaces menu-button; do
    noctalia msg plugin "$DISTRO_ID/utilities:$w" all refresh >/dev/null 2>&1 || true
  done
}

apply_mode() { # apply_mode <dark|light>
  local mode=$1 icons=Papirus-Dark gtk=adw-gtk3-dark
  if [[ $mode == light ]]; then icons=Papirus-Light; gtk=adw-gtk3; fi
  noctalia msg theme-mode-set "$mode" >/dev/null
  gsettings set org.gnome.desktop.interface icon-theme "$icons"
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk"
  local qt=${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct/qt6ct.conf
  if [[ -f $qt ]]; then sed -i "s/^icon_theme=.*/icon_theme=$icons/" "$qt"; fi
  set_setting theme.mode "$mode"
}

# A theme's wallpapers, in order (files are numbered: 1-name.svg, 2-name.svg, …).
wallpapers() { # wallpapers <theme>
  local dir=$themes/$1/wallpapers
  [[ -d $dir ]] || return 0
  find "$dir" -maxdepth 1 -type f \( -name '*.svg' -o -name '*.png' -o -name '*.jpg' -o -name '*.webp' \) -printf '%f\n' | sort -V
}

wallpaper_index() { # wallpaper_index <theme>: the remembered choice, 1 if none
  local n count
  n=$(setting "wallpaper.$1" 1)
  count=$(wallpapers "$1" | wc -l)
  if [[ ! $n =~ ^[0-9]+$ ]] || (( n < 1 || n > count )); then n=1; fi
  printf '%s\n' "$n"
}

apply_wallpaper() { # apply_wallpaper <theme> <n>
  local file
  file=$(wallpapers "$1" | sed -n "${2}p")
  [[ -n $file ]] || return 0
  noctalia msg wallpaper-set "$themes/$1/wallpapers/$file" >/dev/null
  set_setting "wallpaper.$1" "$2"
}

# The login screen shows the theme too: a root helper, allowed without a
# password for the person at the computer. Elsewhere (SSH) it's refused, and
# the theme still changes.
greeter_apply() { # greeter_apply <theme> <mode> <wallpaper n> (and the current shape)
  local helper=$DISTRO_LIB/greeter-theme
  [[ -x $helper ]] || return 1
  if (( EUID == 0 )); then "$helper" "$@" "$(shape)"
  else timeout 10 pkexec --disable-internal-agent "$helper" "$@" "$(shape)"
  fi
}

# Truecolour swatches: two spaces of background per colour.
swatch() { local h=${1#\#}; printf '\e[48;2;%d;%d;%dm  \e[0m' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

preview() { # preview <theme>
  local name=$1 mode colours c
  mode=$(meta "$name" mode)
  mapfile -t colours < <(jq -r --arg m "$mode" '.[$m] | .mSurface, .mSurfaceVariant, .mOnSurface, .mPrimary, .mSecondary, .mTertiary, .mError,
      (.terminal.normal | .black, .red, .green, .yellow, .blue, .magenta, .cyan, .white)' "$themes/$name/palette.json")
  printf '%-12s ' "$name"
  for c in "${colours[@]:0:7}"; do swatch "$c"; done
  printf ' '
  for c in "${colours[@]:7}"; do swatch "$c"; done
  printf '  %s\n' "$(meta "$name" description)"
}

case ${1:-} in
  list)
    cur=$(setting theme)
    while IFS= read -r name; do
      if [[ ${2:-} == --plain ]]; then
        printf '%s\t%s\n' "$name" "$(meta "$name" description)"
      else
        mark=" "; if [[ $name == "$cur" ]]; then mark="*"; fi
        printf '%s %-12s %s\n' "$mark" "$name" "$(meta "$name" description)"
      fi
    done < <(theme_names) ;;
  current) printf '%s (%s)\n' "$(setting theme)" "$(setting theme.mode)" ;;
  set)
    name=${2:-}; [[ -n $name && -d $themes/$name ]] || die "unknown theme '${name}'; see '$DISTRO_ID theme list'"
    mode=${3:-$(meta "$name" mode)}
    [[ $mode == dark || $mode == light ]] || die "mode must be dark or light"
    if ! has_variant "$name" "$mode"; then info "$name has no $mode variant; using its default"; mode=$(meta "$name" mode); fi
    shell_ready || die "the desktop shell isn't running"
    link_palettes
    noctalia msg color-scheme-set custom "$DISTRO_ID-$name" >/dev/null
    apply_mode "$mode"
    write_tokens "$name" "$mode" || true
    write_look || true; reload_look
    apply_wallpaper "$name" "$(wallpaper_index "$name")"
    set_setting theme "$name"
    greeter_apply "$name" "$mode" "$(wallpaper_index "$name")" >/dev/null 2>&1 || true
    info "theme: $name ($mode)" ;;
  mode)
    mode=${2:-}; [[ $mode == dark || $mode == light ]] || die "mode must be dark or light"
    name=$(setting theme)
    has_variant "$name" "$mode" || die "$name has no $mode variant"
    shell_ready || die "the desktop shell isn't running"
    apply_mode "$mode"
    write_tokens "$name" "$mode" || true
    write_look || true; reload_look
    greeter_apply "$name" "$mode" "$(wallpaper_index "$name")" >/dev/null 2>&1 || true
    info "theme: $name ($mode)" ;;
  token)
    [[ -n ${2:-} ]] || die "usage: $DISTRO_ID theme token <path>"
    [[ -f $TOKENS ]] || die "no tokens file; run '$DISTRO_ID theme tokens'"
    token "$2" ;;
  tokens)
    write_tokens "$(setting theme)" "$(setting theme.mode)" || die "the tokens could not be written"
    write_look || die "the window look could not be written"
    reload_look
    info "$TOKENS" ;;
  shape|blur)
    if [[ -z ${2:-} ]]; then "$1"; exit 0; fi
    case $1:$2 in
      shape:terminal|shape:rounded|blur:on|blur:off) ;;
      shape:*) die "shape must be terminal or rounded" ;;
      *) die "blur must be on or off" ;;
    esac
    set_setting "theme.$1" "$2"
    write_look || die "the window look could not be written"
    reload_look
    if [[ $1 == shape ]]; then
      name=$(setting theme)
      greeter_apply "$name" "$(setting theme.mode)" "$(wallpaper_index "$name")" >/dev/null 2>&1 || true
    fi
    info "$1: $2" ;;
  opacity)
    if [[ -z ${2:-} ]]; then
      own=$(own_opacity)
      if [[ -n $own ]]; then info "$own (set in $GHOSTTY_MAIN, which wins over the theme)"
      else info "$(opacity_choice): $(terminal_opacity)"; fi
      exit 0
    fi
    choice=$2; [[ $choice == default ]] && choice=frosted
    valid_opacity "$choice" || die "opacity is solid, frosted, clear, or a number from 0.3 to 1"
    set_setting theme.terminal_opacity "$choice"
    write_look || die "the terminal look could not be written"
    pkill -USR2 -x -u "$(id -u)" ghostty 2>/dev/null || true
    own=$(own_opacity)
    if [[ -n $own ]]; then
      info "terminal opacity: $choice, but your Ghostty config sets background-opacity = $own, which wins;"
      info "remove that line from $GHOSTTY_MAIN to use this"
    else
      info "terminal opacity: $choice ($(terminal_opacity))"
    fi ;;
  greeter)
    name=$(setting theme)
    greeter_apply "$name" "$(setting theme.mode)" "$(wallpaper_index "$name")" \
      || die "the login screen couldn't be changed from here; run this on the computer itself"
    info "login screen: $name ($(setting theme.mode))" ;;
  preview)
    if [[ -n ${2:-} ]]; then
      [[ -d $themes/$2 ]] || die "unknown theme '$2'"
      preview "$2"
    else
      while IFS= read -r name; do preview "$name"; done < <(theme_names)
    fi ;;
  wallpaper)
    name=$(setting theme)
    mapfile -t files < <(wallpapers "$name")
    (( ${#files[@]} )) || die "$name has no wallpapers"
    n=$(wallpaper_index "$name")
    case ${2:-list} in
      list)
        for i in "${!files[@]}"; do
          mark=" "; if (( i + 1 == n )); then mark="*"; fi
          printf '%s %d  %s\n' "$mark" $((i + 1)) "${files[i]%.*}"
        done ;;
      next|prev)
        shell_ready || die "the desktop shell isn't running"
        if [[ $2 == next ]]; then n=$(( n % ${#files[@]} + 1 )); else n=$(( (n + ${#files[@]} - 2) % ${#files[@]} + 1 )); fi
        apply_wallpaper "$name" "$n"
        greeter_apply "$name" "$(setting theme.mode)" "$n" >/dev/null 2>&1 || true
        info "wallpaper $n of ${#files[@]}: ${files[n - 1]%.*}" ;;
      set)
        want=${3:-}
        if [[ ! $want =~ ^[0-9]+$ ]] || (( want < 1 || want > ${#files[@]} )); then
          die "pick a number from 1 to ${#files[@]}"
        fi
        shell_ready || die "the desktop shell isn't running"
        apply_wallpaper "$name" "$want"
        greeter_apply "$name" "$(setting theme.mode)" "$want" >/dev/null 2>&1 || true
        info "wallpaper $want of ${#files[@]}: ${files[want - 1]%.*}" ;;
      *) die "unknown wallpaper command: $2" ;;
    esac ;;
  -h|--help|"") usage ;;
  *) die "unknown theme command: $1" ;;
esac
