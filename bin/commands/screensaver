#!/usr/bin/env bash
# summary: The screensaver: text effects over the wordmark while idle
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

class=$DISTRO_ID.screensaver
art=$SHARE/default/screensaver/wordmark.txt

usage() {
  cat <<USAGE
Usage: $DISTRO_ID screensaver <command>

  start              open the screensaver (Noctalia runs this when the session goes idle)
  stop               close it (Noctalia runs this on any input)
  preview [effect]   open it now; with an effect, play only that one
  effects            list the effects in the rotation
  run [effect]       the animation itself, inside the screensaver's terminal

Effects come from terminaltexteffects plus the distro's own in
$SHARE/default/screensaver/effects. Your own go in
~/.config/terminaltexteffects/effects and join the rotation.
Idle timing is in Noctalia's idle settings ([idle.behavior.screensaver]).
USAGE
}

# Only the screensaver's own Ghostty, not any command line that mentions it.
match="^(/usr/bin/)?ghostty --class=$class( |\$)"
running() { pgrep -f -- "$match" >/dev/null; }

# tte loads extra effects from $XDG_CONFIG_HOME/terminaltexteffects/effects.
# Point it at a folder holding the distro's effects and the user's own.
effects_home() {
  local home=${XDG_RUNTIME_DIR:-/tmp}/$DISTRO_ID-screensaver
  local dir=$home/terminaltexteffects/effects file
  mkdir -p "$dir"
  for file in "$SHARE"/default/screensaver/effects/*.py \
              "${XDG_CONFIG_HOME:-$HOME/.config}"/terminaltexteffects/effects/*.py; do
    if [[ -f $file ]]; then ln -sf "$file" "$dir/${file##*/}"; fi
  done
  # Drop links whose effect was removed.
  find "$dir" -xtype l -delete
  printf '%s\n' "$home"
}

tte_run() { XDG_CONFIG_HOME=$TTE_HOME tte "$@"; }

# Effect names, from the choices in tte's own usage text.
effect_list() {
  tte_run --help | sed -n '/^usage/,/^$/p' | tr -d ' \n' | grep -o '{[^}]*}' | tail -1 | tr -d '{}' | tr ',' '\n'
}

# The theme's text colour and accent, for each effect's final colours: on
# Moonlit that is moonlight fading into gold, left to right.
theme_colour() { # theme_colour <key>
  local palette
  palette=$SHARE/themes/$(setting theme)/palette.json
  [[ -f $palette ]] || return 0
  jq -r --arg m "$(setting theme.mode dark)" --arg k "$1" '.[$m][$k] // empty' "$palette" | tr -d '#'
}

open_window() { # open_window [effect]
  command -v ghostty >/dev/null || die "the screensaver needs Ghostty"
  # Detached, so the caller (Noctalia's idle hook, a shell) returns at once.
  setsid -f bash -c 'source "$DISTRO_LIB/lib.sh"; launch_app "$@"' _ \
    ghostty --class="$class" --font-size=13 --window-padding-x=0 --window-padding-y=0 \
    --cursor-style-blink=false --cursor-opacity=0 --confirm-close-surface=false --background-opacity=1 --scrollbar=never \
    -e "/usr/bin/$DISTRO_ID" screensaver run "$@" >/dev/null 2>&1
  # The window rule normally makes it fullscreen; in some sessions it opens
  # tiled instead, so check once it appears and fullscreen it if needed.
  setsid -f bash -c '
    class=$1
    for _ in $(seq 25); do
      state=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$class" ".[] | select(.class == \$c) | .fullscreen" | head -1)
      if [[ -n $state ]]; then
        if [[ $state == 0 ]]; then
          hyprctl dispatch "hl.dsp.focus({ window = \"class:^$class\$\" })" >/dev/null
          hyprctl dispatch "hl.dsp.window.fullscreen()" >/dev/null
        fi
        exit 0
      fi
      sleep 0.2
    done' _ "$class" >/dev/null 2>&1
}

TTE_HOME=$(effects_home)

case ${1:-} in
  start)
    if ! running; then open_window; fi ;;
  preview)
    effect=${2:-}
    if [[ -n $effect ]] && ! effect_list | grep -qx -- "$effect"; then
      die "no effect called '$effect' (see: $DISTRO_ID screensaver effects)"
    fi
    if running; then pkill -f -- "$match" || true; sleep 0.5; fi
    open_window ${effect:+"$effect"} ;;
  stop)
    pkill -f -- "$match" 2>/dev/null || true ;;
  effects)
    effect_list ;;
  run)
    only=${2:-}
    # The window opens tiled and then goes fullscreen; wait for its size to
    # settle so the first effect is centred on the whole screen.
    last="" same=0
    for _ in $(seq 30); do
      size=$(stty size 2>/dev/null)
      if [[ $size == "$last" ]]; then (( ++same >= 3 )) && break; else same=0; fi
      last=$size; sleep 0.1
    done
    mapfile -t effects < <(effect_list)
    text=$(theme_colour mOnSurface) accent=$(theme_colour mPrimary) background=$(theme_colour mSurface)
    # One effect per round (random unless one was asked for), centred; any key ends it.
    ( while :; do
        effect=${only:-${effects[RANDOM % ${#effects[@]}]}}
        args=(-i "$art" --canvas-width 0 --canvas-height 0 --anchor-canvas c --anchor-text c --frame-rate 60)
        if [[ -n $background ]]; then args+=(--terminal-background-color "$background"); fi
        args+=("$effect")
        if [[ -n $text && -n $accent ]] && tte_run "$effect" --help 2>/dev/null | grep -q -- --final-gradient-stops; then
          args+=(--final-gradient-stops "$text" "$accent" --final-gradient-direction horizontal)
        fi
        clear
        tte_run "${args[@]}" 2>/dev/null || sleep 1
        sleep 2
      done ) &
    anim=$!
    read -rsn1 || true
    kill "$anim" 2>/dev/null || true ;;
  -h|--help|"") usage ;;
  *) die "unknown screensaver command: $1" ;;
esac
