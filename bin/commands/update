#!/usr/bin/env bash
# summary: Update the system safely, see what's waiting, or roll back
set -euo pipefail
source "$DISTRO_LIB/lib.sh"
source "$DISTRO_LIB/security-feed.sh"

usage() {
  cat <<USAGE
Usage: $DISTRO_ID update [--all] | check | security [...] | new-apps | firmware | snapshots | rollback <n> [--dry-run] | rollback --clean | candy on|off

  (no argument)   update everything: keyrings first, then Arch and $DISTRO_NAME
                  packages (a snapshot is taken before and after), then AUR
                  apps, then Flatpak apps
  --all           also take a Hyprland release newer than the one $DISTRO_NAME
                  was tested with (normally held back until a distro update)
  check           list waiting updates, by source, without installing
  auto-check on|off|toggle
                  check once a day in the background (off by default): downloads
                  the package lists from the Arch and $DISTRO_NAME package servers;
                  the menu's Update and a dot on the bar's menu button show the count
  security        security fixes: what's waiting, and how they arrive
  security install|notify|off
                  install: when an installed package has a high or critical
                  CVE whose fix is in the repositories, update in the
                  background (on mains power, not on a metered connection,
                  with the usual snapshot first) and say so afterwards;
                  notify: only say so, with an Update button; off (default).
                  Every six hours it downloads one public file, the security
                  feed (repo.conf's ADVISORIES_URL); nothing is sent about you
  doctor          check what updates need (network, clock, package key) and fix
                  what it can
  candy on|off    pacman's progress bars drawn as Pac-Man eating dots (off by default)
  new-apps        install default apps added since this computer was installed
                  (an update does this; each is offered once)
  restore         put back the tested release of a package the distro holds
                  (Hyprland, Ghostty) if a newer one arrived before the hold (an update
                  does this, once)
  firmware        check for and install firmware updates (BIOS/UEFI, SSD, dock...)
                  through fwupd; firmware lists are only downloaded when you run this
  snapshots       list the snapshots taken before updates
  rollback <n>    put the system back as it was in snapshot <n>, then restart;
                  /home, logs and your files are not touched
  rollback --clean
                  delete the systems set aside by earlier rollbacks
USAGE
}

tested_file=$SHARE/default/tested/hyprland
hypr_family='^(hyprland|aquamarine|hypr[a-z-]*|xdg-desktop-portal-hyprland)$'
ghostty_tested_file=$SHARE/default/tested/ghostty
ghostty_family='^ghostty(-terminfo|-shell-integration)?$'

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

# "name repo" for every package in the sync databases.
repo_of_all() { pacman -Sl 2>/dev/null | awk '{ print $2, $1 }'; }

# The Hyprland release the distro was tested with (a version prefix, e.g. 0.56).
tested_hyprland() {
  [[ -f $tested_file ]] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$tested_file" | head -1 | tr -d '[:space:]'
}

# Waiting Arch/distro updates ("name old -> new"), from a private copy of the
# databases, so the system's own are never half-synced.
pending() { checkupdates 2>/dev/null || true; }

# The Hyprland package the header-strip plugin (hyprbars) is built for, e.g.
# 0.56.2-2: the update waiting for it if there is one (its version is that
# Hyprland's, 0.56.2.2-1), else the installed one. Empty when not installed.
plugin_file=/usr/lib/hyprland-plugins/hyprbars.hyprland
plugin_hyprland() { # plugin_hyprland <pending lines>
  local new
  new=$(awk '$1 == "hyprland-plugin-hyprbars" { print $4 }' <<<"$1")
  if [[ -n $new ]]; then
    new=${new%-*}; printf '%s-%s\n' "${new%.*}" "${new##*.}"
  elif [[ -f $plugin_file ]]; then
    head -1 "$plugin_file"
  fi
}

# The Ghostty release the distro was tested with (an exact package version).
tested_ghostty() {
  [[ -f $ghostty_tested_file ]] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$ghostty_tested_file" | head -1 | tr -d '[:space:]'
}

# Ghostty and its two companion packages, when the waiting Ghostty isn't the
# tested one.
held_ghostty() { # held_ghostty <pending lines>
  local tested new
  new=$(awk '$1 == "ghostty" { print $4 }' <<<"$1")
  tested=$(tested_ghostty)
  [[ -n $new && -n $tested ]] || return 0
  case $new in "$tested"|"$tested".*|"$tested"-*) return 0 ;; esac
  awk '{ print $1 }' <<<"$1" | grep -E "$ghostty_family" || true
}

# Packages to hold back: Hyprland and its own libraries (the plugin among
# them), when the waiting Hyprland is newer than the tested release, or isn't
# the one the plugin is built for: a plugin built for another Hyprland doesn't
# load, so both wait until the distro repository has the matching pair.
held_back() { # held_back <pending lines>
  held_hyprland "$1"
  held_ghostty "$1"
}

held_hyprland() { # held_hyprland <pending lines>
  local tested new plugin hold=0
  new=$(awk '$1 == "hyprland" { print $4 }' <<<"$1")
  if [[ -z $new ]]; then
    # A plugin for a Hyprland that isn't here yet waits for it.
    plugin=$(awk '$1 == "hyprland-plugin-hyprbars" { print $4 }' <<<"$1")
    if [[ -n $plugin && $(plugin_hyprland "$1") != "$(pacman -Q hyprland 2>/dev/null | awk '{ print $2 }')" ]]; then
      echo hyprland-plugin-hyprbars
    fi
    return 0
  fi
  tested=$(tested_hyprland)
  if [[ -n $tested ]]; then
    case $new in "$tested"|"$tested".*|"$tested"-*) ;; *) hold=1 ;; esac
  fi
  plugin=$(plugin_hyprland "$1")
  if [[ -n $plugin && $plugin != "$new" ]]; then hold=1; fi
  (( hold )) || return 0
  awk '{ print $1 }' <<<"$1" | grep -E "$hypr_family" || true
}

# Packages the distro repository builds with its own patches under Arch's
# names: the shell and the login screen (epoch 1, so Arch's package of the same
# name never replaces them).
ours_over_arch=(noctalia noctalia-greeter)

# Arch's version of <pkg>, when it is newer than the release our build is made
# from: it waits until the distro repository has a build of it.
arch_waiting() { # arch_waiting <pkg>
  local ours arch
  ours=$(pacman -Q "$1" 2>/dev/null | awk '{ print $2 }')
  [[ $ours == 1:* ]] || return 0
  arch=$(pacman -Sl 2>/dev/null | awk -v r="$DISTRO_REPO" -v p="$1" '$2 == p && $1 != r { print $3; exit }')
  if [[ -n $arch ]] && (( $(vercmp "${arch#*:}" "${ours#1:}") > 0 )); then printf '%s\n' "$arch"; fi
}

# True when the installed build of <pkg> is the distro repository's newest.
# pacman then skips it, rather than warning on every update that the installed
# one is newer than Arch's. A newer build in the repository is not skipped: the
# distro package depends on it and pulls it in.
ours_current() { # ours_current <pkg>
  local ours repo
  ours=$(pacman -Q "$1" 2>/dev/null | awk '{ print $2 }')
  [[ $ours == 1:* ]] || return 1
  repo=$(pacman -Sl "$DISTRO_REPO" 2>/dev/null | awk -v p="$1" '$2 == p { print $3; exit }')
  [[ -z $repo ]] || (( $(vercmp "$repo" "$ours") <= 0 ))
}

pretty() { case $1 in noctalia) echo Noctalia ;; noctalia-greeter) echo "The login screen (Noctalia Greeter)" ;; *) echo "$1" ;; esac; }

# The number of updates waiting, as last seen by `update check` (0 after an
# update): "<count> <unix time>". The menu's Update shows it ("12 ready")
# without checking anything itself.
remember_pending() { # remember_pending <count>
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$1" "$(date +%s)" > "$STATE_DIR/updates"
  noctalia msg plugin "$DISTRO_ID/utilities:menu-button" all refresh >/dev/null 2>&1 || true
}

# The daily check (opt-in, setting update.auto_check): a user timer runs
# `update check --background`, which looks at the Arch and distro repositories
# only (not the AUR, which would be sent the names of your AUR packages).
auto_check() { # auto_check on|off|toggle|status
  local timer=$DISTRO_ID-update-check.timer want=$1
  if [[ $want == toggle ]]; then
    if [[ $(setting update.auto_check off) == on ]]; then want=off; else want=on; fi
  fi
  case $want in
    on)
      set_setting update.auto_check on
      systemctl --user enable --now "$timer" >/dev/null 2>&1 || die "couldn't start $timer"
      info "checking for updates daily: on (downloads the package lists from the Arch and $DISTRO_NAME package servers)" ;;
    off)
      set_setting update.auto_check off
      systemctl --user disable --now "$timer" >/dev/null 2>&1 || true
      noctalia msg plugin "$DISTRO_ID/utilities:menu-button" all refresh >/dev/null 2>&1 || true
      info "checking for updates daily: off" ;;
    status|"") info "checking for updates daily: $(setting update.auto_check off)" ;;
    *) die "auto-check on, off or toggle?" ;;
  esac
}

# --- Security fixes (setting update.security; install also /etc/<id>/security-updates)
# A user timer reads the feed and notifies (notify and install); a system
# timer, only with the /etc file, installs (`security apply`, as root).
security_conf=/etc/$DISTRO_ID/security-updates

security_mode() {
  if [[ -r $security_conf ]] && grep -qx install "$security_conf"; then echo install; return; fi
  case $(setting update.security off) in notify|install) echo notify ;; *) echo off ;; esac
}

security_set() { # security_set install|notify|off
  local timer=$DISTRO_ID-security-fixes.timer
  case $1 in
    install|notify)
      set_setting update.security "$1"
      systemctl --user enable --now "$timer" >/dev/null 2>&1 || die "couldn't start $timer"
      if [[ $1 == install ]]; then
        local tmp
        tmp=$(mktemp)
        printf 'install\n' > "$tmp"
        sudo install -D -m 644 "$tmp" "$security_conf" || { rm -f "$tmp"; die "couldn't turn on automatic installs"; }
        rm -f "$tmp"
        sudo systemctl start "$DISTRO_ID-security-update.timer" 2>/dev/null || true
      elif [[ -e $security_conf ]]; then
        sudo rm -f "$security_conf"
      fi
      security_check "" || true ;;
    off)
      set_setting update.security off
      systemctl --user disable --now "$timer" >/dev/null 2>&1 || true
      if [[ -e $security_conf ]]; then sudo rm -f "$security_conf"; fi
      rm -f "$STATE_DIR/security"
      noctalia msg plugin "$DISTRO_ID/utilities:menu-button" all refresh >/dev/null 2>&1 || true ;;
    *) die "security install, notify or off?" ;;
  esac
  set_setting privacy.security_asked yes
  info "security fixes: $(security_mode)"
}

security_say_mode() {
  case $(security_mode) in
    install) info "Security fixes: installed automatically (on mains power, not on a metered connection)" ;;
    notify) info "Security fixes: you're told when one is waiting" ;;
    off) info "Security fixes: arrive with your own updates ($DISTRO_ID update security install turns on automatic installs)" ;;
  esac
}

# Reads the feed (downloading it unless --cached) and lists what's waiting;
# with --notify, new ones get a notification with an Update button.
security_check() { # security_check [--notify|--cached]
  local feed=$STATE_DIR/advisories.json waiting n seen=$STATE_DIR/security-seen new top
  mkdir -p "$STATE_DIR"
  if [[ ${1:-} != --cached ]]; then
    if ! fetch_feed "$feed"; then
      if [[ -s $feed ]]; then info "(couldn't download the list of security fixes; using the copy from $(date -r "$feed" '+%b %-d %H:%M'))"
      else info "The list of security fixes couldn't be downloaded yet; it's tried again every six hours."; return 0; fi
    fi
  fi
  [[ -s $feed ]] || { info "The list of security fixes hasn't been downloaded yet; it's tried every six hours."; return 0; }
  waiting=$(feed_waiting "$feed")
  printf '%s\n' "$waiting" | grep . > "$STATE_DIR/security" || true
  noctalia msg plugin "$DISTRO_ID/utilities:menu-button" all refresh >/dev/null 2>&1 || true
  n=$(grep -c . <<<"$waiting" || true)
  if [[ ${1:-} != --notify ]]; then
    if (( n )); then
      info "Security fixes waiting ($DISTRO_ID update installs them):"
      awk '{ s = $5 == "-" ? "" : " (" $5 ")"; printf "  %s %s -> %s  %s%s\n", $1, $2, $3, $4, s }' <<<"$waiting"
    else
      info "No security fixes waiting."
    fi
    return 0
  fi
  (( n )) || return 0
  [[ -f $seen ]] || : > "$seen"
  new=$(awk 'NR == FNR { old[$0] = 1; next } !(($4 "|" $1) in old)' "$seen" - <<<"$waiting")
  { awk '{ print $4 "|" $1 }' <<<"$waiting"; cat "$seen"; } | sort -u > "$seen.part" && mv -f "$seen.part" "$seen"
  [[ -n $new ]] || return 0
  [[ $(security_mode) == install ]] && return 0   # the system timer installs it and says so
  top=$(head -1 <<<"$waiting")
  systemd-run --user --quiet --collect -- bash -c 'a=$(notify-send -a "Security fixes" -u critical \
      --action=update=Update --wait -- "$1" "$2" 2>/dev/null) || exit 0
    [[ $a == update ]] && exec "/usr/bin/$3" terminal run -- "/usr/bin/$3" update' _ \
    "Security fix waiting$( (( n > 1 )) && echo "s ($n)")" \
    "$(awk '{ printf "%s: %s", $1, $4; if ($5 != "-") printf " (%s)", $5 }' <<<"$top")$( (( n > 1 )) && echo ", and $((n - 1)) more")" \
    "$DISTRO_ID" >/dev/null 2>&1 || true
}

# Root's notification to everyone logged in to a desktop.
notify_desktops() { # notify_desktops <urgency> <title> <body>
  local s uid name type active
  while read -r s _; do
    [[ -n $s ]] || continue
    { read -r uid; read -r name; read -r type; read -r active; } < <(loginctl show-session "$s" -p User -p Name -p Type -p Active --value 2>/dev/null)
    [[ $active == yes && $type =~ ^(wayland|x11)$ && $uid =~ ^[0-9]+$ ]] || continue
    runuser -u "$name" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" XDG_RUNTIME_DIR="/run/user/$uid" \
      notify-send -a "Security fixes" -u "$1" -- "$2" "$3" >/dev/null 2>&1 || true
  done < <(loginctl list-sessions --no-legend 2>/dev/null)
}

metered() { # true when the connection in use is metered (phone hotspot, mobile data)
  local dev
  dev=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  [[ -n $dev ]] || return 1
  nmcli -t -g GENERAL.METERED device show "$dev" 2>/dev/null | grep -qE '^yes'
}

# The system timer's job (root): when a security fix is waiting, the normal
# update of Arch and distro packages, unattended. Keyrings first, held-back
# Hyprland honoured, snapshots before and after (snap-pac); no AUR or Flatpak,
# no new default apps (the next `update` does those). --cached uses the feed
# already on disk instead of downloading it (the install test's made-up one).
security_apply() { # security_apply [--dry-run] [--cached]
  local dry=0 cached=0 feed waiting pend ignore=() held=() keyrings=() o before after changed names kernel=0 log a
  for a in "$@"; do
    case $a in
      --dry-run) dry=1 ;;
      --cached) cached=1 ;;
      *) die "unknown option: $a" ;;
    esac
  done
  [[ $EUID -eq 0 ]] || die "security apply runs as root (the system timer)"
  [[ -r $security_conf ]] && grep -qx install "$security_conf" || { info "automatic security installs are off"; return 0; }
  [[ $(booted_snapshot) == 0 ]] || { info "started from a snapshot; not updating"; return 0; }
  install -d -m 755 "/var/lib/$DISTRO_ID"
  feed=/var/lib/$DISTRO_ID/advisories.json
  if (( !cached )); then fetch_feed "$feed" || info "couldn't download the security feed; using the last copy"; fi
  [[ -s $feed ]] || return 0
  waiting=$(feed_waiting "$feed")
  if [[ -z $waiting ]]; then info "no security fixes waiting"; return 0; fi
  info "waiting: $(awk '{ printf "%s%s (%s)", sep, $1, $4; sep = ", " }' <<<"$waiting")"
  names=$(awk '{ print $1 }' <<<"$waiting" | sort -u | tr '\n' ' ')
  if command -v systemd-ac-power >/dev/null && ! systemd-ac-power; then info "on battery; later"; return 0; fi
  if metered; then
    info "metered connection; not downloading"
    (( dry )) || notify_desktops normal "Security fix waiting" "$names- not installed automatically on a metered connection. Menu › Update installs it."
    return 0
  fi
  if [[ -e /var/lib/pacman/db.lck ]]; then info "another package operation is running; later"; return 0; fi
  if (( dry )); then info "would update now (dry run)"; return 0; fi
  log=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$log'" RETURN
  keyrings=(archlinux-keyring)
  if ! pacman -Sy --noconfirm >"$log" 2>&1; then
    info "the package lists could not be downloaded"; cat "$log"; return 1
  fi
  if pacman -Si "$DISTRO_ID-keyring" >/dev/null 2>&1; then keyrings+=("$DISTRO_ID-keyring"); fi
  pacman -S --needed --noconfirm "${keyrings[@]}" >>"$log" 2>&1 || true
  pend=$(pending)
  mapfile -t held < <(held_back "$pend")
  for o in "${ours_over_arch[@]}"; do if ours_current "$o"; then ignore+=(--ignore "$o"); fi; done
  for o in "${held[@]}"; do ignore+=(--ignore "$o"); done
  before=$(pacman -Q)
  if ! pacman -Su --noconfirm "${ignore[@]}" >>"$log" 2>&1; then
    cat "$log"
    notify_desktops critical "Security fixes couldn't install themselves" "Menu › Update installs them and shows why ($names)."
    return 1
  fi
  after=$(pacman -Q)
  changed=$(comm -13 <(sort <<<"$before") <(sort <<<"$after") | awk '{ print $1 }')
  if grep -qE '^linux(-lts|-zen|-hardened)?$' <<<"$changed" || [[ ! -d /usr/lib/modules/$(uname -r) ]]; then kernel=1; fi
  info "updated $(grep -c . <<<"$changed" || true) package(s)"
  printf '%s %s\n' "$(date +%s)" "$names" > "/var/lib/$DISTRO_ID/security-installed"
  notify_desktops normal "Security fixes installed" "$names$( (( kernel )) && echo "- restart to finish (a new kernel)")"
}

latest_snapshot() { snapper -c root --csvout list --columns number 2>/dev/null | tail -1 | tr -cd '0-9'; }

# --- before any pacman call: network, clock, package key ---------------------
# Each check stops with one plain explanation instead of a page of pacman errors.

clock_floor=1767225600   # 2026-01-01: no real clock is earlier than this

repo_url() {
  local url=""
  if [[ -r $DISTRO_LIB/repo.conf ]]; then url=$(sed -n 's/^REPO_URL=//p' "$DISTRO_LIB/repo.conf" | head -1); fi
  if [[ $url =~ ^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._/-]*)?$ ]]; then printf '%s\n' "${url%/}"; fi
}

# The same packages straight from GitHub (repo.conf's REPO_FALLBACK), for
# networks that block the distro's own domain.
repo_fallback() {
  local github=""
  if [[ -r $DISTRO_LIB/repo.conf ]]; then github=$(sed -n 's/^REPO_GITHUB=//p' "$DISTRO_LIB/repo.conf" | head -1); fi
  github=${github//\$DISTRO_ID/$DISTRO_ID}
  if [[ $github =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then printf 'https://github.com/%s/releases/download/packages\n' "$github"; fi
}

# The first Arch mirror pacman would use, as a URL to core's database.
arch_mirror() {
  local server
  server=$(sed -n 's/^[[:space:]]*Server[[:space:]]*=[[:space:]]*//p' /etc/pacman.d/mirrorlist 2>/dev/null | head -1)
  # shellcheck disable=SC2016  # $repo and $arch are pacman's own placeholders
  [[ $server =~ ^https?://[A-Za-z0-9.:/_-]+'$repo'/[A-Za-z0-9./_-]*'$arch'$ ]] || return 0
  server=${server//\$repo/core}; server=${server//\$arch/$(uname -m)}
  printf '%s/core.db\n' "$server"
}

# reach <url>: 0 reachable; 60 TLS refused (often a wrong clock); 1 otherwise.
reach() {
  local rc=0
  curl -fsSIL -m 8 -o /dev/null "$1" 2>/dev/null || rc=$?
  case $rc in 0) return 0 ;; 35|51|58|60) return 60 ;; *) return 1 ;; esac
}

tls_suspect=0
network_check() {
  local repo mirror rc=0 mrc=0
  if command -v nm-online >/dev/null && ! nm-online -q -t 5; then
    die "You're offline. Connect to Wi-Fi from the bar (or run nmtui), then try again."
  fi
  repo=$(repo_url); mirror=$(arch_mirror)
  if [[ -n $repo ]]; then reach "$repo/$DISTRO_REPO.db" || rc=$?; fi
  # Our domain blocked (a network filter), GitHub not: pacman uses the second server.
  if (( rc != 0 )) && [[ -n $(repo_fallback) ]] && reach "$(repo_fallback)/$DISTRO_REPO.db"; then rc=0; fi
  if [[ -n $mirror ]]; then reach "$mirror" || mrc=$?; fi
  if (( rc == 60 || mrc == 60 )); then tls_suspect=1; return 0; fi   # the clock check explains it
  if (( rc != 0 && mrc != 0 )); then
    die "You're connected to a network, but the internet isn't reachable (a Wi-Fi login page, or the network is down). Open a browser to sign in, then try again."
  fi
  if (( rc != 0 )); then
    die "$DISTRO_NAME's package server (${repo#https://}) can't be reached right now, though the rest of the internet can. Try again in a few minutes."
  fi
  if [[ -n $mirror ]] && (( mrc != 0 )); then
    die "The Arch package mirror (${mirror#*://}) can't be reached right now. Try again in a few minutes."
  fi
}

# The time the package server reports (epoch seconds), only as a hint for the
# message below; never applied without asking. -k: a wrong clock makes TLS fail,
# so this time isn't verified: anyone on the network path could fake it.
server_epoch() {
  local repo date
  repo=$(repo_url); [[ -n $repo ]] || return 0
  date=$(curl -ksSIL -m 8 "$repo/$DISTRO_REPO.db" 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: //p' | tail -1)
  [[ $date =~ ^[A-Za-z]{3},\ [0-9]{2}\ [A-Za-z]{3}\ [0-9]{4}\ [0-9:]{8}\ GMT$ ]] || return 0
  date -d "$date" +%s 2>/dev/null || true
}

clock_check() { # clock_check <interactive 0|1>
  local interactive=$1 now real diff answer
  if [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) != yes ]]; then
    if [[ $(timedatectl show -p NTP --value 2>/dev/null) != yes ]] && (( interactive )); then
      info "Turning on network time..."
      sudo timedatectl set-ntp true || true
    fi
    printf 'Waiting for the clock to sync'
    for _ in $(seq 20); do
      if [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == yes ]]; then break; fi
      printf '.'; sleep 1
    done
    printf '\n'
  fi
  now=$(date +%s); real=$(server_epoch)
  if [[ -n $real ]]; then diff=$(( now - real )); diff=${diff#-}; else diff=0; fi
  if (( diff <= 600 && now >= clock_floor )); then
    if (( tls_suspect )); then
      die "Secure connections to the package servers are failing, though the clock looks right. Check the network (a Wi-Fi login page?) and try again."
    fi
    return 0
  fi
  if [[ -n $real ]]; then
    info "The clock says $(date '+%Y-%m-%d %H:%M'), but it's actually about $(date -d "@$real" '+%Y-%m-%d %H:%M')."
  else
    info "The clock says $(date '+%Y-%m-%d %H:%M'), which can't be right."
  fi
  info "Package signatures can't be checked until it's right."
  # Offered only when the clock is before clock_floor (so it's surely
  # wrong) and the unverified time isn't: a faked time can never move the clock
  # back before that floor, where expired keys and certificates look valid, nor
  # more than five years past it, where every certificate would look expired.
  if [[ -n $real ]] && (( interactive && now < clock_floor && real >= clock_floor && real < clock_floor + 5 * 365 * 86400 )); then
    info "(That time comes from the package server over a connection that can't be checked yet.)"
    read -rp "Set the clock to the package server's time now? [y/N] " answer
    if [[ $answer == [yY]* ]]; then
      sudo date -s "@$real" >/dev/null && sudo hwclock --systohc 2>/dev/null || true
      info "Clock set to $(date '+%Y-%m-%d %H:%M'). Network time will keep it right from here."
      return 0
    fi
  fi
  die "Run: sudo timedatectl set-ntp true   (then wait a moment and try again)"
}

# The distro key must be in pacman's keyring and trusted (signed locally).
key_check() {
  local trusted=/usr/share/pacman/keyrings/$DISTRO_ID-trusted fpr validity
  [[ -r $trusted ]] || return 0
  fpr=$(cut -d: -f1 "$trusted" | head -1)
  [[ $fpr =~ ^[0-9A-F]{40}$ ]] || return 0
  validity=$(sudo gpg --homedir /etc/pacman.d/gnupg --batch --with-colons --list-keys "$fpr" 2>/dev/null | awk -F: '$1 == "pub" { print $2; exit }' || true)
  case $validity in f|u) return 0 ;; esac
  info "The $DISTRO_NAME package key isn't trusted on this computer yet. Setting it up from the installed keyring..."
  sudo pacman-key --populate "$DISTRO_ID" >/dev/null
}

preflight() { # preflight <interactive 0|1> [keys 0|1, default = interactive]
  network_check
  clock_check "$1"
  if (( ${2:-$1} )); then key_check; fi
}

# Download the package lists (pacman -Sy). A local copy of a database dated
# newer than the server's is never replaced by -Sy, and pairs with the
# server's newer signature as "invalid": on that error, force fresh copies
# once (-Syy) before explaining.
sync_databases() { # sync_databases <error log>
  if sudo pacman -Sy >/dev/null 2>"$1"; then return 0; fi
  if db_signature_error "$1"; then
    info "Refreshing the package lists..."
    if sudo pacman -Syy >/dev/null 2>"$1"; then return 0; fi
  fi
  cat "$1" >&2; explain_failure "$1"; return 1
}

db_signature_error() { grep -qiE 'invalid or corrupted database|signature from .* is invalid' "$1" 2>/dev/null; }

# After a failed pacman run: if it was a signature problem, say what usually
# causes it instead of leaving only pacman's text.
explain_failure() { # explain_failure <stderr log>
  [[ -s $1 ]] || return 0
  grep -qiE 'signature|PGP|invalid or corrupted' "$1" || return 0
  info ""
  info "A package signature couldn't be checked. Usual causes, most likely first:"
  info "  1. The clock is wrong: timedatectl (fix: sudo timedatectl set-ntp true)"
  info "  2. The $DISTRO_NAME key isn't trusted: sudo pacman-key --populate $DISTRO_ID"
  info "  3. An update was being published just then: try again in a minute"
}

# Default apps added after this computer was installed. A system migration
# lists them (it runs inside pacman's transaction, where pacman can't be
# called); they're installed here, once: the list is cleared either way, so an
# app removed later isn't brought back.
new_apps_list=/var/lib/$DISTRO_ID/new-default-apps
new_default_apps() {
  local pkgs=() p
  [[ -s $new_apps_list ]] || return 0
  while read -r p; do
    if [[ $p =~ ^[a-z0-9][a-z0-9._+-]*$ ]] && ! pacman -Qq "$p" >/dev/null 2>&1; then pkgs+=("$p"); fi
  done < "$new_apps_list"
  if (( ${#pkgs[@]} )); then
    step "New default apps"
    info "$DISTRO_NAME now includes: ${pkgs[*]}"
    if ! sudo pacman -S --needed "${pkgs[@]}"; then
      info "Not installed. To add them later: sudo pacman -S ${pkgs[*]}"
    fi
  fi
  sudo rm -f "$new_apps_list"
}

# An install that took a Ghostty release before the distro held it back (a
# system migration flags it) goes back to the tested one, once, from the Arch
# Linux Archive (packages signed by Arch).
ghostty_restore_flag=/var/lib/$DISTRO_ID/restore-tested-ghostty
restore_tested_ghostty() {
  local tested have p urls=()
  [[ -f $ghostty_restore_flag ]] || return 0
  tested=$(tested_ghostty)
  have=$(pacman -Q ghostty 2>/dev/null | awk '{ print $2 }')
  if [[ $tested =~ ^[0-9][0-9.]*-[0-9]+$ && -n $have && $have != "$tested" ]]; then
    step "Ghostty"
    info "Ghostty $have crashes as the lock screen's screensaver; going back to the tested $tested."
    for p in ghostty ghostty-terminfo ghostty-shell-integration; do
      if pacman -Q "$p" >/dev/null 2>&1; then urls+=("https://archive.archlinux.org/packages/g/$p/$p-$tested-x86_64.pkg.tar.zst"); fi
    done
    if ! sudo pacman -U --noconfirm "${urls[@]}"; then
      info "Ghostty stays at $have for now; the next update tries again."
      return 0
    fi
  fi
  sudo rm -f "$ghostty_restore_flag"
}

# Installs made while the installer couldn't pin Hyprland (Arch moved its
# libraries on, 2026-11-02) got Hyprland 0.57, where the shell may not start
# and the window header plugin doesn't load. A migration flags them; this puts
# the tested family (default/tested/hyprland-packages) back once, from the Arch
# Linux Archive, in one transaction. `update --all` still takes newer ones.
hyprland_restore_flag=/var/lib/$DISTRO_ID/restore-tested-hyprland
restore_tested_hyprland() {
  local name version installed urls=()
  [[ -f $hyprland_restore_flag ]] || return 0
  while read -r name version; do
    [[ $name =~ ^[a-z0-9][a-z0-9+_.-]*$ && $version =~ ^[0-9][0-9a-z.+:_]*-[0-9.]+$ ]] || continue
    installed=$(pacman -Q "$name" 2>/dev/null | awk '{ print $2 }')
    [[ -n $installed && $installed != "$version" ]] || continue
    urls+=("https://archive.archlinux.org/packages/${name:0:1}/$name/$name-$version-x86_64.pkg.tar.zst")
  done < <(grep -vE '^[[:space:]]*(#|$)' "$SHARE/default/tested/hyprland-packages" 2>/dev/null)
  if (( ${#urls[@]} )); then
    step "Hyprland"
    info "Going back to the tested Hyprland ($(awk '$1 == "hyprland" { print $2 }' "$SHARE/default/tested/hyprland-packages")) and its libraries; it applies at the next login."
    if ! sudo pacman -U --noconfirm "${urls[@]}"; then
      info "Hyprland stays as it is for now; the next update tries again."
      return 0
    fi
  fi
  sudo rm -f "$hyprland_restore_flag"
}

update_all() { # update_all [1 = take held-back Hyprland too]
  local all=$1 before after pend changed others snap snap_before pre p
  local held=() ignore=() keyrings=(archlinux-keyring) aur_failed=0 kernel=0 errlog
  if [[ ! -t 0 ]]; then
    exec "/usr/bin/$DISTRO_ID" terminal run -- "/usr/bin/$DISTRO_ID" update ${all:+--all}
  fi
  sudo -v

  step "Checking the connection and the clock"
  preflight 1
  info "ok"
  errlog=$USER_RUNTIME/update-errors.log
  : > "$errlog"

  step "Package keyrings"
  # A system that hasn't updated in a while can fail signature checks until
  # its keyrings are current, so they go first.
  if pacman -Si "$DISTRO_ID-keyring" >/dev/null 2>&1; then keyrings+=("$DISTRO_ID-keyring"); fi
  sync_databases "$errlog" || die "the package lists could not be downloaded"
  if ! sudo pacman -S --needed --noconfirm "${keyrings[@]}" >/dev/null 2>"$errlog"; then
    cat "$errlog" >&2; explain_failure "$errlog"; die "the keyrings could not be updated"
  fi
  info "up to date"

  step "Arch and $DISTRO_NAME packages"
  pend=$(pending)
  if [[ -z $all ]]; then mapfile -t held < <(held_back "$pend"); fi
  if [[ ${held[*]} == hyprland-plugin-hyprbars ]]; then
    info "Holding back the window header plugin until the Hyprland it's built for arrives."
  elif printf '%s\n' "${held[@]}" | grep -qE "$hypr_family"; then
    info "Holding back Hyprland $(awk '$1 == "hyprland" { print $4 }' <<<"$pend") and its libraries."
    info "$DISTRO_NAME's settings and window header plugin are made for Hyprland $(pacman -Q hyprland | awk '{ print $2 }');"
    info "a $DISTRO_NAME update takes the new release once it's tested. '$DISTRO_ID update --all'"
    info "takes it now (terminal windows lose their header strip until then)."
  fi
  if printf '%s\n' "${held[@]}" | grep -qE "$ghostty_family"; then
    info "Holding back Ghostty $(awk '$1 == "ghostty" { print $4 }' <<<"$pend") until it's tested ($DISTRO_NAME stays on $(tested_ghostty));"
    info "'$DISTRO_ID update --all' takes it now."
  fi
  for o in "${ours_over_arch[@]}"; do
    p=$(arch_waiting "$o")
    if [[ -n $p ]]; then info "$(pretty "$o") $p from Arch waits for $DISTRO_NAME's build of it; it stays as it is."; fi
    if ours_current "$o"; then ignore+=(--ignore "$o"); fi
  done
  for p in "${held[@]}"; do ignore+=(--ignore "$p"); done
  before=$(pacman -Q)
  snap_before=$(latest_snapshot)
  # pacman asks its questions on stderr. sudo relays stdout through its own
  # terminal, so a stderr redirected out here could put "Proceed with
  # installation?" on screen before the list it asks about. The log copy is
  # made inside sudo instead, where both streams share that terminal. Root
  # only appends to the log if it's still the user's own plain file.
  # shellcheck disable=SC2016  # expanded by the root shell
  if ! sudo bash -c 'log=$1; shift
    [[ -f $log && ! -L $log && $(stat -c %u "$log") == "${SUDO_UID:-}" ]] || log=/dev/null
    pacman -Syu "$@" 2> >(tee -a "$log" >&2); rc=$?
    wait $!
    exit "$rc"' _ "$errlog" "${ignore[@]}"; then
    explain_failure "$errlog"
    if (( ${#held[@]} )); then
      info "Holding back Hyprland may be blocking other updates; try: $DISTRO_ID update --all"
    fi
    die "the system update did not finish"
  fi

  new_default_apps
  restore_tested_hyprland
  restore_tested_ghostty

  if command -v yay >/dev/null && [[ -n $(pacman -Qqm) ]]; then
    step "AUR apps"
    # Separate from the system update, so a broken AUR package never blocks it.
    yay -Sua || aur_failed=1
  fi

  if command -v flatpak >/dev/null && [[ -n $(flatpak list --app --columns=application 2>/dev/null) ]]; then
    step "Flatpak apps"
    flatpak update -y || info "The Flatpak update failed; run 'flatpak update' to see why."
  fi

  "/usr/bin/$DISTRO_ID" migrate --user

  step "Summary"
  after=$(pacman -Q)
  changed=$(comm -13 <(sort <<<"$before") <(sort <<<"$after") | awk '{ print $1 }')
  if [[ -z $changed ]]; then
    info "Nothing new."
  else
    awk 'NR == FNR { want[$1] = 1; next } ($1 in want) { n[$2]++ }
         END { for (r in n) printf "  %-10s %d package(s)\n", r, n[r] }' \
      <(printf '%s\n' "$changed") <(repo_of_all)
    others=$(comm -23 <(printf '%s\n' "$changed" | sort) <(repo_of_all | awk '{ print $1 }' | sort) | grep -c . || true)
    if (( others )); then printf '  %-10s %d package(s)\n' AUR "$others"; fi
    if grep -qE '^linux(-lts|-zen|-hardened)?$' <<<"$changed" || [[ ! -d /usr/lib/modules/$(uname -r) ]]; then kernel=1; fi
  fi
  snap=$(latest_snapshot)
  if [[ -n $snap && $snap != "$snap_before" ]]; then
    pre=$(snapper -c root --csvout list --columns number,type 2>/dev/null \
      | awk -F, -v s="${snap_before:-0}" '$2 == "pre" && $1 + 0 > s + 0 { print $1; exit }')
    info "Snapshot before this update: ${pre:-$snap}  (undo it with: $DISTRO_ID update rollback ${pre:-$snap})"
  fi
  if (( ${#held[@]} )); then info "Held back: ${held[*]}"; fi
  if (( aur_failed )); then info "Some AUR apps didn't update; the rest of the system did. Run 'yay -Sua' to see why."; fi
  if (( kernel )); then info "A new kernel was installed: restart to use it."; fi
  remember_pending 0
  if [[ $(security_mode) != off ]]; then security_check --cached >/dev/null 2>&1 || true; fi
}

check() { # check [--background]: --background is the daily timer's (no AUR)
  local pend held aur="" n background=0
  if [[ ${1:-} == --background ]]; then background=1; fi
  preflight "$([[ -t 0 ]] && echo 1 || echo 0)"
  pend=$(pending)
  if [[ -n $pend ]]; then
    awk 'NR == FNR { repo[$1] = $2; next } { r = ($1 in repo) ? repo[$1] : "?"; print r ": " $0 }' \
      <(repo_of_all) <(printf '%s\n' "$pend") | sort
  fi
  held=$(held_back "$pend")
  if [[ -n $held ]]; then
    info "(held back until tested: $(tr '\n' ' ' <<<"$held")- '$DISTRO_ID update --all' takes them)"
  fi
  for o in "${ours_over_arch[@]}"; do
    held=$(arch_waiting "$o")
    if [[ -n $held ]]; then info "($(pretty "$o") $held from Arch waits for $DISTRO_NAME's build of it)"; fi
  done
  if (( ! background )) && command -v yay >/dev/null && [[ -n $(pacman -Qqm) ]]; then aur=$(yay -Qua 2>/dev/null || true); fi
  if [[ -n $aur ]]; then sed 's/^/aur: /' <<<"$aur"; fi
  n=$(( $(grep -c . <<<"$pend" || true) + $(grep -c . <<<"$aur" || true) ))
  if (( n )); then info "$n update(s) available"; else info "up to date"; fi
  remember_pending "$(( n - $(grep -c . <<<"$(held_back "$pend")" || true) ))"
}

snapshots() {
  info "Snapshots taken around updates (the 'pre' one is the state before):"
  sudo snapper -c root list
  info ""
  info "Undo an update: $DISTRO_ID update rollback <number>"
  info ""
  sudo "/usr/bin/$DISTRO_ID" boot snapshots list || true
}

# The snapshot this boot started from (0 for the normal system); set by the
# boot menu's snapshot entries (see `boot snapshots`).
booted_snapshot() {
  local word
  for word in $(</proc/cmdline); do
    if [[ $word == "$DISTRO_ID.snapshot="* ]]; then printf '%s\n' "${word#*=}"; return; fi
  done
  echo 0
}

# --- Rolling back (runs as root) ----------------------------------------------
# The system boots the subvolume named @ (rootflags=subvol=@ on the kernel
# command line), so snapper's own rollback, which changes btrfs's default
# subvolume, would have no effect here. Instead, from the running system: make a
# writable copy of the snapshot, set the current @ aside as @old-<date>, and
# give the copy the name @; the next boot starts the restored system. Kernels
# live on the EFI partition, outside the snapshot, so if the snapshot's kernel
# differs from the one in /boot, put it back and rebuild its initramfs.
kernel_of() { # kernel_of <root> <pkgbase>: the modules version installed for it
  local f
  for f in "$1"/usr/lib/modules/*/pkgbase; do
    if [[ -f $f && $(<"$f") == "$2" ]]; then basename "$(dirname "$f")"; return 0; fi
  done
}

mount_top() { # mount_top: mounts the whole btrfs filesystem, prints where
  local dev top
  # The btrfs device: from /.snapshots, which is also mounted when the root is
  # a snapshot under a RAM overlay (where / isn't btrfs).
  dev=$(findmnt -no SOURCE /.snapshots | sed 's/\[.*\]$//')
  top=$(mktemp -d /run/rollback.XXXXXX)
  mount -o subvolid=5 "$dev" "$top"
  printf '%s\n' "$top"
}

rollback_apply() { # rollback_apply <n> <dry-run 0|1>
  local n=$1 dry=$2 top snap stamp new old sub b base ver desc date
  [[ $EUID -eq 0 ]] || die "rolling back needs root"
  if [[ $(booted_snapshot) == 0 ]]; then
    [[ $(findmnt -no FSTYPE /) == btrfs ]] || die "the system isn't on btrfs"
    [[ $(findmnt -no FSROOT /) == /@ ]] || die "the running system isn't the @ subvolume (already rolled back? restart first)"
  else
    [[ $(findmnt -no FSTYPE /.snapshots) == btrfs ]] || die "can't find the snapshots"
  fi
  top=$(mount_top)
  # shellcheck disable=SC2064
  trap "umount -R '$top' 2>/dev/null; rmdir '$top' 2>/dev/null" EXIT
  snap=$top/@snapshots/$n/snapshot
  [[ -d $snap ]] || die "there is no snapshot $n (see: $DISTRO_ID update snapshots)"
  stamp=$(date +%Y%m%d-%H%M%S)
  new=$top/@rollback-$stamp old=$top/@old-$stamp
  desc=$(sed -n 's:.*<description>\(.*\)</description>.*:\1:p' "$top/@snapshots/$n/info.xml" 2>/dev/null)
  date=$(sed -n 's:.*<date>\(.*\)</date>.*:\1:p' "$top/@snapshots/$n/info.xml" 2>/dev/null)

  info "Snapshot $n (${date:-unknown date} UTC): ${desc:-no description}"
  info "Plan:"
  info "  1. copy snapshot $n into a new writable system"
  info "  2. keep the current system (@) as @old-$stamp ('$DISTRO_ID update rollback --clean' removes it later)"
  info "  3. make the copy the system that starts next time"
  for b in /boot/vmlinuz-*; do
    [[ -f $b ]] || continue
    base=${b#/boot/vmlinuz-}
    ver=$(kernel_of "$snap" "$base")
    if [[ -n $ver ]] && ! cmp -s "$b" "$snap/usr/lib/modules/$ver/vmlinuz"; then
      info "  4. put kernel $ver ($base) back in /boot and rebuild its initramfs"
    fi
  done
  if (( dry )); then info "(dry run: nothing changed)"; return 0; fi

  btrfs -q subvolume snapshot "$snap" "$new"
  # Snapshots taken before an install are made while pacman runs, so they hold
  # its lock; nothing runs in the copy, so the lock would only block updates.
  rm -f "$new/var/lib/pacman/db.lck"
  # Renaming the subvolume that's mounted as / is fine: the mount holds it by id.
  mv "$top/@" "$old"
  mv "$new" "$top/@"
  # Subvolumes nested inside the old system (e.g. /var/lib/machines) aren't in
  # snapshots; move them across rather than leave them behind.
  # A failure here leaves that one behind; it never stops the kernel step below.
  local path sub
  while IFS= read -r path; do
    sub=${path#"@old-$stamp/"}
    if [[ -e $top/@/$sub ]] && ! rmdir -- "$top/@/$sub" 2>/dev/null; then
      info "left $sub in @old-$stamp (something is in its place)"; continue
    fi
    if ! { mkdir -p -- "$(dirname -- "$top/@/$sub")" && mv -- "$old/$sub" "$top/@/$sub"; }; then
      info "left $sub in @old-$stamp (couldn't move it)"
    fi
  done < <(nested_subvols "$top" "@old-$stamp")

  for b in /boot/vmlinuz-*; do
    [[ -f $b ]] || continue
    base=${b#/boot/vmlinuz-}
    ver=$(kernel_of "$top/@" "$base")
    [[ -n $ver ]] || continue
    if ! cmp -s "$b" "$top/@/usr/lib/modules/$ver/vmlinuz"; then
      info "putting back kernel $ver ($base)"
      install -m644 "$top/@/usr/lib/modules/$ver/vmlinuz" "$b"
      mount --bind /boot "$top/@/boot"
      for d in proc sys dev run; do mount --rbind "/$d" "$top/@/$d"; done
      chroot "$top/@" mkinitcpio -p "$base" >/dev/null
      umount -R "$top/@/boot" "$top/@/proc" "$top/@/sys" "$top/@/dev" "$top/@/run" 2>/dev/null || true
    fi
  done
  sync
  info ""
  info "Rolled back to snapshot $n. Restart to start the restored system."
  info "The previous system is kept as @old-$stamp."
  # The boot menu's snapshot entries are rewritten from the restored system at
  # its first update; the old ones still point at snapshots that exist.
}

# The subvolumes nested inside <name> (a top-level subvolume, e.g. @old-…),
# as paths from the top of the filesystem, deepest first. The path is all of
# "path …" (names may contain spaces: any user can create a subvolume where
# they can write, /var/tmp included); anything not inside <name>, or with an
# empty, "." or ".." part, is skipped.
nested_subvols() { # nested_subvols <top> <name>
  local line path part ok parts
  while IFS= read -r line; do
    path=${line#* path }
    [[ $path != "$line" && $path == "$2"/* ]] || continue
    ok=1
    IFS=/ read -ra parts <<<"$path"
    for part in "${parts[@]}"; do [[ -n $part && $part != . && $part != .. ]] || ok=0; done
    (( ok )) && printf '%s\n' "$path"
  done < <(btrfs subvolume list -o "$1/$2") | sort -r
}

rollback_clean() {
  local top olds o answer
  [[ $EUID -eq 0 ]] || die "cleaning up needs root"
  top=$(mount_top)
  # shellcheck disable=SC2064
  trap "umount '$top' 2>/dev/null; rmdir '$top' 2>/dev/null" EXIT
  mapfile -t olds < <(find "$top" -mindepth 1 -maxdepth 1 -name '@old-*' -printf '%f\n' | sort)
  if (( ${#olds[@]} == 0 )); then info "Nothing to clean up."; return 0; fi
  info "Systems set aside by earlier rollbacks: ${olds[*]}"
  read -rp "Delete them? [y/N] " answer
  if [[ $answer != [yY]* ]]; then info "Kept."; return 0; fi
  for o in "${olds[@]}"; do
    # Nested subvolumes first, deepest first; only ones inside this system.
    nested_subvols "$top" "$o" | while IFS= read -r sub; do
      btrfs -q subvolume delete -- "$top/$sub"
    done
    btrfs -q subvolume delete "$top/$o"
  done
  info "Deleted."
}

# pacman's ILoveCandy option in /etc/pacman.conf; only that line changes.
candy() { # candy [on|off]
  local conf=/etc/pacman.conf state=off
  if grep -qE '^[[:space:]]*ILoveCandy[[:space:]]*$' "$conf"; then state=on; fi
  case ${1:-} in
    "") info "candy: $state" ;;
    on)
      if [[ $state == off ]]; then
        if grep -qE '^[[:space:]]*Color[[:space:]]*$' "$conf"; then
          sudo sed -i -E '0,/^[[:space:]]*Color[[:space:]]*$/s//&\nILoveCandy/' "$conf"
        else
          sudo sed -i '0,/^\[options\]$/s//&\nILoveCandy/' "$conf"
        fi
      fi
      info "candy: on" ;;
    off)
      if [[ $state == on ]]; then sudo sed -i -E '/^[[:space:]]*ILoveCandy[[:space:]]*$/d' "$conf"; fi
      info "candy: off" ;;
    *) die "candy on or off?" ;;
  esac
}

if [[ ${1:-} == "" || ${1:-} == --all ]] && [[ $(booted_snapshot) != 0 ]]; then
  die "you're running snapshot $(booted_snapshot) (changes are kept in memory only). Keep it first: $DISTRO_ID boot snapshots keep, then restart"
fi

case ${1:-} in
  "") update_all "" ;;
  --all) update_all 1 ;;
  check) check "${2:-}" ;;
  auto-check) auto_check "${2:-status}" ;;
  security)
    case ${2:-} in
      "") security_say_mode; if [[ $(security_mode) != off ]]; then security_check --cached; fi ;;
      install|notify|off) security_set "$2" ;;
      check) security_check "${3:-}" ;;
      apply) shift 2; security_apply "$@" ;;
      *) die "security install, notify, off or check?" ;;
    esac ;;
  new-apps) sudo -v; new_default_apps ;;
  restore) sudo -v; restore_tested_hyprland; restore_tested_ghostty ;;
  firmware)
    command -v fwupdmgr >/dev/null || die "fwupd isn't installed (sudo pacman -S fwupd)"
    # Downloads the firmware list from the Linux Vendor Firmware Service (LVFS)
    # now, at the user's request; nothing refreshes it in the background.
    # --no-unreported-check: never offer to upload update reports (if fwupd asks
    # anyway, answering no keeps it on this computer).
    fwupdmgr refresh --force --no-unreported-check || true
    if fwupdmgr get-updates --no-unreported-check; then fwupdmgr update --no-unreported-check; else info "no firmware updates"; fi ;;
  snapshots) snapshots ;;
  rollback)
    case ${2:-} in
      "") snapshots ;;
      --clean) sudo "/usr/bin/$DISTRO_ID" update rollback-clean ;;
      *)
        [[ $2 =~ ^[0-9]+$ ]] || die "rollback needs a snapshot number (see: $DISTRO_ID update snapshots)"
        sudo "/usr/bin/$DISTRO_ID" update rollback-apply "$2" --dry-run
        if [[ ${3:-} != --dry-run ]]; then
          read -rp "Roll back now? [y/N] " answer
          if [[ $answer != [yY]* ]]; then info "Nothing changed."; exit 0; fi
          sudo "/usr/bin/$DISTRO_ID" update rollback-apply "$2"
        fi ;;
    esac ;;
  rollback-apply) rollback_apply "${2:?snapshot number}" "$([[ ${3:-} == --dry-run ]] && echo 1 || echo 0)" ;;
  rollback-clean) rollback_clean ;;
  candy) candy "${2:-}" ;;
  doctor)
    preflight "$([[ -t 0 ]] && echo 1 || echo 0)" 1
    sync_databases "$USER_RUNTIME/update-errors.log" || exit 1
    info "Network, clock, package key and package lists look right." ;;
  -h|--help) usage ;;
  *) die "unknown update command: $1" ;;
esac
