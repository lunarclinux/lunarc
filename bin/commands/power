#!/usr/bin/env bash
# summary: Laptop power: battery charge limit, hibernate, lid and battery alerts
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

helper=$DISTRO_LIB/power-helper
swap_file=/swap/swapfile

usage() {
  cat <<USAGE
Usage: $DISTRO_ID power <command>

  status                      battery, charge limit and hibernate at a glance
  charge-limit on|off         battery care: stop charging early (kinder to the battery)
  charge-limit <50-100>       stop at this level, on batteries that take a number
  charge-limit                show which kind this battery is and the setting
  hibernate enable|disable    hibernation (encrypted installs only)
  hibernate                   show whether hibernation is on
  hibernate now               hibernate now (when it's on)

Some batteries take a level (on = 80%); others, like Lenovo's, only have
battery care on or off and the firmware picks the level (about 60-80%).

Closing the lid with an external monitor connected turns the laptop's screen
off and keeps working; with no external monitor the laptop sleeps (and locks).
Battery alerts: Noctalia warns at 20%; this adds a persistent alert at
$(setting power.battery_critical 10)% and a last warning at $(setting power.battery_final 5)% (settings power.battery_critical
and power.battery_final).
USAGE
}

as_root() { if (( EUID == 0 )); then "$@"; elif [[ -t 0 ]]; then sudo "$@"; else pkexec "$@"; fi; }

# POWER_SYSFS and POWER_FAKE_UPOWER let tests/charge-limit use a fake battery.
batteries() { local b; for b in "${POWER_SYSFS:-/sys/class/power_supply}"/BAT*; do if [[ -d $b ]]; then echo "$b"; fi; done; }

# Batteries whose firmware only offers a fixed "battery care" level (Lenovo's
# conservation mode, shown by the kernel as charge_types "Long_Life") have no
# percentage to set; UPower switches them, with its own polkit check.
upower_battery() {
  local path
  if [[ -n ${POWER_FAKE_UPOWER:-} ]]; then [[ $POWER_FAKE_UPOWER != none ]] && echo /fake; return $?; fi
  path=$(upower -e 2>/dev/null | grep -m1 '/battery_' || true)
  [[ $path =~ ^/org/freedesktop/UPower/devices/battery_[A-Za-z0-9_]+$ ]] || return 1
  [[ $(busctl get-property org.freedesktop.UPower "$path" org.freedesktop.UPower.Device ChargeThresholdSupported 2>/dev/null) == "b true" ]] || return 1
  printf '%s\n' "$path"
}
upower_care_on() {
  local path
  if [[ -n ${POWER_FAKE_UPOWER:-} ]]; then [[ $POWER_FAKE_UPOWER == on ]]; return $?; fi
  path=$(upower_battery) || return 1
  [[ $(busctl get-property org.freedesktop.UPower "$path" org.freedesktop.UPower.Device ChargeThresholdEnabled 2>/dev/null) == "b true" ]]
}
upower_care_set() { # upower_care_set true|false
  local path
  path=$(upower_battery) || return 1
  busctl call org.freedesktop.UPower "$path" org.freedesktop.UPower.Device EnableChargeThreshold b "$1"
}

care_set() { upower_care_set "$1" >/dev/null || die "UPower didn't switch battery care (cancelled, or not allowed)"; }

# Which kind of charge limit this computer's battery has: percent (a level can
# be set), care (fixed-level battery care through UPower) or none.
charge_kind() {
  local bat
  while read -r bat; do
    if [[ -n $bat && -e $bat/charge_control_end_threshold ]]; then echo percent; return; fi
  done < <(batteries)
  if upower_battery >/dev/null; then echo care; return; fi
  echo none
}

# What `charge-limit <arg>` does for a battery of that kind, one line:
# "percent <N|off>", "care on", "care on-number" (a number given; the
# firmware decides the level), "care off" or "error <message>".
charge_plan() { # charge_plan <kind> <arg>
  local kind=$1 arg=${2,,}
  case $kind in
    care)
      case $arg in
        on) echo "care on" ;;
        off) echo "care off" ;;
        *) if [[ $arg =~ ^[0-9]{1,3}$ ]]; then echo "care on-number"
           else echo "error on this battery charge-limit takes on or off"; fi ;;
      esac ;;
    percent)
      case $arg in
        on) echo "percent 80" ;;
        off) echo "percent off" ;;
        *) if [[ $arg =~ ^[0-9]{1,3}$ ]] && (( 10#$arg >= 50 && 10#$arg <= 100 )); then echo "percent $((10#$arg))"
           else echo "error charge-limit takes on (80%), a number from 50 to 100, or off"; fi ;;
      esac ;;
    *) echo "error this computer's battery doesn't support a charge limit (no battery, or the firmware doesn't offer one)" ;;
  esac
}

# Leads with the kind of battery, so it's clear whether a level can be chosen.
charge_limit_status() {
  local bat end
  case $(charge_kind) in
    percent)
      while read -r bat; do
        [[ -n $bat && -r $bat/charge_control_end_threshold ]] || continue
        end=$(<"$bat/charge_control_end_threshold")
        if (( end >= 100 )); then info "Charge limit: off (charges to 100%). Turn it on with: $DISTRO_ID power charge-limit on"
        else info "Charge limit: $end%"; fi
        return 0
      done < <(batteries) ;;
    care)
      if upower_care_on; then info "Battery care: on — the firmware decides the level (about 60–80%)"
      else info "Battery care: off — the firmware decides the level (about 60–80%) when on. Turn it on with: $DISTRO_ID power charge-limit on"; fi ;;
    *)
      if [[ -n $(batteries) ]]; then info "Charge limit: not supported by this battery"; else info "Charge limit: no battery"; fi ;;
  esac
}

hibernate_on() { swapon --show=NAME --noheadings 2>/dev/null | grep -qx "$swap_file"; }

# The laptop's own screen: eDP/LVDS/DSI connectors.
internal_panel() {
  hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")) | .name' | head -1
}
external_connected() {
  hyprctl monitors all -j 2>/dev/null | jq -e '[.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not)] | length > 0' >/dev/null
}

lid() { # lid close|open (Hyprland's lid-switch binds)
  local panel
  panel=$(internal_panel)
  [[ -n $panel ]] || return 0
  case $1 in
    close)
      # Docked: logind ignores the lid (HandleLidSwitchDocked=ignore), so
      # turn the closed screen off and keep the desktop on the external one.
      # The display command keeps it off across hotplug while the flag exists.
      touch "$USER_RUNTIME/$DISTRO_ID-lid-closed"
      if external_connected; then "/usr/bin/$DISTRO_ID" display apply >/dev/null 2>&1 || \
        hyprctl eval "hl.monitor({ output = \"$panel\", disabled = true })" >/dev/null; fi ;;
    open)
      # Back to the saved arrangement.
      rm -f "$USER_RUNTIME/$DISTRO_ID-lid-closed"
      "/usr/bin/$DISTRO_ID" display apply >/dev/null 2>&1 || hyprctl reload >/dev/null ;;
  esac
}

notify() { # notify <urgency> <title> <body>
  notify-send -a "$DISTRO_NAME" -u "$1" -i battery-caution "$2" "$3" >/dev/null 2>&1 || true
}

# Two alerts after Noctalia's own low-battery warning (20%): a persistent one,
# and a last one before UPower's critical action (at 2% it hibernates when
# hibernation is on, otherwise it shuts down to protect the battery).
battery_watch() {
  local critical final bat capacity status warned_critical=0 warned_final=0
  critical=$(setting power.battery_critical 10)
  final=$(setting power.battery_final 5)
  bat=$(batteries | head -1)
  [[ -n $bat ]] || exit 0
  while sleep 60; do
    capacity=$(<"$bat/capacity") status=$(<"$bat/status")
    if [[ $status != Discharging ]]; then
      warned_critical=0 warned_final=0
      continue
    fi
    if (( capacity <= final && ! warned_final )); then
      warned_final=1 warned_critical=1
      if hibernate_on; then
        notify critical "Battery at $capacity%" "Plug in now. At 2% the laptop hibernates; your work is kept."
      else
        notify critical "Battery at $capacity%" "Plug in now. At 2% the laptop shuts down, and unsaved work is lost."
      fi
    elif (( capacity <= critical && ! warned_critical )); then
      warned_critical=1
      notify critical "Battery at $capacity%" "Plug in soon."
    fi
  done
}

# Hyprland stops counting idle time when a window holds idle off (a
# fullscreen video) and, after that window goes away, doesn't start again
# until the next real input, so an untouched computer never locks. When the
# last idle-holding window is gone, restart the count (the idle timer then
# runs from that moment, as it would after a key press).
idle_watch() {
  local held=0 now
  while sleep 10; do
    now=$(hyprctl clients -j 2>/dev/null | jq '[.[] | select(.inhibitingIdle)] | length' 2>/dev/null) || continue
    [[ $now =~ ^[0-9]+$ ]] || continue
    if (( held > 0 && now == 0 )); then
      hyprctl dispatch 'hl.dsp.force_idle(1)' >/dev/null 2>&1 || true
    fi
    held=$now
  done
}

if [[ ${BASH_SOURCE[0]} != "$0" ]]; then return 0; fi

case ${1:-} in
  status)
    charge_limit_status
    if hibernate_on; then info "hibernate: on"; else info "hibernate: off"; fi ;;
  charge-limit)
    if [[ -z ${2:-} || ${2:-} == status ]]; then charge_limit_status
    else
      # Work out what to do before asking for any password.
      plan=$(charge_plan "$(charge_kind)" "$2")
      case $plan in
        "care on") care_set true; info "Battery care: on — the firmware decides the level (about 60–80%)" ;;
        "care on-number") care_set true; info "This battery stops at a level set by its firmware; battery care is now on." ;;
        "care off") care_set false; info "Battery care: off (charges to 100%)" ;;
        "percent "*) as_root "$helper" charge-limit "${plan#percent }" ;;
        *) die "${plan#error }" ;;
      esac
    fi ;;
  hibernate)
    case ${2:-status} in
      status) if hibernate_on; then info "hibernate: on"; else info "hibernate: off ($DISTRO_ID power hibernate enable)"; fi ;;
      enable) as_root "$helper" hibernate-enable ;;
      disable) as_root "$helper" hibernate-disable ;;
      now)
        if hibernate_on; then systemctl hibernate
        else
          notify normal "Hibernate is off" "Turn it on with: $DISTRO_ID power hibernate enable (encrypted installs only)."
          die "hibernate is off; turn it on with '$DISTRO_ID power hibernate enable'"
        fi ;;
      *) die "hibernate enable, disable, now or status?" ;;
    esac ;;
  lid) lid "${2:-}" ;;
  battery-watch) battery_watch ;;
  idle-watch) idle_watch ;;
  -h|--help|"") usage ;;
  *) die "unknown power command: $1" ;;
esac
