#!/usr/bin/env bash
# summary: Choose, install and open the terminal
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

# name | package | how to make it run a command
known=(
  "ghostty|ghostty|ghostty -e"
  "alacritty|alacritty|alacritty -e"
  "kitty|kitty|kitty"
  "wezterm|wezterm|wezterm start --"
  "foot|foot|foot"
)
field() { local row; for row in "${known[@]}"; do [[ ${row%%|*} == "$1" ]] && { cut -d'|' -f"$2" <<<"$row"; return; }; done; return 1; }
installed() { command -v "$1" >/dev/null; }
current() { setting terminal ghostty; }

usage() {
  cat <<USAGE
Usage: $DISTRO_ID terminal <command>     (or: $DISTRO_ID term <command>)

  list               terminals this distro knows about, and which are installed
  current            the default terminal
  set <name>         make <name> the default (installs it first if needed)
  install <name>     install <name> without changing the default
  launch [-- cmd]    open the default terminal, optionally running cmd
  run -- cmd         open it running cmd, then stay open at a shell prompt
                     (how the menu runs installs, updates and other commands)
  notifications [on|off]   (or: notify on|off)
                     let programs in the terminal (Claude Code and others) show
                     desktop notifications; off by default. On, they disappear
                     after a few seconds and stay out of the notification list.
USAGE
}

case ${1:-} in
  list)
    cur=$(current)
    for row in "${known[@]}"; do
      name=${row%%|*}
      mark=" "; [[ $name == "$cur" ]] && mark="*"
      state="not installed"; installed "$name" && state="installed"
      printf '%s %-10s %s\n' "$mark" "$name" "$state"
    done ;;
  current) current ;;
  notifications|notify)
    if [[ -z ${2:-} ]]; then setting terminal.notifications off; exit 0; fi
    [[ $2 == on || $2 == off ]] || die "notifications: on or off"
    set_setting terminal.notifications "$2"
    # Written into Ghostty's settings file with the theme's look; open windows reload.
    "/usr/bin/$DISTRO_ID" theme tokens >/dev/null || die "Ghostty's settings could not be written"
    info "terminal notifications: $2" ;;
  install)
    [[ -n ${2:-} ]] || die "which terminal? see '$DISTRO_ID terminal list'"
    pkg=$(field "$2" 2) || die "unknown terminal: $2"
    installed "$2" || install_packages "$pkg" ;;
  set)
    [[ -n ${2:-} ]] || die "which terminal? see '$DISTRO_ID terminal list'"
    pkg=$(field "$2" 2) || die "unknown terminal: $2"
    installed "$2" || install_packages "$pkg"
    set_setting terminal "$2"
    info "default terminal: $2" ;;
  launch)
    shift
    [[ ${1:-} == "--" ]] && shift
    name=$(current)
    installed "$name" || name=$(for row in "${known[@]}"; do n=${row%%|*}; installed "$n" && { echo "$n"; break; }; done)
    [[ -n $name ]] || die "no known terminal is installed"
    if [[ $# -eq 0 ]]; then
      launch_app "$name"
    else
      read -ra run <<<"$(field "$name" 3)"
      launch_app "${run[@]}" "$@"
    fi ;;
  run)
    shift
    [[ ${1:-} == "--" ]] && shift
    [[ $# -gt 0 ]] || die "run what? $DISTRO_ID terminal run -- <command>"
    # The command's own arguments, never pasted into a shell string; then the
    # user's shell, so the window stays open like any other terminal.
    # shellcheck disable=SC2016  # expanded by the inner bash
    exec "/usr/bin/$DISTRO_ID" terminal launch -- bash -c '"$@"; exec "${SHELL:-/bin/bash}" -i' "$DISTRO_ID" "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown terminal command: $1" ;;
esac
