#!/usr/bin/env bash
# summary: The boot menu: start the system as it was before an update
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

usage() {
  cat <<USAGE
Usage: $DISTRO_ID boot snapshots [command]

  (none) | list   the snapshots in the boot menu, and which can start
  refresh         rewrite the boot menu's snapshot entries (pacman and the
                  snapshot cleanup run this; you don't need to)
  keep            running a snapshot? make it the system (restart afterwards)

If an update ever stops the computer from starting, pick "Snapshots" in the
boot menu and the state from before that update. It starts with its changes
kept in memory only; run '$DISTRO_ID boot snapshots keep' there to make it the
system again (the same as '$DISTRO_ID update rollback <n>').
USAGE
}

# --- How it works -------------------------------------------------------------
# snap-pac takes a "pre" snapshot of @ before every pacman transaction. Limine
# can start any of them: the same kernel command line as the normal entry, but
# with the snapshot as the root, mounted read-only under a RAM overlay
# (systemd.volatile=overlay), so it starts normally and changes nothing on
# disk. Kernels live on the EFI partition, outside the snapshots: a snapshot
# whose kernel is the one in /boot uses it; one with an older kernel uses a copy
# saved just before that kernel was replaced (save-kernels, a pacman hook that
# runs before mkinitcpio removes the old images). Copies are pruned with the
# snapshots and capped, so the 1 GiB EFI partition doesn't fill up.

conf=/boot/limine.conf
store=/boot/$DISTRO_ID/kernels   # one folder per saved kernel: <version>-<pkgbase>
entries=5                        # snapshot entries in the menu
kept_kernels=3                   # saved kernel copies at most
margin=$(( 128 * 1024 * 1024 ))  # free space to leave on the EFI partition
begin="# >>> $DISTRO_ID snapshots: generated by '$DISTRO_ID boot snapshots refresh'; changes here are replaced"
end="# <<< $DISTRO_ID snapshots"

as_root() { # re-run this command as root
  if [[ $EUID -ne 0 ]]; then exec sudo "/usr/bin/$DISTRO_ID" boot "$@"; fi
}

# The snapshot this boot started from (0 when it's the normal system).
booted_snapshot() {
  local word
  for word in $(</proc/cmdline); do
    if [[ $word == "$DISTRO_ID.snapshot="* ]]; then printf '%s\n' "${word#*=}"; return; fi
  done
  echo 0
}

kernel_of() { # kernel_of <root> <pkgbase>: the modules version installed for it
  local f
  for f in "$1"/usr/lib/modules/*/pkgbase; do
    if [[ -f $f && $(<"$f") == "$2" ]]; then basename "$(dirname "$f")"; return 0; fi
  done
}

# The normal entry's kernel package (vmlinuz-<pkgbase>) and command line: the
# first entry in limine.conf outside the generated block.
main_entry() { # prints "<pkgbase>\t<cmdline>"
  awk -v b="$begin" -v e="$end" '
    $0 == b { skip = 1 } $0 == e { skip = 0; next } skip { next }
    /^[[:space:]]*path:[[:space:]]*boot\(\):\/vmlinuz-/ && !base { p = $0; sub(/.*vmlinuz-/, "", p); base = p }
    /^[[:space:]]*cmdline:/ && !cmd { c = $0; sub(/^[[:space:]]*cmdline:[[:space:]]*/, "", c); cmd = c }
    END { if (base && cmd) printf "%s\t%s\n", base, cmd }' "$conf"
}

# "pre" snapshots, newest first: "<n>\t<date>\t<description>".
pre_snapshots() {
  snapper -c root --csvout --separator $'\t' list --columns number,type,date,description 2>/dev/null \
    | awk -F'\t' 'NR > 1 && $2 == "pre" { print $1 "\t" $3 "\t" $4 }' | sort -t$'\t' -k1,1nr
}

# Copy the kernel(s) in /boot before pacman replaces them, so snapshots taken
# before this update can still start with the kernel that matches them.
save_kernels() {
  local b base ver dir need free
  [[ $(booted_snapshot) == 0 ]] || return 0
  for b in /boot/vmlinuz-*; do
    [[ -f $b ]] || continue
    base=${b#/boot/vmlinuz-}
    ver=$(kernel_of / "$base")
    [[ -n $ver && -f /boot/initramfs-$base.img ]] || continue
    dir=$store/$ver-$base
    [[ -d $dir ]] && continue
    need=$(( $(stat -c %s "$b") + $(stat -c %s "/boot/initramfs-$base.img") ))
    free=$(( $(stat -f -c '%a * %S' /boot) ))
    if (( free - need < margin )); then
      info "$DISTRO_ID: not enough room on the EFI partition to keep kernel $ver for the boot menu's snapshots"
      continue
    fi
    install -d -m700 "$dir"
    install -m644 "$b" "$dir/vmlinuz-$base"
    install -m644 "/boot/initramfs-$base.img" "$dir/initramfs-$base.img"
  done
}

# Rewrite the generated block; keep everything else in limine.conf as it is.
refresh() {
  local main base cmd cur n date desc snap ver kpath ipath title line cmdline block tmp
  local -a lines=() used=() skipped=()
  if [[ ! -f $conf ]]; then info "no $conf: nothing to update"; return 0; fi
  if [[ $(booted_snapshot) != 0 ]]; then info "running a snapshot: the boot menu is left as it is"; return 0; fi
  main=$(main_entry)
  [[ -n $main ]] || die "can't find the normal boot entry in $conf"
  base=${main%%$'\t'*} cmd=${main#*$'\t'}
  cur=$(kernel_of / "$base")

  # The snapshot's root, read-only with a RAM overlay; remount-fs would try
  # to remount it with the normal root's options, so it's masked there.
  cmdline=$(sed -E 's/(^| )rootflags=subvol=[^ ]*/\1rootflags=subvol=@snapshots\/@N@\/snapshot/; s/(^| )rw( |$)/\1ro\2/' <<<"$cmd")
  [[ $cmdline == *"rootflags=subvol=@snapshots/@N@/snapshot"* ]] || cmdline+=" rootflags=subvol=@snapshots/@N@/snapshot"
  [[ $cmdline == *" ro"* || $cmdline == "ro "* ]] || cmdline+=" ro"
  cmdline+=" systemd.volatile=overlay systemd.mask=systemd-remount-fs.service $DISTRO_ID.snapshot=@N@"

  while IFS=$'\t' read -r n date desc; do
    (( ${#lines[@]} < entries )) || break
    snap=/.snapshots/$n/snapshot
    [[ -d $snap ]] || continue
    ver=$(kernel_of "$snap" "$base")
    if [[ -n $ver && $ver == "$cur" ]]; then
      kpath=vmlinuz-$base ipath=initramfs-$base.img
    elif [[ -n $ver && -f $store/$ver-$base/vmlinuz-$base ]]; then
      kpath=$DISTRO_ID/kernels/$ver-$base/vmlinuz-$base ipath=$DISTRO_ID/kernels/$ver-$base/initramfs-$base.img
      used+=("$ver-$base")
    else
      skipped+=("$n"); continue
    fi
    title="Before update, ${date:0:16} (#$n)"
    lines+=("//$title" "    comment: ${desc:-snapshot $n}, kernel ${ver:-?}"
            "    protocol: linux" "    path: boot():/$kpath"
            "    cmdline: ${cmdline//@N@/$n}" "    module_path: boot():/$ipath")
  done < <(pre_snapshots)

  block=$begin$'\n'
  if (( ${#lines[@]} )); then
    block+=$'/Snapshots\n    comment: Start the system as it was before an update (changes stay in memory)\n'
    for line in "${lines[@]}"; do block+=$line$'\n'; done
  fi
  block+=$end

  tmp=$(mktemp /boot/.limine.conf.XXXXXX)
  awk -v b="$begin" -v e="$end" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip' "$conf" \
    | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$tmp"   # drop trailing blank lines
  printf '\n%s\n' "$block" >> "$tmp"
  chmod 600 "$tmp"
  if cmp -s "$tmp" "$conf"; then rm -f "$tmp"; else mv -f "$tmp" "$conf"; fi

  # Saved kernels that no entry uses any more go; and never more than a few.
  local d keep k
  if [[ -d $store ]]; then
    for d in "$store"/*/; do
      d=${d%/}; [[ -d $d ]] || continue
      keep=0
      for k in "${used[@]}"; do [[ ${d##*/} == "$k" ]] && keep=1; done
      if (( ! keep )); then rm -rf "$d"; fi
    done
    while (( $(find "$store" -mindepth 1 -maxdepth 1 -type d | wc -l) > kept_kernels )); do
      rm -rf "$(find "$store" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -n | head -1 | cut -d' ' -f2-)"
    done
  fi
  info "boot menu: $(( ${#lines[@]} / 6 )) snapshot(s)${skipped:+; not startable (no matching kernel kept): ${skipped[*]}}"
}

list() {
  local in=0 line
  [[ -f $conf ]] || die "no $conf"
  info "In the boot menu under Snapshots:"
  while IFS= read -r line; do
    if [[ $line == "$begin" ]]; then in=1; continue; fi
    if [[ $line == "$end" ]]; then in=0; continue; fi
    if (( in )) && [[ $line == //* ]]; then info "  ${line#//}"; fi
  done < "$conf"
  if [[ $(booted_snapshot) != 0 ]]; then
    info ""; info "You're running snapshot $(booted_snapshot). Keep it with: $DISTRO_ID boot snapshots keep"
  fi
}

# At login: if this boot is a snapshot, say so and offer to keep it.
notice() {
  local n action
  n=$(booted_snapshot)
  [[ $n != 0 ]] || return 0
  command -v notify-send >/dev/null || return 0
  action=$(notify-send -u critical -a "$DISTRO_NAME" -A keep="Keep this version" -w \
    "Running snapshot $n" \
    "This is the system as it was before an update. Changes you make now are lost at restart unless you keep this version." \
    2>/dev/null || true)
  if [[ $action == keep ]]; then
    "/usr/bin/$DISTRO_ID" terminal launch -- "/usr/bin/$DISTRO_ID" boot snapshots keep
  fi
}

keep() {
  local n
  n=$(booted_snapshot)
  [[ $n != 0 ]] || die "this boot isn't a snapshot (to undo an update: $DISTRO_ID update rollback <n>)"
  exec "/usr/bin/$DISTRO_ID" update rollback "$n"
}

[[ ${1:-} == snapshots ]] || { usage; [[ -z ${1:-} || ${1:-} == -h || ${1:-} == --help ]]; exit; }
case ${2:-list} in
  list) as_root snapshots list; list ;;
  refresh) as_root snapshots refresh; refresh ;;
  save-kernels) as_root snapshots save-kernels; save_kernels ;;
  notice) notice ;;
  keep) keep ;;
  -h|--help) usage ;;
  *) die "unknown boot snapshots command: $2" ;;
esac
