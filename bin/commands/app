#!/usr/bin/env bash
# summary: Find and install apps: browsers, editors, AI, games and more
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

catalog=$SHARE/default/apps/catalog
webapps=${XDG_DATA_HOME:-$HOME/.local/share}/applications

usage() {
  cat <<USAGE
Usage: $DISTRO_ID app <command>

  list [category]       apps this distro knows about, by category (* = installed)
  search <word>         find apps by name or category
  install <app>...      install apps (Arch repos, the AUR, web apps, coding agents)
  remove <app>...       remove apps
  export [file]         save your apps and a few settings to a file (default: stdout)
  import <file> [--dry-run] [--yes]
                        install what's in an exported list and apply its settings
  web-browser [chromium|edge|chrome]
                        the browser web apps open in (Edge for work sign-ins that
                        need it); existing web apps switch too

Categories: $(categories | tr '\n' ' ')
USAGE
}

trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

# Catalog rows as "id|category|name|source|target|note", whitespace trimmed.
rows() {
  local line id cat name src target note
  while IFS='|' read -r id cat name src target note; do
    id=$(trim "$id")
    [[ -z $id || $id == \#* ]] && continue
    printf '%s|%s|%s|%s|%s|%s\n' "$id" "$(trim "$cat")" "$(trim "$name")" "$(trim "$src")" "$(trim "$target")" "$(trim "${note:-}")"
  done < "$catalog"
}
categories() { rows | cut -d'|' -f2 | awk '!seen[$0]++'; }
row() { rows | awk -F'|' -v id="$1" '$1 == id' | head -1; }

gpu_vendor() {
  local dev vendor
  for dev in /sys/bus/pci/devices/*; do
    [[ $(cat "$dev/class" 2>/dev/null) == 0x03* ]] || continue
    vendor=$(cat "$dev/vendor")
    case $vendor in
      0x1002) echo amd; return ;;
      0x10de) echo nvidia; return ;;
      0x8086) echo intel; return ;;
    esac
  done
  echo other
}

# The Arch packages a row installs (empty for web apps and agents).
packages_for() { # packages_for <source> <target>
  local entry vendor
  case $1 in
    repo|multilib|aur) printf '%s\n' "$2" ;;
    gpu)
      vendor=$(gpu_vendor)
      for entry in $2; do
        if [[ ${entry%%:*} == "$vendor" ]]; then printf '%s\n' "${entry#*:}"; return; fi
      done
      for entry in $2; do
        if [[ ${entry%%:*} == other ]]; then printf '%s\n' "${entry#*:}"; fi
      done ;;
  esac
}

is_installed() { # is_installed <id> <source> <target>
  local pkgs
  case $2 in
    web) [[ -f $webapps/$DISTRO_ID-web-$1.desktop ]] ;;
    agent) command -v "$3" >/dev/null ;;
    mise) "/usr/bin/$DISTRO_ID" dev status "lang:$3" ;;
    dev) "/usr/bin/$DISTRO_ID" dev status "$3" ;;
    *) pkgs=$(packages_for "$2" "$3"); [[ -n $pkgs ]] && pacman -Q "${pkgs%% *}" >/dev/null 2>&1 ;;
  esac
}

as_root() { if [[ -t 0 ]]; then sudo "$@"; else pkexec "$@"; fi; }

enable_multilib() {
  grep -q '^\[multilib\]' /etc/pacman.conf && return 0
  info "enabling the [multilib] repository (32-bit libraries for games)"
  as_root sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
  as_root pacman -Sy
}

lib32_driver() {
  case $(gpu_vendor) in
    amd) echo lib32-vulkan-radeon ;;
    nvidia) echo lib32-nvidia-utils ;;
    intel) echo lib32-vulkan-intel ;;
    *) echo lib32-mesa ;;
  esac
}

aur_install() {
  # base-devel is in the base package list; installs from before it was get it here.
  if ! pacman -Qq base-devel >/dev/null 2>&1; then install_packages base-devel; fi
  if ! command -v yay >/dev/null; then install_packages yay; fi
  info "building from the AUR (community packages; review what you install)"
  local p
  for p in "$@"; do valid_pkg "$p" || die "\"$p\" isn't a package name"; done
  if [[ -t 0 ]]; then system_tx "install $*" yay -S --needed -- "$@"; else yay -S --needed -- "$@"; fi
}

# The browser web apps open in (`app web-browser`): Chromium by default; Edge
# for work accounts whose sign-in needs it (Microsoft Conditional Access).
# All three take the same app-window options.
web_browser() {
  case $(setting app.web_browser chromium) in
    edge) echo "microsoft-edge-stable|edge" ;;
    chrome) echo "google-chrome-stable|chrome" ;;
    *) echo "chromium|chromium" ;;
  esac
}

ensure_browser() {
  local bin=${1%%|*} id=${1#*|}
  command -v "$bin" >/dev/null && return 0
  if [[ $id == chromium ]]; then install_packages chromium; else install_one "$id"; fi
}

web_install() { # web_install <id> <name> <url>
  local file=$webapps/$DISTRO_ID-web-$1.desktop browser
  browser=$(web_browser); ensure_browser "$browser"
  mkdir -p "$webapps"
  cat > "$file" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$2
Comment=$2 in its own window
Exec=${browser%%|*} --app=$3 --class=$DISTRO_ID-web-$1 --user-data-dir=${XDG_CONFIG_HOME:-$HOME/.config}/$DISTRO_ID/webapps/$1
Icon=applications-internet
StartupWMClass=$DISTRO_ID-web-$1
Categories=Network;
DESKTOP
  info "added $2 to the launcher"
}

# Apps that send usage data by default get it turned off when installed
# through the catalog; the user can turn it back on in
# the app. Only adds the setting; never rewrites a settings file it can't parse.
json_setting_defaults() { # json_setting_defaults <file> <jq object of defaults>
  local file=$1 tmp
  mkdir -p "${file%/*}"
  if [[ ! -s $file ]]; then printf '%s\n' "$2" | jq . > "$file"; return; fi
  tmp=$(mktemp)
  if jq --argjson d "$2" '$d * .' "$file" > "$tmp" 2>/dev/null; then mv "$tmp" "$file"
  else rm -f "$tmp"; info "note: couldn't update $file (comments?); turn telemetry off in the app's settings"; fi
}

app_privacy_defaults() { # app_privacy_defaults <id>
  local config=${XDG_CONFIG_HOME:-$HOME/.config}
  case $1 in
    vscode) json_setting_defaults "$config/Code/User/settings.json" '{"telemetry.telemetryLevel":"off","workbench.enableExperiments":false,"workbench.settings.enableNaturalLanguageSearch":false}' ;;
    code) json_setting_defaults "$config/Code - OSS/User/settings.json" '{"telemetry.telemetryLevel":"off","workbench.enableExperiments":false}' ;;
    zed) json_setting_defaults "$config/zed/settings.json" '{"telemetry":{"diagnostics":false,"metrics":false}}' ;;
  esac
}

install_one() {
  local r id cat name src target note pkgs
  r=$(row "$1") || true
  [[ -n $r ]] || die "unknown app: $1 (see: $DISTRO_ID app search <word>)"
  IFS='|' read -r id cat name src target note <<<"$r"
  if is_installed "$id" "$src" "$target"; then info "$name is already installed"; return; fi
  info "installing $name"
  case $src in
    repo|gpu) read -ra pkgs <<<"$(packages_for "$src" "$target")"; install_packages "${pkgs[@]}" ;;
    multilib) enable_multilib; read -ra pkgs <<<"$target"; install_packages "${pkgs[@]}" "$(lib32_driver)" ;;
    aur) read -ra pkgs <<<"$target"; aur_install "${pkgs[@]}" ;;
    web) web_install "$id" "$name" "$target" ;;
    agent) "/usr/bin/$DISTRO_ID" agent install "$target" ;;
    mise) "/usr/bin/$DISTRO_ID" dev lang "$target" ;;
    dev)
      case $target in
        docker) "/usr/bin/$DISTRO_ID" dev docker ;;
        db:*) "/usr/bin/$DISTRO_ID" dev db add "${target#db:}" ;;
        *) die "catalog: $id has an unknown dev target '$target'" ;;
      esac ;;
    *) die "catalog: $id has an unknown source '$src'" ;;
  esac
  app_privacy_defaults "$id"
}

remove_one() {
  local r id cat name src target note pkgs
  r=$(row "$1") || true
  [[ -n $r ]] || die "unknown app: $1"
  IFS='|' read -r id cat name src target note <<<"$r"
  case $src in
    web) rm -f "$webapps/$DISTRO_ID-web-$id.desktop"; info "removed $name from the launcher" ;;
    agent) die "coding agents are managed with: $DISTRO_ID agent" ;;
    mise) mise unuse -g "$target" ;;
    dev)
      case $target in
        db:*) "/usr/bin/$DISTRO_ID" dev db remove "${target#db:}" ;;
        *) read -ra pkgs <<<"docker docker-compose docker-buildx"
           if [[ -t 0 ]]; then pacman_tx "remove ${pkgs[*]}" -Rns "${pkgs[@]}"; else pkexec pacman -Rns --noconfirm "${pkgs[@]}"; fi ;;
      esac ;;
    *)
      read -ra pkgs <<<"$(packages_for "$src" "$target")"
      if [[ -t 0 ]]; then pacman_tx "remove ${pkgs[*]}" -Rns "${pkgs[@]}"; else pkexec pacman -Rns --noconfirm "${pkgs[@]}"; fi ;;
  esac
}

print_rows() { # stdin: rows
  local id cat name src target note last="" mark extra
  while IFS='|' read -r id cat name src target note; do
    if [[ $cat != "$last" ]]; then printf '\n%s\n' "$cat"; last=$cat; fi
    mark=" "; if is_installed "$id" "$src" "$target"; then mark="*"; fi
    extra=""
    if [[ -n $note ]]; then extra=" ($note)"; fi
    printf '  %s %-16s %s%s\n' "$mark" "$id" "$name" "$extra"
  done
}

# --- Moving to another computer: export and import --------------------------

# Settings worth carrying over. Nothing secret lives in the settings file, and
# only these keys are exported.
export_keys=(theme theme.mode terminal agent keyboard.layouts)

# Packages every install gets (the distro's lists), and hardware-specific ones
# that belong to this machine only.
default_packages() { sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$SHARE"/packages/*.packages 2>/dev/null; }
hardware_package() {
  [[ $1 =~ ^(nvidia.*|lib32-nvidia.*|vulkan-.*|lib32-vulkan-.*|lib32-mesa|mesa|intel-media-driver|libva-.*|egl-wayland|.*-ucode|linux|linux-.*|sof-firmware|alsa-firmware|.*-firmware.*)$ ]]
}

# The packages a catalog app installs (so they aren't listed twice).
catalog_packages() {
  local id cat name src target note
  while IFS='|' read -r id cat name src target note; do
    # shellcheck disable=SC2086 # several packages, space-separated
    case $src in repo|multilib|aur) printf '%s\n' $target ;; gpu) packages_for gpu "$target" ;; esac
  done < <(rows)
}

export_apps() {
  local id cat name src target note pkg value
  local -A skip=()
  while read -r pkg; do skip[$pkg]=1; done < <(default_packages; catalog_packages)
  printf '# %s app list: `%s app import <this file>` installs it on another computer.\n' "$DISTRO_NAME" "$DISTRO_ID"
  printf '# Exported %s. Hardware drivers are left out; the installer picks them per machine.\n' "$(date -I)"
  printf '\n[catalog]\n'
  while IFS='|' read -r id cat name src target note; do
    if [[ $note != default ]] && is_installed "$id" "$src" "$target"; then printf '%s\n' "$id"; fi
  done < <(rows)
  printf '\n[packages]\n'
  while read -r pkg; do
    if [[ -z ${skip[$pkg]:-} ]] && ! hardware_package "$pkg"; then printf '%s\n' "$pkg"; fi
  done < <(pacman -Qqen)
  printf '\n[aur]\n'
  while read -r pkg; do
    if [[ -z ${skip[$pkg]:-} && $pkg != "$DISTRO_ID"* ]] && ! hardware_package "$pkg"; then printf '%s\n' "$pkg"; fi
  done < <(pacman -Qqem)
  printf '\n[flatpak]\n'
  if command -v flatpak >/dev/null; then flatpak list --app --columns=application 2>/dev/null || true; fi
  printf '\n[settings]\n'
  for id in "${export_keys[@]}"; do
    value=$(setting "$id")
    if [[ -n $value ]]; then printf '%s = %s\n' "$id" "$value"; fi
  done
}

# Lines of one [section] of an exported list.
section() { # section <file> <name>
  awk -v s="[$2]" '/^\[/ { on = ($0 == s); next } on && NF && !/^#/' "$1"
}

import_apps() { # import_apps <file> [--dry-run] [--yes]
  local file=$1 dry=0 yes=0 arg app pkg key value r
  local -a catalog=() packages=() aur=() flatpaks=() settings=()
  shift
  for arg in "$@"; do
    case $arg in --dry-run) dry=1 ;; --yes) yes=1 ;; *) die "unknown option: $arg" ;; esac
  done
  [[ -f $file ]] || die "no such file: $file"
  while read -r app; do
    r=$(row "$app") || true
    if [[ -z $r ]]; then info "skipping unknown catalog app: $app"; continue; fi
    IFS='|' read -r _ _ _ src target _ <<<"$r"
    if ! is_installed "$app" "$src" "$target"; then catalog+=("$app"); fi
  done < <(section "$file" catalog)
  # The file may come from someone else: names only, never options.
  while read -r pkg; do
    if ! valid_pkg "$pkg"; then info "skipping \"$pkg\": not a package name"; continue; fi
    if ! pacman -Q -- "$pkg" >/dev/null 2>&1; then packages+=("$pkg"); fi
  done < <(section "$file" packages)
  while read -r pkg; do
    if ! valid_pkg "$pkg"; then info "skipping \"$pkg\": not a package name"; continue; fi
    if ! pacman -Q -- "$pkg" >/dev/null 2>&1; then aur+=("$pkg"); fi
  done < <(section "$file" aur)
  while read -r app; do
    if ! valid_app "$app"; then info "skipping \"$app\": not a Flatpak app id"; continue; fi
    if command -v flatpak >/dev/null && flatpak info "$app" >/dev/null 2>&1; then continue; fi
    flatpaks+=("$app")
  done < <(section "$file" flatpak)
  while IFS= read -r arg; do
    key=$(trim "${arg%%=*}") value=$(trim "${arg#*=}")
    if [[ " ${export_keys[*]} " == *" $key "* && $(setting "$key") != "$value" ]]; then settings+=("$key = $value"); fi
  done < <(section "$file" settings)

  info "From $file:"
  info "  catalog apps: ${catalog[*]:-(nothing new)}"
  info "  packages:     ${packages[*]:-(nothing new)}"
  info "  AUR:          ${aur[*]:-(nothing new)}"
  info "  Flatpak:      ${flatpaks[*]:-(nothing new)}"
  info "  settings:     $(IFS=';'; printf '%s' "${settings[*]:-(unchanged)}")"
  if (( dry )); then return 0; fi
  if (( ! yes )); then
    [[ -t 0 ]] || die "add --yes to import without asking"
    read -rp "Install and apply all of this? [y/N] " r
    [[ $r == [yY]* ]] || { info "Nothing changed."; return 0; }
  fi
  if (( ${#catalog[@]} )); then for app in "${catalog[@]}"; do install_one "$app"; done; fi
  if (( ${#packages[@]} )); then install_packages "${packages[@]}"; fi
  if (( ${#aur[@]} )); then aur_install "${aur[@]}"; fi
  if (( ${#flatpaks[@]} )); then
    if ! command -v flatpak >/dev/null; then install_packages flatpak; fi
    flatpak install -y --noninteractive flathub -- "${flatpaks[@]}"
  fi
  for arg in "${settings[@]}"; do
    key=${arg%% = *} value=${arg#* = }
    case $key in
      theme) "/usr/bin/$DISTRO_ID" theme set "$value" ;;
      theme.mode) "/usr/bin/$DISTRO_ID" theme mode "$value" ;;
      terminal) "/usr/bin/$DISTRO_ID" terminal set "$value" ;;
      agent) "/usr/bin/$DISTRO_ID" agent set "$value" ;;
      keyboard.layouts)
        for app in ${value//,/ }; do "/usr/bin/$DISTRO_ID" keyboard add "$app" || true; done ;;
    esac
  done
  info "Done."
}

case ${1:-} in
  web-browser)
    if [[ -z ${2:-} ]]; then setting app.web_browser chromium; exit 0; fi
    case $2 in chromium|edge|chrome) ;; *) die "web-browser: chromium, edge or chrome" ;; esac
    set_setting app.web_browser "$2"
    browser=$(web_browser); ensure_browser "$browser"
    # Web apps already added open in it too.
    for f in "$webapps/$DISTRO_ID"-web-*.desktop; do
      [[ -f $f ]] || continue
      sed -i -E "s#^Exec=(chromium|microsoft-edge-stable|google-chrome-stable) #Exec=${browser%%|*} #" "$f"
    done
    info "web apps open in: $2" ;;
  list)
    if [[ -n ${2:-} ]]; then rows | awk -F'|' -v c="$2" '$2 == c' | print_rows
    else rows | print_rows; fi ;;
  search)
    [[ -n ${2:-} ]] || die "search for what?"
    rows | grep -i -- "$2" | print_rows ;;
  install)
    shift; [[ $# -gt 0 ]] || die "install which app? see: $DISTRO_ID app list"
    for app in "$@"; do install_one "$app"; done ;;
  remove)
    shift; [[ $# -gt 0 ]] || die "remove which app?"
    for app in "$@"; do remove_one "$app"; done ;;
  export)
    if [[ -n ${2:-} ]]; then export_apps > "$2"; info "saved to $2"; else export_apps; fi ;;
  import)
    [[ -n ${2:-} ]] || die "import which file? (made by: $DISTRO_ID app export <file>)"
    shift; import_apps "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown app command: $1" ;;
esac
