#!/usr/bin/env bash
# summary: The menu (SUPER+Space): apps, keybinds, style, setup, capture, install, remove, update, system
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

# A panel of the utilities plugin (decision record 0043): a keyboard list
# drawn by the plugin. Type to filter (deeper items and apps included), Return
# opens, Backspace on an empty filter goes up, Ctrl+R starts over. Its items:
# $SHARE/default/menu/menu, or your copy in ~/.config/<id>/menu.

panel=$DISTRO_ID/utilities:menu
case ${1:-} in
  -h|--help)
    echo "Usage: $DISTRO_ID menu [item]    open or close the menu, or open it at an item (e.g. Capture, or \"Setup › Displays\")" ;;
  "") noctalia msg panel-toggle "$panel" >/dev/null ;;
  *) noctalia msg panel-open "$panel" "$*" >/dev/null ;;
esac
