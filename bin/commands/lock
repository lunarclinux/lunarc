#!/usr/bin/env bash
# summary: Lock the screen, with the screensaver playing behind the lock
set -uo pipefail
source "$DISTRO_LIB/lib.sh"

usage() {
  cat <<USAGE
Usage: $DISTRO_ID lock [--idle | watch]

  (none)    lock now: the screensaver plays behind the lock; start typing your
            password to unlock
  --idle    the idle timer's lock (the same lock)
  watch     lock before the computer sleeps (runs as a user service)

The lock is swaylock-plugin running the screensaver through windowtolayer.
If it can't lock, Noctalia's lock screen takes over; lock.style = noctalia in
~/.config/$DISTRO_ID/settings always uses Noctalia's. If the lock ever hangs,
CTRL+ALT+L restarts it.
USAGE
}

# One colour from the active theme, as rrggbb.
colour() {
  local palette c=""
  palette=$SHARE/themes/$(setting theme)/palette.json
  if [[ -f $palette ]]; then
    c=$(jq -r --arg m "$(setting theme.mode dark)" --arg k "$1" '.[$m][$k] // empty' "$palette" | tr -d '#')
  fi
  printf '%s\n' "${c:-$2}"
}

# The screensaver lock. --daemonize makes swaylock-plugin return only once the
# compositor has confirmed the session lock, so exit status 0 means locked.
# No --grace: in swaylock-plugin 1.8.7 ending a grace period early (SIGUSR2,
# or its sleep watcher) left the locker spinning and no longer checking
# passwords, so every lock asks for the password.
screensaver_lock() {
  if ! command -v swaylock-plugin >/dev/null || ! command -v windowtolayer >/dev/null; then return 1; fi
  local gold text night violet wrong
  gold=$(colour mPrimary ebc77a) text=$(colour mOnSurface e6e2d6) night=$(colour mSurface 0b1020)
  violet=$(colour mSecondary 9c9bef) wrong=$(colour mError f28b82)

  # The screensaver's own terminal, one per screen, drawn as the lock background,
  # with the screensaver window's flags so it looks the same.
  local background="windowtolayer -- ghostty --class=$DISTRO_ID.lockscreen --gtk-single-instance=false \
--font-size=13 --window-padding-x=0 --window-padding-y=0 --cursor-style-blink=false \
--cursor-opacity=0 --confirm-close-surface=false --background-opacity=1 --scrollbar=never \
--quit-after-last-window-closed=true -e /usr/bin/$DISTRO_ID screensaver run --lock"

  local args=(
    --daemonize
    --command-each "$background"
    --ignore-empty-password
    --show-failed-attempts
    # The password box (or ring) appears with the first key and fades back to
    # the screensaver, with one line under it saying what the lock expects (our
    # swaylock-plugin patches); nothing static is drawn on the screensaver.
    --hint-text "Type your password · Enter to unlock · Esc clears"
    --hint-color "$text"
    --font "Inter" --font-size 22
    --indicator-radius 110 --indicator-thickness 9
    --indicator-caps-lock
    # Solid, so the box stays readable over busy screensaver effects.
    --inside-color "${night}ff" --inside-clear-color "${night}ff" --inside-ver-color "${night}ff"
    --inside-wrong-color "${night}ff" --inside-caps-lock-color "${night}ff"
    --ring-color "$gold" --ring-clear-color "$violet" --ring-ver-color "$text"
    --ring-wrong-color "$wrong" --ring-caps-lock-color "$gold"
    --key-hl-color "$text" --bs-hl-color "$wrong" --caps-lock-key-hl-color "$text"
    --caps-lock-bs-hl-color "$wrong"
    --line-color 00000000 --line-clear-color 00000000 --line-ver-color 00000000
    --line-wrong-color 00000000 --line-caps-lock-color 00000000 --separator-color 00000000
    --text-color "$text" --text-clear-color "$text" --text-ver-color "$text"
    --text-wrong-color "$wrong" --text-caps-lock-color "$gold"
    --layout-bg-color "${night}ff" --layout-border-color 00000000 --layout-text-color "$text"
  )
  # A password box instead of the ring (our swaylock-plugin patch); setting
  # lock.indicator = ring keeps the ring. Only passed when the installed
  # swaylock-plugin knows the option, so a half-finished update still locks.
  # (--help exits 1, so read its text rather than piping it under pipefail.)
  local help
  help=$(swaylock-plugin --help 2>&1 || true)
  if [[ $(setting lock.indicator box) == box && $help == *--indicator-style* ]]; then
    args+=(--indicator-style box)
  fi
  timeout 10 swaylock-plugin "${args[@]}" >/dev/null 2>&1
}

# The locker that confirmed the current lock. Written only after swaylock-plugin
# reported the lock as engaged, so a locker that never locked is never trusted.
state=${XDG_RUNTIME_DIR:-/run/user/$UID}/$DISTRO_ID-lock.pid
locked_by_us() {
  local pid
  pid=$(cat "$state" 2>/dev/null) || return 1
  if [[ $pid =~ ^[0-9]+$ && $(ps -o comm= -p "$pid" 2>/dev/null) == swaylock-plugin ]]; then return 0; fi
  return 1
}

# Lock-screen terminals left behind by a lock that crashed (no windowtolayer
# above them any more).
clear_leftovers() {
  local pid parent
  for pid in $(pgrep -f -- "--class=${DISTRO_ID}[.]lockscreen"); do
    parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    if [[ -n $parent && $(ps -o comm= -p "$parent" 2>/dev/null) != windowtolayer ]]; then
      kill "$pid" 2>/dev/null
    fi
  done
}

# Lock, falling back until something is locked; never return quietly unlocked.
lock_now() {
  # Already locked by a confirmed locker that is still running: nothing to do
  # (a second locker would be refused, or stack a second password prompt).
  if locked_by_us; then return 0; fi
  clear_leftovers
  if [[ $(setting lock.style screensaver) != noctalia ]] && screensaver_lock; then
    # --daemonize forks: the newest swaylock-plugin is the locker itself.
    pgrep -n -x swaylock-plugin > "$state"
    return 0
  fi
  # Every step is time-limited: a hung shell or notification daemon must not
  # leave this waiting instead of reaching the next fallback.
  if timeout 5 noctalia msg session lock >/dev/null 2>&1; then return 0; fi
  timeout 5 loginctl lock-session 2>/dev/null
  timeout 5 notify-send -u critical -a "$DISTRO_NAME" "Couldn't lock the screen" \
    "Neither lock screen started. Lock again with SUPER+L, or log out." 2>/dev/null
  return 1
}

# Lock before sleep: hold a "delay" inhibitor so logind waits for us, lock when
# it announces sleep, and only then let it go; take it again after resume.
watch() {
  local inhibitor=0 line
  inhibit() {
    systemd-inhibit --what=sleep --mode=delay --who="$DISTRO_NAME lock" \
      --why="Lock the screen before sleeping" sleep infinity &
    inhibitor=$!
  }
  coproc logind { exec gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1; }
  inhibit
  while read -r line <&"${logind[0]}"; do
    case $line in
      *"PrepareForSleep (true"*)
        lock_now || true
        # Ending its child ends systemd-inhibit, which releases the inhibitor.
        pkill -P "$inhibitor" 2>/dev/null || true ;;
      *"PrepareForSleep (false"*)
        inhibit ;;
    esac
  done
}

case ${1:-} in
  watch) watch ;;
  --idle|"") lock_now ;;
  -h|--help) usage ;;
  *) die "unknown lock option: $1" ;;
esac
