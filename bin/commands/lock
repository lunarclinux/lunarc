#!/usr/bin/env bash
# summary: Lock the screen, with the screensaver playing behind the lock
set -uo pipefail
source "$DISTRO_LIB/lib.sh"

usage() {
  cat <<USAGE
Usage: $DISTRO_ID lock [--idle | watch]

  (none)    lock now: the screensaver plays behind the lock; start typing your
            password to unlock
  --idle    the idle timer's lock (the same lock)
  background  the lock screen's screensaver terminal (started by the lock itself)
  watch     lock before the computer sleeps (runs as a user service)

The lock is swaylock-plugin running the screensaver through windowtolayer.
If it can't lock, Noctalia's lock screen takes over; lock.style = noctalia in
~/.config/$DISTRO_ID/settings always uses Noctalia's. If the lock ever hangs,
CTRL+ALT+L restarts it.
USAGE
}

# One colour from the theme's design tokens (`$DISTRO_ID theme token`), as
# swaylock's rrggbbaa; the fallback (Moonlit's) when there are no tokens.
colour() { # colour <token path> <fallback rrggbbaa>
  local v r g b a=ff
  v=$(token "$1" 2>/dev/null) || v=""
  if [[ $v =~ ^#([0-9a-fA-F]{6})$ ]]; then
    v=${BASH_REMATCH[1]}
  elif [[ $v =~ ^rgba\(\ *([0-9]+)\ *,\ *([0-9]+)\ *,\ *([0-9]+)\ *,\ *([0-9.]+)\ *\)$ ]]; then
    r=${BASH_REMATCH[1]} g=${BASH_REMATCH[2]} b=${BASH_REMATCH[3]}
    a=$(awk -v a="${BASH_REMATCH[4]}" 'BEGIN { printf "%02x", a * 255 + 0.5 }')
    v=$(printf '%02x%02x%02x' "$r" "$g" "$b")
  else
    printf '%s\n' "$2"; return
  fi
  printf '%s%s\n' "${v,,}" "$a"
}

# The screensaver lock. --daemonize makes swaylock-plugin return only once the
# compositor has confirmed the session lock, so exit status 0 means locked.
# No --grace: in swaylock-plugin 1.8.7 ending a grace period early (SIGUSR2,
# or its sleep watcher) left the locker spinning and no longer checking
# passwords, so every lock asks for the password.
screensaver_lock() {
  if ! command -v swaylock-plugin >/dev/null || ! command -v windowtolayer >/dev/null; then return 1; fi
  local amber text body muted night coral violet hairline
  amber=$(colour color.accent.amber ebc77aff) text=$(colour color.text.primary e6e2d6ff)
  body=$(colour color.text.secondary c9c5b9ff) muted=$(colour color.text.muted b4bbd0ff)
  night=$(colour color.bg.deep 070b17ff) coral=$(colour color.signal.coral f0a39aff)
  violet=$(colour color.signal.violet a9a8f2ff) hairline=$(colour color.border.hairline e6e2d621)

  # The screensaver's own terminal, one per screen, drawn as the lock
  # background (`lock background`, which stops retrying a terminal that keeps
  # crashing; the lock then shows the theme's night colour).
  local background="/usr/bin/$DISTRO_ID lock background"
  rm -f "$bg_fails"

  local args=(
    --daemonize
    --command-each "$background"
    --color "${night:0:6}ff"
    --ignore-empty-password
    --show-failed-attempts
    --font "Geist Mono"
    --indicator-caps-lock
    --key-hl-color "$text" --bs-hl-color "$coral" --caps-lock-key-hl-color "$amber"
    --caps-lock-bs-hl-color "$coral"
    --text-clear-color "$text" --text-ver-color "$text"
    --text-wrong-color "$coral" --text-caps-lock-color "$amber"
    --layout-bg-color "${night:0:6}ff" --layout-border-color 00000000 --layout-text-color "$text"
  )
  # The password prompt in a pill (our swaylock-plugin patch) over the
  # screensaver, `user@host password:` and a row of dots, one lit at random
  # per key (never the count). It shows for 3 s at lock and fades out over
  # 1.5 s, leaving the screensaver alone; any key brings it back at once, and
  # it fades again 5 s after the last key (it stays while the password is
  # checked; a wrong password shows 3 s first). Setting lock.indicator = ring
  # keeps the ring, which appears with the first key. Each is only used when
  # the installed swaylock-plugin knows its options, so a half-finished
  # update still locks; one without the timings keeps the pill always shown.
  # (--help exits 1, so read its text rather than piping it under pipefail.)
  local help
  help=$(swaylock-plugin --help 2>&1 || true)
  if [[ $(setting lock.indicator box) == box && $help == *--prompt-text* ]]; then
    args+=(--indicator-style box --indicator-idle-visible)
    if [[ $help == *--indicator-linger* ]]; then
      args+=(--indicator-idle-show 3000 --indicator-linger 5000 --indicator-fade 1500)
    fi
    args+=(
      --prompt-text "${USER:-$(id -un)}@$(uname -n)" --prompt-color "$amber"
      --hint-text "Enter to unlock · Esc clears" --hint-color "$body"
      --font-size 15
      # Translucent like the design's pill (the screensaver shows through);
      # border, top highlight and text by state.
      --inside-color "${night:0:6}b8" --inside-clear-color "${night:0:6}b8" --inside-ver-color "${night:0:6}b8"
      --inside-wrong-color "${night:0:6}b8" --inside-caps-lock-color "${night:0:6}b8"
      --ring-color "$hairline" --ring-clear-color "${violet:0:6}99" --ring-ver-color "$hairline"
      --ring-wrong-color "$coral" --ring-caps-lock-color "${amber:0:6}99"
      --line-color "${amber:0:6}80" --line-clear-color "${violet:0:6}80" --line-ver-color "${amber:0:6}80"
      --line-wrong-color "${coral:0:6}80" --line-caps-lock-color "${amber:0:6}80"
      --text-color "$muted"
    )
  else
    args+=(
      --hint-text "Type your password · Enter to unlock · Esc clears" --hint-color "$text"
      --font-size 22 --indicator-radius 110 --indicator-thickness 9
      # Solid, so the ring stays readable over busy screensaver effects.
      --inside-color "${night:0:6}ff" --inside-clear-color "${night:0:6}ff" --inside-ver-color "${night:0:6}ff"
      --inside-wrong-color "${night:0:6}ff" --inside-caps-lock-color "${night:0:6}ff"
      --ring-color "$amber" --ring-clear-color "$violet" --ring-ver-color "$text"
      --ring-wrong-color "$coral" --ring-caps-lock-color "$amber"
      --line-color 00000000 --line-clear-color 00000000 --line-ver-color 00000000
      --line-wrong-color 00000000 --line-caps-lock-color 00000000 --separator-color 00000000
      --text-color "$text"
    )
  fi
  timeout 10 swaylock-plugin "${args[@]}" >/dev/null 2>&1
}

# The lock's background, one per screen: the screensaver in a terminal with
# the screensaver window's flags, so it looks the same. swaylock-plugin starts
# it again when it ends; a terminal that crashes at once twice in one lock
# (Ghostty 1.4.0 did, inside the lock's own display server) isn't started a
# third time, and the lock keeps its plain night-coloured background.
bg_fails=${XDG_RUNTIME_DIR:-/run/user/$UID}/$DISTRO_ID-lock-background-fails
lock_background() {
  local fails started rc
  fails=$(cat "$bg_fails" 2>/dev/null) || fails=0
  [[ $fails =~ ^[0-9]+$ ]] || fails=0
  if (( fails >= 2 )); then exec sleep infinity; fi
  started=$(date +%s)
  windowtolayer -- ghostty --class="$DISTRO_ID.lockscreen" --gtk-single-instance=false \
    --font-size=13 --window-padding-x=0 --window-padding-y=0 --cursor-style-blink=false \
    --cursor-opacity=0 --confirm-close-surface=false --background-opacity=1 --scrollbar=never \
    --quit-after-last-window-closed=true -e "/usr/bin/$DISTRO_ID" screensaver run --lock
  rc=$?
  # Ended within seconds of starting: a crash. windowtolayer exits 0 even when
  # the terminal under it crashed, so the exit code can't tell; any quick end
  # counts. An unlock that soon also counts, but that lock is over, and each
  # new lock starts counting again.
  if (( $(date +%s) - started < 15 )); then
    printf '%s\n' "$(( fails + 1 ))" > "$bg_fails"
  fi
  exit "$rc"
}

# The locker that confirmed the current lock. Written only after swaylock-plugin
# reported the lock as engaged, so a locker that never locked is never trusted.
state=${XDG_RUNTIME_DIR:-/run/user/$UID}/$DISTRO_ID-lock.pid
locked_by_us() {
  local pid
  pid=$(cat "$state" 2>/dev/null) || return 1
  if [[ $pid =~ ^[0-9]+$ && $(ps -o comm= -p "$pid" 2>/dev/null) == swaylock-plugin ]]; then return 0; fi
  return 1
}

# Lock-screen terminals left behind by a lock that crashed (no windowtolayer
# above them any more).
clear_leftovers() {
  local pid parent
  for pid in $(pgrep -f -- "--class=${DISTRO_ID}[.]lockscreen"); do
    parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    if [[ -n $parent && $(ps -o comm= -p "$parent" 2>/dev/null) != windowtolayer ]]; then
      kill "$pid" 2>/dev/null
    fi
  done
}

# Lock, falling back until something is locked; never return quietly unlocked.
lock_now() {
  # Already locked by a confirmed locker that is still running: nothing to do
  # (a second locker would be refused, or stack a second password prompt).
  if locked_by_us; then return 0; fi
  clear_leftovers
  if [[ $(setting lock.style screensaver) != noctalia ]] && screensaver_lock; then
    # --daemonize forks: the newest swaylock-plugin is the locker itself.
    pgrep -n -x swaylock-plugin > "$state"
    return 0
  fi
  # Every step is time-limited: a hung shell or notification daemon must not
  # leave this waiting instead of reaching the next fallback.
  if timeout 5 noctalia msg session lock >/dev/null 2>&1; then return 0; fi
  timeout 5 loginctl lock-session 2>/dev/null
  timeout 5 notify-send -u critical -a "$DISTRO_NAME" "Couldn't lock the screen" \
    "Neither lock screen started. Lock again with SUPER+L, or log out." 2>/dev/null
  return 1
}

# Lock before sleep: hold a "delay" inhibitor so logind waits for us, lock when
# it announces sleep, and only then let it go; take it again after resume.
watch() {
  local inhibitor=0 line
  inhibit() {
    systemd-inhibit --what=sleep --mode=delay --who="$DISTRO_NAME lock" \
      --why="Lock the screen before sleeping" sleep infinity &
    inhibitor=$!
  }
  coproc logind { exec gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1; }
  inhibit
  while read -r line <&"${logind[0]}"; do
    case $line in
      *"PrepareForSleep (true"*)
        lock_now || true
        # Ending its child ends systemd-inhibit, which releases the inhibitor.
        pkill -P "$inhibitor" 2>/dev/null || true ;;
      *"PrepareForSleep (false"*)
        inhibit ;;
    esac
  done
}

case ${1:-} in
  watch) watch ;;
  --idle|"") lock_now ;;
  background) lock_background ;;
  -h|--help) usage ;;
  *) die "unknown lock option: $1" ;;
esac
