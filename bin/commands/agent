#!/usr/bin/env bash
# summary: Choose, install and open an AI coding agent
set -euo pipefail
source "$DISTRO_LIB/lib.sh"

# name | command | install (pkg:<package>) | interactive with prompt | one-shot, read-only | interactive, read-only
# One-shot runs happen unattended (background crash diagnosis), so they must not
# be able to change anything: "-" means the agent has no mode we trust for that.
# The read-only interactive mode is for prompts built from untrusted text (crash
# captures hold whatever the crashed program printed): the agent can read and
# explain, and asks before running or changing anything.
known=(
  "claude|claude|pkg:claude-code|claude {}|claude -p --permission-mode plan {}|claude --permission-mode plan {}"
  "codex|codex|pkg:openai-codex|codex {}|codex exec --sandbox read-only {}|codex --sandbox read-only {}"
  "gemini|gemini|pkg:gemini-cli|gemini -i {}|gemini --approval-mode default -p {}|gemini --approval-mode default -i {}"
  "opencode|opencode|pkg:opencode|opencode --prompt {}|-|-"
)
row() { local r; for r in "${known[@]}"; do [[ ${r%%|*} == "$1" ]] && { echo "$r"; return; }; done; return 1; }
field() { cut -d'|' -f"$2" <<<"$(row "$1")"; }
# Earlier installs of Claude Code (its own installer) put the command in ~/.local/bin.
find_cmd() { command -v "$1" 2>/dev/null || { [[ -x $HOME/.local/bin/$1 ]] && echo "$HOME/.local/bin/$1"; }; }
current() { setting agent claude; }

usage() {
  cat <<USAGE
Usage: $DISTRO_ID agent <command>

  list                    agents this distro knows about, and which are installed
  current                 the default agent
  set <name>              make <name> the default (installs it first if needed)
  install <name>          install <name>
  launch                  open the default agent in a terminal
  prompt <text>           open the default agent in a terminal, starting with <text>
  usage [--json]          tokens per day and per model over the last week, and plan limits where the agent records them
  run [--headless] [--read-only] [--cwd DIR] -- <prompt>
                          run the default agent here (headless prints the answer and exits;
                          read-only asks before running or changing anything)
USAGE
}

install_agent() {
  local how; how=$(field "$1" 3) || die "unknown agent: $1"
  # Only packages: never a downloaded script run through a shell (decision record 0048).
  install_packages "${how#pkg:}"
}

# Usage records, one JSON object per line (see agent-usage.jq for the shape).
claude_records() {
  local dir=$HOME/.claude/projects
  [[ -d $dir ]] || return 0
  find "$dir" -name '*.jsonl' -mtime -8 -print0 | xargs -0r grep -h '"usage"' 2>/dev/null \
    | jq -c 'select(.type == "assistant" and .message.usage) | .message.usage as $u | {
        agent: "claude", id: (.message.id // .uuid), session: .sessionId, model: (.message.model // "unknown"),
        t: (.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601),
        tokens: (($u.input_tokens // 0) + ($u.output_tokens // 0) + ($u.cache_creation_input_tokens // 0)),
        cache_read: ($u.cache_read_input_tokens // 0) }' 2>/dev/null || true
}

# Codex writes token_count events (with rate limits) into its session logs.
# Not yet verified against a real Codex install.
codex_records() {
  local dir=$HOME/.codex/sessions file
  [[ -d $dir ]] || return 0
  while IFS= read -r -d '' file; do
    jq -c -s --arg f "$file" '
      (map(select(.type == "turn_context") | .payload.model) | first // "unknown") as $model
      | .[] | select(.payload.type? == "token_count")
      | (.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $t
      | ( .payload.info.last_token_usage // empty
          | { agent: "codex", id: ($f + ($t | tostring)), session: $f, model: $model, t: $t,
              tokens: ((.input_tokens // 0) - (.cached_input_tokens // 0) + (.output_tokens // 0)),
              cache_read: (.cached_input_tokens // 0) } ),
        ( (.payload.rate_limits // {}) | to_entries[] | select(.value.used_percent? != null)
          | { agent: "codex",
              limit: { label: (if .key == "primary" then "Session" elif .key == "secondary" then "Week" else .key end),
                       used_percent: .value.used_percent,
                       resets_at: (.value.resets_at // (if .value.resets_in_seconds then $t + .value.resets_in_seconds else null end)) } } )
    ' "$file" 2>/dev/null || true
  done < <(find "$dir" -name '*.jsonl' -mtime -8 -print0)
}

usage_json() {
  { claude_records; codex_records; } | jq -n --argjson days 7 --argjson now "$(date +%s)" -f "$DISTRO_LIB/agent-usage.jq"
}

case ${1:-} in
  usage)
    if [[ ${2:-} == --json ]]; then usage_json
    else
      usage_json | jq -r '.agents[] | "\(.name): today \(.today.tokens) tokens, \(.today.messages) messages, \(.today.sessions) sessions",
        (.limits[] | "  \(.label): \(.used_percent)% used"),
        (.days[] | "  \(.date)  \(.tokens)"),
        (.models[] | "  \(.model): \(.tokens)")'
    fi ;;
  list)
    cur=$(current)
    for r in "${known[@]}"; do
      name=${r%%|*}; mark=" "; [[ $name == "$cur" ]] && mark="*"
      state="not installed"; [[ -n $(find_cmd "$(field "$name" 2)") ]] && state="installed"
      printf '%s %-10s %s\n' "$mark" "$name" "$state"
    done ;;
  current) current ;;
  install) [[ -n ${2:-} ]] || die "which agent? see '$DISTRO_ID agent list'"; install_agent "$2" ;;
  set)
    [[ -n ${2:-} ]] || die "which agent? see '$DISTRO_ID agent list'"
    row "$2" >/dev/null || die "unknown agent: $2"
    [[ -n $(find_cmd "$(field "$2" 2)") ]] || install_agent "$2"
    set_setting agent "$2"; info "default agent: $2" ;;
  launch) exec "/usr/bin/$DISTRO_ID" terminal launch -- "/usr/bin/$DISTRO_ID" agent run -- "" ;;
  prompt) shift; exec "/usr/bin/$DISTRO_ID" terminal launch -- "/usr/bin/$DISTRO_ID" agent run -- "$*" ;;
  run)
    shift; headless=0 read_only=0 cwd=$HOME
    while [[ $# -gt 0 ]]; do
      case $1 in
        --headless) headless=1; shift ;; --read-only) read_only=1; shift ;;
        --cwd) cwd=$2; shift 2 ;; --) shift; break ;; *) break ;;
      esac
    done
    prompt=${*:-}
    name=$(current); cmd=$(find_cmd "$(field "$name" 2)")
    if [[ -z $cmd ]]; then
      (( headless )) && die "$name is not installed; run '$DISTRO_ID agent install $name'"
      read -rp "$name is not installed. Install it now? [Y/n] " yn
      [[ ${yn,,} == n* ]] && exit 1
      install_agent "$name"; cmd=$(find_cmd "$(field "$name" 2)") || die "install failed"
    fi
    template=$(field "$name" $(( headless ? 5 : read_only ? 6 : 4 )))
    if [[ $template == "-" ]]; then
      (( headless )) && die "$name has no read-only one-shot mode; use crash.diagnose_all = terminal"
      die "$name has no read-only mode; choose another agent for this ($DISTRO_ID agent set <name>)"
    fi
    read -ra parts <<<"$template"
    argv=("$cmd")
    for p in "${parts[@]:1}"; do
      if [[ $p == "{}" ]]; then [[ -n $prompt ]] && argv+=("$prompt"); else argv+=("$p"); fi
    done
    # An interactive agent opened with no prompt shouldn't get the prompt flag.
    if [[ -z $prompt && $headless == 0 ]]; then argv=("$cmd"); fi
    cd "$cwd"
    exec "${argv[@]}" ;;
  -h|--help|"") usage ;;
  *) die "unknown agent command: $1" ;;
esac
