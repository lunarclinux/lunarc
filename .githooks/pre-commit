#!/usr/bin/env bash
# Blocks commits that
#   1. write the distro name anywhere except distro.conf, or
#   2. match a local list of blocked references (one extended regex in
#      .git/info/blocked-references, not committed; skipped without it), or
#   3. contain a private key block.
# The public text (docs/, site/, .github/, README.md, SECURITY.md, CONTRIBUTING.md,
# THIRD-PARTY-NOTICES.md) is exempt from both. Run `git config core.hooksPath .githooks` once after cloning.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
# shellcheck source=/dev/null
source "$root/distro.conf"

blocked=$(cat "$(git rev-parse --git-common-dir)/info/blocked-references" 2>/dev/null || true)
names="\\b(${DISTRO_ID}|${DISTRO_REPO}|${DISTRO_NAME})\\b"

fail=0
while IFS= read -r -d '' file; do
  case "$file" in
    distro.conf|docs/*|site/*|.github/*|SECURITY.md|CONTRIBUTING.md|README.md|THIRD-PARTY-NOTICES.md|.githooks/*|tools/lint) continue ;;
  esac
  added=$(git diff --cached -U0 -- "$file" | grep -E '^\+[^+]' || true)
  checks=("$file" "$added")
  for text in "${checks[@]}"; do
    if [[ -n $blocked ]] && grep -qiE "$blocked" <<<"$text"; then
      echo "pre-commit: $file mentions a blocked reference." >&2
      fail=1
      break
    fi
    if grep -q "PRIVATE KEY BLOCK" <<<"$text"; then
      echo "pre-commit: $file contains a private key; keys never go in the repo." >&2
      fail=1
      break
    fi
    if grep -qE "$names" <<<"$text"; then
      echo "pre-commit: $file writes the distro name literally; read it from distro.conf." >&2
      fail=1
      break
    fi
  done
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

exit "$fail"
