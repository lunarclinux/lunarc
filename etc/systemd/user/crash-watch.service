# Follows systemd-coredump's reports for this user and files each crash in the
# crash list (see `@DISTRO_ID@ crash --help`).
[Unit]
Description=Crash watcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/@DISTRO_ID@ crash watch
# Capturing a crash must not look up debug symbols online (that would tell a
# server which programs crashed); diagnosing one, which the user starts, may.
Environment=DEBUGINFOD_URLS=
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
