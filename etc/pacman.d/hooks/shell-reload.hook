# After an update of the distro package, reload the Noctalia shell once for
# everyone logged in, so new plugin code applies without a popup per file.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = @DISTRO_ID@

[Action]
Description = Reloading the desktop shell...
When = PostTransaction
Exec = /usr/lib/@DISTRO_ID@/shell-reload
