# After an update of the distro package, make it take effect for everyone
# logged in: start new session services, restart our watchers on the new code,
# apply user migrations, and reload the Noctalia shell once.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = @DISTRO_ID@

[Action]
Description = Applying the update to logged-in desktops...
When = PostTransaction
Exec = /usr/lib/@DISTRO_ID@/shell-reload
