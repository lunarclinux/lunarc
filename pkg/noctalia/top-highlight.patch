+const SurfaceFinish& Box::globalSurfaceFinish() noexcept { return g_surfaceFinish; }
+
+void Box::setSurfaceFinish(bool enabled) {
+  if (enabled == m_finish) {
+    return;
+  }
+  m_finish = enabled;
+  if (enabled) {
+    m_sheen = static_cast<RectNode*>(addChild(std::make_unique<RectNode>()));
+    m_highlight = static_cast<RectNode*>(addChild(std::make_unique<RectNode>()));
+    m_finishConn = surfaceFinishChanged().connect([this] { syncFinish(); });
+  }
+  syncFinish();
+}
+
+// Both layers copy the box's shape. The sheen is a vertical gradient over the
+// whole box; the highlight is a gradient that is opaque only for the 1px row
+// just inside the border (the shape clips it to the corners).
+void Box::syncFinish() {
+  if (m_sheen == nullptr || m_highlight == nullptr) {
+    return;
+  }
+  const auto& finish = g_surfaceFinish;
+  const float w = width();
+  const float h = height();
+  const bool showSheen = m_finish && finish.sheen && w > 0.0F && h > 0.0F;
+  const bool showHighlight = m_finish && finish.highlight && w > 0.0F && h > 2.0F;
+  m_sheen->setVisible(showSheen);
+  m_highlight->setVisible(showHighlight);
+
+  RoundedRectStyle layer = m_style;
+  layer.border = clearColor();
+  layer.borderWidth = 0.0F;
+  layer.fillMode = FillMode::LinearGradient;
+  layer.gradientDirection = GradientDirection::Vertical;
+  layer.invertFill = false;
+  layer.outerShadow = false;
+  layer.shadowExclusion = false;
+
+  if (showSheen) {
+    const Color top = resolveColorSpec(finish.sheenTop);
+    const Color bottom = resolveColorSpec(finish.sheenBottom);
+    layer.fill = top;
+    layer.gradientStops = {GradientStop{0.0F, top}, GradientStop{0.0F, top}, GradientStop{1.0F, bottom},
+                           GradientStop{1.0F, bottom}};
+    m_sheen->setFrameSize(w, h);
+    m_sheen->setStyle(layer);
+  }
+  if (showHighlight) {
+    const Color line = resolveColorSpec(finish.highlightColor);
+    const Color clear = rgba(line.r, line.g, line.b, 0.0F);
+    const float inset = m_style.border.a > 0.0F ? std::max(0.0F, m_style.borderWidth) : 0.0F;
+    const float from = std::clamp(inset / h, 0.0F, 1.0F);
+    const float to = std::clamp((inset + 1.0F) / h, 0.0F, 1.0F);
+    layer.fill = line;
+    layer.gradientStops = {GradientStop{from, clear}, GradientStop{from, line}, GradientStop{to, line},
+                           GradientStop{to, clear}};
+    m_highlight->setFrameSize(w, h);
+    m_highlight->setStyle(layer);
+  }
 }
 
