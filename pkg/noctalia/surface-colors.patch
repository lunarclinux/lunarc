+  struct Overrides {
+    std::optional<ColorSpec> cardFill;
+    std::optional<ColorSpec> cardBorder;
+    std::optional<ColorSpec> buttonFill;
+    std::optional<ColorSpec> buttonBorder;
+  };
+  [[nodiscard]] const Overrides& overrides() noexcept;
+  void setOverrides(const Overrides& o);
+} // namespace surface_colors
