+  // noctalia.notificationHistory(): the history, oldest first, or an empty list before it's loaded.
+  int luau_notificationHistory(lua_State* L) {
+    auto* host = hostForState(L);
+    const auto history = host == nullptr ? nullptr : host->api().notificationHistory();
+    const int count = history == nullptr ? 0 : static_cast<int>(history->size());
+    lua_createtable(L, count, 0);
+    if (history == nullptr) {
+      return 1;
+    }
+    int index = 1;
+    for (const auto& n : *history) {
+      lua_createtable(L, 0, 8);
+      setTableNumber(L, "id", static_cast<double>(n.id));
+      setTableString(L, "appName", n.appName);
+      setTableString(L, "desktopEntry", n.desktopEntry);
+      setTableString(L, "summary", n.summary);
+      setTableString(L, "body", n.body);
+      setTableString(L, "urgency", n.urgency);
+      setTableNumber(L, "receivedMs", n.receivedMs);
+      setTableBool(L, "active", n.active);
+      lua_rawseti(L, -2, index);
+      ++index;
+    }
+    return 1;
+  }
