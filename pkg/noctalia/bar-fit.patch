+// The widest visible single-line label that sets a maxWidth: the text the bar may shorten.
+Label* PluginWidget::widestFitLabel() const {
+  if (m_isVertical || m_uiHost == nullptr || !m_tree.has_value()) {
+    return nullptr;
+  }
+  Label* widest = nullptr;
+  std::vector<Node*> stack{m_uiHost};
+  while (!stack.empty()) {
+    Node* node = stack.back();
+    stack.pop_back();
+    if (!node->visible()) {
+      continue;
+    }
+    if (auto* label = dynamic_cast<Label*>(node);
+        label != nullptr && label->maxLines() == 1 && label->maxWidth() > 0.0F) {
+      if (widest == nullptr || label->width() > widest->width()) {
+        widest = label;
+      }
+    }
+    for (const auto& child : node->children()) {
+      stack.push_back(child.get());
+    }
+  }
+  return widest;
+}
+
+namespace {
+  // The single-line label with this text and a maxWidth in a render() tree: its maxWidth set.
+  bool shortenTreeLabel(ui::UiTreeNode& node, const std::string& text, double maxWidth) {
+    if (node.type == "label") {
+      const auto t = node.props.find("text");
+      const auto lines = node.props.find("maxLines");
+      if (t != node.props.end() && lines != node.props.end() && node.props.contains("maxWidth")
+          && std::get_if<std::string>(&t->second) != nullptr && *std::get_if<std::string>(&t->second) == text
+          && std::get_if<double>(&lines->second) != nullptr && *std::get_if<double>(&lines->second) == 1.0) {
+        node.props["maxWidth"] = maxWidth;
+        return true;
+      }
+    }
+    for (auto& child : node.children) {
+      if (shortenTreeLabel(child, text, maxWidth)) {
+        return true;
+      }
+    }
+    return false;
+  }
+} // namespace
+
+// Over the bar's limit (setFitMain): the most that label may take to fit, down to about six
+// characters; 0 when it already fits. The widget is then drawn from a copy of the script's tree
+// with that maxWidth; the next layout without a limit draws the script's own tree again.
+float PluginWidget::fitLabelWidth() const {
+  if (fitMain() <= 0.0F || m_uiHost == nullptr) {
+    return 0.0F;
+  }
+  const float excess = m_uiHost->width() - fitMain();
+  Label* widest = widestFitLabel();
+  if (excess <= 0.5F || widest == nullptr) {
+    return 0.0F;
+  }
+  const float least = widest->fontSize() * 4.0F;
+  if (widest->width() <= least) {
+    return 0.0F;
+  }
+  return std::max(least, widest->width() - excess);
+}
