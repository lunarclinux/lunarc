# The desktop shell (bar, launcher, panels, notifications, OSD, lock screen),
# built from the same release and checksum as Arch's own package, with four
# patches of ours (decision record 0043). Arch's PKGBUILD for 5.2.1-1 is the model: same
# source, dependencies, meson options and files.
#
# top-highlight.patch (ours, not sent upstream): Frosted Terminal's finish on
# the shell's surfaces. [shell] top_highlight draws a 1px line along the top
# inner edge of the bar, panels (attached, floating and plugin panels, the
# launcher among them), the OSD and notification toasts; [shell] surface_sheen
# lays a faint top-to-bottom gradient over them. Colours: top_highlight_color,
# sheen_top_color and sheen_bottom_color (default: primary at 32%, on_surface
# at 7% and 2%, so they follow the theme). Both are off unless configured.
#
# plugin-panel-frame.patch (ours): a plugin [[panel]] may set decoration =
# false; the host then draws no background, border, shadow or padding, and the
# panel's own tree is the whole surface (transparent where it draws nothing).
# The SUPER+Space menu uses it to draw the design's menu surface and to grow
# with its list inside a fixed-size panel.
#
# panel-border.patch (ours): [shell.panel] border_color sets the colour of the
# outline around floating panels (the control center, launcher, session menu,
# plugin panels); upstream it is always the outline role. The popovers use the
# theme's amber at 38% (Frosted Terminal's popover border).
#
# bar-fit.patch (ours): a bar's start lane wider than its slot (the centre's
# anchored clock leaves it less room) was cut off at the slot's edge, mid-glyph.
# Widgets that can shorten their text now do, the last first, each down to a
# few characters ending in an ellipsis: the window title (through its
# max_length) and a plugin's widest single-line label with a maxWidth. If that
# isn't enough they give way whole, the first first. Others are never changed,
# so only they can still be cut.
#
# epoch=1, so this build always counts as newer than Arch's noctalia: the
# distro's repository is listed after Arch's, and pacman takes a package from
# the first repository that has it, so with the same version Arch's would
# replace this one on the next update. With the epoch a plain `pacman -Syu`
# keeps ours ("local is newer than extra"), the distro package depends on this
# build's version (pkg/main reads it from here), which pulls it in on installs
# and updates, and `update` says when Arch has a newer Noctalia that waits for
# a rebuild here.
#
# A host build (pkg/build without --chroot) skips makedepends, so the build
# machine may lack libraries it builds against. Then the exact Arch packages
# below (those Arch's 5.2.1-1 was built with) are unpacked into a private
# folder for the build only, checksum-pinned (signatures checked against Arch's
# keyring when pinned); installed systems get the same libraries through
# depends. They are always downloaded, and prepare() decides, once the
# dependencies are installed: in the clean chroot that publishing uses they
# are never used (it installs depends and makedepends first), and using them
# there is an error.
#
# A new Noctalia release: update pkgver, the checksum, the patches (the
# highlight touches box.{h,cpp}, config_types.h, config_schema.cpp,
# application_services.cpp and one line in each surface; the frame touches
# plugin_manifest.{h,cpp}, application_plugins.cpp and plugin_panel.{h,cpp};
# the border, config_types.h, config_schema.cpp, panel_surface_style.h and the
# two panel hosts; the fit, bar.cpp, widget.h, label.h, active_window_widget.cpp
# and plugin_widget.{h,cpp}),
# and the pinned build libraries; reset pkgrel.
pkgname=noctalia
pkgver=5.2.1
pkgrel=5
epoch=1
pkgdesc='A sleek, customizable desktop shell crafted for Wayland (with a top-edge highlight patch)'
arch=(x86_64)
url='https://github.com/noctalia-dev/noctalia'
license=(MIT)
depends=(bash cairo curl fontconfig freetype2 git glib2 glibc harfbuzz hicolor-icon-theme
         jemalloc libgcc libglvnd libical libjxl libpipewire libqalculate librsvg libsecret
         libsndfile libsodium libstdc++ libwebp libwireplumber libxkbcommon libxml2 md4c
         pam polkit pango sdbus-cpp tomlplusplus wayland)
optdepends=('ddcutil: monitor brightness control'
            'power-profiles-daemon: power profile management'
            'upower: battery and power device integration')
makedepends=(meson ninja nlohmann-json pkgconf stb wayland-protocols)
options=(!debug)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        top-highlight.patch
        plugin-panel-frame.patch
        panel-border.patch
        bar-fit.patch)
sha256sums=('5418f6b759de96e56a4bbca809c5a4c60a8a9594bdf67ecb8c5a341f97c221d1'
            'baafe5aff5cbbf08d09ea0f39dac475345f99778ca603d5c3a1099f0abd85af6'
            'f499c11d674575d48d131aa50de2d6b2744737dcea64e1c7e90a155b66310720'
            'cb64e1df7b805e89f76797912c1e7fa5e4f3e51d94983629ae4c84d1f6f0030f'
            'd60e97afd47a30d7b06bf05a14baf53be4a7bcc845ce6c24eff3f619bed296a1')

_archive=https://archive.archlinux.org/packages
_buildlibs=(libqalculate-5.13.2-1-x86_64 libical-4.0.6-1-x86_64
            nlohmann-json-3.12.0-2-any stb-20260415.205329.g31c1ad374564-1-any)
source+=("$_archive/l/libqalculate/${_buildlibs[0]}.pkg.tar.zst"
         "$_archive/l/libical/${_buildlibs[1]}.pkg.tar.zst"
         "$_archive/n/nlohmann-json/${_buildlibs[2]}.pkg.tar.zst"
         "$_archive/s/stb/${_buildlibs[3]}.pkg.tar.zst")
sha256sums+=('ac95d08aa2e829aea1cd022d9062ce0cb4b0ef156a49ed18ca8605fdc9b73c1f'
             '59e08a83e578dbfd77ae907e4fca1bf11533110f80b188312bbaefafd358602d'
             '55968568ee1c8f3ffe691b51d4f6660acb40ee82f474d41fc6e18c571e87ddc4'
             '286f2694dccf92acd197940b6ca068d3a6d5c763123e02a0e4fe26e611a97f25')
noextract=("${_buildlibs[@]/%/.pkg.tar.zst}")

_have_buildlibs() {
  pkg-config --exists libqalculate libical nlohmann_json 2>/dev/null &&
    [[ -f /usr/include/stb/stb_image_resize2.h ]]
}

# meson and ninja come from Arch (makedepends). A host build skips the
# makedepends check, so say clearly when they're missing; never fetch build
# tools from elsewhere (decision record 0043).
_meson() {
  if ! command -v meson >/dev/null || ! command -v ninja >/dev/null; then
    echo "building $pkgname needs meson and ninja: sudo pacman -S --needed meson ninja" >&2
    return 1
  fi
  meson "$@"
}

prepare() {
  patch -d "$pkgname-$pkgver" -p1 < top-highlight.patch
  patch -d "$pkgname-$pkgver" -p1 < plugin-panel-frame.patch
  patch -d "$pkgname-$pkgver" -p1 < panel-border.patch
  patch -d "$pkgname-$pkgver" -p1 < bar-fit.patch
  rm -rf buildlibs
  _have_buildlibs && return 0
  # /.arch-chroot: devtools' clean chroot, where depends and makedepends are installed.
  if [[ -e /.arch-chroot ]]; then
    echo "the build chroot lacks libqalculate, libical, nlohmann-json or stb; check depends and makedepends" >&2
    return 1
  fi
  local lib
  mkdir buildlibs
  for lib in "${_buildlibs[@]}"; do
    bsdtar -xf "$lib.pkg.tar.zst" -C buildlibs --exclude '.*'
  done
}

build() {
  if [[ -d $srcdir/buildlibs ]]; then
    local root=$srcdir/buildlibs
    export PKG_CONFIG_PATH=$root/usr/lib/pkgconfig:$root/usr/share/pkgconfig
    export PKG_CONFIG_RELOCATE_PATHS=1 CPATH=$root/usr/include
    export LDFLAGS="$LDFLAGS -L$root/usr/lib -Wl,-rpath-link,$root/usr/lib"
  fi
  CXXFLAGS+=" -Wno-unused-result"
  # arch-meson's options.
  _meson setup --prefix=/usr --libexecdir=lib --sbindir=bin --buildtype=plain \
    --auto-features=enabled --wrap-mode=nodownload -Db_pie=true \
    -Db_ndebug=true -Dtests=disabled \
    build-release "$pkgname-$pkgver"
  _meson compile -C build-release
}

package() {
  _meson install -C build-release --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
