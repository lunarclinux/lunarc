From upstream commit dbbd88e2ef (noctalia PR #4853, released in 5.3.0), backported
to 5.2.1 unchanged.

Subject: [PATCH] fix(launcher): disable calculator functions that run programs
 or touch files (#4853)

libqalculate ships command(), plot(), load() and export(). The launcher
evaluates math-like queries as you type, so pasting an expression such
as 1+0*command("env","sh","-c","...") ran it before Enter was pressed.

Co-authored-by: dp <199792507+dpiotrkowski@users.noreply.github.com>
---
 src/launcher/math_provider.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/launcher/math_provider.cpp b/src/launcher/math_provider.cpp
index 5f3d927258..bdb6098944 100644
--- a/src/launcher/math_provider.cpp
+++ b/src/launcher/math_provider.cpp
@@ -7,7 +7,9 @@
 
 #include <cctype>
 #include <filesystem>
+#include <libqalculate/BuiltinFunctions.h>
 #include <libqalculate/Calculator.h>
+#include <libqalculate/Function.h>
 #include <memory>
 #include <string>
 
@@ -54,6 +56,12 @@ void MathProvider::initialize() {
   // Load any cached rates before definitions so currency units pick them up.
   m_calc->loadExchangeRates();
   m_calc->loadGlobalDefinitions();
+  // These run programs or touch files, so a pasted expression could execute code while it is typed.
+  for (const int id : {FUNCTION_ID_COMMAND, FUNCTION_ID_PLOT, FUNCTION_ID_LOAD, FUNCTION_ID_EXPORT}) {
+    if (MathFunction* function = m_calc->getFunctionById(id); function != nullptr) {
+      function->setActive(false);
+    }
+  }
   // Pre-warm internal state (GMP randstate) so the destructor path is safe.
   m_calc->calculate("0");
   m_calc->clearMessages();
