#!/usr/bin/env bash
# Builds the distro packages from a git ref into a local pacman repository:
#
#   pkg/build [ref]                          on this machine (development, tests, CI)
#   pkg/build --chroot [--fresh] [ref]       in a clean, current Arch chroot (for publishing)
#   pkg/build --chroot --dry-run [ref]       print the root and signing steps instead
#   pkg/build --dev [ref]                    a test build to install on this machine
#
# default ref: HEAD. The version comes from the last layer tag: l5-complete
# plus 3 commits -> 0.5.3.
#
# Output: --chroot builds go to pkg/out/repo/, which only ever holds a clean
# chroot build (what tools/publish and vm/build-iso --release use); host builds
# go to pkg/out-test/repo/, so tests and development never replace it.
# PKG_OUT=<folder> puts either somewhere else (never a host build in pkg/out).
#
# Packages and the repository database are signed when the signing key is on
# this machine (SIGNING_GNUPGHOME, default ~/.local/share/<id>-signing/gnupg).
# Without it (CI, other machines) everything is built unsigned.
#
# --chroot: every package is built with makechrootpkg
# in a fresh copy of a clean chroot kept in ~/.cache/<id>-chroot (CHROOT_DIR),
# which is created with mkarchroot or brought up to date (pacman -Syu) first,
# from Arch's mirrors (CHROOT_MIRROR for one of your own) rather than this machine's mirrorlist.
# Build and make dependencies are installed into the copy, so nothing is built
# against this machine's libraries. The results are signed here, like host
# builds. Needs devtools and root (sudo asks once). --fresh deletes and
# recreates the chroot first. tools/publish only accepts a chroot build.
#
# --dev: packages for trying a change on your own machine before it's released.
# Each is versioned to sort just above what's published (the repository at
# REPO_URL in repo.conf) and below the next release, so the next update replaces
# it: the distro's packages keep the ref's version with pkgrel 0.<UTC minute>
# (0.8.372-0.202610251030, below 0.8.372-1); a vendored package whose PKGBUILD
# is ahead of the published one gets pkgrel <its pkgrel - 1>.<UTC minute>
# (noctalia 1:5.2.1-7.202610251030, between the published -7 and the coming
# -8). A vendored package the same as the published one isn't built: the
# released package is the one to test with. Unsigned; output in pkg/out-dev/.
#
# Host builds use makepkg --nodeps: this machine needn't have the desktop or
# every build dependency installed (some PKGBUILDs then use pinned Arch
# packages for their build libraries; see pkg/noctalia).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
chroot=0 dry=0 fresh=0 dev=0 ref=HEAD
while (( $# )); do
  case $1 in
    --chroot) chroot=1 ;;
    --dry-run) dry=1 ;;
    --fresh) fresh=1 ;;
    --dev) dev=1 ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    -*) echo "pkg/build: unknown option $1" >&2; exit 2 ;;
    *) ref=$1 ;;
  esac
  shift
done
if (( (dry || fresh) && ! chroot )); then
  echo "pkg/build: --dry-run and --fresh go with --chroot" >&2; exit 2
fi
fail() { echo "pkg/build: $*" >&2; exit 1; }
if (( dev && chroot )); then echo "pkg/build: --dev builds are for this machine; not with --chroot" >&2; exit 2; fi
if (( chroot )); then out=$root/pkg/out; elif (( dev )); then out=$root/pkg/out-dev; else out=$root/pkg/out-test; fi
if [[ -n ${PKG_OUT:-} ]]; then out=$(realpath -m -- "$PKG_OUT"); fi
if (( ! chroot )) && [[ $out == "$(realpath -m -- "$root/pkg/out")" ]]; then
  fail "pkg/out holds only clean-chroot builds (pkg/build --chroot); build elsewhere (default pkg/out-test)"
fi
# The output folder is emptied first, so it may only hold an earlier build.
if [[ -d $out && -n $(ls -A "$out") && ! -d $out/repo ]]; then
  fail "$out isn't empty and isn't an earlier build's output; not replacing it"
fi
# Packages record the folder they were built in (.BUILDINFO), and the repository
# is published, so build in a fixed, neutral place rather than under $HOME.
# mktemp: a private folder, never a predictable shared path.
work=$(mktemp -d "${TMPDIR:-/tmp}/distro-pkgbuild.XXXXXX")
mkdir -p "$work/src"
keepalive=
cleanup() {
  if [[ -n $keepalive ]]; then kill "$keepalive" 2>/dev/null || true; fi
  rm -rf "$work"
}
trap cleanup EXIT
git -C "$root" archive "$ref" | tar -x -C "$work/src"
commit=$(git -C "$root" rev-parse --verify "$ref^{commit}")
source "$work/src/distro.conf"
# Shown as the packager in `pacman -Qi`; no personal name or address.
export PACKAGER="$DISTRO_NAME Project"

ver=$(git -C "$root" describe --tags --long --match 'l*-complete' "$ref" 2>/dev/null \
  | sed -E 's/^l([0-9]+)-complete-([0-9]+)-g[0-9a-f]+$/0.\1.\2/')
[[ $ver =~ ^0\.[0-9]+\.[0-9]+$ ]] || ver=0.0.0

# A dry run prints the steps that need root or the signing key, and runs the rest.
run() {
  if (( dry )); then printf '+'; printf ' %q' "$@"; printf '\n'; else "$@"; fi
}

if (( chroot )); then
  for tool in mkarchroot makechrootpkg arch-nspawn; do
    command -v "$tool" >/dev/null || fail "--chroot needs devtools ($tool): sudo pacman -S --needed devtools"
  done
  devtools=/usr/share/devtools
  chroot_dir=${CHROOT_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/$DISTRO_ID-chroot}
  # Arch's own mirrors, tried in order (pacman moves on when one fails; the
  # geo-routed one has refused TLS from some networks). CHROOT_MIRROR: one URL instead.
  # shellcheck disable=SC2016  # $repo and $arch are pacman's own placeholders
  mirrors=('https://fastly.mirror.pkgbuild.com/$repo/os/$arch'
           'https://geo.mirror.pkgbuild.com/$repo/os/$arch'
           'https://mirror.rackspace.com/archlinux/$repo/os/$arch')
  if [[ -n ${CHROOT_MIRROR:-} ]]; then mirrors=("$CHROOT_MIRROR"); fi
  # Arch's own build settings (the flags Arch's packages are built with).
  chroot_makepkg_conf=$devtools/makepkg.conf.d/x86_64.conf
  [[ -f $devtools/pacman.conf.d/extra.conf && -f $chroot_makepkg_conf ]] \
    || fail "devtools' pacman.conf.d/extra.conf or makepkg.conf.d/x86_64.conf is missing; update devtools"
  # Parallel make where a PKGBUILD uses make (meson and cargo already are).
  export MAKEFLAGS=${MAKEFLAGS:--j$(nproc)}
elif ! cargo --version >/dev/null 2>&1 && command -v mise >/dev/null; then
  # windowtolayer needs cargo. On a machine whose cargo is a mise shim without
  # a version chosen, pick the newest installed Rust.
  MISE_RUST_VERSION=$(mise ls --installed rust 2>/dev/null | awk '{print $2}' | sort -V | tail -1)
  export MISE_RUST_VERSION
fi

# Signing: makepkg (host builds), gpg (chroot builds) and repo-add read GNUPGHOME.
fpr=$(<"$work/src/pkg/keyring/fingerprint")
signing_home=${SIGNING_GNUPGHOME:-$HOME/.local/share/$DISTRO_ID-signing/gnupg}
sign=()
if (( dev )); then
  echo "pkg/build: --dev: unsigned"
elif [[ -d $signing_home ]] && GNUPGHOME=$signing_home gpg --batch --list-secret-keys "$fpr" >/dev/null 2>&1; then
  export GNUPGHOME=$signing_home
  sign=(--sign --key "$fpr")
  echo "pkg/build: signing with $fpr"
else
  echo "pkg/build: no signing key in $signing_home; building UNSIGNED packages" >&2
fi

sources=${XDG_CACHE_HOME:-$HOME/.cache}/$DISTRO_ID-pkg-sources
mkdir -p "$sources"
# A dry run leaves the last build alone.
if (( ! dry )); then rm -rf "$out"; mkdir -p "$out/repo"; fi
if (( chroot && ! dry )); then mkdir -p "$out/logs"; fi

# Build folders. Third-party packages the distro's repository carries (not in
# Arch's): every folder under pkg/ with a PKGBUILD, other than the distro's
# own; the whole folder (PKGBUILD plus any patches), from the git ref.
vendored=()
for dir in "$work"/src/pkg/*/; do
  name=$(basename "$dir")
  case $name in main|settings|keyring|out|out-test) continue ;; esac
  [[ -f $dir/PKGBUILD ]] || continue
  # Software whose license doesn't allow passing it on: only the recipe is
  # ours, built on the user's machine (see the folder's README).
  [[ -f $dir/no-redistribute ]] && continue
  mkdir -p "$work/$name"
  cp -r "$dir." "$work/$name/"
  vendored+=("$name")
done
# --dev: what's published, and the versions that sort between it and the next release.
if (( dev )); then
  repo_url=$(sed -n 's/^REPO_URL=//p' "$work/src/repo.conf" | head -1)
  [[ -n $repo_url ]] || fail "--dev: no REPO_URL in repo.conf"
  curl -fsSL --retry 2 -o "$work/published.db" "$repo_url/$DISTRO_REPO.db" \
    || fail "--dev: couldn't download $repo_url/$DISTRO_REPO.db to see what's published"
  declare -A published=()
  while read -r n v; do published[$n]=$v; done < <(bsdtar -xOf "$work/published.db" '*/desc' \
    | awk '/^%NAME%$/ { getline n } /^%VERSION%$/ { getline v; print n, v }')
  stamp=$(date -u +%Y%m%d%H%M)
  # The distro's packages: the ref must be ahead of the release.
  [[ -n ${published[$DISTRO_ID]:-} ]] || fail "--dev: $DISTRO_ID isn't in the published repository"
  pub=${published[$DISTRO_ID]%-*}
  if (( $(vercmp "$ver" "$pub") <= 0 )); then
    fail "--dev: $ref is $ver, not ahead of the published $pub; nothing to test (or rebase on main)"
  fi
  dev_versions=("$DISTRO_ID $ver-0.$stamp (published ${published[$DISTRO_ID]})")
  # Vendored packages: built only when the PKGBUILD is ahead of the published one.
  keep=()
  for name in "${vendored[@]}"; do
    info=$(cd "$work/$name" && makepkg --printsrcinfo 2>/dev/null)
    first=$(awk '$1 == "pkgname" { print $3; exit }' <<<"$info")
    epoch=$(awk '$1 == "epoch" { print $3; exit }' <<<"$info")
    pv=$(awk '$1 == "pkgver" { print $3; exit }' <<<"$info")
    rel=$(awk '$1 == "pkgrel" { print $3; exit }' <<<"$info")
    full=${epoch:+$epoch:}$pv-$rel
    have=${published[$first]:-}
    if [[ -n $have ]] && (( $(vercmp "$full" "$have") <= 0 )); then
      if (( $(vercmp "$full" "$have") < 0 )); then
        fail "--dev: pkg/$name is $full, behind the published $have"
      fi
      continue
    fi
    base=0
    if [[ -n $have && ${rel%%.*} -gt 1 ]]; then base=$(( ${rel%%.*} - 1 )); fi
    newrel=$base.$stamp
    devfull=${epoch:+$epoch:}$pv-$newrel
    if [[ -n $have ]] && (( $(vercmp "$devfull" "$have") <= 0 )); then newrel=0.$stamp; devfull=${epoch:+$epoch:}$pv-$newrel; fi
    if [[ -n $have ]] && (( $(vercmp "$devfull" "$have") <= 0 )); then
      fail "--dev: no test version of $name between the published $have and $full"
    fi
    # In the folder that's built, and in the copy the distro package reads its
    # dependency on our builds from (pkg/main).
    sed -i "s/^pkgrel=.*/pkgrel=$newrel/" "$work/$name/PKGBUILD" "$work/src/pkg/$name/PKGBUILD"
    keep+=("$name")
    dev_versions+=("$first $devfull (published ${have:-none}; the next release is $full)")
  done
  vendored=("${keep[@]}")
fi

# The distro's own packages. Each folder is self-contained, so the same folder
# builds here and in the chroot (which sees only this folder, as /startdir):
# the repository at the ref in distro-src (hard links; not src, which is
# makepkg's own folder in host builds), and the version set at the top of the
# PKGBUILD.
for part in keyring settings main; do
  build=$work/$part; mkdir -p "$build"
  cp -al "$work/src" "$build/distro-src"
  {
    echo '# Set by pkg/build: the repository at the ref being built (next to this file), and the version.'
    # shellcheck disable=SC2016  # written into the PKGBUILD as it is
    echo 'DISTRO_SRC=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/distro-src'
    echo "PKGVER=$ver"
    cat "$work/src/pkg/$part/PKGBUILD"
  } > "$build/PKGBUILD"
  if (( dev )); then sed -i "s/^pkgrel=.*/pkgrel=0.$stamp/" "$build/PKGBUILD"; fi
  # An install script is named after its package; fill in the name.
  for script in "$work/src/pkg/$part"/*.install; do
    if [[ -f $script ]]; then sed "s/@DISTRO_ID@/$DISTRO_ID/g" "$script" > "$build/$DISTRO_ID-$part.install"; fi
  done
done

# Build order: a vendored package that needs another of ours (to build or to
# run) is built after it, and in the chroot that one is installed first (-I).
declare -A provider=() needs=() pkgfiles=() ordered=()
for name in "${vendored[@]}"; do
  while read -r key _ value; do
    case $key in
      pkgname) provider[$value]=$name ;;
      depends|makedepends|checkdepends) needs[$name]+=" ${value%%[<>=]*}" ;;
    esac
  done < <(cd "$work/$name" && makepkg --printsrcinfo 2>/dev/null)
  pkgfiles[$name]=$(cd "$work/$name" && PKGDEST=$out/repo makepkg --packagelist 2>/dev/null)
done
# ours_needed <folder>: the packages of ours it needs, as "folder package" lines.
ours_needed() {
  local n
  for n in ${needs[$1]:-}; do
    if [[ -n ${provider[$n]:-} && ${provider[$n]} != "$1" ]]; then echo "${provider[$n]} $n"; fi
  done
}
order=() left=("${vendored[@]}")
while (( ${#left[@]} )); do
  next=()
  for name in "${left[@]}"; do
    ready=1
    while read -r dep _; do
      if [[ -n $dep && -z ${ordered[$dep]:-} ]]; then ready=0; fi
    done < <(ours_needed "$name")
    if (( ready )); then order+=("$name"); ordered[$name]=1; else next+=("$name"); fi
  done
  (( ${#next[@]} < ${#left[@]} )) || fail "these packages need each other: ${next[*]}"
  left=("${next[@]}")
done
# package_file <folder> <package>: the file makepkg makes for that package.
package_file() {
  local f rest
  while read -r f; do
    rest=${f##*/}; rest=${rest#"$2"-}
    # what's left is version-release-arch.pkg.tar.*: exactly two dashes
    if [[ ${f##*/} == "$2"-* && $rest =~ ^[^-]+-[^-]+-[^-]+\.pkg\.tar\. ]]; then echo "$f"; return; fi
  done <<<"${pkgfiles[$1]}"
  fail "no package file for $2 in ${1}'s package list"
}

if (( chroot )); then
  if (( dry )); then
    run sudo -v
  else
    echo "pkg/build: building in a clean chroot needs root (mkarchroot, makechrootpkg); sudo asks once for the whole build."
    sudo -v || fail "--chroot needs sudo"
    # Keep sudo's timestamp fresh while the build runs; stops with this script.
    ( while sleep 50; do kill -0 $$ 2>/dev/null || exit 0; sudo -n -v 2>/dev/null || exit 0; done ) &
    keepalive=$!
  fi
  root_dir=$chroot_dir/root
  conf_dir=$chroot_dir
  if (( dry )); then conf_dir=$work; fi
  want=$(sed -n "s/^CHROOT_VERSION='\(.*\)'$/\1/p" "$devtools/lib/archroot.sh")
  have=
  if [[ -f $root_dir/.arch-chroot ]]; then have=$(<"$root_dir/.arch-chroot"); fi
  # Recreated when asked, or when devtools wants a newer chroot layout.
  if { (( fresh )) && [[ -d $chroot_dir ]]; } || { [[ -d $root_dir ]] && [[ $have != "$want" ]]; }; then
    echo "pkg/build: recreating $chroot_dir"
    # The chroot and its working copies may be btrfs subvolumes (removed the way devtools' archbuild does).
    # shellcheck disable=SC2016  # expanded by the root shell
    run sudo bash -c 'source "$1/lib/common.sh"; source "$1/lib/archroot.sh"
      for d in "$2"/*/; do subvolume_delete_recursive "${d%/}"; done
      rm -rf --one-file-system "$2"' _ "$devtools" "$chroot_dir"
    if (( dry )); then root_dir=$work/recreated; fi
  fi
  if (( ! dry )); then mkdir -p "$chroot_dir"; fi
  # Devtools' pacman.conf for Arch's repositories, with Arch's mirrors rather
  # than this machine's mirrorlist (which may lag behind or point elsewhere).
  servers=$(printf 'Server = %s\n' "${mirrors[@]}")
  awk -v servers="$servers" '$0 == "Include = /etc/pacman.d/mirrorlist" { print servers; next } { print }' \
    "$devtools/pacman.conf.d/extra.conf" > "$conf_dir/pacman.conf"
  if [[ ! -d $root_dir ]]; then
    echo "pkg/build: creating the build chroot in $chroot_dir/root"
    run mkarchroot -C "$conf_dir/pacman.conf" -M "$chroot_makepkg_conf" "$chroot_dir/root" base-devel
  else
    echo "pkg/build: updating the build chroot in $root_dir"
    # The keyring first, so packages signed by new Arch packagers verify.
    run arch-nspawn -C "$conf_dir/pacman.conf" -M "$chroot_makepkg_conf" "$root_dir" \
      bash -c 'pacman -Sy --needed --noconfirm archlinux-keyring && pacman -Suu --noconfirm'
  fi
fi

# chroot_build <folder> [makechrootpkg options] [-- makepkg options]: builds in
# a fresh copy of the chroot (-c); its output goes to pkg/out/logs/<folder>.log.
chroot_build() {
  local dir=$1 log=$out/logs/${1##*/}.log; shift
  echo "pkg/build: ${dir##*/}"
  if (( dry )); then
    run cd "$dir"
    run env SRCDEST="$sources" PKGDEST="$out/repo" LOGDEST="$out/logs" PACKAGER="$PACKAGER" \
      MAKEFLAGS="$MAKEFLAGS" makechrootpkg -c -r "$chroot_dir" "$@"
    return 0
  fi
  if ! (cd "$dir" && SRCDEST=$sources PKGDEST=$out/repo LOGDEST=$out/logs \
        makechrootpkg -c -r "$chroot_dir" "$@") >"$log" 2>&1; then
    tail -n 40 "$log" >&2
    fail "${dir##*/} failed to build in the chroot; full output in $log"
  fi
}

for name in "${order[@]}"; do
  build=$work/$name
  # Downloads are kept between builds (checksum-verified each time) and tried
  # three times, so one dropped connection doesn't fail the whole build.
  for try in 1 2 3; do
    (cd "$build" && SRCDEST=$sources makepkg --verifysource --noconfirm >/dev/null 2>&1) && break
    if (( try < 3 )); then sleep 10; fi
  done
  if (( chroot )); then
    installs=()
    while read -r dep n; do
      if [[ -n $dep ]]; then installs+=(-I "$(package_file "$dep" "$n")"); fi
    done < <(ours_needed "$name")
    chroot_build "$build" "${installs[@]}"
  else
    (cd "$build" && SRCDEST=$sources PKGDEST=$out/repo makepkg -f --nodeps --noconfirm "${sign[@]}" >/dev/null)
  fi
done

for part in keyring settings main; do
  build=$work/$part
  # --nodeps: data and scripts only; the desktop they depend on needn't be
  # installed to build them.
  if (( chroot )); then
    chroot_build "$build" -- --nodeps
  else
    (cd "$build" && PKGDEST=$out/repo makepkg -f --nodeps --noconfirm "${sign[@]}" >/dev/null)
  fi
done

# Chroot builds are signed here, the way makepkg --sign does it.
if (( chroot && ${#sign[@]} )); then
  if (( dry )); then
    run gpg --detach-sign --use-agent -u "$fpr" --no-armor "$out/repo/<each package>"
  else
    for pkg in "$out"/repo/*.pkg.tar.zst; do
      gpg --detach-sign --use-agent -u "$fpr" --no-armor "$pkg"
    done
  fi
fi

db=$out/repo/$DISTRO_REPO.db.tar.gz
if (( dry )); then
  run repo-add -q "${sign[@]}" "$db" "$out/repo/<each package>"
  echo "pkg/build: dry run, nothing built. Vendored package files, in build order (a debug package only if there are symbols):"
  for name in "${order[@]}"; do sed 's|^.*/|  |' <<<"${pkgfiles[$name]}"; done
  echo "pkg/build: then keyring, settings, main ($ver)"
  exit 0
fi
repo-add -q "${sign[@]}" "$db" "$out"/repo/*.pkg.tar.zst
# How this build was made; tools/publish only publishes chroot builds.
mode=host
if (( chroot )); then mode=chroot; fi
if (( dev )); then mode=dev; fi
printf 'BUILD_MODE=%s\nBUILD_COMMIT=%s\nBUILD_VERSION=%s\n' "$mode" "$commit" "$ver" > "$out/build-info"
ls -1 "$out/repo"
if (( dev )); then
  echo
  echo "pkg/build: test versions (the next update replaces them with the release):"
  printf '  %s\n' "${dev_versions[@]}"
  echo "pkg/build: install with:"
  printf '  sudo pacman -U'; for f in "$out"/repo/*.pkg.tar.zst; do case ${f##*/} in *-debug-*) ;; *) printf ' %q' "$f" ;; esac; done; echo
fi
