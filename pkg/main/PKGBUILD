# The distro's main package: CLI, defaults, themes, Noctalia plugins, user
# services and new users' configs. Depends on the whole desktop.
# Built by pkg/build, which sets DISTRO_SRC (an unpacked copy of the repo at
# the ref being built) and PKGVER.
source "${DISTRO_SRC:?build with pkg/build}/distro.conf"

pkgname=$DISTRO_ID
pkgver=${PKGVER:-0.0.0}
pkgrel=1
pkgdesc="$DISTRO_NAME desktop: Hyprland, Noctalia, themes and tools"
arch=(any)
license=(GPL-3.0-or-later)
mapfile -t depends < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$DISTRO_SRC"/packages/{desktop,shell}.packages)
# The shell and the login screen are the distro repository's own builds of
# Noctalia and Noctalia Greeter (pkg/noctalia, pkg/noctalia-greeter, epoch 1):
# depending on their version or newer makes pacman take them, not Arch's
# packages of the same names, on installs and updates (decision records 0043
# and 0048).
for _i in "${!depends[@]}"; do
  case ${depends[_i]} in
    noctalia|noctalia-greeter)
      _v=$(source "$DISTRO_SRC/pkg/${depends[_i]}/PKGBUILD" >/dev/null 2>&1; printf '%s:%s-%s' "$epoch" "$pkgver" "$pkgrel")
      depends[_i]="${depends[_i]}>=$_v" ;;
  esac
done
depends+=("$DISTRO_ID-settings")

package() {
  PLUGIN_SET="$pkgver-$pkgrel" DISTRO_VERSION="$pkgver" bash "$DISTRO_SRC/pkg/files.sh" main "$DISTRO_SRC" "$pkgdir"
}
