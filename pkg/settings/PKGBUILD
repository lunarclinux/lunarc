# System configuration in /etc: sudo for wheel, compressed swap, the login
# screen's config (with a greetd drop-in pointing at it) and its wrapper.
# tuigreet stays: the wrapper falls back to it when Noctalia Greeter can't start.
source "${DISTRO_SRC:?build with pkg/build}/distro.conf"

pkgname=$DISTRO_ID-settings
pkgver=${PKGVER:-0.0.0}
pkgrel=1
pkgdesc="$DISTRO_NAME system settings"
arch=(any)
license=(GPL-3.0-or-later)
depends=(sudo zram-generator greetd greetd-tuigreet firewalld)
backup=(
  "etc/greetd/$DISTRO_ID.toml"
  "etc/systemd/zram-generator.conf"
  "etc/xdg/fastfetch/config.jsonc"
  "etc/sudoers.d/10-$DISTRO_ID-wheel"
  "etc/firefox/policies/policies.json"
  "etc/NetworkManager/conf.d/50-$DISTRO_ID-privacy.conf"
  "etc/makepkg.conf.d/$DISTRO_ID.conf"
)

package() {
  DISTRO_VERSION="$pkgver" bash "$DISTRO_SRC/pkg/files.sh" settings "$DISTRO_SRC" "$pkgdir"
}
