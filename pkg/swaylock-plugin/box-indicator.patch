diff --color -ruN -x build base/render.c swaylock-plugin-1.8.7/render.c
--- a/render.c	2026-10-11 20:22:51.792093671 -0500
+++ b/render.c	2026-10-11 20:24:00.660366468 -0500
@@ -90,8 +90,200 @@
 	cairo_font_options_destroy(fo);
 }
 
+static void rounded_rect(cairo_t *cairo, double x, double y, double w, double h,
+		double r) {
+	cairo_new_sub_path(cairo);
+	cairo_arc(cairo, x + w - r, y + r, r, -M_PI / 2, 0);
+	cairo_arc(cairo, x + w - r, y + h - r, r, 0, M_PI / 2);
+	cairo_arc(cairo, x + r, y + h - r, r, M_PI / 2, M_PI);
+	cairo_arc(cairo, x + r, y + r, r, M_PI, 3 * M_PI / 2);
+	cairo_close_path(cairo);
+}
+
+// Text of one line, centred on cx, its top at y; returns the line height.
+static double box_text_line(cairo_t *cairo, const char *text, double cx,
+		double y, double size) {
+	cairo_text_extents_t extents;
+	cairo_font_extents_t fe;
+	cairo_set_font_size(cairo, size);
+	cairo_text_extents(cairo, text, &extents);
+	cairo_font_extents(cairo, &fe);
+	cairo_move_to(cairo, cx - (extents.width / 2 + extents.x_bearing),
+		y + fe.ascent);
+	cairo_show_text(cairo, text);
+	cairo_new_path(cairo);
+	return fe.height;
+}
+
+// --indicator-style box: a password box instead of the ring. Shown exactly
+// when the ring would be; draws one dot per typed character (never the
+// characters), state text in place of the dots, a Caps Lock line under the
+// box and the hint line under that.
+static bool render_box_frame(struct swaylock_surface *surface) {
+	struct swaylock_state *state = surface->state;
+	double s = surface->scale;
+
+	bool draw_indicator = state->args.show_indicator &&
+		(state->auth_state != AUTH_STATE_IDLE ||
+			state->input_state != INPUT_STATE_IDLE ||
+			state->args.indicator_idle_visible);
+	bool active = state->auth_state != AUTH_STATE_IDLE ||
+		state->input_state != INPUT_STATE_IDLE;
+
+	const char *status = NULL;
+	if (state->input_state == INPUT_STATE_CLEAR) {
+		status = "Cleared";
+	} else if (state->auth_state == AUTH_STATE_VALIDATING) {
+		status = "Checking\xe2\x80\xa6";
+	} else if (state->auth_state == AUTH_STATE_INVALID) {
+		status = "Wrong password";
+	}
+	const char *caps = (state->xkb.caps_lock && state->args.show_caps_lock_text &&
+		active) ? "Caps Lock is on" : NULL;
+	const char *hint = (active && state->args.hint) ? state->args.hint : NULL;
+
+	double font_size = (state->args.font_size > 0 ? state->args.font_size : 18) * s;
+	double label_size = font_size * 0.72;
+	double small_size = font_size * 0.62;
+	double box_w = 360 * s, box_h = 56 * s, radius = 12 * s;
+	double border = 2.5 * s, gap = 10 * s, pad = 6 * s;
+
+	// Measure, so the buffer fits the widest line.
+	cairo_set_antialias(state->test_cairo, CAIRO_ANTIALIAS_BEST);
+	configure_font_drawing(state->test_cairo, state, surface->subpixel, (int)box_h);
+	cairo_font_extents_t fe;
+	cairo_text_extents_t te;
+	double width = box_w + 2 * border;
+	cairo_set_font_size(state->test_cairo, label_size);
+	cairo_font_extents(state->test_cairo, &fe);
+	double label_h = fe.height;
+	cairo_set_font_size(state->test_cairo, small_size);
+	cairo_font_extents(state->test_cairo, &fe);
+	double small_h = fe.height;
+	if (hint) {
+		cairo_text_extents(state->test_cairo, hint, &te);
+		if (width < te.width + 2 * pad) {
+			width = te.width + 2 * pad;
+		}
+	}
+	double height = label_h + gap + box_h + 2 * border;
+	if (caps) {
+		height += gap + small_h;
+	}
+	if (hint) {
+		height += gap + small_h + 2 * pad;
+	}
+	int buffer_width = (int)ceil(width);
+	int buffer_height = (int)ceil(height);
+	buffer_height += surface->scale - (buffer_height % surface->scale);
+	buffer_width += surface->scale - (buffer_width % surface->scale);
+
+	// Centre the box itself on the screen (label above, lines below).
+	double box_top = label_h + gap;
+	int subsurf_xpos = surface->width / 2 - buffer_width / (2 * surface->scale);
+	int subsurf_ypos = surface->height / 2 -
+		(int)((box_top + border + box_h / 2) / surface->scale);
+	if (state->args.override_indicator_x_position) {
+		subsurf_xpos = state->args.indicator_x_position -
+			buffer_width / (2 * surface->scale);
+	}
+	if (state->args.override_indicator_y_position) {
+		subsurf_ypos = state->args.indicator_y_position -
+			(int)((box_top + border + box_h / 2) / surface->scale);
+	}
+
+	struct pool_buffer *buffer = get_next_buffer(state->shm,
+			surface->indicator_buffers, buffer_width, buffer_height);
+	if (buffer == NULL) {
+		swaylock_log(LOG_ERROR, "No buffer");
+		return false;
+	}
+	cairo_t *cairo = buffer->cairo;
+	cairo_set_antialias(cairo, CAIRO_ANTIALIAS_BEST);
+	cairo_identity_matrix(cairo);
+	cairo_save(cairo);
+	cairo_set_source_rgba(cairo, 0, 0, 0, 0);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_paint(cairo);
+	cairo_restore(cairo);
+
+	if (draw_indicator) {
+		double cx = buffer_width / 2.0;
+		double bx = cx - box_w / 2, by = box_top + border;
+		configure_font_drawing(cairo, state, surface->subpixel, (int)box_h);
+
+		// Label above the box.
+		cairo_set_source_u32(cairo, state->args.colors.hint_text);
+		box_text_line(cairo, "Password", cx, 0, label_size);
+
+		// The box: inside colour, border in the state's ring colour.
+		rounded_rect(cairo, bx, by, box_w, box_h, radius);
+		set_color_for_state(cairo, state, &state->args.colors.inside);
+		cairo_fill_preserve(cairo);
+		cairo_set_line_width(cairo, border);
+		set_color_for_state(cairo, state, &state->args.colors.ring);
+		cairo_stroke(cairo);
+
+		set_color_for_state(cairo, state, &state->args.colors.text);
+		if (status) {
+			cairo_font_extents_t sfe;
+			cairo_set_font_size(cairo, font_size * 0.8);
+			cairo_font_extents(cairo, &sfe);
+			box_text_line(cairo, status, cx, by + (box_h - sfe.height) / 2,
+				font_size * 0.8);
+		} else {
+			// One dot per character, as many as fit; the newest ones show.
+			double dot_r = 5 * s, step = 18 * s, inner = 22 * s;
+			size_t max_dots = (size_t)((box_w - 2 * inner) / step);
+			size_t len = state->password.len;
+			size_t dots = len < max_dots ? len : max_dots;
+			double x = bx + inner + dot_r, y = by + box_h / 2;
+			for (size_t i = 0; i < dots; ++i) {
+				cairo_arc(cairo, x + i * step, y, dot_r, 0, 2 * M_PI);
+				cairo_fill(cairo);
+			}
+			// A soft caret after the dots while typing.
+			if (state->auth_state == AUTH_STATE_IDLE) {
+				double caret_x = x + dots * step - dot_r;
+				cairo_set_line_width(cairo, 2 * s);
+				set_color_for_state(cairo, state, &state->args.colors.ring);
+				cairo_move_to(cairo, caret_x, y - 12 * s);
+				cairo_line_to(cairo, caret_x, y + 12 * s);
+				cairo_stroke(cairo);
+			}
+		}
+
+		double y = by + box_h + border + gap;
+		if (caps) {
+			cairo_set_source_u32(cairo, state->args.colors.text.caps_lock);
+			y += box_text_line(cairo, caps, cx, y, small_size) + gap;
+		}
+		if (hint) {
+			cairo_set_font_size(cairo, small_size);
+			cairo_text_extents(cairo, hint, &te);
+			cairo_font_extents(cairo, &fe);
+			double hx = cx - te.width / 2 - pad;
+			cairo_rectangle(cairo, hx, y, te.width + 2 * pad, fe.height + 2 * pad);
+			cairo_set_source_u32(cairo, state->args.colors.layout_background);
+			cairo_fill(cairo);
+			cairo_set_source_u32(cairo, state->args.colors.hint_text);
+			box_text_line(cairo, hint, cx, y + pad, small_size);
+		}
+	}
+
+	wl_subsurface_set_position(surface->subsurface, subsurf_xpos, subsurf_ypos);
+	wl_surface_set_buffer_scale(surface->child, surface->scale);
+	wl_surface_attach(surface->child, buffer->buffer, 0, 0);
+	wl_surface_damage_buffer(surface->child, 0, 0, INT32_MAX, INT32_MAX);
+	wl_surface_commit(surface->child);
+	return true;
+}
+
 static bool render_frame(struct swaylock_surface *surface) {
 	struct swaylock_state *state = surface->state;
+	if (state->args.indicator_box) {
+		return render_box_frame(surface);
+	}
 
 	// First, compute the text that will be drawn, if any, since this
 	// determines the size/positioning of the surface
