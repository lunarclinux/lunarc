diff --git c/render.c w/render.c
index 7df5f82..d791654 100644
--- c/render.c
+++ w/render.c
@@ -90,8 +90,299 @@ static void configure_font_drawing(cairo_t *cairo, struct swaylock_state *state,
 	cairo_font_options_destroy(fo);
 }
 
+static void rounded_rect(cairo_t *cairo, double x, double y, double w, double h,
+		double r) {
+	cairo_new_sub_path(cairo);
+	cairo_arc(cairo, x + w - r, y + r, r, -M_PI / 2, 0);
+	cairo_arc(cairo, x + w - r, y + h - r, r, 0, M_PI / 2);
+	cairo_arc(cairo, x + r, y + h - r, r, M_PI / 2, M_PI);
+	cairo_arc(cairo, x + r, y + r, r, M_PI, 3 * M_PI / 2);
+	cairo_close_path(cairo);
+}
+
+// A colour with its alpha multiplied by a.
+static void set_source_u32_alpha(cairo_t *cairo, uint32_t color, double a) {
+	cairo_set_source_rgba(cairo,
+		(color >> 24 & 0xFF) / 255.0, (color >> 16 & 0xFF) / 255.0,
+		(color >> 8 & 0xFF) / 255.0, (color & 0xFF) / 255.0 * a);
+}
+
+// The colour a colourset has in the current state.
+static uint32_t color_for_state(struct swaylock_state *state,
+		struct swaylock_colorset *colorset) {
+	if (state->input_state == INPUT_STATE_CLEAR) {
+		return colorset->cleared;
+	} else if (state->auth_state == AUTH_STATE_VALIDATING) {
+		return colorset->verifying;
+	} else if (state->auth_state == AUTH_STATE_INVALID) {
+		return colorset->wrong;
+	} else if (state->xkb.caps_lock && state->args.show_caps_lock_indicator) {
+		return colorset->caps_lock;
+	}
+	return colorset->input;
+}
+
+// One line of text, its left edge at x, vertically centred on cy; returns its
+// advance.
+static double box_text_at(cairo_t *cairo, const char *text, double x,
+		double cy, double size) {
+	cairo_text_extents_t extents;
+	cairo_font_extents_t fe;
+	cairo_set_font_size(cairo, size);
+	cairo_text_extents(cairo, text, &extents);
+	cairo_font_extents(cairo, &fe);
+	cairo_move_to(cairo, x, cy + (fe.ascent - fe.descent) / 2);
+	cairo_show_text(cairo, text);
+	cairo_new_path(cairo);
+	return extents.x_advance;
+}
+
+static double box_text_width(cairo_t *cairo, const char *text, double size) {
+	cairo_text_extents_t extents;
+	cairo_set_font_size(cairo, size);
+	cairo_text_extents(cairo, text, &extents);
+	return extents.x_advance;
+}
+
+// One short line centred on cx, its top at y, on a small pill of the bg colour
+// so it reads over the screensaver; returns the pill's height.
+static double box_text_pill(cairo_t *cairo, const char *text, double cx,
+		double y, double size, double line_h, double pad, uint32_t bg,
+		uint32_t fg) {
+	double w = box_text_width(cairo, text, size);
+	double h = line_h + 2 * pad;
+	rounded_rect(cairo, cx - w / 2 - 2 * pad, y, w + 4 * pad, h, h / 2);
+	cairo_set_source_u32(cairo, bg);
+	cairo_fill(cairo);
+	cairo_set_source_u32(cairo, fg);
+	box_text_at(cairo, text, cx - w / 2, y + h / 2, size);
+	return h;
+}
+
+// --indicator-style box: a password prompt in a pill instead of the ring,
+// shown exactly when the ring would be. One line, as a shell would draw it:
+// the prompt text (--prompt-text), "password:", then a fixed row of dots with
+// one lit per key (never the characters or their count) and a block cursor;
+// state text (checking, wrong, cleared) in place of the dots. A Caps Lock line
+// and the hint line go under the pill. The pill sits low on the screen.
+static bool render_box_frame(struct swaylock_surface *surface) {
+	struct swaylock_state *state = surface->state;
+	double s = surface->scale;
+
+	bool draw_indicator = state->args.show_indicator &&
+		(state->auth_state != AUTH_STATE_IDLE ||
+			state->input_state != INPUT_STATE_IDLE ||
+			state->args.indicator_idle_visible);
+	bool active = state->auth_state != AUTH_STATE_IDLE ||
+		state->input_state != INPUT_STATE_IDLE;
+
+	const char *status = NULL;
+	if (state->input_state == INPUT_STATE_CLEAR) {
+		status = "cleared";
+	} else if (state->auth_state == AUTH_STATE_VALIDATING) {
+		status = "checking\xe2\x80\xa6";
+	} else if (state->auth_state == AUTH_STATE_INVALID) {
+		status = "wrong password";
+	}
+	const char *caps = (state->xkb.caps_lock && state->args.show_caps_lock_text &&
+		active) ? "Caps Lock is on" : NULL;
+	const char *hint = (active && state->args.hint) ? state->args.hint : NULL;
+	const char *prompt = state->args.prompt;
+	const char *label = "password:";
+
+	double font_size = (state->args.font_size > 0 ? state->args.font_size : 15) * s;
+	double small_size = font_size * 0.82;
+	double box_h = 56 * s, pad_x = 24 * s, gap = font_size * 0.6;
+	double line_gap = 12 * s, pad = 6 * s;
+	const int ndots = 8;
+	double dot_r = 3 * s, step = 13 * s, cursor_w = 9 * s, cursor_h = 18 * s;
+	double dots_w = (ndots - 1) * step + 2 * dot_r;
+
+	// Measure, so the pill (at least 500 wide) and the buffer fit every line.
+	cairo_set_antialias(state->test_cairo, CAIRO_ANTIALIAS_BEST);
+	configure_font_drawing(state->test_cairo, state, surface->subpixel, (int)box_h);
+	cairo_font_extents_t fe;
+	double prompt_w = prompt ? box_text_width(state->test_cairo, prompt, font_size) + gap : 0;
+	double label_w = box_text_width(state->test_cairo, label, font_size);
+	double tail_w = dots_w + gap + cursor_w;
+	if (status) {
+		double w = box_text_width(state->test_cairo, status, font_size);
+		tail_w = w > tail_w ? w : tail_w;
+	}
+	double box_w = pad_x + prompt_w + label_w + gap + tail_w + pad_x;
+	if (box_w < 500 * s) {
+		box_w = 500 * s;
+	}
+	double width = box_w + 2 * s;
+	cairo_set_font_size(state->test_cairo, small_size);
+	cairo_font_extents(state->test_cairo, &fe);
+	double small_h = fe.height;
+	if (hint) {
+		double w = box_text_width(state->test_cairo, hint, small_size) + 4 * pad;
+		width = w > width ? w : width;
+	}
+	double height = box_h + 2 * s;
+	if (caps) {
+		height += line_gap + small_h + 2 * pad;
+	}
+	if (hint) {
+		height += line_gap + small_h + 2 * pad;
+	}
+	int buffer_width = (int)ceil(width);
+	int buffer_height = (int)ceil(height);
+	buffer_height += surface->scale - (buffer_height % surface->scale);
+	buffer_width += surface->scale - (buffer_width % surface->scale);
+
+	// Centred across the screen, the pill's bottom 96 px above the screen's
+	// (or centred on a screen too short for that).
+	int pill_h = (int)ceil(box_h / surface->scale) + 1;
+	int subsurf_xpos = surface->width / 2 - buffer_width / (2 * surface->scale);
+	int screen_h = (int)surface->height;
+	int subsurf_ypos = screen_h - 96 - pill_h;
+	if (subsurf_ypos < screen_h / 2 - pill_h / 2) {
+		subsurf_ypos = screen_h / 2 - pill_h / 2;
+	}
+	if (state->args.override_indicator_x_position) {
+		subsurf_xpos = state->args.indicator_x_position -
+			buffer_width / (2 * surface->scale);
+	}
+	if (state->args.override_indicator_y_position) {
+		subsurf_ypos = state->args.indicator_y_position - pill_h / 2;
+	}
+
+	struct pool_buffer *buffer = get_next_buffer(state->shm,
+			surface->indicator_buffers, buffer_width, buffer_height);
+	if (buffer == NULL) {
+		swaylock_log(LOG_ERROR, "No buffer");
+		return false;
+	}
+	cairo_t *cairo = buffer->cairo;
+	cairo_set_antialias(cairo, CAIRO_ANTIALIAS_BEST);
+	cairo_identity_matrix(cairo);
+	cairo_save(cairo);
+	cairo_set_source_rgba(cairo, 0, 0, 0, 0);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_paint(cairo);
+	cairo_restore(cairo);
+
+	if (draw_indicator) {
+		double cx = buffer_width / 2.0;
+		double bx = cx - box_w / 2, by = s, cy = by + box_h / 2;
+		double radius = box_h / 2;
+		configure_font_drawing(cairo, state, surface->subpixel, (int)box_h);
+
+		// The pill: the inside colour, a faint sheen from the top (the line
+		// colour, a fifth as strong, fading out), a 1 px top highlight in the
+		// line colour, and a 1 px border in the ring colour.
+		rounded_rect(cairo, bx, by, box_w, box_h, radius);
+		set_color_for_state(cairo, state, &state->args.colors.inside);
+		cairo_fill(cairo);
+		uint32_t line = color_for_state(state, &state->args.colors.line);
+		cairo_pattern_t *sheen = cairo_pattern_create_linear(0, by, 0, by + box_h);
+		cairo_pattern_add_color_stop_rgba(sheen, 0, (line >> 24 & 0xFF) / 255.0,
+			(line >> 16 & 0xFF) / 255.0, (line >> 8 & 0xFF) / 255.0,
+			(line & 0xFF) / 255.0 * 0.2);
+		cairo_pattern_add_color_stop_rgba(sheen, 1, (line >> 24 & 0xFF) / 255.0,
+			(line >> 16 & 0xFF) / 255.0, (line >> 8 & 0xFF) / 255.0, 0);
+		rounded_rect(cairo, bx, by, box_w, box_h, radius);
+		cairo_set_source(cairo, sheen);
+		cairo_fill(cairo);
+		cairo_pattern_destroy(sheen);
+		cairo_save(cairo);
+		cairo_set_fill_rule(cairo, CAIRO_FILL_RULE_EVEN_ODD);
+		rounded_rect(cairo, bx + 0.5 * s, by + 0.5 * s, box_w - s, box_h - s, radius - 0.5 * s);
+		rounded_rect(cairo, bx + 0.5 * s, by + 1.5 * s, box_w - s, box_h - s, radius - 0.5 * s);
+		cairo_clip(cairo);
+		rounded_rect(cairo, bx, by, box_w, box_h, radius);
+		cairo_set_source_u32(cairo, line);
+		cairo_fill(cairo);
+		cairo_restore(cairo);
+		rounded_rect(cairo, bx + 0.5 * s, by + 0.5 * s, box_w - s, box_h - s, radius - 0.5 * s);
+		cairo_set_line_width(cairo, s);
+		set_color_for_state(cairo, state, &state->args.colors.ring);
+		cairo_stroke(cairo);
+
+		// The prompt line.
+		double x = bx + pad_x;
+		if (prompt) {
+			cairo_set_source_u32(cairo, state->args.colors.prompt_text);
+			x += box_text_at(cairo, prompt, x, cy, font_size) + gap;
+		}
+		cairo_set_source_u32(cairo, state->args.colors.text.input);
+		x += box_text_at(cairo, label, x, cy, font_size) + gap;
+
+		if (status) {
+			set_color_for_state(cairo, state, &state->args.colors.text);
+			box_text_at(cairo, status, x, cy, font_size);
+		} else {
+			// A fixed row of dim dots, whatever was typed: the pill never shows
+			// how many characters there are. Each key lights one dot at random
+			// (never the same dot twice in a row); backspace lights it in the
+			// backspace colour. A new key is noticed through upstream's
+			// highlight_start, which changes on every key.
+			int lit = -1;
+			if (state->input_state == INPUT_STATE_LETTER ||
+					state->input_state == INPUT_STATE_BACKSPACE) {
+				// Shared by every output's surface, so all screens agree.
+				static uint32_t seen_highlight = UINT32_MAX;
+				static int lit_dot = 0;
+				if (state->highlight_start != seen_highlight) {
+					seen_highlight = state->highlight_start;
+					int next = rand() % (ndots - 1);
+					lit_dot = next >= lit_dot ? next + 1 : next;
+				}
+				lit = lit_dot;
+			}
+			bool caps_on = state->xkb.caps_lock &&
+				state->args.show_caps_lock_indicator;
+			for (int i = 0; i < ndots; ++i) {
+				cairo_arc(cairo, x + dot_r + i * step, cy, dot_r, 0, 2 * M_PI);
+				if (i == lit && state->input_state == INPUT_STATE_LETTER) {
+					cairo_set_source_u32(cairo, caps_on ?
+						state->args.colors.caps_lock_key_highlight :
+						state->args.colors.key_highlight);
+				} else if (i == lit) {
+					cairo_set_source_u32(cairo, caps_on ?
+						state->args.colors.caps_lock_bs_highlight :
+						state->args.colors.bs_highlight);
+				} else {
+					// Dim: the label colour at a third strength.
+					set_source_u32_alpha(cairo, state->args.colors.text.input, 0.35);
+				}
+				cairo_fill(cairo);
+			}
+			// The block cursor, in the key colour.
+			cairo_rectangle(cairo, x + dots_w + gap, cy - cursor_h / 2,
+				cursor_w, cursor_h);
+			cairo_set_source_u32(cairo, state->args.colors.key_highlight);
+			cairo_fill(cairo);
+		}
+
+		double y = by + box_h + s + line_gap;
+		if (caps) {
+			y += box_text_pill(cairo, caps, cx, y, small_size, small_h, pad,
+				state->args.colors.inside.input,
+				state->args.colors.text.caps_lock) + line_gap / 2;
+		}
+		if (hint) {
+			box_text_pill(cairo, hint, cx, y, small_size, small_h, pad,
+				state->args.colors.inside.input, state->args.colors.hint_text);
+		}
+	}
+
+	wl_subsurface_set_position(surface->subsurface, subsurf_xpos, subsurf_ypos);
+	wl_surface_set_buffer_scale(surface->child, surface->scale);
+	wl_surface_attach(surface->child, buffer->buffer, 0, 0);
+	wl_surface_damage_buffer(surface->child, 0, 0, INT32_MAX, INT32_MAX);
+	wl_surface_commit(surface->child);
+	return true;
+}
+
 static bool render_frame(struct swaylock_surface *surface) {
 	struct swaylock_state *state = surface->state;
+	if (state->args.indicator_box) {
+		return render_box_frame(surface);
+	}
 
 	// First, compute the text that will be drawn, if any, since this
 	// determines the size/positioning of the surface
diff --git c/swaylock.1.scd w/swaylock.1.scd
index 15a8d63..628c783 100644
--- c/swaylock.1.scd
+++ w/swaylock.1.scd
@@ -184,6 +184,23 @@ Locks your Wayland session.
 *--hint-color* <rrggbb[aa]>
 	Sets the color of the hint text.
 
+*--indicator-style* ring|box
+	Draw the indicator as the ring (the default) or as a password box: a
+	pill low on the screen holding one prompt line (the prompt text,
+	"password:", a fixed row of dots of which one lights at random per key,
+	so the password's length is never shown, and a block cursor), state text
+	(checking, wrong, cleared) in place of the dots, and a Caps Lock line
+	under it. The pill is filled with the inside color, bordered with the
+	ring color and lit along its top edge with the line color of each state;
+	the label and dim dots use the text color. It is shown exactly when the
+	ring would be.
+
+*--prompt-text* <text>
+	Text drawn before "password:" in the password box.
+
+*--prompt-color* <rrggbb[aa]>
+	Sets the color of the prompt text.
+
 *--line-color* <rrggbb[aa]>
 	Sets the color of the line between the inside and ring.
 
