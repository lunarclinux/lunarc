# Screen locker whose background is drawn by another program: the lock screen
# plays the screensaver behind a real session lock. Not in Arch's official
# repositories, so the distro's repository carries it. Built from the tagged
# release, checksum-pinned.
#
# Built without logind: its sleep watcher (ends the grace period on sleep)
# segfaulted on suspend in testing and left the locker spinning. The distro's
# lock-watch service ends the grace period instead (SIGUSR2) before sleep.
#
# hint-text.patch (ours): --hint-text / --hint-color draw one line of text
# under the indicator while it is visible, so the lock says what it expects
# (the background is our screensaver and can't see keystrokes).
# box-indicator.patch (ours): --indicator-style box draws a password prompt in
# a pill, low on the screen, instead of the ring: --prompt-text (user@host),
# "password:", a fixed row of dots with one lit at random per key so the length
# never shows, a block cursor; state text, a Caps Lock line. Shown exactly when
# the ring would be; with --indicator-idle-visible it is drawn as soon as the
# background is (upstream drew it only at the first key). --indicator-idle-show,
# --indicator-linger and --indicator-fade (ms) time it instead: shown for a
# while at lock, at once at any key until a while after the last, then faded
# out, redrawn every frame only while fading.
pkgname=swaylock-plugin
pkgver=1.8.7
pkgrel=7
pkgdesc="Fork of swaylock that draws its background with a wallpaper program"
arch=(x86_64)
url="https://github.com/mstoeckl/swaylock-plugin"
license=(MIT)
depends=(glibc wayland cairo pam libxkbcommon glib2 gdk-pixbuf2 swaybg)
makedepends=(meson ninja scdoc wayland-protocols)
optdepends=('windowtolayer: run a terminal program as the background')
backup=(etc/pam.d/swaylock-plugin)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        hint-text.patch
        box-indicator.patch)
sha256sums=('98ac74457adfeb812f91e2fc4b289db664637b0d3890a051347b8d1169cc3757'
            '6fb8b6523111603cf6172303fb589c0cbd903bb0913f5e20acfd41578779e24a'
            'ff85e308a59f5b3ca27db7d4c562b7b93598614a034539f324e5fec9c4b9d20c')

# meson and ninja come from Arch (makedepends). A host build skips the
# makedepends check, so say clearly when they're missing; never fetch build
# tools from elsewhere (decision record 0043).
_meson() {
  if ! command -v meson >/dev/null || ! command -v ninja >/dev/null; then
    echo "building $pkgname needs meson and ninja: sudo pacman -S --needed meson ninja" >&2
    return 1
  fi
  meson "$@"
}

prepare() {
  patch -d "$pkgname-$pkgver" -p1 < hint-text.patch
  patch -d "$pkgname-$pkgver" -p1 < box-indicator.patch
}

build() {
  local man=enabled
  command -v scdoc >/dev/null || man=disabled
  _meson setup --prefix=/usr --libexecdir=lib --sbindir=bin --buildtype=plain \
    --wrap-mode=nodownload -Db_pie=true -Dman-pages=$man \
    -Dlogind=disabled \
    build "$pkgname-$pkgver"
  _meson compile -C build
}

package() {
  _meson install -C build --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
