# Claude Code (Anthropic's coding agent). Not in Arch's official repositories,
# and its own installer is a script piped into a shell, so the distro's
# repository carries it instead (decision record 0048). Follows Anthropic's
# "stable" channel (about a week behind, skipping releases with major
# regressions). To move to a newer release: set pkgver and the binary's
# checksum from that release's manifest.json, after checking its signature.
#
# Checked twice: the release manifest must carry a good signature from
# Anthropic's release key (pinned here as release-key.pgp; fingerprint from
# code.claude.com/docs/en/setup), and the binary must match the checksum in
# that signed manifest as well as the one pinned below.
pkgname=claude-code
pkgver=2.1.292
pkgrel=1
pkgdesc="Anthropic's agentic coding tool for the terminal"
arch=(x86_64)
url="https://code.claude.com/docs"
license=(LicenseRef-Anthropic-Commercial)
depends=(glibc)
makedepends=(gnupg jq)
# A single-file executable with its program appended: stripping breaks it.
options=(!strip !debug)
_base=https://downloads.claude.ai/claude-code-releases
_fpr=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
# The signature and key have no .sig/.asc names, so makepkg leaves them to
# prepare() instead of looking for the key in the builder's own keyring.
source=("$pkgname-$pkgver-manifest.json::$_base/$pkgver/manifest.json"
        "$pkgname-$pkgver-manifest-signature::$_base/$pkgver/manifest.json.sig"
        "$pkgname-$pkgver::$_base/$pkgver/linux-x64/claude"
        release-key.pgp)
sha256sums=('SKIP'
            'SKIP'
            'a967e7b1d8b4e47ee421d5433027880347952b0c0857abf880e2c942a4ec93b3'
            'bd70a5e4a268002704024ceba7f8446024114e94f3f0bdd11c23a9e592be81c6')
noextract=("$pkgname-$pkgver")

prepare() {
  local keyring=$srcdir/claude-code.gpg status want got
  gpg --dearmor < release-key.pgp > "$keyring"
  status=$(gpgv --status-fd 1 --keyring "$keyring" \
    "$pkgname-$pkgver-manifest-signature" "$pkgname-$pkgver-manifest.json" 2>/dev/null) || true
  grep -q "^\[GNUPG:\] VALIDSIG $_fpr " <<<"$status" \
    || { echo "the release manifest isn't signed by $_fpr" >&2; return 1; }
  want=$(jq -r --arg v "$pkgver" 'select(.version == $v) | .platforms["linux-x64"].checksum' \
    "$pkgname-$pkgver-manifest.json")
  got=$(sha256sum "$pkgname-$pkgver" | cut -d' ' -f1)
  [[ -n $want && $got == "$want" ]] \
    || { echo "the binary doesn't match the signed manifest" >&2; return 1; }
}

package() {
  install -Dm755 "$pkgname-$pkgver" "$pkgdir/usr/lib/$pkgname/claude"
  # Updates arrive through pacman: the built-in updater would install a second
  # copy into ~/.local and put it ahead of this one on PATH.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/claude" <<'SCRIPT'
#!/bin/sh
export DISABLE_UPDATES=1
exec /usr/lib/claude-code/claude "$@"
SCRIPT
}
