+  if (!m_revealAllowed && m_revealPassword) {
+    m_revealPassword = false;
+    m_revealIcon->setCodepoint(GlyphRegistry::lookup("eye"));
+    updateDisplayText();
+  }
+  markLayoutDirty();
+}
