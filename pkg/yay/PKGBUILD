# AUR helper, so `<id> app install` can reach apps that are only in the AUR.
# Not in Arch's official repositories, so the distro's repository carries it.
#
# Built from the tagged source with Arch's current Go (the steps of the AUR's
# own yay package), not upstream's prebuilt binary: that one was built with Go
# 1.26.4 and missed later TLS and HTTP fixes in Go's standard library (CVE
# review 2026-10-24). golang.org/x/net is raised from the version yay's go.mod
# pins (0.56.0) to one with the fixes. A rebuild picks up new Go releases: bump
# pkgrel when Arch's Go gets security fixes.
pkgname=yay
pkgver=13.0.1
pkgrel=2
pkgdesc="Yet another yogurt: pacman wrapper and AUR helper"
arch=(x86_64)
url="https://github.com/Jguer/yay"
license=(GPL-3.0-or-later)
depends=('pacman>6.1' git)
makedepends=('go>=2:1.27')
optdepends=('sudo: privilege elevation')
options=(!lto !debug)
_xnet=v0.61.0
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('b77454bce87110180a1b6664c2d260de78124c9894b71101610ba84f551eb0d0')

prepare() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath" GOFLAGS="-modcacherw"
  go get "golang.org/x/net@$_xnet"
  go mod tidy
}

build() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath" GOFLAGS="-buildmode=pie -trimpath -modcacherw"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export CGO_ENABLED=1
  make VERSION="$pkgver" DESTDIR="$pkgdir" PREFIX=/usr build
}

package() {
  cd "$pkgname-$pkgver"
  make VERSION="$pkgver" DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
