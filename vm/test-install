#!/usr/bin/env bash
# Proves a layer is reproducible: restores a VM to a snapshot (an empty disk
# with the live ISO), installs a git ref over SSH, reboots into the installed
# system and runs checks.
#
#   vm/test-install [--vm distro-clean] [--from l0-complete] [--ref HEAD] [--keep] [--iso VOLUME] [--encrypt]
#
# --encrypt installs onto LUKS and types the passphrase at boot (virsh send-key).
#
# --iso boots the VM from an installer ISO in libvirt's default pool (built by
# iso/build) and runs the installer bundled in it, instead of copying a git ref.
# --keep leaves the VM running afterwards. Needs vm/make-seed to have been run.
# Log in as 'tester'; the password is in ~/.local/share/arch-distro-vm/<vm>.password.
set -euo pipefail
export LIBVIRT_DEFAULT_URI=qemu:///system
here=$(cd "$(dirname "$0")" && pwd); repo=$(dirname "$here")
vm=distro-clean from=l0-complete ref=HEAD keep=0 iso="" encrypt=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --vm) vm=$2; shift 2 ;; --from) from=$2; shift 2 ;;
    --ref) ref=$2; shift 2 ;; --keep) keep=1; shift ;;
    --iso) iso=$2; shift 2 ;;
    --encrypt) encrypt=1; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
key=~/.local/share/arch-distro-vm/id_ed25519
user=tester
log() { printf '\033[1m[test-install]\033[0m %s\n' "$*"; }

wait_ssh() { # wait_ssh <user> <timeout-seconds>
  local deadline=$((SECONDS + $2))
  until "$here/ssh" "$vm" "$1" -- true 2>/dev/null; do
    (( SECONDS < deadline )) || { log "timed out waiting for SSH as $1"; exit 1; }
    sleep 5
  done
}

[[ $(virsh domstate "$vm") == "shut off" ]] || virsh destroy "$vm" >/dev/null
log "restoring $vm to $from"
virsh snapshot-revert "$vm" "$from"
if [[ -n $iso ]]; then
  virsh change-media "$vm" sda "/var/lib/libvirt/images/$iso" --config >/dev/null
  log "booting $iso"
fi
virsh start "$vm" >/dev/null
wait_ssh root 300
log "live ISO reachable"

id=$(. "$repo/distro.conf"; echo "$DISTRO_ID")
if [[ -z $iso ]]; then
  tarball=$(mktemp); trap 'rm -f "$tarball"' EXIT
  git -C "$repo" archive --format=tar.gz -o "$tarball" "$ref"
  log "copying $(git -C "$repo" rev-parse --short "$ref") ($ref)"
  "$here/ssh" "$vm" -- 'rm -rf /root/src && mkdir -p /root/src'
  "$here/ssh" "$vm" -- 'tar -xzf - -C /root/src' < "$tarball"
  # Layer 6 and later install from distro packages, built here and copied along.
  if [[ -x $repo/pkg/build ]] && git -C "$repo" cat-file -e "$ref:pkg/build" 2>/dev/null; then
    log "building packages"
    "$repo/pkg/build" "$ref" >/dev/null
    tar -C "$repo" -czf - pkg/out/repo | "$here/ssh" "$vm" -- 'tar -xzf - -C /root/src'
  fi
  "$here/ssh" "$vm" -- 'cat > /root/tester.pub' < "$key.pub"

  installer="cd /root/src && install/install.sh"
else
  "$here/ssh" "$vm" -- 'cat > /root/tester.pub' < "$key.pub"
  installer="install-$id"
fi

# A throwaway password, saved outside the repo so the VM's console login works.
password=$(head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')
(umask 077; printf '%s\n' "$password" > ~/.local/share/arch-distro-vm/$vm.password)
"$here/ssh" "$vm" -- "umask 077; printf '%s' '$password' > /root/pw"

# Lowercase letters only, so it can be typed with virsh send-key.
passphrase=correcthorsebattery
crypt_args=""
if (( encrypt )); then
  "$here/ssh" "$vm" -- "umask 077; printf '%s' '$passphrase' > /root/luks"
  crypt_args="--encrypt /root/luks"
fi

log "installing"
started=$SECONDS
"$here/ssh" "$vm" -- "$installer --disk /dev/vda --user $user \
  --password-file /root/pw --ssh-key /root/tester.pub --timezone America/Chicago --autologin $crypt_args --yes" \
  || { log "INSTALL FAILED"; exit 1; }
log "install took $((SECONDS - started))s; rebooting into the installed system"

"$here/ssh" "$vm" -- 'umount -R /mnt; poweroff' || true
for _ in $(seq 60); do [[ $(virsh domstate "$vm") == "shut off" ]] && break; sleep 2; done
virsh start "$vm" >/dev/null
if (( encrypt )); then
  # Type the passphrase at the unlock prompt. Wait well past the boot menu
  # first (letters typed there would edit entries), and retry at most three times.
  type_passphrase() {
    local c; for c in $(grep -o . <<<"$passphrase"); do virsh send-key "$vm" "KEY_${c^^}" >/dev/null; done
    virsh send-key "$vm" KEY_ENTER >/dev/null
  }
  unlocked=0
  for attempt in 1 2 3; do
    sleep 25
    "$here/ssh" "$vm" "$user" -- true 2>/dev/null && { unlocked=1; break; }
    log "typing the disk passphrase (attempt $attempt)"
    type_passphrase
  done
  (( unlocked )) || wait_ssh "$user" 120
fi
wait_ssh "$user" 300

log "checks"
fail=0
check() { # check <description> <command run in the VM as the user>
  if out=$("$here/ssh" "$vm" "$user" -- "$2" 2>&1); then
    printf '  \033[32mok\033[0m   %s\n' "$1"
  else
    printf '  \033[31mFAIL\033[0m %s\n%s\n' "$1" "$(sed 's/^/         /' <<<"$out")"; fail=1
  fi
}
check "system state is running"        'state=$(systemctl is-system-running); echo $state; [ "$state" = running ]'
check "root is btrfs subvolume @"      'findmnt -no FSTYPE,OPTIONS / | grep -qE "btrfs.*subvol=/@(,|$)"'
check "separate subvolumes mounted"    'for m in /home /var/log /var/cache/pacman/pkg /.snapshots; do findmnt -n $m >/dev/null || exit 1; done'
check "booted by Limine (fallback path)" "echo '$password' | sudo -S -p '' sh -c 'test -f /boot/EFI/BOOT/BOOTX64.EFI && tr -d \\\\000 < /sys/firmware/efi/efivars/LoaderInfo-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f | grep -q Limine'"
check "zram swap active"               'swapon --show=NAME --noheadings | grep -q zram'
check "NetworkManager connected"       'nmcli -t -f STATE general | grep -q "^connected"'
check "internet reachable"             'curl -sfI https://archlinux.org -o /dev/null'
check "time synchronised service on"   'systemctl is-active --quiet systemd-timesyncd'
check "sudo works for $user"           "echo '$password' | sudo -S -p '' true"
check "root account locked"            "echo '$password' | sudo -S -p '' passwd -S root | grep -q ' L '"
check "/boot is root-only"           'test "$(stat -c %a /boot)" = 700'
if "$here/ssh" "$vm" "$user" -- "pacman -Q $id >/dev/null 2>&1"; then
  check "distro packages installed"     "pacman -Q $id $id-settings"
  check "package files intact"          "pacman -Qkk $id 2>&1 | grep -q ', 0 altered files'"
  check "login screen uses distro config" "systemctl cat greetd | grep -q -- '--config /etc/greetd/$id.toml'"
  check "hidden apps dir in XDG_DATA_DIRS" "systemctl --user show-environment | grep -q '^XDG_DATA_DIRS=/usr/share/$id/xdg'"
fi
if [[ -n $iso ]]; then
  check "installed from the ISO's installer" "pacman -Q $id | grep -q ."
fi
if "$here/ssh" "$vm" "$user" -- "pacman -Q firefox >/dev/null 2>&1"; then
  check "default apps installed"        "pacman -Q firefox nautilus >/dev/null"
  check "bluetooth service enabled"     "systemctl is-enabled --quiet bluetooth"
  check "VM has no vendor GPU drivers"  "! pacman -Q vulkan-radeon nvidia-utils vulkan-intel 2>/dev/null | grep -q ."
fi
if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/migrate"; then
  check "fresh install: system migrations marked" "echo '$password' | sudo -S -p '' $id migrate --system --list | grep -qv pending || true; ! (echo '$password' | sudo -S -p '' $id migrate --system --list | grep -q pending)"
  check "new user: user migrations marked"        "$id migrate --user --list | grep -q '^applied' && ! $id migrate --user --list | grep -q pending"
  check "migration service ran at login"          "systemctl --user show -p Result $id-migrate.service | grep -q success"
  # Simulate an update that ships one new user and one new system migration.
  "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' sh -c 'echo \"touch \\\$HOME/user-migration-ran\" > /usr/share/$id/migrations/user/29990101-0000-test.sh; echo \"touch /var/lib/$id/system-migration-ran\" > /usr/share/$id/migrations/system/29990101-0000-test.sh'" || true
  check "new user migration runs once"   "$id migrate --user >/dev/null && test -f ~/user-migration-ran && rm ~/user-migration-ran && $id migrate --user >/dev/null && ! test -f ~/user-migration-ran"
  check "new system migration runs"      "echo '$password' | sudo -S -p '' $id migrate --system >/dev/null && test -f /var/lib/$id/system-migration-ran"
  check "ghostty migration fixes an old config" "sed -i '/app-notifications/d; /announce it/d' ~/.config/ghostty/config && sed -i '/ghostty-quiet-reloads/d' ~/.local/state/$id/migrations-applied && $id migrate --user >/dev/null && grep -q '^app-notifications = no-config-reload' ~/.config/ghostty/config"
fi
if (( encrypt )); then
  check "root filesystem is on LUKS"   "lsblk -lno TYPE,NAME | grep -qE '^crypt +system$'"
  check "LUKS2 unlocked at boot"       "echo '$password' | sudo -S -p '' cryptsetup status system | grep -qE 'type: +LUKS2'"
fi
check "hostname from distro.conf"      "test \"\$(cat /etc/hostname)\" = \"$(. "$repo/distro.conf"; echo "$DISTRO_ID")\""

# Layer 2 and later: the desktop session.
if "$here/ssh" "$vm" "$user" -- 'test -x /usr/bin/Hyprland'; then
  hypr='export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-1; export HYPRLAND_INSTANCE_SIGNATURE=$(ls $XDG_RUNTIME_DIR/hypr | head -1);'
  # Give the autologin session a moment to come up.
  for _ in $(seq 30); do "$here/ssh" "$vm" "$user" -- 'pgrep -x Hyprland' >/dev/null 2>&1 && break; sleep 2; done
  check "login screen service active"   'systemctl is-active --quiet greetd'
  check "Hyprland running for $user"    'pgrep -u "$USER" -x Hyprland >/dev/null'
  check "Hyprland answers hyprctl"      "$hypr hyprctl monitors | grep -q '^Monitor'"
  check "session config loaded cleanly" "$hypr"' out=$(hyprctl configerrors); echo "$out"; [ -z "$(printf %s "$out" | tr -d "[:space:]")" ] || printf %s "$out" | grep -qi "no errors"'
  # pipewire-pulse starts on demand, so its socket is what should be listening.
  check "audio services running"        'systemctl --user is-active --quiet pipewire wireplumber pipewire-pulse.socket && wpctl status >/dev/null'
  if "$here/ssh" "$vm" "$user" -- 'test -x /usr/bin/noctalia'; then
    # Layer 3: the shell.
    check "shell service running"        'systemctl --user is-active --quiet noctalia'
    check "shell owns notifications"     'busctl --user status org.freedesktop.Notifications 2>/dev/null | grep -q "^Comm=noctalia"'
    check "notifications can be sent"    "$hypr"' notify-send "Test" "Hello from the install test"'
    check "shell answers its IPC"        "$hypr"' noctalia msg status >/dev/null'
    check "shell config has no errors"   "$hypr"' noctalia config validate 2>&1 | tail -3; noctalia config validate >/dev/null 2>&1'
    check "distro shell defaults applied" "$hypr"' noctalia config export | grep -qE "^polkit_agent *= *true"'
    check "clutter hidden from launcher"  "grep -q '^NoDisplay=true' /usr/local/share/applications/avahi-discover.desktop 2>/dev/null || grep -q '^NoDisplay=true' /usr/share/$id/xdg/applications/avahi-discover.desktop"
    # Every launcher entry must be one we mean to show; new dependency clutter fails here.
    check "launcher shows only intended apps" "for f in /usr/share/applications/*.desktop; do n=\${f##*/}; grep -q '^NoDisplay=true' \"\$f\" && continue; [ -f /usr/share/$id/xdg/applications/\$n ] && continue; echo \$n; done | sort | tr '\\n' ' ' | tee /dev/stderr | grep -qxE '(com.mitchellh.ghostty.desktop |dev.noctalia.Noctalia.desktop |firefox.desktop |org.gnome.Nautilus.desktop |org.wezfurlong.wezterm.desktop )+'"
    check "launcher opens"               "$hypr"' noctalia msg panel-open launcher'
  else
    check "polkit agent running"         'systemctl --user is-active --quiet hyprpolkitagent'
  fi
  if "$here/ssh" "$vm" "$user" -- "command -v $id" >/dev/null 2>&1; then
    term_cmd="$id terminal launch"; term_class=ghostty
  else
    term_cmd="uwsm app -- wezterm"; term_class=wezterm
  fi
  check "terminal opens a window"       "$hypr hyprctl dispatch 'hl.dsp.exec_cmd(\"$term_cmd\")' >/dev/null; for i in \$(seq 20); do hyprctl clients | grep -qi $term_class && exit 0; sleep 1; done; exit 1"
  check "screen-sharing portal available" "$hypr"' busctl --user introspect org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop | grep -q org.freedesktop.portal.ScreenCast'
  shots=~/.local/share/arch-distro-vm/screenshots; mkdir -p "$shots"
  screenshot() { # screenshot <label>
    local shot
    shot=$shots/$vm-$(date +%Y%m%d-%H%M%S)-$1.png
    if "$here/ssh" "$vm" "$user" -- "$hypr sleep 2; grim -" > "$shot" 2>/dev/null && [[ -s $shot ]]; then
      log "screenshot: $shot"
    else
      rm -f "$shot"; log "screenshot failed"
    fi
  }
  screenshot desktop

  if "$here/ssh" "$vm" "$user" -- "command -v $id" >/dev/null 2>&1; then
    # Layer 4 and later: the CLI and themes.
    for _ in $(seq 20); do "$here/ssh" "$vm" "$user" -- "test -f ~/.local/state/$id/first-login-done" && break; sleep 2; done
    check "CLI lists its commands"        "$id help | grep -q theme"
    check "first-login setup ran"         "test -f ~/.local/state/$id/first-login-done"
    check "default theme applied"         "$hypr $id theme current | grep -q '^ember (dark)'; noctalia msg color-scheme-get | grep -q 'custom $id-ember'"
    check "terminal theme generated"      'test -s ~/.config/ghostty/themes/noctalia'
    check "Hyprland borders from theme"   "$hypr test -s ~/.config/hypr/noctalia.lua && grep -q 'e0a458' ~/.config/hypr/noctalia.lua"
    check "GTK follows theme"             'test -s ~/.config/gtk-4.0/noctalia.css && [ "$(gsettings get org.gnome.desktop.interface icon-theme)" = "'"'"'Papirus-Dark'"'"'" ]'
    check "default terminal is ghostty"   "$id terminal list | grep -qE '^\* ghostty +installed'"
    check "switch theme to tide"          "$hypr $id theme set tide >/dev/null && sleep 2 && grep -q '6cb6d9' ~/.config/hypr/noctalia.lua && grep -qi '10161d' ~/.config/ghostty/themes/noctalia"
    screenshot tide
    check "switch to paper (light)"       "$hypr $id theme set paper >/dev/null && sleep 2 && noctalia msg theme-mode-get | grep -q light && [ \"\$(gsettings get org.gnome.desktop.interface icon-theme)\" = \"'Papirus-Light'\" ]"
    screenshot paper

    # Layer 5: crash inbox, agents, updates.
    "$here/ssh" "$vm" "$user" -- "$hypr $id theme set ember >/dev/null" || true
    check "crash watcher running"         "systemctl --user is-active --quiet $id-crash-watch"
    check "crash plugin enabled"          "$hypr noctalia msg plugins list 2>&1 | grep -E '$id/crashes' | grep -qiE 'enabled|on|yes|true'"
    check "a crash is captured"           "$id crash test >/dev/null; for i in \$(seq 20); do [ \"\$($id crash list --json | jq length)\" = 1 ] && exit 0; sleep 1; done; exit 1"
    check "capture has the coredump report" "f=\$($id crash list --json | jq -r '.[0].last_capture'); grep -q 'systemd-coredump report' \"\$f\" && grep -qi sleep \"\$f\""
    check "repeat crash is grouped"       "$id crash test >/dev/null; for i in \$(seq 20); do c=\$($id crash list --json | jq '[length, .[0].count] | @csv' -r); [ \"\$c\" = '1,2' ] && exit 0; sleep 1; done; echo \$c; exit 1"
    check "notified only once"            "$id crash list --json | jq -e '.[0].notified == true' >/dev/null"
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null 2>&1; noctalia msg panel-toggle $id/crashes:viewer >/dev/null 2>&1" || true
    screenshot crashes
    check "resolve empties the inbox"     "$hypr $id crash resolve \$($id crash list --json | jq -r '.[0].id') && [ \"\$($id crash list --json | jq length)\" = 0 ]"
    check "resolved crash returns and notifies" "$id crash test >/dev/null; for i in \$(seq 20); do $id crash list --json | jq -e '.[0].count == 3 and .[0].status == \"new\" and .[0].notified == true' >/dev/null && exit 0; sleep 1; done; exit 1"
    # AI usage: seed a week of Claude Code records and one Codex session, then read them back.
    "$here/ssh" "$vm" "$user" -- 'mkdir -p ~/.claude/projects/demo ~/.codex/sessions/demo; now=$(date +%s); : > ~/.claude/projects/demo/s.jsonl
      for d in 0 1 2 3 4 5 6; do for n in 1 2 3; do t=$(date -u -d "@$((now - d*86400 - n))" +%Y-%m-%dT%H:%M:%S.000Z)
        printf "{\"type\":\"assistant\",\"timestamp\":\"%s\",\"sessionId\":\"s%s\",\"message\":{\"id\":\"m%s-%s\",\"model\":\"%s\",\"usage\":{\"input_tokens\":%s,\"output_tokens\":2000,\"cache_creation_input_tokens\":5000,\"cache_read_input_tokens\":90000}}}\n" "$t" "$d" "$d" "$n" "$( [ $n = 3 ] && echo claude-haiku-4-5 || echo claude-opus-5-5 )" "$(( (7-d) * 40000 ))" >> ~/.claude/projects/demo/s.jsonl; done; done
      t=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
      printf "%s\n" "{\"timestamp\":\"$t\",\"type\":\"turn_context\",\"payload\":{\"model\":\"gpt-5-codex\"}}" "{\"timestamp\":\"$t\",\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"last_token_usage\":{\"input_tokens\":52000,\"cached_input_tokens\":12000,\"output_tokens\":8000}},\"rate_limits\":{\"primary\":{\"used_percent\":38,\"resets_in_seconds\":7400},\"secondary\":{\"used_percent\":91,\"resets_in_seconds\":300000}}}}" > ~/.codex/sessions/demo/rollout.jsonl'
    check "AI usage collected"            "$id agent usage --json | jq -e '(.agents | length) == 2 and (.agents[] | select(.name == \"claude\") | .today.messages == 3 and (.days | length) == 7 and (.models | length) == 2) and (.agents[] | select(.name == \"codex\") | (.limits | length) == 2)' >/dev/null"
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg plugin $id/agents:usage all refresh >/dev/null 2>&1; sleep 3; noctalia msg panel-close >/dev/null 2>&1; noctalia msg panel-toggle $id/agents:panel >/dev/null 2>&1" || true
    screenshot ai-usage
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg plugin $id/agents:panel all select codex >/dev/null 2>&1" || true
    screenshot ai-usage-codex
    # Screensaver: opens fullscreen over everything, closes on stop.
    if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/screensaver"; then
      check "screensaver engine installed" "command -v tte >/dev/null"
      check "screensaver opens fullscreen" "$hypr $id screensaver start; for i in \$(seq 20); do hyprctl clients -j | jq -e '.[] | select(.class == \"$id.screensaver\") | .fullscreen > 0' >/dev/null && exit 0; sleep 1; done; hyprctl clients -j | jq -c '.[] | {class, fullscreen}'; exit 1"
      "$here/ssh" "$vm" "$user" -- "sleep 3" || true
      screenshot screensaver
      check "screensaver closes on stop"   "$hypr $id screensaver stop; sleep 2; ! hyprctl clients | grep -q 'class: $id.screensaver'"
      check "idle runs the screensaver"    "$hypr noctalia config export | grep -A4 'idle.behavior.screensaver' | grep -q 'screensaver start'"
    fi
    check "agent list knows claude"       "$id agent list | grep -qE '^\\* claude'"
    check "update check runs"             "$id update check >/dev/null"
  fi

  # Last: logging out of the autologin session should bring up the login screen.
  check "logging out shows the login screen" "$hypr"' uwsm stop >/dev/null 2>&1; for i in $(seq 20); do pgrep -x tuigreet >/dev/null && exit 0; sleep 1; done; exit 1'
fi

if (( keep )); then log "leaving $vm running"; else "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' poweroff" || true; fi
(( fail )) && { log "FAILED"; exit 1; }
log "all checks passed"
