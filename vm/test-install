      check "menu: and back to SUPER+K" "$hypr hyprctl binds -j | jq -e 'any(.[]; .modmask == 64 and .key == \"K\" and (.description | test(\"Keyboard shortcuts\")))' >/dev/null && ! grep -q 'SUPER + Y' ~/.config/$id/hypr/binds.lua"
      key KEY_ESC
      # Install: search a repository package, Return installs it in a normal
      # terminal: snapshot line first, pacman, then a shell prompt that stays.
      key KEY_LEFTMETA KEY_SPACE; sleep 1
      vm_type "install"; key KEY_ENTER; sleep 1
      vm_type "cowsay"; sleep 3
      menu_is "menu: Install finds a repository package" '.path == ["Install"] and (.rows[0] == "[cowsay] · REPO") and (.count | test("results?$"))'
      screenshot menu-install
      key KEY_ENTER; sleep 4
      vm_type "$password"; key KEY_ENTER; sleep 6
      key KEY_ENTER
      check "menu: the install runs in a terminal" "for i in \$(seq 60); do pacman -Q cowsay >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1"
      sleep 3
      bar_shot menu-install-terminal
      check "menu: one snapshot pair for it, no second from snap-pac" "s=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns type,description); [ \$(grep -c '^pre,pacman -S cowsay\$' <<<\"\$s\") = 1 ] && [ \$(grep -c '^post,pacman -S cowsay\$' <<<\"\$s\") = 1 ] && ! grep -q 'cowsay' <<<\"\$(grep -v 'pacman -S cowsay\$' <<<\"\$s\")\""
      check "menu: the terminal stays open at a shell prompt" "$hypr hyprctl clients -j | jq -e 'any(.[]; .class == \"com.mitchellh.ghostty\")' >/dev/null && pgrep -u \$USER -fx '(/usr)?/bin/(bash|zsh|fish) -i' >/dev/null"
      if command -v tesseract >/dev/null && command -v magick >/dev/null; then
        rc=0; magick "$last_shot" -resize 200% -colorspace gray -negate png:- | tesseract - - --psm 6 2>/dev/null \
          | grep -qiE 'snapshot before install cowsay.*ok' || rc=1
        report "$rc" "menu: the terminal printed the snapshot line first"
      fi
      "$here/ssh" "$vm" "$user" -- "$hypr hyprctl dispatch 'hl.dsp.window.close()' >/dev/null" || true
      # The rounded shape: the menu's corners follow it.
      "$here/ssh" "$vm" "$user" -- "$hypr $id theme shape rounded >/dev/null; sleep 1" || true
      key KEY_LEFTMETA KEY_SPACE; sleep 1
      screenshot menu-rounded
      key KEY_ESC
      "$here/ssh" "$vm" "$user" -- "$hypr $id theme shape terminal >/dev/null" || true
      # Popovers (Frosted Terminal): opened with real
      # clicks from the VM's USB tablet and real keys; where each one landed
      # is read from screenshots taken with and without it.
      check "popovers: Noctalia's panels styled, corners follow the shape" "$hypr x=\$(noctalia config export); grep -qi 'border_color = \"#ebc77a61' <<<\"\$x\" && grep -qi 'border_color = \"#ebc77a79' <<<\"\$x\" && grep -q 'transparency_mode = \"soft\"' <<<\"\$x\" && grep -q 'sidebar_section = \"none\"' <<<\"\$x\" && grep -qx 'corner_radius_scale = 1.000' ~/.config/noctalia/00-$id-look.toml && $id theme shape rounded >/dev/null && grep -qx 'corner_radius_scale = 1.333' ~/.config/noctalia/00-$id-look.toml && sleep 1 && noctalia config export | grep -q 'corner_radius_scale = 1.33'; rc=\$?; $id theme shape terminal >/dev/null; exit \$rc"
      check "panels: the design's cards and buttons (dark inset cards, hairline buttons)" "$hypr x=\$(noctalia config export); grep -qi 'card_color = \"#070b178c' <<<\"\$x\" && grep -qi 'card_border_color = \"#e6e2d61f' <<<\"\$x\" && grep -qi 'button_color = \"#e6e2d60f' <<<\"\$x\" && grep -qi 'button_border_color = \"#e6e2d62e' <<<\"\$x\""
      check "popovers: the migration writes the look file on older installs" "$hypr rm -f ~/.config/noctalia/00-$id-look.toml && sed -i '/frosted-popovers/d' ~/.local/state/$id/migrations-applied && $id migrate --user >/dev/null && grep -q '^corner_radius_scale' ~/.config/noctalia/00-$id-look.toml"
      if command -v magick >/dev/null && command -v tesseract >/dev/null; then
        dbus="export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus;"
        read -r sw sh < <("$here/ssh" "$vm" "$user" -- "$hypr hyprctl monitors -j | jq -r '.[0] | \"\\(.width) \\(.height)\"'") || true
        qmp_input() { virsh qemu-monitor-command "$vm" "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[$1]}}" >/dev/null; }
        click() { # click <x> <y>: a real left click
          qmp_input "{\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$(( $1 * 32767 / (sw - 1) ))}},{\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$(( $2 * 32767 / (sh - 1) ))}}"
          sleep 0.3; qmp_input '{"type":"btn","data":{"down":true,"button":"left"}}'
          sleep 0.08; qmp_input '{"type":"btn","data":{"down":false,"button":"left"}}'; sleep 1
        }
        rclick() { # rclick <x> <y>: a real right click
          qmp_input "{\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$(( $1 * 32767 / (sw - 1) ))}},{\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$(( $2 * 32767 / (sh - 1) ))}}"
          sleep 0.3; qmp_input '{"type":"btn","data":{"down":true,"button":"right"}}'
          sleep 0.08; qmp_input '{"type":"btn","data":{"down":false,"button":"right"}}'; sleep 1
        }
        shot() { # shot <label>: a screenshot to $last_shot
          last_shot=$shots/$vm-$(date +%Y%m%d-%H%M%S)-$1.png
          "$here/ssh" "$vm" "$user" -- "$hypr grim -" > "$last_shot" 2>/dev/null || true
          log "screenshot: $last_shot"
        }
        # → "<w> <h> <x> <y>" of what differs from the screenshot without it, below the bar.
        popover_box() {
          magick "$1" "$2" -compose difference -composite -crop "${sw}x$((sh - 44))+0+44" +repage -colorspace gray -threshold 8% \
            -format '%@' info: | sed -E 's/^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$/\1 \2 \3 \4/' | awk '{ print $1, $2, $3, $4 + 44 }'
        }
        read_text() { # read_text <png> <crop> → the words in it
          magick "$1" -crop "$2" +repage -colorspace gray -resize 300% -negate -level 15%,85% png:- | tesseract - - --psm 6 2>/dev/null | tr '\n' ' ' || true
        }
        amber() { # amber <png> <crop> → amber pixels in it
          magick "$1" -crop "$2" +repage -fuzz 14% -fill black +opaque '#ebc77a' -fill white -opaque '#ebc77a' -colorspace gray -format '%[fx:round(mean*w*h)]' info:
        }
        centred_under() { # centred_under <w> <x> <segment x>: the popover's middle within 12px of it, or against a screen edge
          local mid=$(( $2 + $1 / 2 ))
          (( (mid - $3) <= 12 && ($3 - mid) <= 12 || $2 <= 12 || $2 + $1 >= sw - 12 ))
        }
        "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null 2>&1; $id workspaces go 9; sleep 1" || true
        click 640 600; shot popover-rest; rest=$last_shot

        # The calendar: the clock opens the calendar popover, under it.
        click "$((sw / 2))" 15
        check "calendar: a click on the clock opens it" "$hypr noctalia msg status | jq -e '.activePanelId == \"$id/utilities:calendar-panel\"' >/dev/null"
        shot calendar; read -r bw bh bx by < <(popover_box "$last_shot" "$rest") || true
        report "$(( ${bw:-0} > 300 && bw < 640 && by >= 34 && by <= 48 ? 0 : 1 ))" "calendar: under the bar (${bw:-?}x${bh:-?} at ${bx:-?},${by:-?})"
        report "$(centred_under "${bw:-0}" "${bx:-0}" "$((sw / 2))"; echo $?)" "calendar: centred under the clock"
        # Its cards are the design's dark inset cards: none of the palette's
        # lighter surface_variant (Moonlit #1d2742) that Noctalia fills them with.
        variant=$(magick "$last_shot" -crop "${bw:-1}x${bh:-1}+${bx:-0}+${by:-0}" +repage -fuzz 3% -fill black +opaque '#1d2742' -fill white -opaque '#1d2742' -colorspace gray -format '%[fx:round(mean*w*h)]' info: 2>/dev/null || echo -1)
        report "$(( variant >= 0 && variant < 400 ? 0 : 1 ))" "calendar: dark inset cards, not surface_variant ($variant px of it)"
        month=$("$here/ssh" "$vm" "$user" -- "date +%B")
        text=$(read_text "$last_shot" "${bw:-600}x${bh:-400}+${bx:-340}+${by:-38}")
        report "$(grep -qi "$month" <<<"$text"; echo $?)" "calendar: shows this month ($month; read: $(head -c 80 <<<"$text"))"
        report "$(grep -q 'CALENDAR' <<<"$text"; echo $?)" "calendar: in the popovers' look (── CALENDAR header)"
        check "calendar: the week starts on the locale's first day" "$hypr rm -f \$XDG_RUNTIME_DIR/$id-calendar.json; noctalia msg plugin $id/utilities:calendar-panel all dump >/dev/null 2>&1; sleep 0.5; [ \"\$(jq -r .first_day \$XDG_RUNTIME_DIR/$id-calendar.json)\" = \"\$(( \$(locale first_weekday) - 1 ))\" ]"
        key KEY_ESC
        check "calendar: Escape closes it" "$hypr sleep 0.5; noctalia msg status | jq -e '.panelOpen == false' >/dev/null"

        # Now playing: a test player (a small MPRIS service), the media segment
        # clicked, play and pause from the keyboard and the amber button.
        "$here/ssh" "$vm" "$user" -- "cat > ~/mpris-stub.py" < "$here/checks/mpris-stub.py"
        check "now playing: a test player is running" "$hypr $dbus ffmpeg -nostdin -loglevel error -y -f lavfi -i color=c=0x2c3e66:s=256x256 -frames:v 1 \$XDG_RUNTIME_DIR/$id-test-art.png && systemd-run --user --quiet --unit=$id-test-mpris python3 ~/mpris-stub.py \$XDG_RUNTIME_DIR/$id-test-art.png && for i in \$(seq 20); do [ \"\$(playerctl -p teststub status 2>/dev/null)\" = Playing ] && sleep 2 && exit 0; sleep 0.5; done; exit 1"
        shot media-segment
        mx=$(magick "$last_shot" -crop 900x30+0+0 +repage -colorspace gray -resize 400% -negate -level 20%,80% png:- | tesseract - - --psm 7 tsv 2>/dev/null \
          | awk -F'\t' '$12 == "Low" { print int(($7 + $9 / 2) / 4); exit }')
        report "$(( ${mx:-0} > 0 ? 0 : 1 ))" "now playing: the media segment shows the track (Low Tide at x ${mx:-?})"
        click "${mx:-200}" 15
        np_dump() { "$here/ssh" "$vm" "$user" -- "$hypr rm -f \$XDG_RUNTIME_DIR/$id-now-playing.json; noctalia msg plugin $id/utilities:now-playing all dump >/dev/null 2>&1; sleep 0.5; cat \$XDG_RUNTIME_DIR/$id-now-playing.json" 2>/dev/null; }
        np_is() { # np_is <description> <jq test on the dump>
          local d; d=$(np_dump)
          report "$(jq -e "$2" >/dev/null 2>&1 <<<"$d"; echo $?)" "$1"
          [[ $(jq -e "$2" 2>/dev/null <<<"$d") == true ]] || log "now playing: $d"
        }
        np_is "now playing: the click opens it with the title, artist and up next" '.open and .title == "Low Tide" and .artist == "Saltmarsh" and .queue == ["Breakwater", "Sodium Lamps", "Night Ferry"] and .position > 100'
        shot now-playing; read -r bw bh bx by < <(popover_box "$last_shot" "$rest") || true
        report "$(( ${bw:-0} >= 470 && by >= 34 && by <= 48 ? 0 : 1 ))" "now playing: under the bar (${bw:-?}x${bh:-?} at ${bx:-?},${by:-?})"
        report "$(centred_under 480 "${bx:-0}" "${mx:-0}"; echo $?)" "now playing: under the media segment"
        report "$(( $(amber "$last_shot" "160x1+$(( ${mx:-200} - 80 > 0 ? ${mx:-200} - 80 : 0 ))+27") >= 20 ? 0 : 1 ))" "now playing: the segment has the active underline while open"
        text=$(read_text "$last_shot" "${bw:-480}x${bh:-400}+${bx:-0}+${by:-38}")
        report "$(grep -q 'NOW PLAYING' <<<"$text" && grep -q 'Low Tide' <<<"$text"; echo $?)" "now playing: header and title drawn (read: $(head -c 100 <<<"$text"))"
        key KEY_SPACE
        check "now playing: space pauses" "$hypr $dbus sleep 0.5; [ \"\$(playerctl -p teststub status)\" = Paused ]"
        read -r px py < <(magick "$last_shot" -crop "${bw:-480}x${bh:-400}+${bx:-0}+${by:-38}" +repage -fuzz 14% -fill black +opaque '#ebc77a' -fill white -opaque '#ebc77a' -colorspace gray \
          -define connected-components:verbose=true -define connected-components:area-threshold=1000 -connected-components 8 null: 2>/dev/null \
          | awk -v ox="${bx:-0}" -v oy="${by:-38}" '/gray\(255\)/ { split($3, c, ","); if ($4 + 0 > best) { best = $4 + 0; x = c[1]; y = c[2] } } END { if (best) printf "%d %d\n", x + ox, y + oy }') || true
        click "${px:-0}" "${py:-0}"
        check "now playing: the amber button plays again (at ${px:-?},${py:-?})" "$hypr $dbus [ \"\$(playerctl -p teststub status)\" = Playing ]"
        key KEY_RIGHT
        np_is "now playing: Right seeks forward" '.position >= 140'
        key KEY_ESC
        np_is "now playing: Escape closes it" '.open == false'
        "$here/ssh" "$vm" "$user" -- "$hypr $id theme shape rounded >/dev/null; sleep 2" || true
        click "${mx:-200}" 25; shot now-playing-rounded; key KEY_ESC
        click "$((sw / 2))" 25; shot calendar-rounded; key KEY_ESC
        "$here/ssh" "$vm" "$user" -- "$hypr $id theme shape terminal >/dev/null; $id theme blur off >/dev/null; sleep 2" || true
        click "$((sw / 2))" 15; shot calendar-blur-off; key KEY_ESC
        click "${mx:-200}" 15; shot now-playing-blur-off; key KEY_ESC
        "$here/ssh" "$vm" "$user" -- "$hypr $id theme blur on >/dev/null" || true

        # The theme picker: opens on the theme in use, Right moves along, Down
        # shows the light colours of a theme with both, Escape closes it.
        tp_dump() { "$here/ssh" "$vm" "$user" -- "$hypr rm -f \$XDG_RUNTIME_DIR/$id-theme-picker.json; noctalia msg plugin $id/utilities:themes all dump >/dev/null 2>&1; sleep 0.5; cat \$XDG_RUNTIME_DIR/$id-theme-picker.json" 2>/dev/null; }
        tp_is() { # tp_is <description> <jq test on the dump>
          local d; d=$(tp_dump)
          report "$(jq -e "$2" >/dev/null 2>&1 <<<"$d"; echo $?)" "$1"
          [[ $(jq -e "$2" 2>/dev/null <<<"$d") == true ]] || log "theme picker: $d"
        }
        "$here/ssh" "$vm" "$user" -- "$hypr $id theme pick; sleep 2" || true
        tp_is "theme picker: opens on the theme in use, with every theme" '.open and .count >= 17 and .theme == "moonlit" and .mode == "dark" and (.picture | test("/themes/moonlit/"))'
        shot theme-picker
        text=$(read_text "$last_shot" "$((sw))x$((sh))+0+0")
        report "$(grep -q 'THEME' <<<"$text" && grep -q 'Moonlit' <<<"$text"; echo $?)" "theme picker: header and name drawn (read: $(head -c 100 <<<"$text"))"
        key KEY_RIGHT
        tp_is "theme picker: Right moves to the next theme" '.open and .theme != "moonlit"'
        key KEY_LEFT; key KEY_LEFT
        tp_is "theme picker: Left goes back past it" '.open and .theme != "moonlit"'
        for _ in $(seq 17); do d=$(tp_dump); [[ $(jq -r .theme <<<"$d") == paper ]] && break; key KEY_RIGHT; done
        key KEY_UP
        tp_is "theme picker: Up shows the other colours" '.theme == "paper" and .mode == "dark"'
        key KEY_ESC
        tp_is "theme picker: Escape closes it" '.open == false'
        check "theme picker: nothing changed without Enter" "$id theme current | grep -qx 'moonlit (dark)'"

        # A squeezed left lane: a toggle on beside the clock, a long window
        # title and the test player. The lane's text shortens to fit (our
        # Noctalia bar-fit patch) instead of being cut mid-glyph; the clock
        # stays centred.
        "$here/ssh" "$vm" "$user" -- "$hypr $dbus $id awake on >/dev/null; hyprctl dispatch 'hl.dsp.exec_cmd(\"ghostty --class=$id.squeeze --gtk-single-instance=false --title=quarterly-notes-on-the-tide-tables-and-harbour-schedule-final-draft.md -e sleep 300\")' >/dev/null; sleep 6" || true
        bar_shot bar-squeezed
        clock_centred "$last_shot" "a toggle on, a long title and media"
        read -r _ _ _ t < <(clock_lines "$last_shot")
        text=$(ocr "$last_shot" "$(( ${t:-640} > 40 ? ${t:-640} : 640 ))x30+0+0" 7)
        # How much room is left depends on the workspaces earlier steps
        # opened: the media text is whole, shortened with an ellipsis, or gone
        # (the title gives way first), but never cut off part-way.
        # (OCR reads the ellipsis as dots or an underscore.)
        if grep -qE 'Low T.*(…|\.|_)[^A-Za-z]*$' <<<"$text"; then state="shortened with an ellipsis"
        elif grep -q 'Saltmarsh' <<<"$text"; then state="whole"
        elif ! grep -q 'Low T' <<<"$text"; then state="hidden (no room)"
        else state=""; fi
        report "$([[ -n $state ]] && echo 0 || echo 1)" "squeezed: the media text, ${state:-cut off part-way} (read: $(tr '\n' ' ' <<<"$text" | head -c 120))"
        "$here/ssh" "$vm" "$user" -- "$hypr $dbus $id awake off >/dev/null; pkill -f -- '^(/usr/bin/)?ghostty --class=${id}[.]squeeze'; systemctl --user stop $id-test-mpris; sleep 2" || true

        # The volume pill: the volume key, then gone on its own.
        v0=$("$here/ssh" "$vm" "$user" -- "$hypr wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{ print int(\$2 * 100 + 0.5) }'")
        "$here/ssh" "$vm" "$user" -- "$hypr wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.5" || true
        virsh send-key "$vm" KEY_VOLUMEUP >/dev/null; sleep 0.4; shot osd
        n=$(amber "$last_shot" "300x80+$((sw / 2 - 150))+$((sh - 80))"); text=$(read_text "$last_shot" "300x80+$((sw / 2 - 150))+$((sh - 80))")
        report "$(( n >= 60 ? 0 : 1 ))" "volume key: the pill at the bottom centre, amber cells (amber $n; read: $text)"
        report "$(grep -qiE 'v[o0][l.|]' <<<"$text" && grep -q 55 <<<"$text"; echo $?)" "volume key: VOL and the new level, 55"
        check "volume key: the volume went up 5%" "$hypr wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q '0.55'"
        sleep 3; shot osd-gone
        n=$(amber "$last_shot" "300x80+$((sw / 2 - 150))+$((sh - 80))")
        report "$(( n < 10 ? 0 : 1 ))" "volume key: the pill goes away by itself (amber $n)"
        virsh send-key "$vm" KEY_MUTE >/dev/null; sleep 0.4; shot osd-mute
        text=$(read_text "$last_shot" "300x80+$((sw / 2 - 150))+$((sh - 80))")
        report "$(grep -qi mute <<<"$text"; echo $?)" "mute key: the pill says mute (read: $text)"
        "$here/ssh" "$vm" "$user" -- "$hypr wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ ${v0:-50}%" || true

        # The notification center: a notification with actions, the bell, do not disturb.
        "$here/ssh" "$vm" "$user" -- "$hypr $dbus noctalia msg notification-dnd-set off >/dev/null; setsid -f notify-send -a Updates -A now='update now' -A later=tonight 'Updates ready' '12 packages are ready.' >/dev/null 2>&1 </dev/null; sleep 1.5" || true
        shot notification-toast
        sleep 8; click 640 600; shot bell-unread
        # The right lane, clear of the clock's light amber; close to the amber
        # only, as the crash indicator's coral is near it.
        read -r dw _ dx _ < <(magick "$last_shot" -crop "$((sw * 2 / 5))x28+$((sw * 3 / 5))+1" +repage -fuzz 7% -fill black +opaque '#ebc77a' -fill white -opaque '#ebc77a' -format '%@' info: | sed -E 's/^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$/\1 \2 \3 \4/') || true
        bell=$(( sw * 3 / 5 + ${dx:-0} + ${dw:-0} / 2 - 6 ))
        report "$(( ${dw:-0} > 0 && ${dw:-0} < 12 ? 0 : 1 ))" "bell: an amber dot for the unread notification (x $bell)"
        click "$bell" 15
        check "notifications: a click on the bell opens them" "$hypr noctalia msg status | jq -e '.activePanelId == \"$id/utilities:notify-panel\"' >/dev/null"
        shot notifications; read -r bw bh bx by < <(popover_box "$last_shot" "$rest") || true
        text=$(read_text "$last_shot" "${bw:-500}x${bh:-400}+${bx:-700}+${by:-38}")
        report "$(grep -q 'Updates ready' <<<"$text" && grep -q NOTIFICATIONS <<<"$text"; echo $?)" "notifications: the popover lists it under its header (read: $(head -c 100 <<<"$text"))"
        report "$(( ${by:-0} >= 34 && ${by:-0} <= 48 ? 0 : 1 ))" "notifications: under the bar (${bw:-?}x${bh:-?} at ${bx:-?},${by:-?})"
        report "$(centred_under "${bw:-0}" "${bx:-0}" "$bell"; echo $?)" "notifications: under the bell"
        # Do not disturb: the bell's right-click (the popover also has a switch).
        key KEY_ESC; rclick "$bell" 15
        check "notifications: do not disturb from the bell" "$hypr [ \"\$(noctalia msg notification-dnd-status)\" = on ]"
        shot notifications-dnd
        "$here/ssh" "$vm" "$user" -- "$hypr $id theme shape rounded >/dev/null; sleep 2" || true
        key KEY_ESC; click "$bell" 25; shot notifications-rounded; key KEY_ESC
        "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg notification-dnd-set off >/dev/null; $id theme shape terminal >/dev/null; noctalia msg panel-close >/dev/null 2>&1" || true
      else
        log "no magick or tesseract here: skipping the popover checks"
      fi
      check "plugins load without errors" "journalctl --user -u noctalia -b --no-pager | grep -E '\\[luau\\]|script-runtime.*(error|failed)' | grep '$id/' ; ! journalctl --user -u noctalia -b --no-pager | grep -E '\\[luau\\]|script-runtime.*(error|failed)' | grep -q '$id/'"
      check "keyboard layouts switch"      "$hypr $id keyboard add de >/dev/null && sleep 1 && hyprctl devices -j | jq -e '[.keyboards[] | select(.main)][0].layout == \"us,de\"' >/dev/null && $id keyboard next && sleep 1 && hyprctl devices -j | jq -r '.keyboards[] | select(.main) | .active_keymap' | grep -q German"
      screenshot keyboard-layout
      check "keyboard layout removed"      "$hypr $id keyboard remove de >/dev/null && sleep 1 && hyprctl devices -j | jq -e '[.keyboards[] | select(.main)][0].layout == \"us\"' >/dev/null"
      check "displays: scale, arrangement, profile, hotplug" "$(sed "s/@ID@/$id/g" "$here/checks/displays.sh")"
      "$here/ssh" "$vm" "$user" -- "$hypr $id menu 'Setup › Displays' >/dev/null; sleep 1" || true
      screenshot displays-menu
      "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null" || true
      check "display size: density default, scale, keep or go back" "$(sed "s/@ID@/$id/g" "$here/checks/display-size.sh")"
      # The first-login step on its own: the choices, then Larger applied with
      # the keep-or-go-back question, then back to 100% on its own.
      check "display size step opens" "$hypr hyprctl dispatch 'hl.dsp.exec_cmd(\"ghostty --class=$id.sizetest -e $id setup welcome --only display-size\")' >/dev/null; for i in \$(seq 20); do hyprctl clients -j | jq -e '.[] | select(.class == \"$id.sizetest\")' >/dev/null && sleep 2 && exit 0; sleep 1; done; exit 1"
      screenshot setup-display-size
      check "display size step previews Larger" "$hypr hyprctl dispatch 'hl.dsp.focus({ window = \"class:^$id.sizetest\$\" })' >/dev/null; sleep 0.3; wtype -k Down; wtype -k Return; sleep 2; hyprctl monitors -j | jq -e '.[0].scale == 1.25' >/dev/null"
      screenshot setup-display-size-keep
      check "display size step goes back unanswered" "$hypr sleep 11; hyprctl monitors -j | jq -e '.[0].scale == 1' >/dev/null"
      screenshot setup-display-size-back
      check "display size step closes" "$hypr pkill -f -- '^(/usr/bin/)?ghostty --class=${id}[.]sizetest'; true"
      check "launcher opens apps as their own units" "$(sed "s/@ID@/$id/g" "$here/checks/launcher-apps.sh")"
      check "idle: lock stays up; inhibitors respected" "$(sed "s/@ID@/$id/g" "$here/checks/idle.sh")"
      if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/power"; then
        check "idle counts again after a video" "$(sed "s/@ID@/$id/g" "$here/checks/idle-rearm.sh")"
        check "lid binds: external monitor only" "$hypr hyprctl binds -j | jq -e '[.[] | select(.key == \"switch:on:Lid Switch\" or .key == \"switch:off:Lid Switch\")] | length == 2' >/dev/null"
        check "battery warning at 20%"       "$hypr noctalia config export | grep -A2 '^\[battery\]' | grep -q 'warning_threshold = 20'"
        check "charge limit: says when unsupported" "$id power charge-limit 80 2>&1 | grep -q \"doesn't support a charge limit\""
        check "charge limit: 'on' accepted, status leads with the kind" "$id power charge-limit on 2>&1 | grep -q \"doesn't support a charge limit\" && $id power charge-limit | grep -qx 'Charge limit: no battery'"
        check "charge limit re-applied at boot" "test -L /usr/lib/systemd/system/multi-user.target.wants/$id-charge-limit.service && systemctl cat $id-charge-limit.service >/dev/null && test -x /usr/lib/systemd/system-sleep/$id-charge-limit"
        if (( encrypt )); then
          check "hibernate: swap file and resume" "echo '$password' | sudo -S -p '' $id power hibernate enable >/dev/null && swapon --show=NAME --noheadings | grep -qx /swap/swapfile && echo '$password' | sudo -S -p '' grep -q 'resume=UUID=.* resume_offset=' /boot/limine.conf"
          check "hibernate: off again"        "echo '$password' | sudo -S -p '' $id power hibernate disable >/dev/null && ! swapon --show=NAME --noheadings | grep -q /swap/swapfile && ! echo '$password' | sudo -S -p '' grep -q 'resume_offset=' /boot/limine.conf && ! grep -q /swap /etc/fstab"
        else
          check "hibernate: refused unencrypted" "echo '$password' | sudo -S -p '' $id power hibernate enable 2>&1 | grep -q 'only offered on encrypted installs'"
        fi
      fi
      # The lock: the screensaver plays behind a real session lock; the
      # password (typed like a person would) unlocks it.
      check "lock packages installed"       "pacman -Q swaylock-plugin windowtolayer >/dev/null"
      check "lock recovery key works while locked" "$hypr hyprctl binds -j | jq -e '.[] | select(.key == \"L\" and .modmask == 12 and .locked == true)' >/dev/null"
      check "lock engages"                  "$hypr $id lock && pgrep -x swaylock-plugin >/dev/null"
      locked_at=$SECONDS
      # The prompt pill (Frosted Terminal): low on the
      # screen, `tester@<host> password:` and a row of dots, nothing else (no
      # clock, no chips). It shows for 3 s from the screensaver's first frame,
      # fades out over 1.5 s, pops back at once at any key and fades again 5 s
      # after the last; the hint line shows with it once a key was pressed.
      # These grab the screen at once and read bands of it here on the host
      # (the busy animation defeats OCR on the whole screen).
      quick_shot() { # quick_shot <label>
        local f; f=$shots/$vm-$(date +%Y%m%d-%H%M%S)-$1.png
        "$here/ssh" "$vm" "$user" -- "$hypr grim -" > "$f" 2>/dev/null || true
        log "screenshot: $f"; last_shot=$f
      }
      # OCR one horizontal band of a screenshot: band_says <png> <top per mille>
      # <height per mille> <regex> [width per mille, centred; default 600].
      # 0 = found, 1 = not found, 2 = no OCR tools.
      band_says() {
        local w h crop rc=1 bw=${5:-600}
        command -v tesseract >/dev/null && command -v magick >/dev/null || return 2
        read -r w h < <(magick identify -format '%w %h' "$1")
        crop=$(mktemp --suffix=.png)
        magick "$1" -crop "$((w * bw / 1000))x$((h * $3 / 1000))+$((w * (1000 - bw) / 2000))+$((h * $2 / 1000))" +repage -resize 300% -colorspace gray -negate "$crop"
        if tesseract "$crop" - --psm 6 2>/dev/null | grep -qiE "$4"; then rc=0; fi
        rm -f "$crop"; return "$rc"
      }
      # On the 1280x800 VM screen the pill is 500x56, its bottom 96 px above
      # the screen's: y 648-704; the Caps Lock and hint lines are under it
      # (read through a narrow crop, clear of the screensaver's art beside them).
      pill_says() { band_says "$1" 805 90 "$2"; }
      hint_seen() { band_says "$1" 885 60 unlock 240; }
      # Pixels of one colour inside the pill (fuzz 4%); lit_dots counts the
      # separate blobs of the lit-key colour, minus one for the block cursor.
      pill_colour() { # pill_colour <png> <#rrggbb> → pixel count
        magick "$1" -crop 520x60+380+646 +repage -fuzz 4% -fill black +opaque "$2" -fill white -opaque "$2" -colorspace gray -format '%[fx:round(mean*w*h)]' info:
      }
      blobs() { # blobs <png> → "<w>x<h>" of each blob of the lit-key colour in the pill
        magick "$1" -crop 520x60+380+646 +repage -fuzz 4% -fill black +opaque '#e6e2d6' -fill white -opaque '#e6e2d6' -colorspace gray \
          -define connected-components:verbose=true -define connected-components:area-threshold=3 -connected-components 8 null: 2>/dev/null \
          | awk '/gray\(255\)/ { sub(/\+.*/, "", $2); print $2 }'
      }
      lit_dots() { # lit_dots <png> → lit dots
        local n; n=$(blobs "$1" | wc -l); echo $((n - 1))
      }
      # The pill is gone: OCR reads no prompt in its band and its block cursor
      # (an 8-10 x 17-19 px blob of the key colour; the screensaver's blocks
      # are 10x22) is not there. 0 = gone.
      pill_gone() { # pill_gone <png>
        local rc=0
        pill_says "$1" 'password|tester' && return 1
        blobs "$1" | grep -qE '^(8|9|10)x(17|18|19)$' && rc=1
        return "$rc"
      }
      # The pill is there: OCR reads its prompt, or (when the screensaver's
      # lines cross the text) its block cursor is there. 0 = shown.
      pill_shown() { # pill_shown <png>
        pill_says "$1" 'tester|password' && return 0
        blobs "$1" | grep -qE '^(8|9|10)x(17|18|19)$'
      }
      # Waits until <seconds> after <start> (bash's SECONDS).
      wait_until() { local d=$(( $1 + $2 - SECONDS )); (( d > 0 )) && sleep "$d"; return 0; }
      have_ocr=0; command -v tesseract >/dev/null && command -v magick >/dev/null && have_ocr=1
      if (( ! have_ocr )); then log "no tesseract/magick here: skipping the lock screen checks"; fi
      if (( have_ocr )); then
        # Right after the lock: the pill, for 3 s from the first frame.
        rc=1
        for i in 1 2 3 4 5 6 7 8; do
          quick_shot lock-start
          pill_says "$last_shot" 'tester@.*password' && { rc=0; break; }
          (( SECONDS - locked_at >= 4 )) && break
        done
        report "$rc" "lock: the prompt pill right after locking (tester@host password:)"
        rc=0; band_says "$last_shot" 0 600 '[0-2][0-9]:[0-5][0-9]|BAT|NOTIFY|SESSION' || rc=$?
        report "$(( rc == 1 ? 0 : 1 ))" "lock: no clock or chips above it"
        rc=0; hint_seen "$last_shot" || rc=$?
        report "$(( rc == 1 ? 0 : 1 ))" "lock: no hint before a key"
        report "$(( $(lit_dots "$last_shot") == 0 ? 0 : 1 ))" "lock: no dot lit before a key"
      fi
      check "lock: the screensaver plays behind it" "for i in \$(seq 20); do pgrep -x windowtolayer >/dev/null && pgrep -x tte >/dev/null && exit 0; sleep 1; done; pgrep -a windowtolayer; pgrep -a tte; exit 1"
      wait_until "$locked_at" 7
      quick_shot lock-idle
      if (( have_ocr )); then
        rc=0; pill_gone "$last_shot" || rc=$?
        report "$rc" "lock: the pill has faded out, the screensaver alone (7 s after locking)"
      fi
      # While idle and hidden nothing is redrawn: swaylock-plugin's CPU over
      # 10 s (it still passes the screensaver's frames on).
      cpu=$("$here/ssh" "$vm" "$user" -- 'p=$(pgrep -n -x swaylock-plugin); t() { awk "{print \$14 + \$15}" /proc/$p/stat; }; a=$(t); sleep 10; b=$(t); awk -v d=$((b - a)) -v hz="$(getconf CLK_TCK)" "BEGIN { printf \"%.1f\", d * 100 / hz / 10 }"' 2>/dev/null) || cpu=""
      c=${cpu%.*}; report "$(( ${c:-100} <= 15 ? 0 : 1 ))" "lock: hidden while idle, swaylock-plugin uses ${cpu:-?}% of a core (it passes the screensaver's frames on)"
      if (( have_ocr )); then
        vm_type "a"; quick_shot lock-key
        rc=0; pill_shown "$last_shot" || rc=$?
        report "$rc" "lock: a key brings the pill back at once"
        n=$(lit_dots "$last_shot")
        report "$(( n == 1 ? 0 : 1 ))" "lock: one key, one dot lit (lit $n)"
        vm_type "bc"; quick_shot lock-typing
        rc=0; hint_seen "$last_shot" || rc=$?
        report "$rc" "lock: hint under the pill while typing"
        n=$(lit_dots "$last_shot")
        report "$(( n == 1 ? 0 : 1 ))" "lock: 3 keys typed, one dot lit, never the count (lit $n)"
        vm_type "defg"; typed_at=$SECONDS; quick_shot lock-typing-more
        n=$(lit_dots "$last_shot")
        report "$(( n == 1 ? 0 : 1 ))" "lock: 7 keys typed, still one dot lit (lit $n)"
        sleep 3; quick_shot lock-lingering
        rc=0; pill_shown "$last_shot" || rc=$?
        report "$rc" "lock: still shown 3 s after the last key"
        wait_until "$typed_at" 6; quick_shot lock-fading
        wait_until "$typed_at" 8; quick_shot lock-typed-gone
        rc=0; pill_gone "$last_shot" || rc=$?
        report "$rc" "lock: faded out again 8 s after the last key"
        # The typed text is cleared 10 s after the last key, unseen.
        wait_until "$typed_at" 12; quick_shot lock-autoclear
        rc=0; pill_gone "$last_shot" || rc=$?
        report "$rc" "lock: clearing the unsent text doesn't bring the pill back"
      fi
      vm_type "xyz"; virsh send-key "$vm" KEY_ENTER >/dev/null
      # A wrong password: coral border and text once PAM has answered.
      coral=0
      for i in 1 2 3 4 5 6; do
        sleep 0.5; quick_shot lock-wrong
        command -v magick >/dev/null || break
        coral=$(pill_colour "$last_shot" '#f0a39a'); (( coral >= 300 )) && break
      done
      wrong_at=$SECONDS
      if (( have_ocr )); then
        report "$(( coral >= 300 ? 0 : 1 ))" "lock: wrong password turns the pill coral (coral $coral)"
        rc=0; pill_says "$last_shot" 'wrong' || rc=$?
        report "$rc" "lock: says wrong password"
        sleep 1.5; quick_shot lock-wrong-later
        coral=$(pill_colour "$last_shot" '#f0a39a')
        report "$(( coral >= 300 ? 0 : 1 ))" "lock: still coral 1.5 s later (coral $coral)"
        wait_until "$wrong_at" 6; quick_shot lock-wrong-lingering
        rc=0; pill_shown "$last_shot" || rc=$?
        report "$rc" "lock: the pill stays 5 s past the wrong password"
        wait_until "$wrong_at" 11; quick_shot lock-wrong-gone
        rc=0; pill_gone "$last_shot" || rc=$?
        report "$rc" "lock: then fades out (11 s after the wrong password)"
      fi
      # Caps Lock on its own brings the pill back, with its line under it.
      virsh send-key "$vm" KEY_CAPSLOCK >/dev/null; quick_shot lock-capslock
      if (( have_ocr )); then
        rc=0; pill_shown "$last_shot" || rc=$?
        report "$rc" "lock: Caps Lock brings the pill back"
        rc=0; band_says "$last_shot" 880 60 'caps' 240 || rc=$?
        report "$rc" "lock: Caps Lock is on, under the pill"
      fi
      virsh send-key "$vm" KEY_CAPSLOCK >/dev/null; virsh send-key "$vm" KEY_ESC >/dev/null; quick_shot lock-cleared; sleep 1
      vm_type "$password"; virsh send-key "$vm" KEY_ENTER >/dev/null; sleep 5
      check "password unlocks; animation ends" "! pgrep -x swaylock-plugin >/dev/null && sleep 3 && ! pgrep -x windowtolayer >/dev/null && ! pgrep -x tte >/dev/null"
      # lock.indicator = ring keeps the ring, which appears with the first key.
      check "lock: the ring setting locks too" "$hypr echo 'lock.indicator = ring' >> ~/.config/$id/settings && $id lock && sleep 3 && pgrep -x swaylock-plugin >/dev/null"
      vm_type "ab"; quick_shot lock-ring
      if command -v magick >/dev/null; then
        n=$(magick "$last_shot" -crop 260x260+510+270 +repage -fuzz 6% -fill black +opaque '#ebc77a' -fill white -opaque '#ebc77a' -colorspace gray -format '%[fx:round(mean*w*h)]' info:)
        report "$(( n >= 1000 ? 0 : 1 ))" "lock: the amber ring at the centre while typing (amber $n)"
        rc=0; pill_says "$last_shot" 'password' || rc=$?
        report "$(( rc == 1 ? 0 : 1 ))" "lock: no pill with the ring"
      fi
      virsh send-key "$vm" KEY_ESC >/dev/null; sleep 0.5
      vm_type "$password"; virsh send-key "$vm" KEY_ENTER >/dev/null; sleep 5
      check "lock: the password unlocks the ring" "! pgrep -x swaylock-plugin >/dev/null && sed -i '/^lock.indicator = ring\$/d' ~/.config/$id/settings && ! grep -q '^lock.indicator' ~/.config/$id/settings"
      # Fail closed: without the screensaver lock, Noctalia's lock takes over.
      "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' mv /usr/bin/swaylock-plugin /usr/bin/swaylock-plugin.off" || true
      check "falls back to Noctalia's lock" "$hypr $id lock; sleep 3; noctalia msg status | jq -e '.. | objects | select(has(\"locked\")) | .locked == true' >/dev/null"
      # A new Noctalia build arriving now must not restart the shell under its
      # own lock screen: the restart waits for the unlock.
      shell_pid=$("$here/ssh" "$vm" "$user" -- 'systemctl --user show -P MainPID noctalia' 2>/dev/null || true)
      check "shell restart waits while Noctalia's lock is up" "$hypr echo '$password' | sudo -S -p '' /usr/lib/$id/shell-reload --noctalia; sleep 4; [ \"\$(systemctl --user show -P MainPID noctalia)\" = '$shell_pid' ] && noctalia msg status | jq -e '.locked == true' >/dev/null && systemctl --user is-active --quiet $id-shell-restart"
      vm_type "$password"; virsh send-key "$vm" KEY_ENTER >/dev/null; sleep 4
      check "shell restarts once unlocked" "$hypr for i in \$(seq 20); do p=\$(systemctl --user show -P MainPID noctalia); [ \"\$p\" != '$shell_pid' ] && [ \"\$p\" != 0 ] && noctalia msg status >/dev/null 2>&1 && ! noctalia msg status | jq -e '.locked == true' >/dev/null && exit 0; sleep 1; done; exit 1"
      "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' mv /usr/bin/swaylock-plugin.off /usr/bin/swaylock-plugin" || true
    fi
    check "agent list knows claude"       "$id agent list | grep -qE '^\\* claude'"
    check "SUPER+A opens the coding agent" "$hypr $id keys --list --json | jq -e 'any(.[]; .chord == \"SUPER + A\" and (.description | test(\"coding agent\")))' >/dev/null"
    check "update check runs"             "$id update check >/dev/null"
    # The daily update check is opt-in: off by default; on enables a user timer
    # whose run writes the waiting count the menu and the bar read.
    check "update auto-check: off by default" "[ \"\$($id update auto-check)\" = 'checking for updates daily: off' ] && ! systemctl --user is-enabled --quiet $id-update-check.timer"
    check "update auto-check: on enables the daily timer" "$hypr $id update auto-check on >/dev/null && systemctl --user is-enabled --quiet $id-update-check.timer && systemctl --user is-active --quiet $id-update-check.timer && grep -qx 'update.auto_check = on' ~/.config/$id/settings"
    check "update auto-check: a run writes the count" "rm -f ~/.local/state/$id/updates; $hypr systemctl --user start $id-update-check.service && grep -qE '^[0-9]+ [0-9]+\$' ~/.local/state/$id/updates && ! journalctl --user -u $id-update-check.service -b --no-pager | grep -q 'aur:'"
    "$here/ssh" "$vm" "$user" -- "$hypr echo \"3 \$(date +%s)\" > ~/.local/state/$id/updates; noctalia msg plugin $id/utilities:menu-button all refresh >/dev/null 2>&1; sleep 1" || true
    bar_shot update-dot
    check "update auto-check: off disables it" "$hypr $id update auto-check off >/dev/null && ! systemctl --user is-enabled --quiet $id-update-check.timer && ! systemctl --user is-active --quiet $id-update-check.timer"
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null 2>&1" || true
    key KEY_LEFTMETA KEY_SPACE; sleep 1; vm_type "daily"; sleep 0.5
    menu_is "update auto-check: the menu finds its item" '.rows[0] == "System › Check for updates [daily]"'
    key KEY_ENTER; sleep 2
    check "update auto-check: the menu's item turns it on" "systemctl --user is-enabled --quiet $id-update-check.timer && $hypr $id update auto-check off >/dev/null"
    # Security fixes: off by default; install mode turns on the user timer
    # (notifications) and the system one (installs). A made-up feed with a
    # fix for bash finds it waiting, the unattended update runs, and off
    # turns both off again. (The feed's download may fail before the
    # repository is public; the last copy is used.)
    sp="echo '$password' | sudo -S -p ''"
    # The CLI's own sudo calls get the password through an exported wrapper.
    sudo_fn="sudo() { printf '%s\\n' '$password' | command sudo -S -p '' \"\$@\"; }; export -f sudo;"
    fakefeed='{"version":1,"generated":"2026-10-28T00:00:00Z","advisories":[{"id":"CVE-0000-0001","pkg":"bash","fixed":"99-1","score":9.8,"summary":"test advisory"}]}'
    check "security fixes: off by default" "$id update security | grep -q 'arrive with your own updates' && ! systemctl --user is-enabled --quiet $id-security-fixes.timer && test ! -e /etc/$id/security-updates && systemctl is-active --quiet $id-security-update.timer"
    check "security fixes: install turns on both timers" "$sudo_fn $hypr $id update security install >/dev/null && grep -qx install /etc/$id/security-updates && systemctl --user is-active --quiet $id-security-fixes.timer && systemctl is-active --quiet $id-security-update.timer && grep -qx 'update.security = install' ~/.config/$id/settings"
    check "security fixes: a waiting fix is found" "mkdir -p ~/.local/state/$id && printf '%s\n' '$fakefeed' > ~/.local/state/$id/advisories.json && $hypr $id update security check --cached | grep -q 'bash .* -> 99-1  CVE-0000-0001 (9.8)' && grep -q '^bash ' ~/.local/state/$id/security"
    check "security fixes: the unattended update runs" "printf '%s\n' '$fakefeed' > /tmp/fakefeed.json && $sp install -D -m 644 /tmp/fakefeed.json /var/lib/$id/advisories.json && $sp $id update security apply 2>&1 | tee /dev/stderr | grep -q 'updated [0-9]* package' && $sp test -s /var/lib/$id/security-installed"
    check "security fixes: the system service starts cleanly" "$sp systemctl start $id-security-update.service && ! systemctl is-failed --quiet $id-security-update.service"
    check "security fixes: off turns both off" "$sudo_fn $hypr $id update security off >/dev/null && test ! -e /etc/$id/security-updates && ! systemctl --user is-enabled --quiet $id-security-fixes.timer && test ! -e ~/.local/state/$id/security"
    # Pre-checks: offline, a wrong clock and an untrusted
    # key each give one plain message instead of pacman errors. Offline runs
    # detached (it takes the network away from this SSH session too).
    fpr=$(cat "$repo/pkg/keyring/fingerprint")
    sp="echo '$password' | sudo -S -p ''"
    "$here/ssh" "$vm" "$user" -- "$sp systemd-run --unit=$id-offline-test --collect --setenv=HOME=/root sh -c 'sleep 2; nmcli networking off; sleep 3; /usr/bin/$id update check > /run/$id-offline.out 2>&1; echo \$? > /run/$id-offline.rc; nmcli networking on'" >/dev/null 2>&1 || true
    sleep 25; wait_ssh "$user" 120
    check "update: offline says so plainly"  "cat /run/$id-offline.out; [ \"\$(cat /run/$id-offline.rc)\" != 0 ] && grep -q \"You're offline\" /run/$id-offline.out && ! grep -qi 'failed to retrieve' /run/$id-offline.out"
    check "update: a wrong clock is explained" "before=\$(date +%s); $sp timedatectl set-ntp false; $sp date -s @\$((before - 31536000)) >/dev/null; out=\$($id update check 2>&1); rc=\$?; now=\$(date +%s); $sp date -s @\$((now + 31536000)) >/dev/null; $sp timedatectl set-ntp true; printf '%s\n' \"\$out\" | tail -4; [ \$rc != 0 ] && grep -q 'The clock says' <<<\"\$out\" && grep -q 'actually about' <<<\"\$out\""
    check "update: a stale repository database recovers" "$sp sh -c 'printf stale > /var/lib/pacman/sync/$id.db; touch -d tomorrow /var/lib/pacman/sync/$id.db'; $sp env HOME=/root /usr/bin/$id update doctor 2>&1 | tail -3; $sp pacman-key --verify /var/lib/pacman/sync/$id.db.sig /var/lib/pacman/sync/$id.db >/dev/null 2>&1"
    check "migration drops a stale repository database" "$sp sh -c 'printf stale > /var/lib/pacman/sync/$id.db; DISTRO_REPO=$id bash /usr/share/$id/migrations/system/20261011-1000-stale-repo-database.sh'; [ ! -e /var/lib/pacman/sync/$id.db ] && $sp pacman -Sy >/dev/null 2>&1 && $sp pacman-key --verify /var/lib/pacman/sync/$id.db.sig /var/lib/pacman/sync/$id.db >/dev/null 2>&1"
    check "update: an untrusted key is repaired" "$sp pacman-key --delete $fpr >/dev/null 2>&1; $sp env HOME=/root /usr/bin/$id update doctor 2>&1 | tail -3 | tee /dev/stderr | grep -q 'look right' && $sp gpg --homedir /etc/pacman.d/gnupg --batch --with-colons --list-keys $fpr 2>/dev/null | awk -F: '\$1 == \"pub\" { print \$2; exit }' | grep -qE '^[fu]\$'"
  fi

  # Last: logging out of the autologin session brings up the login screen
  # (Noctalia Greeter, not its tuigreet fallback); the password logs back in.
  greeter_up='for i in $(seq 30); do pgrep -u greeter -xf "/usr/bin/noctalia-greeter( .*)?" >/dev/null && ! pgrep -x tuigreet >/dev/null && exit 0; sleep 1; done; pgrep -a -u greeter; exit 1'
  check "logging out shows the login screen" "$hypr uwsm stop >/dev/null 2>&1; $greeter_up"
  sleep 3
  # No session to run grim in now, and virsh can't capture a virgl screen:
  # read the display's framebuffer (kmsgrab, as root).
  login_shot() { # login_shot <label>
    last_shot=$shots/$vm-$(date +%Y%m%d-%H%M%S)-$1.png
    if "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' sh -c 'ffmpeg -loglevel error -y -device \$(ls /dev/dri/card* | head -1) -f kmsgrab -i - -vf hwmap=derive_device=vaapi,hwdownload,format=bgr0 -frames:v 1 -f image2 -c:v png - 2>/dev/null'" > "$last_shot" && [[ -s $last_shot ]]; then
      log "screenshot: $last_shot"
    else
      rm -f "$last_shot"; last_shot=""; log "screenshot failed"
    fi
  }
  # The text in the login panel (screen centre), read here on the host;
  # empty without OCR tools or a screenshot.
  login_text() {
    command -v tesseract >/dev/null && command -v magick >/dev/null && [[ -n $last_shot ]] || return 0
    local w h crop
    read -r w h < <(magick identify -format '%w %h' "$last_shot")
    crop=$(mktemp --suffix=.png)
    magick "$last_shot" -crop "$((w / 2))x$((h * 2 / 5))+$((w / 4))+$((h * 2 / 5))" +repage -resize 300% -colorspace gray -negate "$crop"
    tesseract "$crop" - --psm 6 2>/dev/null; rm -f "$crop"
  }
  ocr_check() { # ocr_check <description> <regex that must match> <regex that must not>
    local text; text=$(login_text)
    if [[ -z $text ]]; then log "no screenshot or OCR tools: skipping '$1'"
    elif grep -qiE "$2" <<<"$text" && ! grep -qiE "$3" <<<"$text"; then printf '  \033[32mok\033[0m   %s\n' "$1"
    else printf '  \033[31mFAIL\033[0m %s\n%s\n' "$1" "$(sed 's/^/         /' <<<"$text")"; fail=1
    fi
  }
  # The sessions the running greeter offers: its own discovery, with the hide
  # list read from its environment (set by the wrapper).
  greeter_sessions="hide=\$(echo '$password' | sudo -S -p '' cat /proc/\$(pgrep -u greeter -xf \"/usr/bin/noctalia-greeter( .*)?\")/environ | xargs -0 printf '%s\n' | sed -n 's/^NOCTALIA_GREETER_HIDE_SESSIONS=//p'); NOCTALIA_GREETER_HIDE_SESSIONS=\$hide noctalia-greeter sessions | sort | paste -sd '|'"
  check "login screen hides Hyprland's own sessions" "noctalia-greeter sessions | grep -qx Hyprland && s=\$($greeter_sessions) && echo \"\$s\" && [ \"\$s\" = '$name' ]"
  login_shot login-screen
  ocr_check "login screen: no session picker with one session" "tester" "$name"
  # Another session installed: the picker appears, the distro session chosen.
  two=$(printf '%s\n' "$name" "Test Extra" | sort | paste -sd '|')
  extra="printf '[Desktop Entry]\nName=Test Extra\nExec=/usr/bin/true\nType=Application\n' > /usr/share/wayland-sessions/test-extra.desktop"
  check "an extra session shows the picker" "echo '$password' | sudo -S -p '' sh -c \"$extra\" && echo '$password' | sudo -S -p '' systemctl restart greetd && sleep 2 && ($greeter_up) && s=\$($greeter_sessions) && echo \"\$s\" && [ \"\$s\" = '$two' ]"
  sleep 3
  login_shot login-screen-two-sessions
  # (Geist Mono: OCR sometimes reads the last letters wrong.)
  ocr_check "login screen: picker shows the distro session" "${name:0:5}" "Test Extra"
  check "removing it hides the picker again" "echo '$password' | sudo -S -p '' sh -c 'rm /usr/share/wayland-sessions/test-extra.desktop && systemctl restart greetd' && sleep 2 && ($greeter_up) && s=\$($greeter_sessions) && [ \"\$s\" = '$name' ]"
  sleep 3
  # The rounded shape's login screen (written as root here; from the desktop,
  # `theme shape` does it), then back to the terminal shape.
  check "login screen: rounded corners" "echo '$password' | sudo -S -p '' sh -c '/usr/lib/$id/greeter-theme moonlit dark 1 rounded && systemctl restart greetd' && sleep 2 && ($greeter_up) && grep -qx 'corner_radius_scale = 1.333' /var/lib/$id/greeter.toml"
  sleep 3
  login_shot login-screen-rounded
  ocr_check "login screen, rounded: asks tester's password" "tester" "$name"
  check "login screen: back to the terminal shape" "echo '$password' | sudo -S -p '' sh -c '/usr/lib/$id/greeter-theme moonlit dark 1 terminal && systemctl restart greetd' && sleep 2 && ($greeter_up) && grep -qx 'corner_radius_scale = 1' /var/lib/$id/greeter.toml"
  sleep 3
  vm_type "$password"; virsh send-key "$vm" KEY_ENTER >/dev/null
  check "logging in from the login screen" 'for i in $(seq 60); do pgrep -u "$USER" -x Hyprland >/dev/null && ! pgrep -u greeter -xf "/usr/bin/noctalia-greeter( .*)?" >/dev/null && exit 0; sleep 1; done; exit 1'
  check "...into the uwsm-run desktop" 'for i in $(seq 30); do systemctl --user is-active --quiet graphical-session.target && exit 0; sleep 1; done; exit 1'
  # The password login unlocked the keyring (greetd's PAM stack): apps store
  # and read secrets without any prompt.
  check "password login: keyring unlocked, no prompt" "$hypr export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus; sleep 3; test -s ~/.local/share/keyrings/login.keyring && echo s3cret2 | timeout 10 secret-tool store --label=install-test app install-test-2 && [ \"\$(timeout 10 secret-tool lookup app install-test-2)\" = s3cret2 ] && ! hyprctl clients -j | jq -e '.[] | select(.class | test(\"gcr-prompter\"; \"i\"))' >/dev/null && ! pgrep -x gcr-prompter >/dev/null"
fi

# Optional: start the snapshot taken before the `tree` install from the boot
# menu (default_entry set for one boot), check it's that snapshot under a RAM
# overlay with the desktop up, keep it from inside, restart normally.
if (( bootsnap )) && (( ! encrypt )); then
  log "starting the pre-update snapshot from the boot menu"
  "$here/ssh" "$vm" "$user" -- "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1); echo '$password' | sudo -S -p '' $id boot snapshots next \$n && echo '$password' | sudo -S -p '' systemctl reboot" || fail=1
  sleep 15; wait_ssh "$user" 300
  check "snapshot boot: started that snapshot" "grep -q '$id.snapshot=' /proc/cmdline && [ \"\$(findmnt -no FSTYPE /)\" = overlay ]"
  check "snapshot boot: the install isn't there" "! command -v tree"
  check "snapshot boot: desktop up"      'for i in $(seq 30); do pgrep -u "$USER" -x Hyprland >/dev/null && exit 0; sleep 1; done; exit 1'
  check "snapshot boot: boots cleanly"   'state=$(systemctl is-system-running); echo $state; [ "$state" = running ]'
  check "snapshot boot: updates refused"  "! $id update 2>&1 </dev/null | grep -q '^:: Synchronizing' && $id update 2>&1 </dev/null | grep -q 'running snapshot'"
  check "snapshot boot: notice offered"  "systemctl --user is-active --quiet $id-snapshot-notice.service || systemctl --user show -p ExecMainStatus $id-snapshot-notice.service | grep -q ."
  log "keeping the snapshot and restarting"
  "$here/ssh" "$vm" "$user" -- "n=\$(grep -o '$id.snapshot=[0-9]*' /proc/cmdline | cut -d= -f2); echo '$password' | sudo -S -p '' $id boot snapshots next --clear && echo '$password' | sudo -S -p '' $id update rollback-apply \$n && echo '$password' | sudo -S -p '' systemctl reboot" || fail=1
  sleep 15; wait_ssh "$user" 300
  check "kept snapshot: the install is undone" "! command -v tree"
  check "kept snapshot: normal boot of @"  "! grep -q '$id.snapshot=' /proc/cmdline && [ \"\$(findmnt -no FSROOT /)\" = /@ ]"
  check "kept snapshot: menu still has snapshots" "echo '$password' | sudo -S -p '' grep -q '^//Before update' /boot/limine.conf"
  rollback=0
fi

# Optional: undo the `tree` install by rolling back, restart, and check the
# restored system is the one running.
if (( rollback )) && (( ! encrypt )); then
  log "rolling back the tree install and restarting"
  "$here/ssh" "$vm" "$user" -- "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1); echo '$password' | sudo -S -p '' $id update rollback-apply \$n" || fail=1
  "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' systemctl reboot" || true
  sleep 15; wait_ssh "$user" 300
  check "rollback: the install is undone" "! command -v tree"
  check "rollback: no pacman lock left behind (updates work)" "! test -e /var/lib/pacman/db.lck"
  check "rollback: booted the restored @"  "[ \"\$(findmnt -no FSROOT /)\" = /@ ]"
  check "rollback: old system kept aside"  "echo '$password' | sudo -S -p '' sh -c 'd=\$(mktemp -d); mount -o subvolid=5 \$(findmnt -no SOURCE / | sed \"s/\\[.*//\") \$d && ls \$d | grep -q ^@old-; r=\$?; umount \$d; exit \$r'"
  check "rollback: snapshots still there"  "echo '$password' | sudo -S -p '' snapper -c root list | grep -q tree"
fi

# The pretend Windows' and our firmware entries would outlive the disk they
# point at; remove them (not with --keep, which leaves everything as it is).
if (( alongside && ! keep )); then
  "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' sh -c 'efibootmgr | sed -n \"s/^Boot\\([0-9A-Fa-f]\\{4\\}\\)\\*\\{0,1\\} \\(Windows Boot Manager\\|Old Linux\\|$name\\)\\b.*/\\1/p\" | while read -r n; do efibootmgr -q -b \$n -B; done'" || true
fi
if (( keep )); then log "leaving $vm running"; else "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' poweroff" || true; fi
(( fail )) && { log "FAILED"; exit 1; }
log "all checks passed"
