#!/usr/bin/env bash
# Proves a layer is reproducible: restores a VM to a snapshot (an empty disk
# with the live ISO), installs a git ref over SSH, reboots into the installed
# system and runs checks.
#
#   vm/test-install [--vm distro-clean] [--from l0-complete] [--ref HEAD] [--keep] [--iso VOLUME] [--encrypt] [--rollback] [--bootsnap] [--alongside] [--replace] [--upgrade-from REF|default]
#
# --encrypt installs onto LUKS and types the passphrase at boot (virsh send-key).
# --bootsnap starts the pre-update snapshot of a package install from the boot
# menu, checks it, keeps it (rollback from inside it) and restarts normally.
# --rollback ends by rolling back a package install and rebooting into the
# restored system (not with --encrypt).
# --alongside first lays out a pretend Windows (EFI partition with Windows Boot
# Manager files, an NTFS partition, a firmware entry), installs into the free
# space beside it and checks none of it changed.
# --replace adds an old Linux to that layout (a Linux partition, its Limine,
# kernel and menu on Windows' EFI partition, and a firmware entry that comes
# first), installs with --replace-linux --remove-old-boot, and checks the old
# Linux is gone, its boot files are set aside and only Windows' entry is kept.
#
# --upgrade-from installs an older ref instead (its own installer, and packages
# built by its own pkg/build in a temporary worktree), logs in once, then
# updates it straight to --ref's packages from a local copy of the repository
# (keyrings, pacman -Syu with the migration hook, new default apps, user
# migrations, as `update` does), restarts, and runs the checks on the updated
# system. "default": the last commit of 2026-10-12, the first public ISO's.
#
# --iso boots the VM from an installer ISO in libvirt's default pool (built by
# iso/build) and runs the installer bundled in it, instead of copying a git ref.
# --keep leaves the VM running afterwards. Needs vm/make-seed to have been run.
# Log in as 'tester'; the password is in ~/.local/share/arch-distro-vm/<vm>.password.
set -euo pipefail
export LIBVIRT_DEFAULT_URI=qemu:///system
here=$(cd "$(dirname "$0")" && pwd); repo=$(dirname "$here")
vm=distro-clean from=l0-complete ref=HEAD keep=0 iso="" encrypt=0 rollback=0 bootsnap=0 alongside=0 replace=0 upgrade_from=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --vm) vm=$2; shift 2 ;; --from) from=$2; shift 2 ;;
    --ref) ref=$2; shift 2 ;; --keep) keep=1; shift ;;
    --iso) iso=$2; shift 2 ;;
    --encrypt) encrypt=1; shift ;;
    --rollback) rollback=1; shift ;;
    --bootsnap) bootsnap=1; shift ;;
    --alongside) alongside=1; shift ;;
    --replace) alongside=1 replace=1; shift ;;
    --upgrade-from) upgrade_from=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
if [[ -n $upgrade_from ]]; then
  [[ -z $iso ]] || { echo "--upgrade-from and --iso don't go together" >&2; exit 2; }
  if [[ $upgrade_from == default ]]; then
    upgrade_from=$(git -C "$repo" rev-list -1 --before='2026-10-12 23:59:59' "$ref")
  fi
  git -C "$repo" rev-parse --verify -q "$upgrade_from^{commit}" >/dev/null || { echo "no such ref: $upgrade_from" >&2; exit 2; }
fi
key=~/.local/share/arch-distro-vm/id_ed25519
user=tester
log() { printf '\033[1m[test-install]\033[0m %s\n' "$*"; }

wait_ssh() { # wait_ssh <user> <timeout-seconds>
  local deadline=$((SECONDS + $2))
  until "$here/ssh" "$vm" "$1" -- true 2>/dev/null; do
    (( SECONDS < deadline )) || { log "timed out waiting for SSH as $1"; exit 1; }
    sleep 5
  done
}

[[ $(virsh domstate "$vm") == "shut off" ]] || virsh destroy "$vm" >/dev/null
log "restoring $vm to $from"
virsh snapshot-revert "$vm" "$from"
if [[ -n $iso ]]; then
  virsh change-media "$vm" sda "/var/lib/libvirt/images/$iso" --config >/dev/null
  log "booting $iso"
fi
virsh start "$vm" >/dev/null
wait_ssh root 300
log "live ISO reachable"

id=$(. "$repo/distro.conf"; echo "$DISTRO_ID")
repo_name=$(. "$repo/distro.conf"; echo "$DISTRO_REPO")
repo_url=$(. "$repo/distro.conf"; . "$repo/repo.conf"; echo "$REPO_URL")
tarball="" old_tree=""
cleanup() {
  rm -f "$tarball"
  if [[ -n $old_tree ]]; then git -C "$repo" worktree remove --force "$old_tree" 2>/dev/null || rm -rf "$old_tree"; fi
}
trap cleanup EXIT
install_ref=$ref
if [[ -n $upgrade_from ]]; then install_ref=$upgrade_from; fi
# Packages only for later (pkg/online-only) aren't copied to the live system.
online_only_excludes=()
while read -r n; do online_only_excludes+=("--exclude=repo/$n-[0-9]*"); done < <(grep -sv '^#' "$repo/pkg/online-only")
if [[ -z $iso ]]; then
  tarball=$(mktemp)
  git -C "$repo" archive --format=tar.gz -o "$tarball" "$install_ref"
  log "copying $(git -C "$repo" rev-parse --short "$install_ref") ($install_ref)"
  "$here/ssh" "$vm" -- 'rm -rf /root/src && mkdir -p /root/src'
  "$here/ssh" "$vm" -- 'tar -xzf - -C /root/src' < "$tarball"
  # Layer 6 and later install from distro packages, built here and copied along.
  if [[ -n $upgrade_from ]]; then
    # The older ref's packages, built by its own pkg/build in a worktree of it.
    log "building packages from $(git -C "$repo" rev-parse --short "$install_ref") with its own pkg/build"
    old_tree=$(mktemp -d "${TMPDIR:-/tmp}/distro-upgrade-from.XXXXXX")
    git -C "$repo" worktree add -q --detach "$old_tree" "$install_ref"
    # Downloads from the shared source cache (an older pkg/build may not use
    # it), tried three times.
    for try in 1 2 3; do
      SRCDEST=${XDG_CACHE_HOME:-$HOME/.cache}/$id-pkg-sources "$old_tree/pkg/build" >/dev/null && break
      (( try < 3 )) || { log "BUILDING $(git -C "$repo" rev-parse --short "$install_ref") FAILED"; exit 1; }
      sleep 20
    done
    old_out=$old_tree/pkg/out-test
    if [[ ! -d $old_out/repo ]]; then old_out=$old_tree/pkg/out; fi
    tar -C "$old_out" "${online_only_excludes[@]}" -czf - repo | "$here/ssh" "$vm" -- 'mkdir -p /root/src/pkg/out && tar -xzf - -C /root/src/pkg/out'
  elif [[ -x $repo/pkg/build ]] && git -C "$repo" cat-file -e "$ref:pkg/build" 2>/dev/null; then
    log "building packages"
    "$repo/pkg/build" "$ref" >/dev/null
    # A test build (pkg/out-test), where the installer looks for packages.
    tar -C "$repo/pkg/out-test" "${online_only_excludes[@]}" -czf - repo | "$here/ssh" "$vm" -- 'mkdir -p /root/src/pkg/out && tar -xzf - -C /root/src/pkg/out'
  fi
  "$here/ssh" "$vm" -- 'cat > /root/tester.pub' < "$key.pub"

  installer="cd /root/src && install/install.sh"
else
  "$here/ssh" "$vm" -- 'cat > /root/tester.pub' < "$key.pub"
  installer="install-$id"
fi

# A throwaway password, saved outside the repo so the VM's console login works.
password=$(head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')
(umask 077; printf '%s\n' "$password" > ~/.local/share/arch-distro-vm/$vm.password)
"$here/ssh" "$vm" -- "umask 077; printf '%s' '$password' > /root/pw"

# Lowercase letters only, so it can be typed with virsh send-key.
passphrase=correcthorsebattery
crypt_args=""
if (( encrypt )); then
  "$here/ssh" "$vm" -- "umask 077; printf '%s' '$passphrase' > /root/luks"
  crypt_args="--encrypt /root/luks"
fi

# A pretend Windows on the disk: its EFI partition (Windows Boot Manager files
# and firmware entry), the Microsoft reserved partition and an NTFS volume,
# leaving the rest of the disk free. Fingerprinted before and after.
name=$(. "$repo/distro.conf"; echo "$DISTRO_NAME")
along_args=""
windows_fingerprint='sfdisk --dump /dev/vda | grep -E "^/dev/vda[123] "; sha256sum < /dev/vda1; head -c 268435456 /dev/vda3 | sha256sum'
# Replacing moves the old Linux's files on Windows' EFI partition, so compare
# Windows' own files there instead of the whole partition.
if (( replace )); then
  windows_fingerprint='sfdisk --dump /dev/vda | grep -E "^/dev/vda[123] "; mkdir -p /tmp/fp; mount -o ro /dev/vda1 /tmp/fp; (cd /tmp/fp/EFI && find Microsoft Boot -type f -exec sha256sum {} + | sort); umount /tmp/fp; head -c 268435456 /dev/vda3 | sha256sum'
fi
if (( alongside )); then
  log "laying out a pretend Windows"
  "$here/ssh" "$vm" -- bash -s -- "$name" "$replace" <<'WINDOWS' || { log "WINDOWS LAYOUT FAILED"; exit 1; }
set -euo pipefail
name=$1 replace=$2 d=/dev/vda
wipefs -af "$d" >/dev/null; sgdisk --zap-all "$d" >/dev/null
sgdisk -n1:0:+260M -t1:ef00 -c1:"EFI system partition" \
       -n2:0:+16M -t2:0c01 -c2:"Microsoft reserved partition" \
       -n3:0:+12G -t3:0700 -c3:"Basic data partition" "$d" >/dev/null
partprobe "$d"; udevadm settle
mkfs.fat -F32 -n SYSTEM "${d}1" >/dev/null
mkfs.ntfs -Q -L Windows "${d}3" >/dev/null
mkdir -p /tmp/win
mount "${d}1" /tmp/win
mkdir -p /tmp/win/EFI/Microsoft/Boot /tmp/win/EFI/Boot
# A real EFI program stands in for Windows Boot Manager: firmware (OVMF, and
# real machines) may drop boot entries whose file isn't a valid EFI image,
# which a real Windows install never has. The live ISO's systemd-boot will do.
efi=''
for f in /usr/lib/systemd/boot/efi/systemd-bootx64.efi /run/archiso/bootmnt/EFI/BOOT/BOOTx64.EFI /run/archiso/bootmnt/EFI/BOOT/BOOTX64.EFI; do
  if [ -f "$f" ]; then efi=$f; break; fi
done
[ -n "$efi" ] || { echo "no EFI binary on the live ISO to stand in for Windows" >&2; exit 1; }
cp "$efi" /tmp/win/EFI/Microsoft/Boot/bootmgfw.efi
cp /tmp/win/EFI/Microsoft/Boot/bootmgfw.efi /tmp/win/EFI/Boot/bootx64.efi
umount /tmp/win
mount -t ntfs3 "${d}3" /tmp/win 2>/dev/null || mount -t ntfs-3g "${d}3" /tmp/win
echo "not to be touched" > /tmp/win/marker.txt
umount /tmp/win
# Windows' firmware entry; entries left by earlier runs go first.
efibootmgr | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} \(Windows Boot Manager\|Old Linux\|$name\)\b.*/\1/p" \
  | while read -r n; do efibootmgr -q -b "$n" -B; done
efibootmgr -q --create --disk "$d" --part 1 --label "Windows Boot Manager" --loader '\EFI\Microsoft\Boot\bootmgfw.efi'
if [ "$replace" = 1 ]; then
  # An old Linux: its partition, and its Limine, kernel and menu on Windows'
  # EFI partition, with a firmware entry placed first (as its installer left it).
  sgdisk -n4:0:+8G -t4:8300 -c4:"Old Linux" "$d" >/dev/null
  partprobe "$d"; udevadm settle
  mkfs.ext4 -q -L oldlinux "${d}4"
  mount "${d}1" /tmp/win
  mkdir -p /tmp/win/EFI/limine
  cp "$efi" /tmp/win/EFI/limine/limine_x64.efi
  printf 'timeout: 3\n/Old Linux\n    protocol: linux\n' > /tmp/win/limine.conf
  echo "old kernel" > /tmp/win/vmlinuz-linux
  umount /tmp/win
  efibootmgr -q --create --disk "$d" --part 1 --label "Old Linux" --loader '\EFI\limine\limine_x64.efi'
fi
WINDOWS
  windows_before=$("$here/ssh" "$vm" -- "$windows_fingerprint")
  along_args="--alongside"
  if (( replace )); then along_args="--replace-linux --remove-old-boot"; fi
fi

log "installing"
started=$SECONDS
"$here/ssh" "$vm" -- "$installer --disk /dev/vda --user $user \
  --password-file /root/pw --ssh-key /root/tester.pub --timezone America/Chicago --autologin $crypt_args $along_args --yes" \
  || { log "INSTALL FAILED"; exit 1; }
log "install took $((SECONDS - started))s; rebooting into the installed system"

"$here/ssh" "$vm" -- 'umount -R /mnt; poweroff' || true
for _ in $(seq 60); do [[ $(virsh domstate "$vm") == "shut off" ]] && break; sleep 2; done
# Waits for the installed system to come up (typing the disk passphrase).
wait_boot() {
  if (( encrypt )); then
    # Type the passphrase at the unlock prompt. Wait well past the boot menu
    # first (letters typed there would edit entries), and retry at most three times.
    type_passphrase() {
      local c; for c in $(grep -o . <<<"$passphrase"); do virsh send-key "$vm" "KEY_${c^^}" >/dev/null; done
      virsh send-key "$vm" KEY_ENTER >/dev/null
    }
    local unlocked=0 attempt
    for attempt in 1 2 3; do
      sleep 25
      "$here/ssh" "$vm" "$user" -- true 2>/dev/null && { unlocked=1; break; }
      log "typing the disk passphrase (attempt $attempt)"
      type_passphrase
    done
    (( unlocked )) || wait_ssh "$user" 120
  fi
  wait_ssh "$user" 300
}
virsh start "$vm" >/dev/null
wait_boot

# --upgrade-from: the older install, as someone used it (one login), updated
# to --ref's packages the way `update` does, then restarted.
upgraded=0
if [[ -n $upgrade_from ]]; then
  upgrade() { "$here/ssh" "$vm" "$user" -- "$@"; }
  sudo_up="echo '$password' | sudo -S -p ''"
  session='export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-1; export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus HYPRLAND_INSTANCE_SIGNATURE=$(ls $XDG_RUNTIME_DIR/hypr 2>/dev/null | head -1);'
  for _ in $(seq 60); do upgrade "test -f ~/.local/state/$id/first-login-done" 2>/dev/null && break; sleep 3; done
  sleep 10
  log "installed $(upgrade "pacman -Q $id"); first login done: $(upgrade "test -f ~/.local/state/$id/first-login-done && echo yes || echo no")"
  log "building packages from $(git -C "$repo" rev-parse --short "$ref") ($ref)"
  "$repo/pkg/build" "$ref" >/dev/null
  siglevel=Required
  if [[ ! -f $repo/pkg/out-test/repo/$repo_name.db.sig ]]; then siglevel="Optional TrustAll"; fi
  tar -C "$repo/pkg/out-test" -czf - repo | upgrade 'rm -rf ~/upgrade && mkdir ~/upgrade && tar -xzf - -C ~/upgrade'
  local_repo=/var/tmp/$id-upgrade-repo
  # The distro repository's section points at the local copy for the update,
  # and back at the hosted one afterwards.
  upgrade 'cat > ~/upgrade-setup.sh' <<SETUP
set -e
rm -rf $local_repo
mv /home/$user/upgrade/repo $local_repo
chown -R root:root $local_repo; chmod 755 $local_repo; chmod 644 $local_repo/*
sed -i '/^\[$repo_name\]\$/,/^\[/{s|^Server = .*|Server = file://$local_repo|; s|^SigLevel = .*|SigLevel = $siglevel|}' /etc/pacman.conf
grep -A2 '^\[$repo_name\]' /etc/pacman.conf
# The hosted database's signature would be checked against the local one.
rm -f /var/lib/pacman/sync/$repo_name.db.sig /var/lib/pacman/sync/$repo_name.files.sig
SETUP
  upgrade "$sudo_up bash ~/upgrade-setup.sh" || { log "UPGRADE SETUP FAILED"; exit 1; }
  log "updating to $(git -C "$repo" rev-parse --short "$ref")"
  started=$SECONDS
  # As `update` does: keyrings first, then everything (the migration hook runs
  # the system migrations), new default apps, then the user's migrations.
  # Releases the distro holds back (default/tested: Hyprland and Ghostty, as
  # `update` does) are left out, unless they're the tested ones.
  upgrade 'cat > ~/holds.sh' <<HOLDS
checkupdates 2>/dev/null | awk -v h="$(grep -vE '^[[:space:]]*(#|$)' "$repo/default/tested/hyprland" | head -1)" \\
  -v g="$(grep -vE '^[[:space:]]*(#|$)' "$repo/default/tested/ghostty" | head -1)" '
  \$1 ~ /^(hyprland|aquamarine|hypr[a-z-]*|xdg-desktop-portal-hyprland)\$/ { hypr = hypr " " \$1 }
  \$1 == "hyprland" && index(\$4, h) != 1 { newer = 1 }
  \$1 ~ /^ghostty(-terminfo|-shell-integration)?\$/ && \$4 != g { print \$1 }
  END { if (newer) { n = split(hypr, p, " "); for (i = 1; i <= n; i++) print p[i] } }' | paste -sd,
HOLDS
  upgrade "ign=\$(bash ~/holds.sh); echo \"held: \${ign:-none}\"; $sudo_up pacman -Syy --needed --noconfirm archlinux-keyring $id-keyring >/dev/null && $sudo_up pacman -Su --noconfirm \${ign:+--ignore \$ign} > /tmp/upgrade.log 2>&1; rc=\$?; grep -iE 'migration|error|warning' /tmp/upgrade.log; exit \$rc" \
    || { log "UPDATE FAILED"; upgrade 'tail -40 /tmp/upgrade.log'; exit 1; }
  upgrade "printf '%s\\ny\\n' '$password' | sudo -k -S -p '' $id update new-apps 2>&1 | tail -3" || log "new default apps: not installed"
  upgrade "printf '%s\\ny\\n' '$password' | sudo -k -S -p '' $id update restore 2>&1 | tail -3" || log "held packages: not restored"
  pending=$(upgrade "$sudo_up $id migrate --system --list | grep -v '^applied'" || true)
  if [[ -n $pending ]]; then log "SYSTEM MIGRATIONS NOT ALL APPLIED:"; printf '%s\n' "$pending"; fi
  upgrade "$session $id migrate --user" || { log "USER MIGRATIONS FAILED"; exit 1; }
  # Back to the hosted repository (-yy: a matching database and signature).
  # Only those two lines change back: migrations may have changed others.
  upgrade "$sudo_up sed -i '/^\\[$repo_name\\]\$/,/^\\[/{s|^Server = .*|Server = $repo_url|; s|^SigLevel = .*|SigLevel = Required|}' /etc/pacman.conf && grep -A2 '^\\[$repo_name\\]' /etc/pacman.conf && $sudo_up rm -f /var/lib/pacman/sync/$repo_name.db.sig /var/lib/pacman/sync/$repo_name.files.sig && $sudo_up pacman -Syy >/dev/null 2>&1; true"
  log "update took $((SECONDS - started))s; now $(upgrade "pacman -Q $id"); restarting"
  upgraded=1
  upgrade "$sudo_up systemctl reboot" >/dev/null 2>&1 || true
  sleep 15
  wait_boot
fi

log "checks"
fail=0
# Types letters and digits into the VM's focused surface (the lock screen).
vm_type() { # vm_type <text>
  local i c
  for ((i = 0; i < ${#1}; i++)); do
    c=${1:i:1}
    case $c in
      [a-z]) virsh send-key "$vm" "KEY_${c^^}" >/dev/null ;;
      [A-Z]) virsh send-key "$vm" KEY_LEFTSHIFT "KEY_$c" >/dev/null ;;
      [0-9]) virsh send-key "$vm" "KEY_$c" >/dev/null ;;
    esac
  done
}

check() { # check <description> <command run in the VM as the user>
  if out=$("$here/ssh" "$vm" "$user" -- "$2" 2>&1); then
    printf '  \033[32mok\033[0m   %s\n' "$1"
  else
    printf '  \033[31mFAIL\033[0m %s\n%s\n' "$1" "$(sed 's/^/         /' <<<"$out")"; fail=1
  fi
}
check "system state is running"        'state=$(systemctl is-system-running); echo $state; [ "$state" = running ]'
check "root is btrfs subvolume @"      'findmnt -no FSTYPE,OPTIONS / | grep -qE "btrfs.*subvol=/@(,|$)"'
check "separate subvolumes mounted"    'for m in /home /var/log /var/cache/pacman/pkg /.snapshots; do findmnt -n $m >/dev/null || exit 1; done'
check "booted by Limine (fallback path)" "echo '$password' | sudo -S -p '' sh -c 'test -f /boot/EFI/BOOT/BOOTX64.EFI && tr -d \\\\000 < /sys/firmware/efi/efivars/LoaderInfo-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f | grep -q Limine'"
check "zram swap active"               'swapon --show=NAME --noheadings | grep -q zram'
check "Wi-Fi country from the time zone" 'grep -qx "WIRELESS_REGDOM=\"US\"" /etc/conf.d/wireless-regdom'
if (( alongside )); then
  sudo_pw="echo '$password' | sudo -S -p ''"
  check "alongside: Windows partitions unchanged" "[ \"\$($sudo_pw sh -c '$windows_fingerprint')\" = '$windows_before' ]"
  check "alongside: installed into the free space" "lsblk -lno PARTN,PARTLABEL /dev/vda | grep -qx ' *4 $name boot' && lsblk -lno PARTN,PARTLABEL /dev/vda | grep -qx ' *5 $name system' && findmnt -no SOURCE /boot | grep -qx /dev/vda4"
  check "alongside: firmware starts us first, Windows kept" "o=\$($sudo_pw efibootmgr); printf '%s\\n' \"\$o\"; first=\$(sed -n 's/^BootOrder: \\([0-9A-F]*\\).*/\\1/p' <<<\"\$o\"); grep -q \"^Boot\$first\\*\\{0,1\\} $name\" <<<\"\$o\" && grep -q 'Windows Boot Manager' <<<\"\$o\" && cur=\$(sed -n 's/^BootCurrent: //p' <<<\"\$o\") && [ \"\$cur\" = \"\$first\" ]"
  check "alongside: boot menu has Windows" "$sudo_pw sh -c 'grep -q \"^entry: Windows Boot Manager\\|^ *entry: Windows Boot Manager\" /boot/limine.conf && grep -q \"guid(.*):/EFI/Microsoft/Boot/bootmgfw.efi\" /boot/limine.conf'"
  if (( replace )); then
    check "replace: old Linux partition deleted" "! lsblk -lno PARTLABEL /dev/vda | grep -qx 'Old Linux'"
    check "replace: old boot files set aside" "$sudo_pw sh -c 'mkdir -p /tmp/esp && mount -o ro /dev/vda1 /tmp/esp; r=1; [ ! -e /tmp/esp/EFI/limine ] && [ ! -e /tmp/esp/limine.conf ] && [ ! -e /tmp/esp/vmlinuz-linux ] && ls -d /tmp/esp/$id-removed/*/EFI/limine >/dev/null && [ -f /tmp/esp/EFI/Boot/bootx64.efi ] && r=0; umount /tmp/esp; exit \$r'"
    check "replace: old firmware entry removed" "! $sudo_pw efibootmgr | grep -q 'Old Linux'"
  fi
  check "alongside: Limine copies kept up to date" "$sudo_pw sh -c 'cmp -s /usr/share/limine/BOOTX64.EFI /boot/EFI/$id/BOOTX64.EFI && cmp -s /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI && grep -q \"/boot/EFI/$id/BOOTX64.EFI\" /usr/share/libalpm/hooks/$id-limine-update.hook && grep -qx BOOT_MODE=alongside /etc/$id/boot.conf'"
fi
check "NetworkManager connected"       'nmcli -t -f STATE general | grep -q "^connected"'
check "internet reachable"             'curl -sfI https://archlinux.org -o /dev/null'
check "time synchronised service on"   'systemctl is-active --quiet systemd-timesyncd'
check "sudo works for $user"           "echo '$password' | sudo -S -p '' true"
check "root account locked"            "echo '$password' | sudo -S -p '' passwd -S root | grep -q ' L '"
check "/boot is root-only"           'test "$(stat -c %a /boot)" = 700'
if "$here/ssh" "$vm" "$user" -- "pacman -Q $id >/dev/null 2>&1"; then
  check "distro packages installed"     "pacman -Q $id $id-settings"
  check "Ghostty is the tested one"      "[ \"\$(pacman -Q ghostty | awk '{ print \$2 }')\" = \"\$(grep -vE '^[[:space:]]*(#|\$)' /usr/share/$id/default/tested/ghostty | head -1)\" ]"
  check "Hyprland is the tested one"     "[ \"\$(pacman -Q hyprland | awk '{ print \$2 }')\" = \"\$(head -1 /usr/lib/hyprland-plugins/hyprbars.hyprland)\" ]"
  # Privacy and security by default.
  sudo_vm="echo '$password' | sudo -S -p ''"
  check "firefox has Mozilla's defaults" "[ ! -e /etc/firefox/policies/policies.json ]"
  check "telemetry opt-outs in shells"  "bash -lc 'echo \$DO_NOT_TRACK \$DOTNET_CLI_TELEMETRY_OPTOUT \$DISABLE_TELEMETRY' | grep -qx '1 1 1'"
  check "firewall refuses incoming"     "$sudo_vm firewall-cmd --state | grep -qx running && $sudo_vm firewall-cmd --get-default-zone | grep -qx public && $sudo_vm firewall-cmd --permanent --zone=public --get-target | grep -qx default && [ -z \"\$($sudo_vm firewall-cmd --zone=public --list-ports)\" ]"
