  check "manual installed, every menu link opens a page" "for p in getting-started look apps privacy troubleshooting verify; do test -s /usr/share/$id/doc/\$p.md || exit 1; done; n=0; for f in \$(grep -o '/usr/share/$id/doc/[a-z-]*\\.md' /usr/share/$id/default/menu/menu); do test -s \$f || { echo missing \$f; exit 1; }; n=\$((n + 1)); done; [ \$n = 6 ]"
  check "package files intact"          "pacman -Qkk $id 2>&1 | grep -q ', 0 altered files'"
  check "login screen uses distro config" "systemctl cat greetd | grep -q -- '--config /etc/greetd/$id.toml'"
  check "hidden apps dir in XDG_DATA_DIRS" "systemctl --user show-environment | grep -q '^XDG_DATA_DIRS=/usr/share/$id/xdg'"
  check "system names itself and its version (os-release)" ". /etc/os-release; [ \"\$ID\" = $id ] && [ \"\$ID_LIKE\" = arch ] && [ -n \"\$NAME\" ] && [[ \"\$VERSION_ID\" == 0.* ]]"
  check "signing key trusted"            "pacman -Q $id-keyring >/dev/null && echo '$password' | sudo -S -p '' pacman-key --list-keys $(cat "$repo/pkg/keyring/fingerprint") >/dev/null"
