if "$here/ssh" "$vm" "$user" -- "pacman -Q firefox >/dev/null 2>&1"; then
  check "default apps installed"        "pacman -Q firefox nautilus gnome-text-editor papers loupe showtime decibels gnome-calculator btop pika-backup gnome-disk-utility snapshot system-config-printer >/dev/null"
  # An install from before an app became a default: the migration lists it,
  # the next update installs it, once; removed again, it stays removed.
  check "new default apps: installed once by update" "$sudo_vm pacman -Rns --noconfirm snapshot >/dev/null && $sudo_vm sed -i '/new-default-apps/d' /var/lib/$id/migrations-applied && $sudo_vm $id migrate --system >/dev/null && grep -qx snapshot /var/lib/$id/new-default-apps && ! grep -q gnome-disk-utility /var/lib/$id/new-default-apps && printf '%s\\ny\\n' '$password' | sudo -k -S -p '' $id update new-apps >/dev/null && pacman -Q snapshot >/dev/null && ! test -e /var/lib/$id/new-default-apps && $sudo_vm pacman -Rns --noconfirm snapshot >/dev/null && printf '%s\\ny\\n' '$password' | sudo -k -S -p '' $id update new-apps >/dev/null && ! pacman -Q snapshot 2>/dev/null && $sudo_vm pacman -S --noconfirm snapshot >/dev/null"
  check "app catalog lists apps"        "$id app list | grep -q steam && $id app search claude | grep -q claude-desktop"
  check "default editor is micro"       "command -v micro >/dev/null && [ \"\$(bash -lc 'echo \$EDITOR')\" = micro ] && systemctl --user show-environment | grep -qx EDITOR=micro"
  check "shell defaults active"         "grep -q 'shell defaults' ~/.bashrc && bash -ic 'alias ll && type z && type starship_precmd' >/dev/null 2>&1"
  check "app catalog has dev tools"     "$id app list dev | grep -q docker && $id app list dev | grep -q postgres"
