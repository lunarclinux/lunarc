  screenshot desktop

  if "$here/ssh" "$vm" "$user" -- "command -v $id" >/dev/null 2>&1; then
    # Layer 4 and later: the CLI and themes.
    for _ in $(seq 20); do "$here/ssh" "$vm" "$user" -- "test -f ~/.local/state/$id/first-login-done" && break; sleep 2; done
    check "CLI lists its commands"        "$id help | grep -q theme"
    check "first-login setup ran"         "test -f ~/.local/state/$id/first-login-done"
    check "Files' sidebar has the standard folders" "for d in DOCUMENTS DOWNLOAD PICTURES MUSIC VIDEOS; do grep -qx \"file://\$(xdg-user-dir \$d)\" ~/.config/gtk-3.0/bookmarks || { echo \"no \$d\"; exit 1; }; done"
    # The setup window opens once at first login: welcome, then backups.
