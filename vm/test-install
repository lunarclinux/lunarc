  check "new user migration runs once"   "$id migrate --user >/dev/null && test -f ~/user-migration-ran && rm ~/user-migration-ran && $id migrate --user >/dev/null && ! test -f ~/user-migration-ran"
  check "new system migration runs"      "echo '$password' | sudo -S -p '' $id migrate --system >/dev/null && test -f /var/lib/$id/system-migration-ran"
  check "ghostty migration fixes an old config" "sed -i '/app-notifications/d; /announce it/d' ~/.config/ghostty/config && sed -i '/ghostty-quiet-reloads/d' ~/.local/state/$id/migrations-applied && $id migrate --user >/dev/null && grep -q '^app-notifications = no-config-reload' ~/.config/ghostty/config"
fi
if (( encrypt )); then
