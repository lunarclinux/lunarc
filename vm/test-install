  check "pacman: colour on, candy off by default" "grep -qx Color /etc/pacman.conf && ! grep -q '^ILoveCandy' /etc/pacman.conf && $id update candy 2>&1 | grep -qx 'candy: off'"
  check "pacman: candy on and off, nothing else changes" "cp /etc/pacman.conf /tmp/pacman.conf.before && $sudo_vm $id update candy on >/dev/null 2>&1 && grep -qx ILoveCandy /etc/pacman.conf && $id update candy 2>&1 | grep -qx 'candy: on' && [ \"\$(diff /tmp/pacman.conf.before /etc/pacman.conf | grep -c '^[<>]')\" = 1 ] && $sudo_vm $id update candy off >/dev/null 2>&1 && cmp -s /tmp/pacman.conf.before /etc/pacman.conf"
  check "pacman: the colour migration, twice, changes only that line" "$sudo_vm sed -i 's/^Color\$/#Color/' /etc/pacman.conf && $sudo_vm env DISTRO_ID=$id bash /usr/share/$id/migrations/system/20261015-2310-pacman-color.sh && $sudo_vm env DISTRO_ID=$id bash /usr/share/$id/migrations/system/20261015-2310-pacman-color.sh && cmp -s /tmp/pacman.conf.before /etc/pacman.conf"
  check "snapshots configured (@snapshots)" "[ \"\$(findmnt -no FSROOT /.snapshots)\" = /@snapshots ] && echo '$password' | sudo -S -p '' snapper -c root get-config | grep TIMELINE_CREATE | grep -qw no"
  check "a package install takes snapshots" "echo '$password' | sudo -S -p '' pacman -S --noconfirm tree >/dev/null && echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns type,description | grep -q '^pre,.*tree' && echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns type | grep -qx post"
  check "boot menu lists the snapshot"   "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1) && echo '$password' | sudo -S -p '' grep -q \"^//Before update, .* (#\$n)\$\" /boot/limine.conf && echo '$password' | sudo -S -p '' grep -q \"rootflags=subvol=@snapshots/\$n/snapshot .*systemd.volatile=overlay\" /boot/limine.conf"
  check "rollback dry run shows the plan" "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1) && echo '$password' | sudo -S -p '' $id update rollback-apply \$n --dry-run | grep -q 'Plan:'"
  check "distro icon installed"         "test -f /usr/share/icons/hicolor/scalable/apps/$id-logo.svg && test -f /usr/share/icons/hicolor/symbolic/apps/$id-logo-symbolic.svg"
  check "os-release names the icon"     "grep -qx 'LOGO=$id-logo' /etc/os-release"
  check "fastfetch uses the distro logo" "grep -q '/usr/share/$id/default/branding/fastfetch-logo.txt' /etc/xdg/fastfetch/config.jsonc && fastfetch --pipe >/dev/null"
  check "boot menu has the wallpaper"   "echo '$password' | sudo -S -p '' sh -c 'grep -q \"^wallpaper: boot():/$id/wallpaper.png\" /boot/limine.conf && test -s /boot/$id/wallpaper.png'"
  check "console uses the theme palette" "grep -q 'vt.default_red=11,' /proc/cmdline"
  check "boot menu and console colours: current, migrated" "$(sed -e "s/@ID@/$id/g" -e "s/@PW@/$password/g" "$here/checks/boot-palette.sh")"
  # The login screen: Noctalia Greeter through the
