check "weekly TRIM timer enabled"      'systemctl is-enabled --quiet fstrim.timer'
check "zswap off (zram is the swap)"   'grep -qw zswap.enabled=0 /proc/cmdline && [ "$(cat /sys/module/zswap/parameters/enabled)" = N ]'
