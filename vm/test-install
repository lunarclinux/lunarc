    check "setup goes on to backups"      "$hypr hyprctl dispatch 'hl.dsp.focus({ window = \"class:^$id.setup\$\" })' >/dev/null; sleep 0.5; wtype -k Return; sleep 1.5; true"
    screenshot setup-backups
