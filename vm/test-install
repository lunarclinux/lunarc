#!/usr/bin/env bash
# Proves a layer is reproducible: restores a VM to a snapshot (an empty disk
# with the live ISO), installs a git ref over SSH, reboots into the installed
# system and runs checks.
#
#   vm/test-install [--vm distro-clean] [--from l0-complete] [--ref HEAD] [--keep] [--iso VOLUME] [--encrypt] [--rollback] [--bootsnap] [--alongside]
#
# --encrypt installs onto LUKS and types the passphrase at boot (virsh send-key).
# --bootsnap starts the pre-update snapshot of a package install from the boot
# menu, checks it, keeps it (rollback from inside it) and restarts normally.
# --rollback ends by rolling back a package install and rebooting into the
# restored system (not with --encrypt).
# --alongside first lays out a pretend Windows (EFI partition with Windows Boot
# Manager files, an NTFS partition, a firmware entry), installs into the free
# space beside it and checks none of it changed (decision record 0035).
#
# --iso boots the VM from an installer ISO in libvirt's default pool (built by
# iso/build) and runs the installer bundled in it, instead of copying a git ref.
# --keep leaves the VM running afterwards. Needs vm/make-seed to have been run.
# Log in as 'tester'; the password is in ~/.local/share/arch-distro-vm/<vm>.password.
set -euo pipefail
export LIBVIRT_DEFAULT_URI=qemu:///system
here=$(cd "$(dirname "$0")" && pwd); repo=$(dirname "$here")
vm=distro-clean from=l0-complete ref=HEAD keep=0 iso="" encrypt=0 rollback=0 bootsnap=0 alongside=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --vm) vm=$2; shift 2 ;; --from) from=$2; shift 2 ;;
    --ref) ref=$2; shift 2 ;; --keep) keep=1; shift ;;
    --iso) iso=$2; shift 2 ;;
    --encrypt) encrypt=1; shift ;;
    --rollback) rollback=1; shift ;;
    --bootsnap) bootsnap=1; shift ;;
    --alongside) alongside=1; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
key=~/.local/share/arch-distro-vm/id_ed25519
user=tester
log() { printf '\033[1m[test-install]\033[0m %s\n' "$*"; }

wait_ssh() { # wait_ssh <user> <timeout-seconds>
  local deadline=$((SECONDS + $2))
  until "$here/ssh" "$vm" "$1" -- true 2>/dev/null; do
    (( SECONDS < deadline )) || { log "timed out waiting for SSH as $1"; exit 1; }
    sleep 5
  done
}

[[ $(virsh domstate "$vm") == "shut off" ]] || virsh destroy "$vm" >/dev/null
log "restoring $vm to $from"
virsh snapshot-revert "$vm" "$from"
if [[ -n $iso ]]; then
  virsh change-media "$vm" sda "/var/lib/libvirt/images/$iso" --config >/dev/null
  log "booting $iso"
fi
virsh start "$vm" >/dev/null
wait_ssh root 300
log "live ISO reachable"

id=$(. "$repo/distro.conf"; echo "$DISTRO_ID")
repo_url=$(. "$repo/distro.conf"; . "$repo/repo.conf"; echo "$REPO_URL")
if [[ -z $iso ]]; then
  tarball=$(mktemp); trap 'rm -f "$tarball"' EXIT
  git -C "$repo" archive --format=tar.gz -o "$tarball" "$ref"
  log "copying $(git -C "$repo" rev-parse --short "$ref") ($ref)"
  "$here/ssh" "$vm" -- 'rm -rf /root/src && mkdir -p /root/src'
  "$here/ssh" "$vm" -- 'tar -xzf - -C /root/src' < "$tarball"
  # Layer 6 and later install from distro packages, built here and copied along.
  if [[ -x $repo/pkg/build ]] && git -C "$repo" cat-file -e "$ref:pkg/build" 2>/dev/null; then
    log "building packages"
    "$repo/pkg/build" "$ref" >/dev/null
    tar -C "$repo" -czf - pkg/out/repo | "$here/ssh" "$vm" -- 'tar -xzf - -C /root/src'
  fi
  "$here/ssh" "$vm" -- 'cat > /root/tester.pub' < "$key.pub"

  installer="cd /root/src && install/install.sh"
else
  "$here/ssh" "$vm" -- 'cat > /root/tester.pub' < "$key.pub"
  installer="install-$id"
fi

# A throwaway password, saved outside the repo so the VM's console login works.
password=$(head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')
(umask 077; printf '%s\n' "$password" > ~/.local/share/arch-distro-vm/$vm.password)
"$here/ssh" "$vm" -- "umask 077; printf '%s' '$password' > /root/pw"

# Lowercase letters only, so it can be typed with virsh send-key.
passphrase=correcthorsebattery
crypt_args=""
if (( encrypt )); then
  "$here/ssh" "$vm" -- "umask 077; printf '%s' '$passphrase' > /root/luks"
  crypt_args="--encrypt /root/luks"
fi

# A pretend Windows on the disk: its EFI partition (Windows Boot Manager files
# and firmware entry), the Microsoft reserved partition and an NTFS volume,
# leaving the rest of the disk free. Fingerprinted before and after.
name=$(. "$repo/distro.conf"; echo "$DISTRO_NAME")
along_args=""
windows_fingerprint='sfdisk --dump /dev/vda | grep -E "^/dev/vda[123] "; sha256sum < /dev/vda1; head -c 268435456 /dev/vda3 | sha256sum'
if (( alongside )); then
  log "laying out a pretend Windows"
  "$here/ssh" "$vm" -- bash -s -- "$name" <<'WINDOWS' || { log "WINDOWS LAYOUT FAILED"; exit 1; }
set -euo pipefail
name=$1 d=/dev/vda
wipefs -af "$d" >/dev/null; sgdisk --zap-all "$d" >/dev/null
sgdisk -n1:0:+260M -t1:ef00 -c1:"EFI system partition" \
       -n2:0:+16M -t2:0c01 -c2:"Microsoft reserved partition" \
       -n3:0:+12G -t3:0700 -c3:"Basic data partition" "$d" >/dev/null
partprobe "$d"; udevadm settle
mkfs.fat -F32 -n SYSTEM "${d}1" >/dev/null
mkfs.ntfs -Q -L Windows "${d}3" >/dev/null
mkdir -p /tmp/win
mount "${d}1" /tmp/win
mkdir -p /tmp/win/EFI/Microsoft/Boot /tmp/win/EFI/Boot
# A real EFI program stands in for Windows Boot Manager: firmware (OVMF, and
# real machines) may drop boot entries whose file isn't a valid EFI image,
# which a real Windows install never has. The live ISO's systemd-boot will do.
efi=''
for f in /usr/lib/systemd/boot/efi/systemd-bootx64.efi /run/archiso/bootmnt/EFI/BOOT/BOOTx64.EFI /run/archiso/bootmnt/EFI/BOOT/BOOTX64.EFI; do
  if [ -f "$f" ]; then efi=$f; break; fi
done
[ -n "$efi" ] || { echo "no EFI binary on the live ISO to stand in for Windows" >&2; exit 1; }
cp "$efi" /tmp/win/EFI/Microsoft/Boot/bootmgfw.efi
cp /tmp/win/EFI/Microsoft/Boot/bootmgfw.efi /tmp/win/EFI/Boot/bootx64.efi
umount /tmp/win
mount -t ntfs3 "${d}3" /tmp/win 2>/dev/null || mount -t ntfs-3g "${d}3" /tmp/win
echo "not to be touched" > /tmp/win/marker.txt
umount /tmp/win
# Windows' firmware entry; entries left by earlier runs go first.
efibootmgr | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} \(Windows Boot Manager\|$name\)\b.*/\1/p" \
  | while read -r n; do efibootmgr -q -b "$n" -B; done
efibootmgr -q --create --disk "$d" --part 1 --label "Windows Boot Manager" --loader '\EFI\Microsoft\Boot\bootmgfw.efi'
WINDOWS
  windows_before=$("$here/ssh" "$vm" -- "$windows_fingerprint")
  along_args="--alongside"
fi

log "installing"
started=$SECONDS
"$here/ssh" "$vm" -- "$installer --disk /dev/vda --user $user \
  --password-file /root/pw --ssh-key /root/tester.pub --timezone America/Chicago --autologin $crypt_args $along_args --yes" \
  || { log "INSTALL FAILED"; exit 1; }
log "install took $((SECONDS - started))s; rebooting into the installed system"

"$here/ssh" "$vm" -- 'umount -R /mnt; poweroff' || true
for _ in $(seq 60); do [[ $(virsh domstate "$vm") == "shut off" ]] && break; sleep 2; done
virsh start "$vm" >/dev/null
if (( encrypt )); then
  # Type the passphrase at the unlock prompt. Wait well past the boot menu
  # first (letters typed there would edit entries), and retry at most three times.
  type_passphrase() {
    local c; for c in $(grep -o . <<<"$passphrase"); do virsh send-key "$vm" "KEY_${c^^}" >/dev/null; done
    virsh send-key "$vm" KEY_ENTER >/dev/null
  }
  unlocked=0
  for attempt in 1 2 3; do
    sleep 25
    "$here/ssh" "$vm" "$user" -- true 2>/dev/null && { unlocked=1; break; }
    log "typing the disk passphrase (attempt $attempt)"
    type_passphrase
  done
  (( unlocked )) || wait_ssh "$user" 120
fi
wait_ssh "$user" 300

log "checks"
fail=0
# Types letters and digits into the VM's focused surface (the lock screen).
vm_type() { # vm_type <text>
  local i c
  for ((i = 0; i < ${#1}; i++)); do
    c=${1:i:1}
    case $c in
      [a-z]) virsh send-key "$vm" "KEY_${c^^}" >/dev/null ;;
      [A-Z]) virsh send-key "$vm" KEY_LEFTSHIFT "KEY_$c" >/dev/null ;;
      [0-9]) virsh send-key "$vm" "KEY_$c" >/dev/null ;;
    esac
  done
}

check() { # check <description> <command run in the VM as the user>
  if out=$("$here/ssh" "$vm" "$user" -- "$2" 2>&1); then
    printf '  \033[32mok\033[0m   %s\n' "$1"
  else
    printf '  \033[31mFAIL\033[0m %s\n%s\n' "$1" "$(sed 's/^/         /' <<<"$out")"; fail=1
  fi
}
check "system state is running"        'state=$(systemctl is-system-running); echo $state; [ "$state" = running ]'
check "root is btrfs subvolume @"      'findmnt -no FSTYPE,OPTIONS / | grep -qE "btrfs.*subvol=/@(,|$)"'
check "separate subvolumes mounted"    'for m in /home /var/log /var/cache/pacman/pkg /.snapshots; do findmnt -n $m >/dev/null || exit 1; done'
check "booted by Limine (fallback path)" "echo '$password' | sudo -S -p '' sh -c 'test -f /boot/EFI/BOOT/BOOTX64.EFI && tr -d \\\\000 < /sys/firmware/efi/efivars/LoaderInfo-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f | grep -q Limine'"
check "zram swap active"               'swapon --show=NAME --noheadings | grep -q zram'
if (( alongside )); then
  sudo_pw="echo '$password' | sudo -S -p ''"
  check "alongside: Windows partitions unchanged" "[ \"\$($sudo_pw sh -c '$windows_fingerprint')\" = '$windows_before' ]"
  check "alongside: installed into the free space" "lsblk -lno PARTN,PARTLABEL /dev/vda | grep -qx ' *4 $name boot' && lsblk -lno PARTN,PARTLABEL /dev/vda | grep -qx ' *5 $name system' && findmnt -no SOURCE /boot | grep -qx /dev/vda4"
  check "alongside: firmware starts us first, Windows kept" "o=\$($sudo_pw efibootmgr); printf '%s\\n' \"\$o\"; first=\$(sed -n 's/^BootOrder: \\([0-9A-F]*\\).*/\\1/p' <<<\"\$o\"); grep -q \"^Boot\$first\\*\\{0,1\\} $name\" <<<\"\$o\" && grep -q 'Windows Boot Manager' <<<\"\$o\" && cur=\$(sed -n 's/^BootCurrent: //p' <<<\"\$o\") && [ \"\$cur\" = \"\$first\" ]"
  check "alongside: boot menu has Windows" "$sudo_pw sh -c 'grep -q \"^entry: Windows Boot Manager\\|^ *entry: Windows Boot Manager\" /boot/limine.conf && grep -q \"guid(.*):/EFI/Microsoft/Boot/bootmgfw.efi\" /boot/limine.conf'"
  check "alongside: Limine copies kept up to date" "$sudo_pw sh -c 'cmp -s /usr/share/limine/BOOTX64.EFI /boot/EFI/$id/BOOTX64.EFI && cmp -s /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI && grep -q \"/boot/EFI/$id/BOOTX64.EFI\" /usr/share/libalpm/hooks/$id-limine-update.hook && grep -qx BOOT_MODE=alongside /etc/$id/boot.conf'"
fi
check "NetworkManager connected"       'nmcli -t -f STATE general | grep -q "^connected"'
check "internet reachable"             'curl -sfI https://archlinux.org -o /dev/null'
check "time synchronised service on"   'systemctl is-active --quiet systemd-timesyncd'
check "sudo works for $user"           "echo '$password' | sudo -S -p '' true"
check "root account locked"            "echo '$password' | sudo -S -p '' passwd -S root | grep -q ' L '"
check "/boot is root-only"           'test "$(stat -c %a /boot)" = 700'
if "$here/ssh" "$vm" "$user" -- "pacman -Q $id >/dev/null 2>&1"; then
  check "distro packages installed"     "pacman -Q $id $id-settings"
  # Privacy and security by default (decision record 0031).
  sudo_vm="echo '$password' | sudo -S -p ''"
  check "firefox policies in place"     "jq -e '.policies.DisableTelemetry == true and .policies.DNSOverHTTPS.Enabled == false and .policies.HttpsOnlyMode == \"enabled\"' /etc/firefox/policies/policies.json >/dev/null"
  check "telemetry opt-outs in shells"  "bash -lc 'echo \$DO_NOT_TRACK \$DOTNET_CLI_TELEMETRY_OPTOUT \$DISABLE_TELEMETRY' | grep -qx '1 1 1'"
  check "firewall refuses incoming"     "$sudo_vm firewall-cmd --state | grep -qx running && $sudo_vm firewall-cmd --get-default-zone | grep -qx public && $sudo_vm firewall-cmd --permanent --zone=public --get-target | grep -qx default && [ -z \"\$($sudo_vm firewall-cmd --zone=public --list-ports)\" ]"
  check "firewall: ssh open only because a key was set up" "$sudo_vm firewall-cmd --zone=public --list-services | tr ' ' '\\n' | grep -qx ssh && systemctl is-enabled --quiet sshd"
  check "network privacy settings"      "NetworkManager --print-config | grep -qx 'wifi.cloned-mac-address=stable' && NetworkManager --print-config | grep -qx 'ipv6.ip6-privacy=2' && NetworkManager --print-config | grep -qx 'ipv4.dhcp-send-hostname=false'"
  check "kernel hardening applied"      "[ \$(sysctl -n kernel.kptr_restrict) = 2 ] && [ \$(sysctl -n kernel.unprivileged_bpf_disabled) = 1 ] && [ \$(sysctl -n kernel.kexec_load_disabled) = 1 ] && [ \$(sysctl -n kernel.yama.ptrace_scope) = 1 ]"
  check "calculator downloads nothing"  "[ \$(gsettings get org.gnome.calculator refresh-interval) = 0 ]"
  check "firmware checks only on request" "pacman -Q fwupd >/dev/null && ! systemctl is-enabled --quiet fwupd-refresh.timer"
  check "home folder private"           "[ \$(stat -c %a ~) = 700 ]"
  check "privacy switches report"       "$id privacy | grep -qE '^weather in the bar +off' && $id firewall apps | grep -q localsend"
  check "encrypted DNS on and off"      "$sudo_vm env HOME=/root /usr/bin/$id privacy dns quad9 >/dev/null && sleep 3 && resolvectl status | grep -q '+DNSOverTLS' && getent hosts archlinux.org >/dev/null && $sudo_vm env HOME=/root /usr/bin/$id privacy dns off >/dev/null && sleep 3 && [ ! -L /etc/resolv.conf ] && ! grep -rqs DNSOverTLS /etc/systemd/resolved.conf.d && getent hosts archlinux.org >/dev/null"
  check "package files intact"          "pacman -Qkk $id 2>&1 | grep -q ', 0 altered files'"
  check "login screen uses distro config" "systemctl cat greetd | grep -q -- '--config /etc/greetd/$id.toml'"
  check "hidden apps dir in XDG_DATA_DIRS" "systemctl --user show-environment | grep -q '^XDG_DATA_DIRS=/usr/share/$id/xdg'"
  check "system names itself (os-release)" ". /etc/os-release; [ \"\$ID\" = $id ] && [ \"\$ID_LIKE\" = arch ] && [ -n \"\$NAME\" ]"
  check "signing key trusted"            "pacman -Q $id-keyring >/dev/null && echo '$password' | sudo -S -p '' pacman-key --list-keys $(cat "$repo/pkg/keyring/fingerprint") >/dev/null"
  check "package repository enabled, signed" "grep -A2 '^\\[$id\\]\$' /etc/pacman.conf | grep -qx 'SigLevel = Required' && grep -A2 '^\\[$id\\]\$' /etc/pacman.conf | grep -qx 'Server = $repo_url'"
  check "snapshots configured (@snapshots)" "[ \"\$(findmnt -no FSROOT /.snapshots)\" = /@snapshots ] && echo '$password' | sudo -S -p '' snapper -c root get-config | grep TIMELINE_CREATE | grep -qw no"
  check "a package install takes snapshots" "echo '$password' | sudo -S -p '' pacman -S --noconfirm tree >/dev/null && echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns type,description | grep -q '^pre,.*tree' && echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns type | grep -qx post"
  check "boot menu lists the snapshot"   "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1) && echo '$password' | sudo -S -p '' grep -q \"^//Before update, .* (#\$n)\$\" /boot/limine.conf && echo '$password' | sudo -S -p '' grep -q \"rootflags=subvol=@snapshots/\$n/snapshot .*systemd.volatile=overlay\" /boot/limine.conf"
  check "rollback dry run shows the plan" "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1) && echo '$password' | sudo -S -p '' $id update rollback-apply \$n --dry-run | grep -q 'Plan:'"
  check "distro icon installed"         "test -f /usr/share/icons/hicolor/scalable/apps/$id-logo.svg && test -f /usr/share/icons/hicolor/symbolic/apps/$id-logo-symbolic.svg"
  check "os-release names the icon"     "grep -qx 'LOGO=$id-logo' /etc/os-release"
  check "fastfetch uses the distro logo" "grep -q '/usr/share/$id/default/branding/fastfetch-logo.txt' /etc/xdg/fastfetch/config.jsonc && fastfetch --pipe >/dev/null"
  check "boot menu has the wallpaper"   "echo '$password' | sudo -S -p '' sh -c 'grep -q \"^wallpaper: boot():/$id/wallpaper.png\" /boot/limine.conf && test -s /boot/$id/wallpaper.png'"
  check "console uses the theme palette" "grep -q 'vt.default_red=11,' /proc/cmdline"
  check "login screen is themed"        "grep -q -- \"--theme 'border=yellow\" /etc/greetd/$id.toml"
  check "boot splash is the distro theme" "test -f /usr/share/plymouth/themes/$id/$id.script && [ \"\$(plymouth-set-default-theme)\" = $id ]"
  check "splash hook in the initramfs"   "grep -hE '^HOOKS=' /etc/mkinitcpio.conf.d/$id-hooks.conf | grep -qE 'systemd plymouth'"
  check "initramfs carries the splash"   "echo '$password' | sudo -S -p '' lsinitcpio /boot/initramfs-linux.img | grep -q 'usr/share/plymouth/themes/$id/$id.script'"
  check "splash on the boot command line" "grep -qw splash /proc/cmdline"
fi
if [[ -n $iso ]]; then
  check "installed from the ISO's installer" "pacman -Q $id | grep -q ."
fi
if "$here/ssh" "$vm" "$user" -- "pacman -Q firefox >/dev/null 2>&1"; then
  check "default apps installed"        "pacman -Q firefox nautilus gnome-text-editor papers loupe showtime decibels gnome-calculator btop pika-backup >/dev/null"
  check "app catalog lists apps"        "$id app list | grep -q steam && $id app search claude | grep -q claude-desktop"
  check "default editor is micro"       "command -v micro >/dev/null && [ \"\$(bash -lc 'echo \$EDITOR')\" = micro ] && systemctl --user show-environment | grep -qx EDITOR=micro"
  check "shell defaults active"         "grep -q 'shell defaults' ~/.bashrc && bash -ic 'alias ll && type z && type starship_precmd' >/dev/null 2>&1"
  check "app catalog has dev tools"     "$id app list dev | grep -q docker && $id app list dev | grep -q postgres"
  check "bluetooth service enabled"     "systemctl is-enabled --quiet bluetooth"
  check "VM has no vendor GPU drivers"  "! pacman -Q vulkan-radeon nvidia-utils vulkan-intel 2>/dev/null | grep -q ."
fi
if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/migrate"; then
  check "fresh install: system migrations marked" "echo '$password' | sudo -S -p '' $id migrate --system --list | grep -qv pending || true; ! (echo '$password' | sudo -S -p '' $id migrate --system --list | grep -q pending)"
  check "new user: user migrations marked"        "$id migrate --user --list | grep -q '^applied' && ! $id migrate --user --list | grep -q pending"
  check "migration service ran at login"          "systemctl --user show -p Result $id-migrate.service | grep -q success"
  # Simulate an update that ships one new user and one new system migration.
  "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' sh -c 'echo \"touch \\\$HOME/user-migration-ran\" > /usr/share/$id/migrations/user/29990101-0000-test.sh; echo \"touch /var/lib/$id/system-migration-ran\" > /usr/share/$id/migrations/system/29990101-0000-test.sh'" || true
  check "new user migration runs once"   "$id migrate --user >/dev/null && test -f ~/user-migration-ran && rm ~/user-migration-ran && $id migrate --user >/dev/null && ! test -f ~/user-migration-ran"
  check "new system migration runs"      "echo '$password' | sudo -S -p '' $id migrate --system >/dev/null && test -f /var/lib/$id/system-migration-ran"
  check "ghostty migration fixes an old config" "sed -i '/app-notifications/d; /announce it/d' ~/.config/ghostty/config && sed -i '/ghostty-quiet-reloads/d' ~/.local/state/$id/migrations-applied && $id migrate --user >/dev/null && grep -q '^app-notifications = no-config-reload' ~/.config/ghostty/config"
fi
if (( encrypt )); then
  check "root filesystem is on LUKS"   "lsblk -lno TYPE,NAME | grep -qE '^crypt +system$'"
  check "LUKS2 unlocked at boot"       "echo '$password' | sudo -S -p '' cryptsetup status system | grep -qE 'type: +LUKS2'"
fi
check "hostname from distro.conf"      "test \"\$(cat /etc/hostname)\" = \"$(. "$repo/distro.conf"; echo "$DISTRO_ID")\""

# Layer 2 and later: the desktop session.
if "$here/ssh" "$vm" "$user" -- 'test -x /usr/bin/Hyprland'; then
  hypr='export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-1; export HYPRLAND_INSTANCE_SIGNATURE=$(ls $XDG_RUNTIME_DIR/hypr | head -1);'
  # Give the autologin session a moment to come up.
  for _ in $(seq 30); do "$here/ssh" "$vm" "$user" -- 'pgrep -x Hyprland' >/dev/null 2>&1 && break; sleep 2; done
  check "login screen service active"   'systemctl is-active --quiet greetd'
  check "Hyprland running for $user"    'pgrep -u "$USER" -x Hyprland >/dev/null'
  check "Hyprland answers hyprctl"      "$hypr hyprctl monitors | grep -q '^Monitor'"
  check "pointer hides when idle"       "$hypr"' hyprctl getoption cursor:inactive_timeout | grep -qE "(float|int): 3"'
  check "session config loaded cleanly" "$hypr"' out=$(hyprctl configerrors); echo "$out"; [ -z "$(printf %s "$out" | tr -d "[:space:]")" ] || printf %s "$out" | grep -qi "no errors"'
  # pipewire-pulse starts on demand, so its socket is what should be listening.
  check "audio services running"        'systemctl --user is-active --quiet pipewire wireplumber pipewire-pulse.socket && wpctl status >/dev/null'
  if "$here/ssh" "$vm" "$user" -- 'test -x /usr/bin/noctalia'; then
    # Layer 3: the shell.
    check "shell service running"        'systemctl --user is-active --quiet noctalia'
    check "shell owns notifications"     'busctl --user status org.freedesktop.Notifications 2>/dev/null | grep -q "^Comm=noctalia"'
    check "notifications can be sent"    "$hypr"' notify-send "Test" "Hello from the install test"'
    check "shell answers its IPC"        "$hypr"' noctalia msg status >/dev/null'
    check "shell config has no errors"   "$hypr"' noctalia config validate 2>&1 | tail -3; noctalia config validate >/dev/null 2>&1'
    check "weather and location off by default" "$hypr"' noctalia config export | grep -A3 "^\[weather\]" | grep -q "enabled = false" && noctalia config export | grep -A3 "^\[location\]" | grep -q "auto_locate = false"'
    check "crash capture never looks up symbols online" "systemctl --user show -p Environment $id-crash-watch.service | grep -qE 'DEBUGINFOD_URLS=( |\$)'"
    check "idle desktop connects nowhere unexpected" "$(sed -e "s/@ID@/$id/g" -e "s/@PW@/$password/g" "$here/checks/privacy-traffic.sh")"
    check "editor follows the theme"     "grep -q 'rendered by Noctalia' ~/.config/micro/colorschemes/noctalia.micro && ! grep -q '{{' ~/.config/micro/colorschemes/noctalia.micro"
    check "distro shell defaults applied" "$hypr"' noctalia config export | grep -qE "^polkit_agent *= *true"'
    check "clutter hidden from launcher"  "grep -q '^NoDisplay=true' /usr/local/share/applications/avahi-discover.desktop 2>/dev/null || grep -q '^NoDisplay=true' /usr/share/$id/xdg/applications/avahi-discover.desktop"
    # Every launcher entry must be one we mean to show; new dependency clutter fails here.
    check "launcher shows only intended apps" "for f in /usr/share/applications/*.desktop; do n=\${f##*/}; grep -q '^NoDisplay=true' \"\$f\" && continue; [ -f /usr/share/$id/xdg/applications/\$n ] && continue; echo \$n; done | sort | tr '\\n' ' ' | tee /dev/stderr | grep -qxE '(btop.desktop |com.mitchellh.ghostty.desktop |dev.noctalia.Noctalia.desktop |firefox.desktop |org.gnome.Calculator.desktop |org.gnome.Decibels.desktop |org.gnome.Loupe.desktop |org.gnome.Nautilus.desktop |org.gnome.Papers.desktop |org.gnome.Showtime.desktop |org.gnome.World.PikaBackup.desktop |org.gnome.TextEditor.desktop |org.wezfurlong.wezterm.desktop )+'"
    check "launcher opens"               "$hypr"' noctalia msg panel-open launcher'
  else
    check "polkit agent running"         'systemctl --user is-active --quiet hyprpolkitagent'
  fi
  if "$here/ssh" "$vm" "$user" -- "command -v $id" >/dev/null 2>&1; then
    term_cmd="$id terminal launch"; term_class=ghostty
  else
    term_cmd="uwsm app -- wezterm"; term_class=wezterm
  fi
  check "terminal opens a window"       "$hypr hyprctl dispatch 'hl.dsp.exec_cmd(\"$term_cmd\")' >/dev/null; for i in \$(seq 20); do hyprctl clients | grep -qi $term_class && exit 0; sleep 1; done; exit 1"
  check "screen-sharing portal available" "$hypr"' busctl --user introspect org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop | grep -q org.freedesktop.portal.ScreenCast'
  shots=~/.local/share/arch-distro-vm/screenshots; mkdir -p "$shots"
  screenshot() { # screenshot <label>
    local shot
    shot=$shots/$vm-$(date +%Y%m%d-%H%M%S)-$1.png
    if "$here/ssh" "$vm" "$user" -- "$hypr sleep 2; grim -" > "$shot" 2>/dev/null && [[ -s $shot ]]; then
      log "screenshot: $shot"
    else
      rm -f "$shot"; log "screenshot failed"
    fi
  }
  screenshot desktop

  if "$here/ssh" "$vm" "$user" -- "command -v $id" >/dev/null 2>&1; then
    # Layer 4 and later: the CLI and themes.
    for _ in $(seq 20); do "$here/ssh" "$vm" "$user" -- "test -f ~/.local/state/$id/first-login-done" && break; sleep 2; done
    check "CLI lists its commands"        "$id help | grep -q theme"
    check "first-login setup ran"         "test -f ~/.local/state/$id/first-login-done"
    # The setup window opens once at first login: welcome, then backups.
    check "setup window opens at first login" "$hypr for i in \$(seq 20); do hyprctl clients -j | jq -e '.[] | select(.class == \"$id.setup\")' >/dev/null && exit 0; sleep 1; done; exit 1"
    screenshot setup-welcome
    check "setup goes on to backups"      "$hypr hyprctl dispatch 'hl.dsp.focus({ window = \"class:^$id.setup\$\" })' >/dev/null; sleep 0.5; wtype -k Return; sleep 1.5; true"
    screenshot setup-backups
    check "backups step opens Pika's setup" "$hypr pkill -f -- '^(/usr/bin/)?ghostty --class=${id}[.]setup'; gapplication launch org.gnome.World.PikaBackup; sleep 1; gapplication action org.gnome.World.PikaBackup setup; for i in \$(seq 20); do hyprctl clients -j | jq -e '.[] | select(.class | test(\"PikaBackup\"))' >/dev/null && exit 0; sleep 1; done; exit 1"
    screenshot pika-setup
    check "\"Later\" schedules one reminder" "$hypr pkill -x pika-backup; rm -rf ~/.local/state/$id/setup; $id setup welcome --skip && test -f ~/.local/state/$id/setup/finished && grep -qx skipped ~/.local/state/$id/setup/backups && due=\$(cat ~/.local/state/$id/setup/remind-at) && [ \$(( due - \$(date +%s) )) -gt 250000 ] && systemctl --user is-active --quiet $id-setup-reminder.timer"
    check "reminder waits until it's due" "$id setup remind-backups && ! test -f ~/.local/state/$id/setup/reminded"
    check "reminder shows once, never again" "$hypr echo 0 > ~/.local/state/$id/setup/remind-at; timeout 5 $id setup remind-backups; test -f ~/.local/state/$id/setup/reminded && r1=\$(stat -c %Y ~/.local/state/$id/setup/reminded) && sleep 1 && $id setup remind-backups && [ \$(stat -c %Y ~/.local/state/$id/setup/reminded) = \$r1 ]"
    check "app export lists an added package" "pacman -Q tree >/dev/null 2>&1 || echo '$password' | sudo -S -p '' pacman -S --noconfirm tree >/dev/null; $id app export /tmp/apps.txt >/dev/null && awk '/^\\[packages\\]/{on=1;next} /^\\[/{on=0} on' /tmp/apps.txt | grep -qx tree && grep -q '^theme = ' /tmp/apps.txt && ! grep -qiE 'password|token|secret' /tmp/apps.txt"
    check "app import previews what's missing" "printf '[packages]\\ncowsay\\n[catalog]\\nobsidian\\n[settings]\\ntheme = nord\\n' > /tmp/import.txt && out=\$($id app import /tmp/import.txt --dry-run) && grep -q cowsay <<<\"\$out\" && grep -q obsidian <<<\"\$out\" && grep -q 'theme = nord' <<<\"\$out\" && ! pacman -Q cowsay >/dev/null 2>&1"
    check "default theme applied"         "$hypr $id theme current | grep -q '^moonlit (dark)'; noctalia msg color-scheme-get | grep -q 'custom $id-moonlit'"
    check "terminal theme generated"      'test -s ~/.config/ghostty/themes/noctalia'
    check "Hyprland borders from theme"   "$hypr test -s ~/.config/hypr/noctalia.lua && grep -q 'ebc77a' ~/.config/hypr/noctalia.lua"
    check "GTK follows theme"             'test -s ~/.config/gtk-4.0/noctalia.css && [ "$(gsettings get org.gnome.desktop.interface icon-theme)" = "'"'"'Papirus-Dark'"'"'" ]'
    check "default terminal is ghostty"   "$id terminal list | grep -qE '^\* ghostty +installed'"
    check "switch theme to tide"          "$hypr $id theme set tide >/dev/null && sleep 2 && grep -q '6cb6d9' ~/.config/hypr/noctalia.lua && grep -qi '10161d' ~/.config/ghostty/themes/noctalia"
    screenshot tide
    check "switch to paper (light)"       "$hypr $id theme set paper >/dev/null && sleep 2 && noctalia msg theme-mode-get | grep -q light && [ \"\$(gsettings get org.gnome.desktop.interface icon-theme)\" = \"'Papirus-Light'\" ]"
    screenshot paper
    check "all themes listed"             "[ \$($id theme list --plain | wc -l) -ge 17 ] && $id theme list --plain | grep -qP '^catppuccin\t'"
    check "switch to catppuccin"          "$hypr $id theme set catppuccin >/dev/null && sleep 2 && grep -q 'cba6f7' ~/.config/hypr/noctalia.lua && grep -qi '1e1e2e' ~/.config/ghostty/themes/noctalia"
    check "wallpaper cycles"              "$hypr $id theme wallpaper next | grep -q '^wallpaper 2 of ' && grep -q '^wallpaper.catppuccin = 2' ~/.config/$id/settings && $id theme wallpaper set 1 >/dev/null"
    screenshot catppuccin
    check "switch to eclipse"             "$hypr $id theme set eclipse >/dev/null && sleep 2 && grep -q 'f5c542' ~/.config/hypr/noctalia.lua"
    screenshot eclipse
    check "earthshine opens light"        "$hypr $id theme set earthshine >/dev/null && sleep 2 && noctalia msg theme-mode-get | grep -q light"
    screenshot earthshine

    # Layer 5: crash inbox, agents, updates.
    "$here/ssh" "$vm" "$user" -- "$hypr $id theme set moonlit >/dev/null" || true
    check "crash watcher running"         "systemctl --user is-active --quiet $id-crash-watch"
    check "crash plugin enabled"          "$hypr noctalia msg plugins list 2>&1 | grep -E '$id/crashes' | grep -qiE 'enabled|on|yes|true'"
    check "a crash is captured"           "$id crash test >/dev/null; for i in \$(seq 20); do [ \"\$($id crash list --json | jq length)\" = 1 ] && exit 0; sleep 1; done; exit 1"
    check "capture has the coredump report" "f=\$($id crash list --json | jq -r '.[0].last_capture'); grep -q 'systemd-coredump report' \"\$f\" && grep -qi sleep \"\$f\""
    check "repeat crash is grouped"       "$id crash test >/dev/null; for i in \$(seq 20); do c=\$($id crash list --json | jq '[length, .[0].count] | @csv' -r); [ \"\$c\" = '1,2' ] && exit 0; sleep 1; done; echo \$c; exit 1"
    check "notified only once"            "$id crash list --json | jq -e '.[0].notified == true' >/dev/null"
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null 2>&1; noctalia msg panel-toggle $id/crashes:viewer >/dev/null 2>&1" || true
    screenshot crashes
    check "resolve empties the inbox"     "$hypr $id crash resolve \$($id crash list --json | jq -r '.[0].id') && [ \"\$($id crash list --json | jq length)\" = 0 ]"
    check "resolved crash returns and notifies" "$id crash test >/dev/null; for i in \$(seq 20); do $id crash list --json | jq -e '.[0].count == 3 and .[0].status == \"new\" and .[0].notified == true' >/dev/null && exit 0; sleep 1; done; exit 1"
    # AI usage: seed a week of Claude Code records and one Codex session, then read them back.
    "$here/ssh" "$vm" "$user" -- 'mkdir -p ~/.claude/projects/demo ~/.codex/sessions/demo; now=$(date +%s); : > ~/.claude/projects/demo/s.jsonl
      for d in 0 1 2 3 4 5 6; do for n in 1 2 3; do t=$(date -u -d "@$((now - d*86400 - n))" +%Y-%m-%dT%H:%M:%S.000Z)
        printf "{\"type\":\"assistant\",\"timestamp\":\"%s\",\"sessionId\":\"s%s\",\"message\":{\"id\":\"m%s-%s\",\"model\":\"%s\",\"usage\":{\"input_tokens\":%s,\"output_tokens\":2000,\"cache_creation_input_tokens\":5000,\"cache_read_input_tokens\":90000}}}\n" "$t" "$d" "$d" "$n" "$( [ $n = 3 ] && echo claude-haiku-4-5 || echo claude-opus-5-5 )" "$(( (7-d) * 40000 ))" >> ~/.claude/projects/demo/s.jsonl; done; done
      t=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
      printf "%s\n" "{\"timestamp\":\"$t\",\"type\":\"turn_context\",\"payload\":{\"model\":\"gpt-5-codex\"}}" "{\"timestamp\":\"$t\",\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"last_token_usage\":{\"input_tokens\":52000,\"cached_input_tokens\":12000,\"output_tokens\":8000}},\"rate_limits\":{\"primary\":{\"used_percent\":38,\"resets_in_seconds\":7400},\"secondary\":{\"used_percent\":91,\"resets_in_seconds\":300000}}}}" > ~/.codex/sessions/demo/rollout.jsonl'
    check "AI usage collected"            "$id agent usage --json | jq -e '(.agents | length) == 2 and (.agents[] | select(.name == \"claude\") | .today.messages == 3 and (.days | length) == 7 and (.models | length) == 2) and (.agents[] | select(.name == \"codex\") | (.limits | length) == 2)' >/dev/null"
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg plugin $id/agents:usage all refresh >/dev/null 2>&1; sleep 3; noctalia msg panel-close >/dev/null 2>&1; noctalia msg panel-toggle $id/agents:panel >/dev/null 2>&1" || true
    screenshot ai-usage
    "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg plugin $id/agents:panel all select codex >/dev/null 2>&1" || true
    screenshot ai-usage-codex
    # Screensaver: opens fullscreen over everything, closes on stop.
    if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/screensaver"; then
      check "screensaver engine installed" "command -v tte >/dev/null"
      check "screensaver has the distro effects" "$id screensaver effects | grep -qx moonarc && $id screensaver effects | grep -qx eclipse && $id screensaver effects | grep -qx moonrise"
      check "screensaver effects run"       "for e in moonarc eclipse moonrise; do XDG_CONFIG_HOME=\${XDG_RUNTIME_DIR}/$id-screensaver script -qc \"stty cols 160 rows 45; tte -i /usr/share/$id/default/screensaver/wordmark.txt --frame-rate 0 \$e --final-gradient-stops e6e2d6 ebc77a --final-gradient-direction horizontal\" /dev/null >/dev/null || exit 1; done"
      check "screensaver opens fullscreen" "$hypr $id screensaver start; for i in \$(seq 20); do hyprctl clients -j | jq -e '.[] | select(.class == \"$id.screensaver\") | .fullscreen > 0' >/dev/null && exit 0; sleep 1; done; hyprctl clients -j | jq -c '.[] | {class, fullscreen}'; exit 1"
      "$here/ssh" "$vm" "$user" -- "sleep 3" || true
      screenshot screensaver
      check "screensaver closes on stop"   "$hypr $id screensaver stop; sleep 2; ! hyprctl clients | grep -q 'class: $id.screensaver'"
      check "idle locks with the screensaver" "$hypr noctalia config export | grep -A4 'idle.behavior.screensaver' | grep -q 'lock --idle'"
    fi
    if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/menu"; then
      check "bar has the utility group"   "$hypr noctalia config export | grep -qE 'center *=.*stay-awake.*silence.*reminders.*recorder.*dictate.*clock'"
      check "utilities plugin enabled"    "$hypr noctalia msg plugins list 2>&1 | grep -E '$id/utilities' | grep -qiE 'enabled'"
      # Workspaces (decision record 0037): numbers, the active one as its moon
      # phase, a gold dot for a window asking for attention.
      check "workspaces widget in the bar"  "$hypr noctalia config export | grep -qE '^start *= *\\[ *\"menu\", *\"workspaces\" *\\]' && noctalia config export | grep -qE 'type *= *\"$id/utilities:workspaces\"'"
      check "workspace watcher running"     "systemctl --user is-active --quiet $id-workspace-watch"
      check "workspaces follow Hyprland"    "$hypr $id workspaces go 3 && sleep 1 && $id workspaces state | jq -e '.active == 3 and (.items | length) >= 5' >/dev/null"
      check "attention: dot, then SUPER+U"  "$(sed "s/@ID@/$id/g" "$here/checks/attention.sh")"
      # Low Gravity (decision record 0038): float this workspace, tile it again.
      check "Low Gravity: float, spread, new windows, off, all" "$(sed "s/@ID@/$id/g" "$here/checks/gravity.sh")"
      "$here/ssh" "$vm" "$user" -- "$hypr $id workspaces go 6; for i in 1 2 3; do hyprctl dispatch 'hl.dsp.exec_cmd(\"ghostty --gtk-single-instance=false\")' >/dev/null; sleep 2; done; $id gravity on >/dev/null; sleep 2" >/dev/null 2>&1 || true
      screenshot gravity-on
      "$here/ssh" "$vm" "$user" -- "$hypr $id gravity off >/dev/null; sleep 2" >/dev/null 2>&1 || true
      screenshot gravity-off
      "$here/ssh" "$vm" "$user" -- "$hypr for p in \$(hyprctl clients -j | jq -r '.[] | select(.workspace.id == 6) | .pid'); do kill \$p; done" >/dev/null 2>&1 || true
      check "workspaces style switches"     "$hypr $id workspaces style noctalia >/dev/null && sleep 2 && noctalia config export | grep -qE 'workspaces-noctalia' && noctalia config export | grep -qE '^center *=.*stay-awake' && $id workspaces style moon >/dev/null && sleep 2 && ! noctalia config export | grep -qE '^start *=.*workspaces-noctalia'"
      "$here/ssh" "$vm" "$user" -- "$hypr $id workspaces go 3" >/dev/null 2>&1 || true
      screenshot workspaces
      check "system menu opens"           "$hypr $id menu; sleep 1.5; noctalia msg status | jq -e '.activePanelId == \"launcher\"' >/dev/null"
      screenshot menu
      check "keyboard shortcuts listed"   "$hypr noctalia msg panel-close >/dev/null; $id keys --list | grep -q 'System menu'"
      check "screenshot saves a file"     "$hypr f=\$($id capture screenshot screen) && test -s \"\$f\""
      check "screen recording saves a file" "$hypr $id capture record screen >/dev/null && sleep 3 && f=\$($id capture stop | tail -1) && test -s \"\$f\""
      check "a reminder fires"            "$hypr $id remind 'install test' in 3s >/dev/null && for i in \$(seq 15); do $id remind list | grep -q 'install test' || exit 0; sleep 1; done; exit 1"
      "$here/ssh" "$vm" "$user" -- "$hypr $id remind 'stretch' in 20m >/dev/null; noctalia msg panel-open $id/utilities:reminders-panel >/dev/null" || true
      screenshot reminders
      "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null" || true
    fi
    if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/keyboard"; then
      check "lock-outs are short"          "grep -qx 'deny = 10' /etc/security/faillock.conf && grep -qx 'unlock_time = 120' /etc/security/faillock.conf && for i in 1 2 3 4; do echo wrong | sudo -S -k -p '' true 2>/dev/null; done; echo '$password' | sudo -S -k -p '' true"
      check "login screen unlocks the keyring" "grep -q 'pam_gnome_keyring.so auto_start' /etc/pam.d/greetd"
      if (( encrypt )); then
        check "keyring needs no password"  "$hypr export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus; test -f ~/.local/share/keyrings/login.keyring && echo s3cret | timeout 10 secret-tool store --label=install-test app install-test && timeout 10 secret-tool lookup app install-test | grep -qx s3cret && ! hyprctl clients -j | jq -e '.[] | select(.class == \"gcr-prompter\")' >/dev/null"
      else
        check "no passwordless keyring"    "! test -e ~/.local/share/keyrings/login.keyring || ! grep -q '^\[keyring\]' ~/.local/share/keyrings/login.keyring"
      fi
      check "menu searches inside groups" "grep -q 'local function nested' /usr/share/$id/default/noctalia-plugins/utilities/menu.luau && $hypr noctalia msg panel-open launcher '/m steam' >/dev/null && sleep 1 && noctalia msg status | jq -e '.activePanelId == \"launcher\"' >/dev/null"
      screenshot menu-search
      "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null" || true
      check "keyboard layouts switch"      "$hypr $id keyboard add de >/dev/null && sleep 1 && hyprctl devices -j | jq -e '[.keyboards[] | select(.main)][0].layout == \"us,de\"' >/dev/null && $id keyboard next && sleep 1 && hyprctl devices -j | jq -r '.keyboards[] | select(.main) | .active_keymap' | grep -q German"
      screenshot keyboard-layout
      check "keyboard layout removed"      "$hypr $id keyboard remove de >/dev/null && sleep 1 && hyprctl devices -j | jq -e '[.keyboards[] | select(.main)][0].layout == \"us\"' >/dev/null"
      check "displays: scale, arrangement, profile, hotplug" "$(sed "s/@ID@/$id/g" "$here/checks/displays.sh")"
      "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-open launcher '/m Setup › Displays › ' >/dev/null" || true
      screenshot displays-menu
      "$here/ssh" "$vm" "$user" -- "$hypr noctalia msg panel-close >/dev/null" || true
      check "idle: lock stays up; inhibitors respected" "$(sed "s/@ID@/$id/g" "$here/checks/idle.sh")"
      if "$here/ssh" "$vm" "$user" -- "test -x /usr/lib/$id/commands/power"; then
        check "idle counts again after a video" "$(sed "s/@ID@/$id/g" "$here/checks/idle-rearm.sh")"
        check "lid binds: external monitor only" "$hypr hyprctl binds -j | jq -e '[.[] | select(.key == \"switch:on:Lid Switch\" or .key == \"switch:off:Lid Switch\")] | length == 2' >/dev/null"
        check "battery warning at 20%"       "$hypr noctalia config export | grep -A2 '^\[battery\]' | grep -q 'warning_threshold = 20'"
        check "charge limit: says when unsupported" "$id power charge-limit 80 2>&1 | grep -q \"doesn't support a charge limit\""
        check "charge limit re-applied at boot" "test -L /usr/lib/systemd/system/multi-user.target.wants/$id-charge-limit.service && systemctl cat $id-charge-limit.service >/dev/null && test -x /usr/lib/systemd/system-sleep/$id-charge-limit"
        if (( encrypt )); then
          check "hibernate: swap file and resume" "echo '$password' | sudo -S -p '' $id power hibernate enable >/dev/null && swapon --show=NAME --noheadings | grep -qx /swap/swapfile && echo '$password' | sudo -S -p '' grep -q 'resume=UUID=.* resume_offset=' /boot/limine.conf"
          check "hibernate: off again"        "echo '$password' | sudo -S -p '' $id power hibernate disable >/dev/null && ! swapon --show=NAME --noheadings | grep -q /swap/swapfile && ! echo '$password' | sudo -S -p '' grep -q 'resume_offset=' /boot/limine.conf && ! grep -q /swap /etc/fstab"
        else
          check "hibernate: refused unencrypted" "echo '$password' | sudo -S -p '' $id power hibernate enable 2>&1 | grep -q 'only offered on encrypted installs'"
        fi
      fi
      # The lock: the screensaver plays behind a real session lock; the
      # password (typed like a person would) unlocks it.
      check "lock packages installed"       "pacman -Q swaylock-plugin windowtolayer >/dev/null"
      check "lock recovery key works while locked" "$hypr hyprctl binds -j | jq -e '.[] | select(.key == \"L\" and .modmask == 12 and .locked == true)' >/dev/null"
      check "lock engages, screensaver behind it" "$hypr $id lock && sleep 3 && pgrep -x swaylock-plugin >/dev/null && pgrep -x windowtolayer >/dev/null && for i in \$(seq 20); do pgrep -x tte >/dev/null && exit 0; sleep 1; done; exit 1"
      screenshot lock
      check "lock says what it expects"    "$hypr sleep 1; grim - | tesseract stdin - 2>/dev/null | tr -s ' ' | grep -qi 'typing your password'"
      # The ring's states, for the screenshots: typing, a wrong password, caps lock.
      vm_type "abc"; screenshot lock-typing
      virsh send-key "$vm" KEY_ENTER >/dev/null; sleep 1; screenshot lock-wrong; sleep 3
      virsh send-key "$vm" KEY_CAPSLOCK >/dev/null; vm_type "x"; screenshot lock-capslock
      virsh send-key "$vm" KEY_CAPSLOCK >/dev/null; virsh send-key "$vm" KEY_ESC >/dev/null; sleep 1
      vm_type "$password"; virsh send-key "$vm" KEY_ENTER >/dev/null; sleep 5
      check "password unlocks; animation ends" "! pgrep -x swaylock-plugin >/dev/null && sleep 3 && ! pgrep -x windowtolayer >/dev/null && ! pgrep -x tte >/dev/null"
      # Fail closed: without the screensaver lock, Noctalia's lock takes over.
      "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' mv /usr/bin/swaylock-plugin /usr/bin/swaylock-plugin.off" || true
      check "falls back to Noctalia's lock" "$hypr $id lock; sleep 3; noctalia msg status | jq -e '.. | objects | select(has(\"locked\")) | .locked == true' >/dev/null"
      vm_type "$password"; virsh send-key "$vm" KEY_ENTER >/dev/null; sleep 4
      "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' mv /usr/bin/swaylock-plugin.off /usr/bin/swaylock-plugin" || true
    fi
    check "agent list knows claude"       "$id agent list | grep -qE '^\\* claude'"
    check "update check runs"             "$id update check >/dev/null"
  fi

  # Last: logging out of the autologin session should bring up the login screen.
  check "logging out shows the login screen" "$hypr"' uwsm stop >/dev/null 2>&1; for i in $(seq 20); do pgrep -x tuigreet >/dev/null && exit 0; sleep 1; done; exit 1'
fi

# Optional: start the snapshot taken before the `tree` install from the boot
# menu (default_entry set for one boot), check it's that snapshot under a RAM
# overlay with the desktop up, keep it from inside, restart normally.
if (( bootsnap )) && (( ! encrypt )); then
  log "starting the pre-update snapshot from the boot menu"
  "$here/ssh" "$vm" "$user" -- "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1); echo '$password' | sudo -S -p '' $id boot snapshots next \$n && echo '$password' | sudo -S -p '' systemctl reboot" || fail=1
  sleep 15; wait_ssh "$user" 300
  check "snapshot boot: started that snapshot" "grep -q '$id.snapshot=' /proc/cmdline && [ \"\$(findmnt -no FSTYPE /)\" = overlay ]"
  check "snapshot boot: the install isn't there" "! command -v tree"
  check "snapshot boot: desktop up"      'for i in $(seq 30); do pgrep -u "$USER" -x Hyprland >/dev/null && exit 0; sleep 1; done; exit 1'
  check "snapshot boot: boots cleanly"   'state=$(systemctl is-system-running); echo $state; [ "$state" = running ]'
  check "snapshot boot: updates refused"  "! $id update 2>&1 </dev/null | grep -q '^:: Synchronizing' && $id update 2>&1 </dev/null | grep -q 'running snapshot'"
  check "snapshot boot: notice offered"  "systemctl --user is-active --quiet $id-snapshot-notice.service || systemctl --user show -p ExecMainStatus $id-snapshot-notice.service | grep -q ."
  log "keeping the snapshot and restarting"
  "$here/ssh" "$vm" "$user" -- "n=\$(grep -o '$id.snapshot=[0-9]*' /proc/cmdline | cut -d= -f2); echo '$password' | sudo -S -p '' $id boot snapshots next --clear && echo '$password' | sudo -S -p '' $id update rollback-apply \$n && echo '$password' | sudo -S -p '' systemctl reboot" || fail=1
  sleep 15; wait_ssh "$user" 300
  check "kept snapshot: the install is undone" "! command -v tree"
  check "kept snapshot: normal boot of @"  "! grep -q '$id.snapshot=' /proc/cmdline && [ \"\$(findmnt -no FSROOT /)\" = /@ ]"
  check "kept snapshot: menu still has snapshots" "echo '$password' | sudo -S -p '' grep -q '^//Before update' /boot/limine.conf"
  rollback=0
fi

# Optional: undo the `tree` install by rolling back, restart, and check the
# restored system is the one running.
if (( rollback )) && (( ! encrypt )); then
  log "rolling back the tree install and restarting"
  "$here/ssh" "$vm" "$user" -- "n=\$(echo '$password' | sudo -S -p '' snapper -c root --csvout list --columns number,type,description | awk -F, '\$2 == \"pre\" && /tree/ { print \$1 }' | tail -1); echo '$password' | sudo -S -p '' $id update rollback-apply \$n" || fail=1
  "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' systemctl reboot" || true
  sleep 15; wait_ssh "$user" 300
  check "rollback: the install is undone" "! command -v tree"
  check "rollback: booted the restored @"  "[ \"\$(findmnt -no FSROOT /)\" = /@ ]"
  check "rollback: old system kept aside"  "echo '$password' | sudo -S -p '' sh -c 'd=\$(mktemp -d); mount -o subvolid=5 \$(findmnt -no SOURCE / | sed \"s/\\[.*//\") \$d && ls \$d | grep -q ^@old-; r=\$?; umount \$d; exit \$r'"
  check "rollback: snapshots still there"  "echo '$password' | sudo -S -p '' snapper -c root list | grep -q tree"
fi

# The pretend Windows' and our firmware entries would outlive the disk they
# point at; remove them (not with --keep, which leaves everything as it is).
if (( alongside && ! keep )); then
  "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' sh -c 'efibootmgr | sed -n \"s/^Boot\\([0-9A-Fa-f]\\{4\\}\\)\\*\\{0,1\\} \\(Windows Boot Manager\\|$name\\)\\b.*/\\1/p\" | while read -r n; do efibootmgr -q -b \$n -B; done'" || true
fi
if (( keep )); then log "leaving $vm running"; else "$here/ssh" "$vm" "$user" -- "echo '$password' | sudo -S -p '' poweroff" || true; fi
(( fail )) && { log "FAILED"; exit 1; }
log "all checks passed"
