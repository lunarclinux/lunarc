  fi
  check "terminal opens a window"       "$hypr hyprctl dispatch 'hl.dsp.exec_cmd(\"$term_cmd\")' >/dev/null; for i in \$(seq 20); do hyprctl clients | grep -qi $term_class && exit 0; sleep 1; done; exit 1"
  check "screen-sharing portal available" "$hypr"' busctl --user introspect org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop | grep -q org.freedesktop.portal.ScreenCast'
  shots=~/.local/share/arch-distro-vm/screenshots; mkdir -p "$shots"
  screenshot() { # screenshot <label>
    local shot
    shot=$shots/$vm-$(date +%Y%m%d-%H%M%S)-$1.png
    if "$here/ssh" "$vm" "$user" -- "$hypr sleep 2; grim -" > "$shot" 2>/dev/null && [[ -s $shot ]]; then
