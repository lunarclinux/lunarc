        "$here/ssh" "$vm" "$user" -- "$hypr mkdir -p ~/.cache/noctalia && printf '%s' '$weather_json' > ~/.cache/noctalia/weather.json && sed -i '/^privacy.weather *=/d' ~/.config/$id/settings && echo 'privacy.weather = on' >> ~/.config/$id/settings && $id bar moon on >/dev/null; sleep 4" || true
        check "weather: the plugin's segment, with the moon in it" "$hypr x=\$(noctalia config export | tr -d '\\n'); grep -oE 'center = \\[[^]]*\\]' <<<\"\$x\" | head -1 | grep -qE '\"clock\", *\"weather\", *\"moon\"' && noctalia config export | grep -A4 '^\\[widget.weather\\]' | grep -q 'type = \"$id/utilities:weather\"'"
