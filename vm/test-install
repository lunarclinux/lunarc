# Layer 2 and later: the desktop session.
if "$here/ssh" "$vm" "$user" -- 'test -x /usr/bin/Hyprland'; then
  hypr='export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-1; export HYPRLAND_INSTANCE_SIGNATURE=$(ls $XDG_RUNTIME_DIR/hypr | head -1);'
  # Give the autologin session a moment to come up.
  for _ in $(seq 30); do "$here/ssh" "$vm" "$user" -- 'pgrep -x Hyprland' >/dev/null 2>&1 && break; sleep 2; done
  check "login screen service active"   'systemctl is-active --quiet greetd'
  check "Hyprland running for $user"    'pgrep -u "$USER" -x Hyprland >/dev/null'
  check "Hyprland answers hyprctl"      "$hypr hyprctl monitors | grep -q '^Monitor'"
  check "pointer hides when idle"       "$hypr"' hyprctl getoption cursor:inactive_timeout | grep -qE "(float|int): 3"'
  check "session config loaded cleanly" "$hypr"' out=$(hyprctl configerrors); echo "$out"; [ -z "$(printf %s "$out" | tr -d "[:space:]")" ] || printf %s "$out" | grep -qi "no errors"'
  # pipewire-pulse starts on demand, so its socket is what should be listening.
  check "audio services running"        'systemctl --user is-active --quiet pipewire wireplumber pipewire-pulse.socket && wpctl status >/dev/null'
  if "$here/ssh" "$vm" "$user" -- 'test -x /usr/bin/noctalia'; then
    # Layer 3: the shell.
    check "shell service running"        'systemctl --user is-active --quiet noctalia'
    check "shell owns notifications"     'busctl --user status org.freedesktop.Notifications 2>/dev/null | grep -q "^Comm=noctalia"'
    check "notifications can be sent"    "$hypr"' notify-send "Test" "Hello from the install test"'
    check "shell answers its IPC"        "$hypr"' noctalia msg status >/dev/null'
    check "shell config has no errors"   "$hypr"' noctalia config validate 2>&1 | tail -3; noctalia config validate >/dev/null 2>&1'
    check "weather and location off by default" "$hypr"' noctalia config export | grep -A3 "^\[weather\]" | grep -q "enabled = false" && noctalia config export | grep -A3 "^\[location\]" | grep -q "auto_locate = false"'
    check "crash capture never looks up symbols online" "systemctl --user show -p Environment $id-crash-watch.service | grep -qE 'DEBUGINFOD_URLS=( |\$)'"
    "$here/ssh" "$vm" "$user" -- "cat > ~/mpris-stub.py" < "$here/checks/mpris-stub.py"
    check "desktop connects nowhere unexpected (shell start, every panel, idle)" "$(sed -e "s/@ID@/$id/g" -e "s/@PW@/$password/g" "$here/checks/privacy-traffic.sh")"
    check "community templates, remote art and icons, external IP and telemetry off" "$hypr"' c=$(noctalia config export); for k in enable_community_templates remote_art remote_icons external_ip_enabled telemetry_enabled; do grep -qE "^ *$k *= *false\$" <<<"$c" || { echo "$k not false"; exit 1; }; done'
    check "NetworkManager's connectivity check is Arch's, as documented" "nm='org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager'; busctl get-property \$nm ConnectivityCheckEnabled; busctl get-property \$nm ConnectivityCheckUri | tee /dev/stderr | grep -qx 's \"http://ping.archlinux.org/nm-check.txt\"'"
    check "editor follows the theme"     "grep -q 'rendered by Noctalia' ~/.config/micro/colorschemes/noctalia.micro && ! grep -q '{{' ~/.config/micro/colorschemes/noctalia.micro"
    check "distro shell defaults applied" "$hypr"' noctalia config export | grep -qE "^polkit_agent *= *true"'
    check "clutter hidden from launcher"  "grep -q '^NoDisplay=true' /usr/local/share/applications/avahi-discover.desktop 2>/dev/null || grep -q '^NoDisplay=true' /usr/share/$id/xdg/applications/avahi-discover.desktop"
    # Every launcher entry must be one we mean to show; new dependency clutter fails here.
    check "launcher shows only intended apps" "for f in /usr/share/applications/*.desktop; do n=\${f##*/}; grep -q '^NoDisplay=true' \"\$f\" && continue; [ -f /usr/share/$id/xdg/applications/\$n ] && continue; echo \$n; done | sort | tr '\\n' ' ' | tee /dev/stderr | grep -qxE '(btop.desktop |com.mitchellh.ghostty.desktop |dev.noctalia.Noctalia.desktop |firefox.desktop |org.gnome.Calculator.desktop |org.gnome.Decibels.desktop |org.gnome.DiskUtility.desktop |org.gnome.Snapshot.desktop |system-config-printer.desktop |org.gnome.Loupe.desktop |org.gnome.Nautilus.desktop |org.gnome.Papers.desktop |org.gnome.Showtime.desktop |org.gnome.World.PikaBackup.desktop |org.gnome.TextEditor.desktop |org.wezfurlong.wezterm.desktop )+'"
    check "launcher opens"               "$hypr"' noctalia msg panel-open launcher'
    check "launcher: no exchange-rate downloads" "$hypr noctalia config export | grep -qE '^ *fetch_exchange_rates = false\$'"
  else
    check "polkit agent running"         'systemctl --user is-active --quiet hyprpolkitagent'
  fi
  if "$here/ssh" "$vm" "$user" -- "command -v $id" >/dev/null 2>&1; then
    term_cmd="$id terminal launch"; term_class=ghostty
