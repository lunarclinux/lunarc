  check "login screen in Frosted Terminal's look" "grep -qx 'font_family = \"Geist Mono\"' /var/lib/$id/greeter.toml && grep -qx 'corner_radius_scale = 1' /var/lib/$id/greeter.toml && grep -qx 'surface = \"#070b17\"' /var/lib/$id/greeter.toml && grep -qx 'on_surface_variant = \"#b4bbd0\"' /var/lib/$id/greeter.toml && grep -qx 'error = \"#f0a39a\"' /var/lib/$id/greeter.toml"
  check "login screen is themed"        "grep -qx 'primary = \"#ebc77a\"' /var/lib/$id/greeter.toml && grep -q '^path = \"/usr/share/$id/themes/moonlit/wallpapers/' /var/lib/$id/greeter.toml && [ \"\$(echo '$password' | sudo -S -p '' readlink /var/lib/noctalia-greeter/greeter.toml)\" = /var/lib/$id/greeter.toml ]"
  check "login screen starts the distro session" "noctalia-greeter sessions | grep -qx '$name' && grep -qx 'default = \"$name\"' /var/lib/$id/greeter.toml && grep -qx 'Exec=uwsm start -e -D Hyprland hyprland.desktop' /usr/share/wayland-sessions/$id.desktop"
  check "boot splash is the distro theme" "test -f /usr/share/plymouth/themes/$id/$id.script && [ \"\$(plymouth-set-default-theme)\" = $id ]"
  check "splash hook in the initramfs"   "grep -hE '^HOOKS=' /etc/mkinitcpio.conf.d/$id-hooks.conf | grep -qE 'systemd plymouth'"
  check "initramfs carries the splash"   "echo '$password' | sudo -S -p '' lsinitcpio /boot/initramfs-linux.img | grep -q 'usr/share/plymouth/themes/$id/$id.script'"
  check "splash on the boot command line" "grep -qw splash /proc/cmdline"
fi
if [[ -n $iso ]]; then
