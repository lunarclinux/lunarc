      }
      # The clock's two hairlines: the columns that
      # stand out from both neighbours along the bar's rows above and below
      # any text, nearest the middle of the screen. → "<left x> <right x> <screen width>"
      clock_lines() { # clock_lines <png> [bar's top y] → "<left x> <right x> <screen width> <toggles' hairline x>"
        magick "$1" -crop "x30+0+${2:-0}" +repage -colorspace gray -depth 8 txt:- | awk -F'[,:() ]+' -v W="$(magick identify -format %w "$1")" '
          NR > 1 && (($2 >= 3 && $2 <= 6) || ($2 >= 23 && $2 <= 26)) { g[$1] += $3 }
          function line(x) { return g[x] - (g[x-1] + g[x+1]) / 2 > 60 }
          END {
            mid = int(W / 2); l = -1; r = -1; t = -1
            for (x = mid - 1; x > mid - 300 && l < 0; x--) if (line(x)) l = x
            for (x = mid; x < mid + 300 && r < 0; x++) if (line(x)) r = x
            for (x = l - 2; x > l - 400 && x > 1 && t < 0; x--) if (line(x)) t = x
            print l, r, W, t }'
