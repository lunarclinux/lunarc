  check "the login screen's session can't use the greeter-theme helper" "grep -q 'subject.user == \"greeter\"' /usr/share/polkit-1/rules.d/50-$id-greeter-theme.rules"
  check "MT7921 Wi-Fi: no ASPM (when that card is present)" "modprobe -c | grep -qx 'options mt7921e disable_aspm=1'"
  check "calculator downloads nothing"  "[ \$(gsettings get org.gnome.calculator refresh-interval) = 0 ]"
  check "firmware checks only on request" "pacman -Q fwupd >/dev/null && ! systemctl is-enabled --quiet fwupd-refresh.timer"
  check "home folder private"           "[ \$(stat -c %a ~) = 700 ]"
  check "privacy switches report"       "$id privacy | grep -qE '^weather in the bar +off' && $id firewall apps | grep -q localsend"
  # Security pass.
  check "security check, install watch, rootless containers" "$(sed -e "s/@ID@/$id/g" -e "s/@PW@/$password/g" "$here/checks/security.sh")"
  check "nothing pipes a download into a shell" "! grep -rIlE '(curl|wget)[^|]*\\|[[:space:]]*(sudo[[:space:]]+)?(ba|z)?sh\\b' /usr/lib/$id /usr/share/$id/default 2>/dev/null | grep -q ."
  # DNS: resolved only for encrypted DNS, never LLMNR
