#!/usr/bin/env bash
# Builds the installer ISO inside a build VM (mkarchiso needs root on Arch),
# then puts it in libvirt's default pool as distro-installer.iso and copies it
# to ~/Downloads/arch-iso/ (e.g. for a Ventoy USB stick).
#
#   vm/build-iso [--vm distro-dev] [--ref HEAD] [--release]
#
# --release: use the signed packages already in pkg/out (from
# `pkg/build --chroot`, the build that was published) instead of building
# unsigned ones, so the ISO carries exactly what installed systems get.
# The ISO scripts come from that build's commit unless --ref is given.
#
# The build VM must be an installed system with archiso, whose 'tester' password
# is in ~/.local/share/arch-distro-vm/<vm>.password (vm/test-install sets that up).
set -euo pipefail
export LIBVIRT_DEFAULT_URI=qemu:///system
here=$(cd "$(dirname "$0")" && pwd); repo=$(dirname "$here")
vm=distro-dev ref=HEAD ref_given=0 release=0
while [[ $# -gt 0 ]]; do
  case $1 in --vm) vm=$2; shift 2 ;; --ref) ref=$2; ref_given=1; shift 2 ;; --release) release=1; shift ;; *) echo "unknown option: $1" >&2; exit 2 ;; esac
done
log() { printf '\033[1m[build-iso]\033[0m %s\n' "$*"; }
pw=$(<~/.local/share/arch-distro-vm/$vm.password)
ssh_vm() { "$here/ssh" "$vm" tester -- "$@"; }

[[ $(virsh domstate "$vm") == running ]] || virsh start "$vm" >/dev/null
for _ in $(seq 60); do ssh_vm true 2>/dev/null && break; sleep 3; done

if (( release )); then
  BUILD_MODE="" BUILD_COMMIT=""
  [[ -f $repo/pkg/out/build-info ]] && source "$repo/pkg/out/build-info"
  [[ $BUILD_MODE == chroot ]] || { echo "build-iso: --release needs the clean-chroot build in pkg/out (pkg/build --chroot)" >&2; exit 1; }
  for f in "$repo"/pkg/out/repo/*.pkg.tar.zst; do
    [[ -f $f.sig ]] || { echo "build-iso: $(basename "$f") isn't signed" >&2; exit 1; }
  done
  # The ISO's own scripts come from the packages' commit, unless --ref names
  # a later one (a fix to the ISO build that doesn't touch the packages).
  (( ref_given )) || ref=$BUILD_COMMIT
  log "using the signed packages built from ${BUILD_COMMIT:0:7}, ISO scripts from $(git -C "$repo" rev-parse --short "$ref")"
else
  log "building packages from $(git -C "$repo" rev-parse --short "$ref")"
  "$repo/pkg/build" "$ref" >/dev/null 2>&1
fi
ssh_vm "echo '$pw' | sudo -S -p '' sh -c 'pacman -S --needed --noconfirm archiso >/dev/null && rm -rf /home/tester/isosrc /home/tester/isoout'"
ssh_vm 'mkdir -p ~/isosrc'
git -C "$repo" archive "$ref" | ssh_vm 'tar -x -C ~/isosrc'
tar -C "$repo" -cf - pkg/out/repo | ssh_vm 'tar -x -m -C ~/isosrc'

log "running mkarchiso in $vm"
ssh_vm "cd ~/isosrc && echo '$pw' | sudo -S -p '' iso/build /home/tester/isoout > /tmp/isobuild.log 2>&1" \
  || { ssh_vm 'tail -20 /tmp/isobuild.log'; exit 1; }
name=$(ssh_vm 'basename /home/tester/isoout/*.iso')

log "copying $name"
dl=~/Downloads/arch-iso; mkdir -p "$dl"
ssh_vm "cat /home/tester/isoout/$name" > "$dl/$name"
virsh vol-delete --pool default distro-installer.iso >/dev/null 2>&1 || true
virsh vol-create-as default distro-installer.iso "$(stat -c %s "$dl/$name")" --format raw >/dev/null
virsh vol-upload --pool default distro-installer.iso "$dl/$name"
sha256sum "$dl/$name" | sed "s|$dl/||" > "$dl/$name.sha256"
log "done: $dl/$name (also in the pool as distro-installer.iso)"
