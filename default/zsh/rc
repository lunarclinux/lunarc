# Distro shell defaults for zsh: history, prompt, smarter cd, ls and search.
# ~/.zshrc sources this; `@DISTRO_ID@ shell defaults off` removes that line.
[[ -o interactive ]] || return 0

HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=50000
SAVEHIST=100000
setopt share_history hist_ignore_all_dups hist_ignore_space

autoload -Uz compinit && compinit

if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --git --group-directories-first'
  alias la='eza -la --git --group-directories-first'
  alias lt='eza --tree --level=2 --group-directories-first'
fi

if (( $+commands[fzf] )); then
  export FZF_DEFAULT_OPTS="--color=16 --height=40% --layout=reverse --border"
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
  source <(fzf --zsh)
fi

export BAT_THEME=ansi
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[mise] )) && eval "$(mise activate zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

# `@DISTRO_ID@ security watch on`: install commands that bypass the package
# manager (a script piped into a shell, npm -g, pip, cargo install, ...) are
# noted in a private log on this computer, never sent anywhere.
if grep -qsx 'security.watch = on' "${XDG_CONFIG_HOME:-$HOME/.config}/@DISTRO_ID@/settings"; then
  __install_watch() {
    [[ $1 =~ '(^|[[:space:];|&(])(curl|wget|npm|pnpm|yarn|bun|pip3?|pipx|uv|cargo|go|gem|make)[[:space:]]|\.[Aa]pp[Ii]mage' ]] && { @DISTRO_ID@ security noted -- "$1" >/dev/null 2>&1 &! }
    return 0
  }
  autoload -Uz add-zsh-hook && add-zsh-hook preexec __install_watch
fi
return 0
