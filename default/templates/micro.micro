# micro colour scheme rendered by Noctalia from the active theme.
# Generated: changes are overwritten when the theme changes.
color-link default "{{ colors.terminal_foreground.default.hex }},{{ colors.terminal_background.default.hex }}"
color-link comment "italic {{ colors.on_surface_variant.default.hex }}"
color-link identifier "{{ colors.terminal_normal_blue.default.hex }}"
color-link constant "{{ colors.terminal_normal_yellow.default.hex }}"
color-link constant.string "{{ colors.terminal_normal_green.default.hex }}"
color-link constant.string.char "{{ colors.terminal_normal_green.default.hex }}"
color-link constant.number "{{ colors.terminal_bright_yellow.default.hex }}"
color-link constant.bool "{{ colors.terminal_normal_yellow.default.hex }}"
color-link statement "bold {{ colors.terminal_normal_magenta.default.hex }}"
color-link symbol "{{ colors.on_surface_variant.default.hex }}"
color-link symbol.brackets "{{ colors.terminal_foreground.default.hex }}"
color-link preproc "{{ colors.terminal_normal_red.default.hex }}"
color-link type "{{ colors.terminal_normal_cyan.default.hex }}"
color-link special "{{ colors.terminal_bright_magenta.default.hex }}"
color-link underlined "underline {{ colors.terminal_normal_blue.default.hex }}"
color-link error "bold {{ colors.error.default.hex }}"
color-link todo "bold {{ colors.on_primary.default.hex }},{{ colors.primary.default.hex }}"
color-link hlsearch "{{ colors.on_primary.default.hex }},{{ colors.primary.default.hex }}"
color-link match-brace "bold {{ colors.primary.default.hex }}"
color-link selection "{{ colors.terminal_selection_fg.default.hex }},{{ colors.terminal_selection_bg.default.hex }}"
color-link statusline "{{ colors.on_surface.default.hex }},{{ colors.surface_container_high.default.hex }}"
color-link statusline.inactive "{{ colors.on_surface_variant.default.hex }},{{ colors.surface_container.default.hex }}"
color-link tabbar "{{ colors.on_surface_variant.default.hex }},{{ colors.surface_container.default.hex }}"
color-link tabbar.active "bold {{ colors.on_primary.default.hex }},{{ colors.primary.default.hex }}"
color-link indent-char "{{ colors.outline.default.hex }}"
color-link line-number "{{ colors.outline.default.hex }},{{ colors.terminal_background.default.hex }}"
color-link current-line-number "bold {{ colors.primary.default.hex }},{{ colors.surface_container_low.default.hex }}"
color-link cursor-line "{{ colors.surface_container_low.default.hex }}"
color-link color-column "{{ colors.surface_container_low.default.hex }}"
color-link gutter-error "{{ colors.error.default.hex }}"
color-link gutter-warning "{{ colors.terminal_normal_yellow.default.hex }}"
color-link diff-added "{{ colors.terminal_normal_green.default.hex }}"
color-link diff-modified "{{ colors.terminal_normal_yellow.default.hex }}"
color-link diff-deleted "{{ colors.terminal_normal_red.default.hex }}"
color-link divider "{{ colors.outline.default.hex }},{{ colors.terminal_background.default.hex }}"
color-link scrollbar "{{ colors.outline.default.hex }}"
color-link message "{{ colors.on_surface.default.hex }}"
color-link error-message "bold {{ colors.error.default.hex }}"
color-link trailingws "{{ colors.terminal_normal_red.default.hex }}"
