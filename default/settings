# Distro defaults for the CLI. Override any line in ~/.config/<distro id>/settings.
theme = moonlit
theme.mode = dark
# Window corners and the bar (later also menus): terminal or rounded. Blur: on or off.
theme.shape = terminal
theme.blur = on
# The bar's system stats: icons, hover or inline. The moon segment: on or off.
bar.stats = icons
bar.moon = off
terminal = ghostty
agent = claude
crash.notify = first
crash.diagnose_all = terminal
crash.keep_resolved = system

# Lock screen: a password box (box) or the ring (ring) appears while typing.
lock.indicator = box
