# Distro defaults for the CLI. Override any line in ~/.config/<distro id>/settings.
theme = moonlit
theme.mode = dark
# Window corners and the bar (later also menus): terminal or rounded. Blur: on or off.
theme.shape = terminal
theme.blur = on
# How much the terminal shows the wallpaper: solid, frosted (the theme's own), clear, or 0.3-1.
theme.terminal_opacity = frosted
# Desktop notifications from programs in the terminal (Claude Code and others): on or off.
terminal.notifications = off
# The browser web apps (app install <web app>) open in: chromium, edge or chrome.
app.web_browser = chromium
# The login screen's password field has an eye that shows what's typed: on or off.
login.show_password = on
# The bar's system stats: icons, hover or inline. The moon segment: on or off.
bar.stats = icons
bar.moon = off
# The menu's Install searches the AUR too once you've typed three letters
# (the words go to aur.archlinux.org). `@DISTRO_ID@ privacy aur-search off` stops it.
privacy.aur_search = on
# Check for updates once a day in the background (downloads the package lists
# from the Arch and distro package servers): `@DISTRO_ID@ update auto-check on`.
update.auto_check = off
terminal = ghostty
agent = claude
crash.notify = first
crash.diagnose_all = terminal
crash.keep_resolved = system

# Lock screen: a password box (box) or the ring (ring) appears while typing.
lock.indicator = box
