# App fonts in the desktop's faces (Frosted Terminal, decision record 0043):
# GTK apps (Files, Text Editor, the keyring and other prompts) use Geist, as
# the shell's panels do, and Geist Mono where they ask for a monospace face.
# Defaults only: a font chosen in an app or with gsettings still wins.
# Compiled by glib2's pacman hook.
[org.gnome.desktop.interface]
font-name='Geist 11'
document-font-name='Geist 11'
monospace-font-name='Geist Mono 11'

# File pickers (open, save, choose a folder) show a box to type a path in, not
# only the folder buttons: a path like /mnt/nas/... is quicker to type than to
# click to. GTK 4 and GTK 3 dialogs; Ctrl+L still switches.
[org.gtk.gtk4.Settings.FileChooser]
location-mode='filename-entry'

[org.gtk.Settings.FileChooser]
location-mode='filename-entry'
