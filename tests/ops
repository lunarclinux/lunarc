#!/usr/bin/env bash
# Checks the ops tools (`<id> nas`) against the test driver, a NAS that's
# a JSON file: connect (wrong key, a key stronger than its level), status,
# and the guardrails every change goes through (level, confirm, backup,
# audit log, rate limit), the certificate pin, and what input is refused.
# No network, no keyring (a stand-in), nothing outside a temporary folder.
#
#   tests/ops
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
DISTRO_ID=distro XDG_CONFIG_HOME=$work/config XDG_STATE_HOME=$work/state \
  python3 -I - "$root/bin" "$work" <<'PY'
import io, json, os, stat, sys
sys.path.insert(0, sys.argv[1])
work = sys.argv[2]
from ops import cli, core, tls
from ops.drivers import fake

fails = 0
def expect(desc, ok):
    global fails
    print(("ok    " if ok else "FAIL  ") + desc)
    fails += 0 if ok else 1

# The keyring, stood in for by a dict.
keys = {}
core.store_key = lambda n, k: keys.__setitem__(n, k)
core.lookup_key = lambda n: keys[n]
core.clear_key = lambda n: keys.pop(n, None)
cli.core = core

nas = os.path.join(work, "nas.json")
def reset(role="watch"):
    with open(nas, "w") as f:
        json.dump({"user": "desk", "key": "s3cret-key", "role": role, "version": "25.10.0",
                   "alerts": ["pool tank is 85% full"], "pools": ["tank", "tank/old"], "snapshots": []}, f)
reset()

def run(argv, stdin=""):
    sys.stdin = io.StringIO(stdin)
    out, err = io.StringIO(), io.StringIO()
    so, se = sys.stdout, sys.stderr
    sys.stdout, sys.stderr = out, err
    try:
        rc = cli.main("nas", argv)
    finally:
        sys.stdout, sys.stderr = so, se
    return rc, out.getvalue() + err.getvalue()

base = ["connect", "home", "--driver", "fake", "--address", nas, "--user", "desk", "--key-stdin"]
rc, out = run(base + ["--level", "watch"], "wrong\n")
expect("a wrong key is refused", rc == 1 and "refused" in out)
expect("... and nothing is saved", core.load_appliances() == {} and keys == {})

reset("full")
rc, out = run(base + ["--level", "watch"], "s3cret-key\n")
expect("a full-admin key for the watch level is refused without a terminal", rc == 1 and "more than watch" in out)
expect("... and nothing is saved", core.load_appliances() == {})

reset()
rc, out = run(base + ["--level", "watch"], "s3cret-key\n")
expect("connect at watch", rc == 0 and "level watch" in out)
cfg = core.appliances_file()
expect("the settings file is private (600, folder 700)",
       stat.S_IMODE(os.stat(cfg).st_mode) == 0o600 and stat.S_IMODE(os.stat(os.path.dirname(cfg)).st_mode) == 0o700)
expect("the key is in the keyring, not the settings or the log",
       keys.get("home") == "s3cret-key" and "s3cret" not in open(cfg).read() and "s3cret" not in open(core.audit_file()).read())

rc, out = run(["status", "--json"])
st = json.loads(out)
expect("status reads the NAS", rc == 0 and st["sections"][0]["items"][0]["text"] == "pool tank is 85% full")
rc, out = run(["list"])
expect("list shows it", out.startswith("home\tTest NAS\t"))

name, app = core.get_appliance("home", "nas")
drv = cli.open_driver(name, app)
lines = []
def change(action, args, answer=True):
    return core.change(name, core.load_appliances()[name], drv, action, args, lambda q: answer, out=lines.append)

def audit():
    return [json.loads(l) for l in open(core.audit_file())]

try:
    change("snapshot", {"dataset": "tank", "name": "a"})
    expect("a snapshot is refused at watch", False)
except core.OpsError as e:
    expect("a snapshot is refused at watch", "needs operate" in str(e) and audit()[-1]["result"] == "refused: level")

rc, out = run(base + ["--level", "operate", "--yes"], "s3cret-key\n")
expect("connect again at operate", rc == 0)
r = change("snapshot", {"dataset": "tank", "name": "b"}, answer=False)
expect("declined: nothing changes, the log says so",
       r is None and json.load(open(nas))["snapshots"] == [] and audit()[-1]["result"] == "declined")
change("snapshot", {"dataset": "tank", "name": "c"})
last = audit()[-1]
expect("a snapshot at operate: done, previewed, logged with before and after",
       json.load(open(nas))["snapshots"] == ["tank@c"] and "+ snapshot tank@c" in " ".join(lines)
       and last["result"] == "done" and last["before"] == {"snapshots": []} and last["after"] == {"snapshots": ["tank@c"]})
try:
    change("dataset_delete", {"dataset": "tank/old"})
    expect("deleting is refused below admin", False)
except core.OpsError:
    expect("deleting is refused below admin", "tank/old" in json.load(open(nas))["pools"])

rc, out = run(base + ["--level", "admin", "--yes"], "s3cret-key\n")
change("dataset_delete", {"dataset": "tank/old"})
s = json.load(open(nas))
expect("at admin, the backup comes first, then the change",
       "tank/old" not in s["pools"] and "tank/old@before-delete" in s["snapshots"])

for i in range(core.RATE_LIMIT):
    try:
        change("snapshot", {"dataset": "tank", "name": f"r{i}"})
    except core.OpsError:
        break
try:
    change("snapshot", {"dataset": "tank", "name": "over"})
    expect("the rate limit stops the next change", False)
except core.OpsError as e:
    expect("the rate limit stops the next change", "last minute" in str(e) and audit()[-1]["result"] == "refused: rate")

class Sock:
    def __init__(self, der): self.der = der
    def getpeercert(self, binary_form=False): return self.der
pin = {"mode": "pin", "pin": tls.fingerprint(b"cert-a")}
tls.check_pin(Sock(b"cert-a"), pin, "home")
try:
    tls.check_pin(Sock(b"cert-b"), pin, "home")
    expect("a different certificate is refused", False)
except core.OpsError as e:
    expect("a different certificate is refused", "different certificate" in str(e))
expect("an unpinned connection is never accepted as pinned", tls.sslopt({})["cert_reqs"] == 0)
expect("[::1]:8443 splits into host and port", tls.split_address("[::1]:8443") == ("::1", 8443))

def refused(fn, value):
    try:
        fn(value)
        return False
    except core.OpsError:
        return True
expect("bad names are refused", all(refused(core.check_name, v) for v in ["", "Nas", "-x", "a b", "a/b", "x" * 33]))
expect("bad addresses are refused",
       all(refused(core.check_address, v) for v in ["", "a b", "h;rm", "http://h", "h/x", "-h", "h:99999x"]))
expect("good addresses pass", not any(refused(core.check_address, v)
       for v in ["nas", "nas.home.arpa", "10.0.0.20", "nas:8443", "[fd00::1]:443"]))

# The agents' MCP server: tools by level, preview first, logged as the agent.
from ops import mcp
rc, out = run(base + ["--level", "watch", "--yes"], "s3cret-key\n")
names = [t["name"] for t in mcp.tools()]
expect("MCP at watch: status only, no change tools", names == ["nas_list", "nas_status"])
rc, out = run(base + ["--level", "operate", "--yes"], "s3cret-key\n")
names = [t["name"] for t in mcp.tools()]
expect("MCP at operate: snapshot listed, delete not", "nas_snapshot" in names and "nas_dataset_delete" not in names)
os.environ["OPS_ACTOR"] = "agent"
core.RATE_LIMIT = 100  # the earlier checks used up this minute's changes
reset()
r = mcp.call("nas_snapshot", {"dataset": "tank", "name": "m"})
expect("an agent's change without confirm is only a preview",
       "preview only" in r["content"][0]["text"] and json.load(open(nas))["snapshots"] == [])
r = mcp.call("nas_snapshot", {"dataset": "tank", "name": "m", "confirm": True})
expect("with confirm it's made and logged as the agent's",
       json.load(open(nas))["snapshots"] == ["tank@m"] and audit()[-1]["actor"] == "agent")
try:
    mcp.call("nas_snapshot", {"dataset": "tank", "name": "m", "extra": "x", "confirm": True})
    expect("unexpected arguments are refused", False)
except core.OpsError:
    expect("unexpected arguments are refused", True)
r = mcp.call("nas_status", {})
expect("an agent reads status", "tank: online" in r["content"][0]["text"])
del os.environ["OPS_ACTOR"]

# A monitor's check-ins (Healthchecks, stood in for) join the NAS's status.
from ops.drivers import healthchecks
from datetime import datetime, timedelta, timezone
recent = (datetime.now(timezone.utc) - timedelta(hours=6)).isoformat()
healthchecks.Healthchecks._get = lambda self, path: {"checks": [
    {"name": "Restic backup", "status": "up", "last_ping": recent},
    {"name": "Old job", "status": "down", "last_ping": None}]}
data = core.load_appliances()
data["hc"] = {"role": "monitor", "driver": "healthchecks", "address": "hc.example", "user": "-", "level": "watch",
              "tls": {"mode": "system"}}
core.save_appliances(data); keys["hc"] = "ro-key"
rc, out = run(["status", "home", "--json"])
items = {i["text"]: i["state"] for sct in json.loads(out)["sections"] if sct["title"] == "Check-ins (hc)" for i in sct["items"]}
expect("check-ins show in the NAS's status", items == {"Restic backup: up, last check-in 6 hours ago": "ok",
                                                         "Old job: down": "bad"})
rc, out = run(["forget", "hc", "--yes"])
expect("a monitor can be forgotten", rc == 0 and "hc" not in core.load_appliances())

# A product whose driver package isn't installed: says which package.
from ops import drivers
saved = drivers.DRIVERS.pop("truenas")
try:
    drivers.get("truenas")
    expect("a missing driver names its package", False)
except core.OpsError as e:
    expect("a missing driver names its package", "distro-ops-truenas" in str(e))
drivers.DRIVERS["truenas"] = saved

rc, out = run(["forget", "home", "--yes"])
expect("forget removes it and its key", rc == 0 and core.load_appliances() == {} and "home" not in keys)

print(f"\n{'all passed' if not fails else f'{fails} failed'}")
sys.exit(1 if fails else 0)
PY
