#!/usr/bin/env bash
# Checks files_bookmarks (bin/lib.sh), which puts the standard folders in
# Files' sidebar: the existing ones are added above the user's own bookmarks,
# from wherever xdg-user-dirs keeps them (a name with a space encoded); one
# already bookmarked stays where it is, a missing one is skipped and not
# created, and a second run adds nothing.
#
#   tests/files-bookmarks
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
command -v xdg-user-dir >/dev/null || { echo "files-bookmarks: xdg-user-dir not installed; skipped"; exit 0; }
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/.config/gtk-3.0" "$work/Documents" "$work/Downloads" "$work/My Pictures" "$work/Videos"
cat > "$work/.config/user-dirs.dirs" <<'DIRS'
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_PICTURES_DIR="$HOME/My Pictures"
XDG_MUSIC_DIR="$HOME/Music"
XDG_VIDEOS_DIR="$HOME/Videos"
DIRS
printf 'file://%s/Downloads\nfile:///mnt/nas/me/backups NAS backups\n' "$work" > "$work/.config/gtk-3.0/bookmarks"
HOME=$work XDG_CONFIG_HOME=$work/.config DISTRO_ID=distro DISTRO_LIB=$root/bin bash -euo pipefail -c \
  'source "$DISTRO_LIB/lib.sh"; files_bookmarks; files_bookmarks'
want="file://$work/Documents|file://$work/My%20Pictures|file://$work/Videos|file://$work/Downloads|file:///mnt/nas/me/backups NAS backups"
got=$(paste -sd'|' "$work/.config/gtk-3.0/bookmarks")
if [[ $got == "$want" ]]; then echo "ok    standard folders above the user's bookmarks, once"; else echo "FAIL  bookmarks: $got"; exit 1; fi
if [[ ! -e $work/Music ]]; then echo "ok    a missing folder isn't created"; else echo "FAIL  Music was created"; exit 1; fi
