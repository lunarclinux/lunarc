#!/usr/bin/env bash
# Checks how `update security` reads the security feed: which installed
# packages wait for a fix (older than the fixed version, upstream version in
# the affected range) and that anything that isn't a plain name or version is
# ignored. A made-up feed and package list; no network, no pacman database.
#
#   tests/security-feed
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
export DISTRO_ID=distro DISTRO_LIB=$root/bin
source "$root/bin/security-feed.sh"
set +e

# CI's lint job runs on Ubuntu, without pacman's vercmp: sort -V orders these
# test versions the same way.
if ! command -v vercmp >/dev/null; then
  vercmp() {
    if [[ $1 == "$2" ]]; then echo 0
    elif [[ $(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1) == "$1" ]]; then echo -1
    else echo 1; fi
  }
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fails=0

expect() { # expect <description> <expected> <actual>
  if [[ $2 == "$3" ]]; then
    printf 'ok    %s\n' "$1"
  else
    printf 'FAIL  %s: expected "%s", got "%s"\n' "$1" "$2" "$3"
    fails=$((fails + 1))
  fi
}

cat > "$work/installed" <<'LIST'
brotli 1.2.0-1
curl 8.22.0-1
expat 2.8.3-1
gnutls 3.8.13-2
openssl 3.6.0-1
noctalia 1:5.2.1-1
zlib 1:1.3.1-2
LIST
cat > "$work/feed.json" <<'JSON'
{"version": 1, "generated": "2026-10-28T00:00:00Z", "advisories": [
 {"id": "CVE-2026-111497", "pkg": "brotli", "fixed": "1.2.1-1", "below": "1.2.1", "from": "1.0.3", "score": 9.2, "summary": "decoder overflow"},
 {"id": "CVE-2026-10536", "pkg": "curl", "fixed": "8.23.0-1", "below": "8.20.1", "from": "8.17.0", "score": 9.8, "summary": "fixed before ours"},
 {"id": "CVE-2026-66046", "pkg": "expat", "fixed": "2.9.0-1", "through": "2.8.3", "score": 8.7, "summary": "through ours"},
 {"id": "CVE-2026-42013", "pkg": "gnutls", "fixed": "3.8.13-3", "score": 8.2, "summary": "Arch's backport"},
 {"id": "CVE-2026-1", "pkg": "openssl", "fixed": "3.6.0-1", "below": "3.6.1", "score": 7.5, "summary": "same version: nothing newer"},
 {"id": "CVE-2026-2", "pkg": "notinstalled", "fixed": "2-1", "score": 9.9, "summary": "x"},
 {"id": "CVE-2026-3", "pkg": "zlib", "fixed": "1:1.3.2-1", "below": "1.3.2", "severity": "high", "summary": "epoch"},
 {"id": "CVE-2026-4", "pkg": "curl;reboot", "fixed": "9-1", "score": 9.9, "summary": "bad name"},
 {"id": "CVE-2026-5", "pkg": "curl", "fixed": "$(id)", "score": 9.9, "summary": "bad version"},
 {"id": "CVE-2026-6", "pkg": "expat", "fixed": "2.9.0-1", "below": "2.9.0 x", "score": 9.9, "summary": "bad range"}
]}
JSON

out=$(feed_waiting "$work/feed.json" "$work/installed")
ids=$(awk '{ print $1 ":" $4 }' <<<"$out" | tr '\n' ' ')
expect "waiting: in range, through, backport, epoch" \
  "brotli:CVE-2026-111497 expat:CVE-2026-66046 gnutls:CVE-2026-42013 zlib:CVE-2026-3 " "$ids"
expect "line: package, installed, fixed, id, score, summary" \
  "brotli 1.2.0-1 1.2.1-1 CVE-2026-111497 9.2 decoder overflow" "$(head -1 <<<"$out")"
expect "severity when there's no score" "high" "$(awk '$1 == "zlib" { print $5 }' <<<"$out")"
expect "a feed that isn't JSON: nothing" "" "$(echo 'not json' > "$work/bad.json"; feed_waiting "$work/bad.json" "$work/installed")"

# The feed's address: only https, from repo.conf.
mkdir -p "$work/lib"
printf 'ADVISORIES_URL=https://github.com/example/$DISTRO_ID/releases/download/security/advisories.json\n' > "$work/lib/repo.conf"
expect "feed url" "https://github.com/example/distro/releases/download/security/advisories.json" "$(DISTRO_LIB=$work/lib feed_url)"
printf 'ADVISORIES_URL=http://example.com/a.json\n' > "$work/lib/repo.conf"
expect "plain http refused" "" "$(DISTRO_LIB=$work/lib feed_url)"
printf 'ADVISORIES_URL=https://example.com/a.json;rm\n' > "$work/lib/repo.conf"
expect "odd characters refused" "" "$(DISTRO_LIB=$work/lib feed_url)"

(( fails == 0 )) || { echo "$fails failed"; exit 1; }
