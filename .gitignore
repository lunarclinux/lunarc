# VM disks and ISOs live outside the repo
*.qcow2
*.img
*.iso
*.iso.sig

# Build output (layers 6 and 8)
*.pkg.tar.zst
*.pkg.tar.zst.sig
pkg/*/src/
pkg/*/pkg/
iso/work/
iso/out/

# Keys never go in the repo
*.gpg
*.asc
*.key
secring*
# ...except the public package-signing key (pkg/keyring)
!pkg/keyring/signing-key.asc

# Package build output (release builds; test builds)
pkg/out/
pkg/out-test/
iso/out/

# Website build output (tools/make-site)
site/dist/
